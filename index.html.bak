// Mutable store — keyed by 'YYYY-MM'
let BS_BALANCES_BY_MONTH = { '2026-02': JSON.parse(JSON.stringify(BS_BALANCES_SEED)) };

// Helper: get balances for the current accounting period
function bsBalancesForPeriod(year, month){
  const key = `${year}-${String(month).padStart(2,'0')}`;
  // If no data for this month yet, return empty (not seed — months are independent)
  return BS_BALANCES_BY_MONTH[key] || {};
}

// Helper: set a single GL balance for current period
function bsSetBalance(year, month, code, token, amount){
  const key = `${year}-${String(month).padStart(2,'0')}`;
  if(!BS_BALANCES_BY_MONTH[key]) BS_BALANCES_BY_MONTH[key] = {};
  if(!BS_BALANCES_BY_MONTH[key][code]) BS_BALANCES_BY_MONTH[key][code] = {};
  BS_BALANCES_BY_MONTH[key][code][token] = amount;
}

// Compat shim — old code that reads BS_BALANCES still works via proxy to current period
let BS_BALANCES = new Proxy({}, {
  get(_, code){ return (bsBalancesForPeriod(accPeriodYear, accPeriodMonth))[code]; },
  set(_, code, val){ bsSetBalance(accPeriodYear, accPeriodMonth, code, Object.keys(val)[0], Object.values(val)[0]); return true; }
});

const TOKEN_COLORS = {
  USDC:'#2775CA', ORCA:'#00A8A8', SOL:'#9945FF',
  USDT:'#26A17B', PYUSD:'#004085', ETH:'#627EEA',
  TUNA:'#e06b00', default:'#888'
};
function tcol(sym){ return TOKEN_COLORS[sym] || TOKEN_COLORS.default; }

function tokenBadgeAcc(sym){
  const c = tcol(sym);
  return `<span style="display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;background:${c}18;border:1px solid ${c}35;font-family:var(--mono);font-size:0.68rem;color:${c};font-weight:600">${sym}</span>`;
}

// Read on-chain balance from state.walletData (populated by main Fetch Data)
// ── Accounting On-Chain Cache (independent of state.walletData) ───────────
// accOnchainMonthCache['YYYY-MM'][address] = { SOL, ORCA, USDC, USDT, PYUSD, ... }
let accOnchainMonthCache = {};

function accCacheKey(year, month){ return `${year}-${String(month).padStart(2,'0')}`; }

function accOnchainAmt(addr, token){
  const key = accCacheKey(accPeriodYear, accPeriodMonth);
  return accOnchainMonthCache[key]?.[addr]?.[token] ?? null;
}

function accHasMonthData(year, month){
  const key = accCacheKey(year, month);
  return !!accOnchainMonthCache[key] && Object.keys(accOnchainMonthCache[key]).length > 0;
}

// Fetch historical on-chain balances for all BS_ACCOUNTS wallets at month-end
// localStorage key for persisting acc on-chain cache across reloads
const ACC_ONCHAIN_LS_KEY = 'tidelog_acc_onchain_v1';

function accSaveOnchainToLS(){
  try { localStorage.setItem(ACC_ONCHAIN_LS_KEY, JSON.stringify(accOnchainMonthCache)); } catch(e){}
}
function accLoadOnchainFromLS(){
  try {
    const raw = localStorage.getItem(ACC_ONCHAIN_LS_KEY);
    if(raw){ const d = JSON.parse(raw); Object.assign(accOnchainMonthCache, d); }
  } catch(e){}
}
// Load on startup
accLoadOnchainFromLS();

async function accFetchOnchain(year, month){
  console.log('[BS] accFetchOnchain called with year:', year, 'month:', month);
  const key     = accCacheKey(year, month);
  const endTs   = accMonthEndTs(year, month);
  const endDate = new Date(endTs * 1000).toISOString().slice(0,10); // YYYY-MM-DD
  console.log('[BS] endDate:', endDate, 'endTs:', endTs);

  // Unique wallet addresses from BS_ACCOUNTS
  const addrs = [...new Set(BS_ACCOUNTS.flatMap(a => a.wallets||[]))].filter(Boolean);
  console.log('[BS] Found', addrs.length, 'wallet addresses:', addrs.map(a=>a.slice(0,8)));

  const btn    = document.getElementById('acc-fetch-btn');
  const status = document.getElementById('acc-price-status');
  if(btn)    { btn.disabled = true; btn.textContent = '⟳ Fetching…'; }

  if(!accOnchainMonthCache[key]) accOnchainMonthCache[key] = {};

  let done = 0;
  let retries = 0;
  const MAX_RETRIES = 3;
  
  for(const addr of addrs){
    // Skip if already cached
    if(accOnchainMonthCache[key][addr]) {
      done++;
      continue;
    }
    
    if(status) status.textContent = `⟳ fetching wallet ${done+1}/${addrs.length}…`;
    
    let success = false;
    for(let attempt = 0; attempt < MAX_RETRIES && !success; attempt++) {
      try {
        if(attempt > 0) {
          const backoff = Math.min(2000 * Math.pow(2, attempt), 10000);
          if(status) status.textContent = `⏳ rate limited, waiting ${backoff/1000}s... (${done+1}/${addrs.length})`;
          await new Promise(r => setTimeout(r, backoff));
        }
        
        const balances = await accFetchWalletAtDate(addr, endDate);
        accOnchainMonthCache[key][addr] = balances;
        success = true;
        retries = 0; // reset retry counter on success
      } catch(e) {
        console.error(`[BS] Failed to fetch ${addr.slice(0,8)} (attempt ${attempt+1}):`, e);
        if(attempt === MAX_RETRIES - 1) {
          accOnchainMonthCache[key][addr] = {};
        }
      }
    }
    
    done++;
    accSaveOnchainToLS();
    renderAccEntity();
    
    // Longer delay to avoid 429
    await new Promise(r => setTimeout(r, 500));
  }

  if(btn) { btn.disabled = false; btn.textContent = '⟳ Fetch On-Chain'; }
  if(status) status.textContent = `✓ ${done} wallets synced`;
  renderAccEntity();
}

// Fetch wallet balances at a historical date — isolated from _histCache
// Uses direct Helius RPC to avoid Railway proxy rate limits
async function accFetchWalletAtDate(address, cutoffDate){
  const cutoffTs = Math.floor(new Date(cutoffDate+'T23:59:59Z').getTime()/1000);

  try {
    const taD = await heliusRPCDirect('getTokenAccountsByOwner', [address,{programId:'TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA'},{encoding:'jsonParsed'}]);
    const tokenAccounts = (taD?.result?.value||[]).map(a=>({
      pubkey: a.pubkey,
      mint:   a.account?.data?.parsed?.info?.mint,
    })).filter(a => a.mint && FOCUS_SET.has(getSym(a.mint)));

    async function fetchTaBal(ta) {
      let before;
      let oldestBlockTime = null;
      for(let page=0; page<8; page++) {
        const sigRes = await heliusRPCDirect('getSignaturesForAddress', [ta.pubkey, {limit:50, ...(before?{before}:{})}]);
        const sigs = sigRes?.result || [];
        if(!sigs.length) break;
        for(const s of sigs) {
          if(s.blockTime != null) oldestBlockTime = s.blockTime;
          if(s.err) continue;
          if(s.blockTime != null && s.blockTime <= cutoffTs) {
            const txRes = await heliusRPCDirect('getTransaction', [s.signature, {encoding:'jsonParsed',maxSupportedTransactionVersion:0}]);
            const tx = txRes?.result;
            if(tx) {
              // Try by accountIndex first
              const keys = (tx.transaction?.message?.accountKeys||[]).map(k=>typeof k==='string'?k:k.pubkey);
              const idx = keys.indexOf(ta.pubkey);
              let bal = idx >= 0 ? (tx.meta?.postTokenBalances||[]).find(b=>b.accountIndex===idx) : null;
              // Fallback: search postTokenBalances by owner or directly
              if(!bal) bal = (tx.meta?.postTokenBalances||[]).find(b=>b.owner === ta.pubkey || b.owner === ta.owner);
              if(bal) return parseFloat(bal.uiTokenAmount?.uiAmountString||0);
              // tx found but ATA not in balances — continue to next tx
              continue;
            }
          }
        }
        before = sigs[sigs.length-1].signature;
        if(sigs.length < 50) break;
        // CRITICAL FIX: Stop pagination if we've already gone past cutoff date
        if(oldestBlockTime !== null && oldestBlockTime < cutoffTs) break;
      }
      // Fallback: no tx found before cutoff date.
      // If the oldest tx on this ATA is AFTER the cutoff, the account didn't exist yet → 0.
      // If all txs are BEFORE cutoff (account was static during the period), use current on-chain balance.
      if(oldestBlockTime !== null && oldestBlockTime > cutoffTs) return 0;
      try {
        const r = await heliusRPCDirect('getAccountInfo', [ta.pubkey, {encoding:'jsonParsed'}]);
        const info = r?.result?.value?.data?.parsed?.info;
        return parseFloat(info?.tokenAmount?.uiAmountString || 0);
      } catch(e) { return 0; }
    }

    async function fetchSolBal() {
      let before;
      let oldestBlockTime = null;
      for(let page=0; page<8; page++) {
        const sigRes = await heliusRPCDirect('getSignaturesForAddress', [address, {limit:50, ...(before?{before}:{})}]);
        const sigs = sigRes?.result || [];
        if(!sigs.length) break;
        for(const s of sigs) {
          if(s.blockTime != null) oldestBlockTime = s.blockTime;
          if(s.err) continue;
          if(s.blockTime != null && s.blockTime <= cutoffTs) {
            const txRes = await heliusRPCDirect('getTransaction', [s.signature, {encoding:'jsonParsed',maxSupportedTransactionVersion:0}]);
            const tx = txRes?.result;
            if(tx) {
              const keys = (tx.transaction?.message?.accountKeys||[]).map(k=>typeof k==='string'?k:k.pubkey);
              const idx = keys.indexOf(address);
              if(idx >= 0 && tx.meta?.postBalances?.[idx] != null)
                return tx.meta.postBalances[idx] / 1e9;
            }
            // Found first tx at/before cutoff but no balance — return 0
            return 0;
          }
        }
        before = sigs[sigs.length-1].signature;
        if(sigs.length < 50) break;
        // CRITICAL FIX: Stop pagination if we've already gone past cutoff date
        if(oldestBlockTime !== null && oldestBlockTime < cutoffTs) break;
      }
      // If oldest tx is after cutoff, wallet didn't exist yet
      if(oldestBlockTime !== null && oldestBlockTime > cutoffTs) return 0;
      // Otherwise use current balance
      try {
        const r = await heliusRPCDirect('getBalance', [address]);
        return (r?.result?.value || 0) / 1e9;
      } catch(e) { return 0; }
    }

    const [solBal, ...tokenBals] = await Promise.all([
      fetchSolBal(),
      ...tokenAccounts.map(ta => fetchTaBal(ta))
    ]);

    const balances = {SOL: solBal, ORCA:0, USDC:0, USDT:0, ETH:0, PYUSD:0};
    tokenAccounts.forEach((ta, i) => {
      const sym = getSym(ta.mint);
      if(sym) balances[sym] = (balances[sym]||0) + tokenBals[i];
    });
    return balances;

  } catch(e) {
    return {SOL:0, ORCA:0, USDC:0, USDT:0};
  }
}

// ── Period prices (Birdeye close of last day of month) ─────────────────────
let accPeriodPrices = { SOL: 84.74, ETH: 1988.1, ORCA: null };
let accPeriodMonth  = 2;
let accPeriodYear   = 2026;
let accPeriodPriceCache = {}; // { 'YYYY-MM': { SOL, ORCA, ETH } }

function accMonthEndTs(year, month){
  return Math.floor(new Date(Date.UTC(year, month, 1) - 1) / 1000);
}

async function accFetchMonthPrices(year, month){
  const key = accCacheKey(year, month);
  if(accPeriodPriceCache[key]){
    accPeriodPrices = { ...accPeriodPrices, ...accPeriodPriceCache[key] };
    accUpdatePriceStatus();
    return;
  }

  const ts = accMonthEndTs(year, month);
  const STATUS = document.getElementById('acc-price-status');
  if(STATUS) STATUS.textContent = '⟳ fetching prices…';

  const results = {};
  for(const [sym, mint] of [
    ['SOL',  PRICE_MINTS['SOL']  || 'So11111111111111111111111111111111111111112'],
    ['ORCA', PRICE_MINTS['ORCA'] || 'orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE'],
  ]){
    try {
      const r = await fetch(
        `${PROXY_BASE}/proxy/birdeye?path=/defi/history_price&address=${mint}&address_type=token&type=1D&time_from=${ts-86400}&time_to=${ts+3600}`,
        { headers: authHeaders() }
      );
      if(r.ok){
        const d = await r.json();
        const items = d?.data?.items || [];
        if(items.length){
          const best = items.reduce((a,b) =>
            Math.abs(a.unixTime-ts) < Math.abs(b.unixTime-ts) ? a : b);
          results[sym] = best.value;
        }
      }
    } catch(e){}
  }

  if(results.SOL)  accPeriodPrices.SOL  = results.SOL;
  if(results.ORCA) accPeriodPrices.ORCA = results.ORCA;
  accPeriodPriceCache[key] = { ...results };
  accUpdatePriceStatus();
}

function accUpdatePriceStatus(){
  const MONTH_NAMES = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const tag = (sym, p) => p
    ? `<span style="font-family:var(--mono);font-size:0.68rem;background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:2px 7px;margin-right:4px"><span style="color:var(--muted)">${sym}</span> $${p.toLocaleString(undefined,{maximumFractionDigits:4})}</span>`
    : '';
  const el = document.getElementById('acc-price-status');
  if(el) el.innerHTML =
    `<span style="color:var(--green);margin-right:6px">✓ ${MONTH_NAMES[accPeriodMonth]} ${accPeriodYear} close</span>`
    + tag('SOL', accPeriodPrices.SOL)
    + tag('ORCA', accPeriodPrices.ORCA);
}

let accPeriodInitialized = false;
function accInitPeriod(){
  const mSel = document.getElementById('acc-period-month');
  const ySel = document.getElementById('acc-period-year');
  if(!accPeriodInitialized){
    if(mSel) mSel.value = String(accPeriodMonth);
    if(ySel) ySel.value = String(accPeriodYear);
    accPeriodInitialized = true;
    accFetchMonthPrices(accPeriodYear, accPeriodMonth).then(() => {
      renderAccEntity();
      accSyncFromQB(accEntitySelected, accPeriodYear, accPeriodMonth);
    });
  } else {
    renderAccEntity();
    accSyncFromQB(accEntitySelected, accPeriodYear, accPeriodMonth);
  }
}

function accChangePeriod(){
  const m = parseInt(document.getElementById('acc-period-month')?.value || accPeriodMonth);
  const y = parseInt(document.getElementById('acc-period-year')?.value  || accPeriodYear);
  accPeriodMonth = m;
  accPeriodYear  = y;
  accFetchMonthPrices(y, m).then(() => {
    renderAccEntity();
    // Auto-sync GL balances from QB when period changes
    accSyncFromQB(accEntitySelected, y, m);
  });
}

function accToUSD(token, amt){
  if(amt == null) return null;
  const STABLES = ['USDC','USDT','PYUSD','DAI'];
  if(STABLES.includes(token)) return amt;
  const p = accPeriodPrices[token] ?? (state.prices?.[token] ?? null);
  return p ? amt * p : null;
}

function accGLtoUSD(token, amt)   { return accToUSD(token, amt); }
function accTokenToUSD(token, amt){ return accToUSD(token, amt); }

// Build reconciliation rows
function buildAccRows(){
  const rows = [];
  const balances = bsBalancesForPeriod(accPeriodYear, accPeriodMonth);
  for(const acct of BS_ACCOUNTS){
    const glToken = acct.glToken || (acct.tokens&&acct.tokens[0]) || null;
    if(!glToken) continue;

    // GL balance is always stored in USD (even for ORCA/SOL accounts)
    const bal = balances[acct.code] || {};
    const glAmt = bal[glToken] ?? 0;
    const glUSD = glAmt;

    // On-chain: aggregate across all linked wallets
    let onchainAmt = null;
    let anyFetched = false;
    for(const addr of (acct.wallets||[])){
      const cached = accOnchainAmt(addr, glToken);
      if(cached !== null){
        anyFetched = true;
        onchainAmt = (onchainAmt||0) + cached;
      }
    }
    const onchainUSD = anyFetched ? accTokenToUSD(glToken, onchainAmt||0) : null;

    const isOffchain = (acct.note||'').toLowerCase().includes('off-chain') || !acct.wallets?.length;

    rows.push({
      code: acct.code,
      entity: acct.entity,
      name: acct.name,
      glToken,
      glAmt,
      glUSD,
      onchainAmt,
      onchainUSD,
      isOffchain,
      wallets: acct.wallets||[],
      anyFetched,
    });
  }
  return rows;
}

// BS Balance Sheet Reconciliation view
// State for BS per Entity view
let accEntitySelected = 'Opco';
let accEntityExpandedToken = null;

function renderAccEntity(){
  const ENTITIES = ['Opco','Foundation','Juku','Zagreus'];
  const ENTITY_COLORS = {Opco:'#0077cc',Foundation:'#06D6A0',Juku:'#e06b00',Zagreus:'#9945FF'};
  const ENTITY_ICONS  = {Opco:'🏢',Foundation:'🌱',Juku:'🎯',Zagreus:'⚡'};
  const container = document.getElementById('acc-entity-cards');
  const allRows   = buildAccRows();
  const entity    = accEntitySelected;
  const rows      = allRows.filter(r => r.entity === entity);

  // ── Summary numbers ───────────────────────────────────────────────────────
  const totalGL  = rows.reduce((s,r)=>s+(r.glUSD||0),0);
  const fetched  = rows.filter(r=>r.anyFetched);
  const totalOC  = fetched.reduce((s,r)=>s+(r.onchainUSD||0),0);
  const diff     = totalOC - totalGL;
  const hasFetch = fetched.length > 0;

  // byToken
  const byToken = {};
  for(const r of rows){
    if(!byToken[r.glToken]) byToken[r.glToken]={glUSD:0,onchainUSD:0,hasFetch:false,accounts:[]};
    byToken[r.glToken].glUSD += r.glUSD||0;
    if(r.anyFetched){ byToken[r.glToken].onchainUSD += r.onchainUSD||0; byToken[r.glToken].hasFetch=true; }
    byToken[r.glToken].accounts.push(r);
  }
  const sortedTokens = Object.entries(byToken).sort((a,b)=>b[1].glUSD-a[1].glUSD);

  // ── Entity tabs (reuse existing .entity-tabs / .entity-tab styles) ────────
  const tabsHtml = `
    <div class="entity-tabs" style="margin-bottom:20px;display:inline-flex">
      ${ENTITIES.map(e => {
        const eRows = allRows.filter(r=>r.entity===e);
        const tot   = eRows.reduce((s,r)=>s+(r.glUSD||0),0);
        return `<button class="entity-tab${e===entity?' active':''}" onclick="accSelectEntity('${e}')">
          ${ENTITY_ICONS[e]} ${e}
          <span style="margin-left:5px;font-size:0.62rem;opacity:0.7">${fmtUSD(tot,0)}</span>
        </button>`;
      }).join('')}
    </div>`;

  // ── Summary cards (reuse .cards-grid / .card) ─────────────────────────────
  const diffColor = !hasFetch ? 'var(--muted)' : Math.abs(diff)<1 ? 'var(--green)' : diff>0 ? 'var(--green)' : 'var(--red)';
  const summaryHtml = `
    <div class="cards-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:20px">
      <div class="card">
        <div class="card-label">GL Total</div>
        <div class="card-value">${fmtUSD(totalGL,0)}</div>
        <div class="card-sub">${rows.length} accounts · ${sortedTokens.length} tokens</div>
      </div>
      <div class="card">
        <div class="card-label">On-Chain</div>
        <div class="card-value${hasFetch?'':' orange'}" style="${hasFetch?'':'color:var(--muted)'}">${hasFetch?fmtUSD(totalOC,0):'—'}</div>
        <div class="card-sub">${hasFetch?fetched.length+' wallets fetched':'click ⟳ Fetch On-Chain above'}</div>
      </div>
      <div class="card">
        <div class="card-label">Difference</div>
        <div class="card-value" style="color:${diffColor}">${hasFetch?(Math.abs(diff)<1?'✓ Match':(diff>0?'+':'')+fmtUSD(diff,0)):'—'}</div>
        <div class="card-sub">${hasFetch?(Math.abs(diff)<1?'Fully reconciled':'Needs investigation'):'Not yet fetched'}</div>
      </div>
    </div>`;

  // ── Token table with expandable rows ─────────────────────────────────────
  const TH = (label, right=false) =>
    `<th class="${right?'num':''} no-sort" style="font-size:0.62rem">${label}</th>`;

  const tokenRows = sortedTokens.map(([tok, v]) => {
    const c   = tcol(tok);
    const d   = v.onchainUSD - v.glUSD;
    const key = entity+'::'+tok;
    const isEx= accEntityExpandedToken === key;

    // ── Token summary row ─────────────────────────────────────────────────
    const tokenRow = `
      <tr onclick="accToggleToken('${entity}','${tok}')" style="cursor:pointer;background:${isEx?c+'08':''}">
        <td style="padding-left:14px">
          <div style="display:flex;align-items:center;gap:8px">
            <span style="font-family:var(--mono);font-size:0.65rem;color:${c};display:inline-block;transition:transform 0.18s;transform:rotate(${isEx?90:0}deg)">▶</span>
            ${tokenBadgeAcc(tok)}
            <span class="muted" style="font-size:0.68rem">${v.accounts.length} acct${v.accounts.length>1?'s':''}</span>
          </div>
        </td>
        <td class="num">
          <span style="font-weight:600">${fmtUSD(v.glUSD)}</span>
        </td>
        <td class="num muted">${v.hasFetch ? fmtUSD(v.onchainUSD) : '—'}</td>
        <td class="num" style="font-weight:700;color:${!v.hasFetch?'var(--muted)':Math.abs(d)<0.05?'var(--green)':d>0?'var(--green)':'var(--red)'}">
          ${v.hasFetch?(Math.abs(d)<0.05?'✓ Match':(d>0?'+':'')+fmtUSD(d)):'—'}
        </td>
      </tr>`;

    // ── Expanded account sub-rows ────────────────────────────────────────
    let subRows = '';
    if(isEx){
      const accs = [...v.accounts].sort((a,b)=>a.code.localeCompare(b.code));
      // sub-header
      subRows += `
        <tr style="background:var(--surface2)">
          <td colspan="4" style="padding:0">
            <div style="display:grid;grid-template-columns:110px 1fr 110px 110px 100px 1fr;padding:5px 14px 5px 36px;gap:8px">
              <span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted)">GL Code</span>
              <span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted)">Account Name</span>
              <span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);text-align:right">GL Balance</span>
              <span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);text-align:right">On-Chain</span>
              <span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);text-align:right">Diff</span>
              <span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted)">Wallet</span>
            </div>
          </td>
        </tr>`;
      // account rows
      subRows += accs.map(r => {
        const rd = (r.onchainUSD||0) - (r.glUSD||0);
        const diffVal = r.isOffchain
          ? `<span style="color:var(--muted);font-size:0.65rem">off-chain</span>`
          : !r.wallets.length
            ? `<span style="color:var(--muted)">—</span>`
            : !r.anyFetched
              ? `<span style="color:var(--muted)">⏳</span>`
              : Math.abs(rd)<0.05
                ? `<span style="color:var(--green);font-weight:700">✓</span>`
                : `<span style="color:${rd>0?'var(--green)':'var(--red)'};font-weight:700">${rd>0?'+':''}${fmtUSD(rd)}</span>`;
        const walletVal = r.wallets.length
          ? r.wallets.map(a => {
              const lbl = walletLabel(a);
              const short = a.slice(0,6)+'…'+a.slice(-4);
              return `<a href="https://solscan.io/account/${a}" target="_blank"
                style="font-family:var(--mono);font-size:0.63rem;color:var(--accent);text-decoration:none;display:block"
                title="${a}">${lbl||short}</a>`;
            }).join('')
          : `<span style="color:var(--muted)">—</span>`;
        return `
          <tr style="background:var(--bg)" onmouseover="this.style.background='var(--surface)'" onmouseout="this.style.background='var(--bg)'">
            <td colspan="4" style="padding:0;border-left:3px solid ${c}">
              <div style="display:grid;grid-template-columns:110px 1fr 150px 110px 100px 1fr;padding:8px 14px 8px 33px;gap:8px;align-items:center">
                <span style="font-family:var(--mono);font-size:0.72rem;font-weight:700;color:var(--accent)">${r.code}</span>
                <span style="font-size:0.75rem;line-height:1.35;color:var(--text)">${r.name}</span>
                <div style="text-align:right">
                  <div style="display:flex;align-items:center;justify-content:flex-end;gap:4px">
                    <input
                      type="number"
                      value="${r.glAmt}"
                      step="any"
                      onchange="accUpdateGL('${r.code}','${r.glToken}',this.value)"
                      style="font-family:var(--mono);font-size:0.72rem;font-weight:600;width:100px;text-align:right;
                        background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:3px 6px;
                        color:var(--text);outline:none;"
                      onfocus="this.style.borderColor='var(--accent)'"
                      onblur="this.style.borderColor='var(--border)'"
                    />
                    <span style="font-family:var(--mono);font-size:0.62rem;color:var(--muted)">USD</span>
                  </div>
                </div>
                <div style="text-align:right;font-family:var(--mono);font-size:0.72rem;color:var(--muted)">
                  ${r.anyFetched
                    ? `<div>${fmtUSD(r.onchainUSD||0)}</div><div style="font-size:0.6rem">${fmtNum(r.onchainAmt||0,4)} ${r.glToken}</div>`
                    : r.isOffchain ? '<span style="font-size:0.65rem">off-chain</span>' : '—'}
                </div>
                <div style="text-align:right;font-family:var(--mono);font-size:0.72rem">${diffVal}</div>
                <div>${walletVal}</div>
              </div>
            </td>
          </tr>`;
      }).join('');
    }
    return tokenRow + subRows;
  }).join('');

  const tableHtml = `
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr>
          ${TH('Token')}
          ${TH('GL Balance (editable)', true)}
          ${TH('On-Chain', true)}
          ${TH('Diff', true)}
        </tr></thead>
        <tbody>${tokenRows}</tbody>
      </table>
    </div>`;

  // ── Import CSV/Excel button ───────────────────────────────────────────────
  const importHtml = `
    <div style="margin-top:14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <label style="font-family:var(--mono);font-size:0.72rem;color:var(--muted)">Import GL Balances:</label>
      <label style="font-family:var(--mono);font-size:0.72rem;padding:5px 14px;border-radius:5px;
        border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer;
        display:flex;align-items:center;gap:6px"
        onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
        📂 CSV / Excel
        <input type="file" accept=".csv,.xlsx,.xls" style="display:none"
          onchange="accImportFile(this, ${accPeriodYear}, ${accPeriodMonth})">
      </label>
      <span style="font-family:var(--mono);font-size:0.65rem;color:var(--muted)">
        Format: GL Code | Amount (token auto-detected from BS_ACCOUNTS)
      </span>
      <button onclick="accExportCSV(${accPeriodYear}, ${accPeriodMonth})"
        style="font-family:var(--mono);font-size:0.72rem;padding:5px 14px;border-radius:5px;
          border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer;margin-left:auto"
        onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
        ↓ Export CSV
      </button>
    </div>`;

  container.innerHTML = tabsHtml + summaryHtml + tableHtml + importHtml;
}

// ── QB Trial Balance Sync ─────────────────────────────────────────────────────
// Maps QB account numbers to token (all digital asset accounts use USDC as proxy)
const QB_DIGITAL_ASSET_TOKENS = { USDC:true, USDT:true, PYUSD:true, ORCA:true, SOL:true };

let _accQbSyncStatus = {}; // entity+period → 'syncing'|'ok'|'error'|null

async function accSyncFromQB(entity, year, month) {
  const realmId = QB_REALM_IDS[entity];
  if(!realmId) return;
  const tok = _qb.tokens[realmId] || (_qb.accessToken ? {accessToken:_qb.accessToken} : null);
  if(!tok?.accessToken) await qbAutoConnect();
  if(!(_qb.tokens[realmId]?.accessToken || _qb.accessToken)) return; // still not connected

  const statusKey = `${entity}::${year}-${String(month).padStart(2,'0')}`;
  _accQbSyncStatus[statusKey] = 'syncing';
  _accUpdateSyncBadge(entity, 'syncing');

  try {
    const accessToken = await qbEnsureToken(realmId);
    const lastDay   = new Date(year, month, 0).getDate();
    const endDate   = `${year}-${String(month).padStart(2,'0')}-${String(lastDay).padStart(2,'0')}`;

    // Use BalanceSheet report — gives balance per account as of end_date
    const path = `/v3/company/${realmId}/reports/BalanceSheet?end_date=${endDate}&accounting_method=Accrual&minorversion=65`;
    const proxyUrl = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
    const res = await fetch(proxyUrl, { credentials: 'include', headers: { 'Authorization': `Bearer ${accessToken}` } });
    if(!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();

    // Ensure account map is loaded
    if(!_qb.glAccountMapByEntity?.[entity] || Object.keys(_qb.glAccountMapByEntity[entity]).length < 5) {
      qbLog(`   Loading account map for ${entity}…`, '#aaa');
      await qbFetchAccountMap();
    }
    const glMap = _qb.glAccountMapByEntity?.[entity] || _qb.glAccountMap || {};
    let synced = 0, skipped = 0;

    // BalanceSheet: flatten all Data rows recursively
    // Match strategy: account name starts with GL code (e.g. "1132912 USD Coin...")
    // Fallback: match by QB Id against glMap
    function flattenRows(rowArr) {
      for(const row of rowArr) {
        if(row.Rows?.Row) flattenRows(row.Rows.Row);
        if(row.type !== 'Data') continue;
        const cols = row.ColData || [];
        if(!cols.length) continue;

        const acctMeta = cols[0];
        const qbId     = String(acctMeta?.id || '');
        const acctName = acctMeta?.value || '';
        const amount   = parseFloat(cols[1]?.value);
        if(!qbId || isNaN(amount)) { skipped++; continue; }

        // Primary: extract GL code from account name prefix (e.g. "1132912 USD Coin...")
        const nameMatch = acctName.match(/^(\d{5,})\s/);
        let glCode = nameMatch ? nameMatch[1] : null;

        // Validate: glCode must exist in BS_ACCOUNTS
        if(glCode && !BS_ACCOUNTS.find(a => a.code === glCode)) glCode = null;

        // Fallback: match by QB Id in glMap
        if(!glCode) {
          const entry = Object.entries(glMap).find(([k,v]) => !k.startsWith('id:') && String(v?.Id) === qbId);
          glCode = entry?.[0] || null;
        }

        if(!glCode) { skipped++; continue; }

        const bsAcct = BS_ACCOUNTS.find(a => a.code === glCode);
        const token  = bsAcct?.glToken || 'USDC';
        
        // CRITICAL: Don't overwrite existing manual balances — only fill in missing ones
        const key = `${year}-${String(month).padStart(2,'0')}`;
        const existingVal = BS_BALANCES_BY_MONTH[key]?.[glCode]?.[token];
        if(existingVal != null && existingVal !== 0) {
          skipped++;
          continue;
        }
        
        bsSetBalance(year, month, glCode, token, amount);
        synced++;
      }
    }
    flattenRows(data?.Rows?.Row || []);

    _accQbSyncStatus[statusKey] = 'ok';
    _accUpdateSyncBadge(entity, 'ok', synced);
    qbLog(`✓ QB GL sync ${entity} ${endDate}: ${synced} accounts updated, ${skipped} skipped`, 'var(--green)');
  } catch(err) {
    _accQbSyncStatus[statusKey] = 'error';
    _accUpdateSyncBadge(entity, 'error');
    qbLog(`⚠ QB sync ${entity}: ${err.message}`, '#f0a500');
  }
  renderAccEntity();
}

// ── Debug: test raw QB BalanceSheet response ─────────────────────────────────
async function accDebugQBRaw() {
  const realmId = QB_REALM_IDS[accEntitySelected];
  if(!realmId) { alert(`No realmId for ${accEntitySelected}`); return; }
  const hasToken = _qb.tokens[realmId]?.accessToken || _qb.accessToken;
  if(!hasToken) await qbAutoConnect();
  if(!(_qb.tokens[realmId]?.accessToken || _qb.accessToken)) { alert('Connect QB first — no token found'); return; }
  const endDate = `${accPeriodYear}-${String(accPeriodMonth).padStart(2,'0')}-${new Date(accPeriodYear, accPeriodMonth, 0).getDate()}`;
  const path = `/v3/company/${realmId}/reports/BalanceSheet?end_date=${endDate}&accounting_method=Accrual&minorversion=65`;
  const proxyUrl = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
  const accessToken = await qbEnsureToken(realmId);
  const res = await fetch(proxyUrl, { credentials: 'include', headers: { 'Authorization': `Bearer ${accessToken}` } });
  const data = await res.json();

  // Show first 10 Data rows with their ColData
  const results = [];
  function scan(rows) {
    for(const r of rows||[]) {
      if(r.Rows?.Row) scan(r.Rows.Row);
      if(r.type==='Data' && r.ColData) {
        results.push({ id: r.ColData[0]?.id, name: r.ColData[0]?.value, val: r.ColData[1]?.value });
        if(results.length >= 15) return;
      }
    }
  }
  scan(data?.Rows?.Row||[]);

  const glMap = _qb.glAccountMapByEntity?.[accEntitySelected] || _qb.glAccountMap || {};
  // Show first 5 glMap entries
  const glSample = Object.entries(glMap).filter(([k])=>!k.startsWith('id:')).slice(0,5);

  qbLog('── QB BalanceSheet debug ──', 'var(--accent)');
  qbLog(`Report rows sample (first 15):`, '#aaa');
  results.forEach(r => qbLog(`  id="${r.id}" name="${(r.name||'').slice(0,30)}" val="${r.val}"`, '#ccc'));
  qbLog(`glMap sample (first 5 non-id: keys):`, '#aaa');
  glSample.forEach(([k,v]) => qbLog(`  glCode="${k}" → Id="${v?.Id}" Name="${(v?.Name||'').slice(0,30)}"`, '#ccc'));

  // Try matching
  let matched = 0;
  results.forEach(r => {
    const found = Object.entries(glMap).find(([k,v]) => !k.startsWith('id:') && String(v?.Id) === String(r.id));
    if(found) { matched++; qbLog(`  ✓ MATCH: QB id ${r.id} → glCode ${found[0]}`, 'var(--green)'); }
  });
  qbLog(`Matched ${matched}/${results.length} in sample`, matched>0?'var(--green)':'var(--red)');
}

function _accUpdateSyncBadge(entity, status, count) {
  const badge = document.getElementById('acc-qb-sync-badge');
  if(!badge) return;
  if(status === 'syncing') {
    badge.textContent = '⟳ Syncing QB…';
    badge.style.color = 'var(--muted)';
  } else if(status === 'ok') {
    badge.textContent = `✓ QB synced${count ? ' ('+count+' accts)' : ''}`;
    badge.style.color = 'var(--green)';
  } else if(status === 'error') {
    badge.textContent = '⚠ QB sync failed';
    badge.style.color = 'var(--orange)';
  } else {
    badge.textContent = '';
  }
}

function accSelectEntity(entity){
  accEntitySelected = entity;
  accEntityExpandedToken = null;
  renderAccEntity();
  // Auto-sync GL balances from QB when entity changes
  accSyncFromQB(entity, accPeriodYear, accPeriodMonth);
}

function accToggleToken(entity, tok){
  const key = entity+'::'+tok;
  accEntityExpandedToken = accEntityExpandedToken === key ? null : key;
  renderAccEntity();
}

// ── GL inline edit ────────────────────────────────────────────────────────
function accUpdateGL(code, token, rawVal){
  const amt = parseFloat(rawVal);
  if(isNaN(amt)) return;
  bsSetBalance(accPeriodYear, accPeriodMonth, code, token, amt);
  // Re-render only the summary cards (avoid full re-render which would reset inputs)
  accRefreshSummary();
}

function accRefreshSummary(){
  // Lightweight re-render of just the 3 summary cards without touching the table
  const allRows = buildAccRows();
  const rows    = allRows.filter(r => r.entity === accEntitySelected);
  const totalGL = rows.reduce((s,r)=>s+(r.glUSD||0),0);
  const fetched = rows.filter(r=>r.anyFetched);
  const totalOC = fetched.reduce((s,r)=>s+(r.onchainUSD||0),0);
  const diff    = totalOC - totalGL;
  const hasFetch= fetched.length > 0;
  const diffColor = !hasFetch?'var(--muted)':Math.abs(diff)<1?'var(--green)':diff>0?'var(--green)':'var(--red)';

  const el = document.querySelector('#acc-entity-cards .cards-grid');
  if(!el) return;
  el.innerHTML = `
    <div class="card">
      <div class="card-label">GL Total</div>
      <div class="card-value">${fmtUSD(totalGL,0)}</div>
      <div class="card-sub">${rows.length} accounts · ${[...new Set(rows.map(r=>r.glToken))].length} tokens</div>
    </div>
    <div class="card">
      <div class="card-label">On-Chain</div>
      <div class="card-value" style="${hasFetch?'':'color:var(--muted)'}">${hasFetch?fmtUSD(totalOC,0):'—'}</div>
      <div class="card-sub">${hasFetch?fetched.length+' wallets fetched':'click ⟳ Fetch On-Chain above'}</div>
    </div>
    <div class="card">
      <div class="card-label">Difference</div>
      <div class="card-value" style="color:${diffColor}">${hasFetch?(Math.abs(diff)<1?'✓ Match':(diff>0?'+':'')+fmtUSD(diff,0)):'—'}</div>
      <div class="card-sub">${hasFetch?(Math.abs(diff)<1?'Fully reconciled':'Needs investigation'):'Not yet fetched'}</div>
    </div>`;
}

// ── Import CSV/Excel ──────────────────────────────────────────────────────
async function accImportFile(input, year, month){
  const file = input.files[0];
  if(!file) return;
  const ext = file.name.split('.').pop().toLowerCase();

  let rows = []; // [{code, amount}]

  if(ext === 'csv'){
    const text = await file.text();
    for(const line of text.split('\n')){
      const parts = line.split(/[,;\t]/);
      if(parts.length < 2) continue;
      const code = parts[0].trim().replace(/"/g,'');
      const amt  = parseFloat(parts[1].replace(/[",\s]/g,''));
      if(code && !isNaN(amt)) rows.push({code, amt});
    }
  } else if(ext === 'xlsx' || ext === 'xls'){
    // Use SheetJS
    const ab = await file.arrayBuffer();
    const wb = XLSX.read(ab, {type:'array'});
    const ws = wb.Sheets[wb.SheetNames[0]];
    const data = XLSX.utils.sheet_to_json(ws, {header:1});
    for(const row of data){
      if(!row || row.length < 2) continue;
      const code = String(row[0]).trim();
      const amt  = parseFloat(String(row[1]).replace(/[,\s]/g,''));
      if(code && !isNaN(amt)) rows.push({code, amt});
    }
  }

  if(!rows.length){ alert('No valid rows found. Expected: GL Code in column A, Amount in column B.'); return; }

  // Map code → token from BS_ACCOUNTS
  const codeToToken = {};
  for(const a of BS_ACCOUNTS) codeToToken[a.code] = a.glToken;

  let updated = 0, skipped = 0;
  for(const {code, amt} of rows){
    const token = codeToToken[code];
    if(!token){ skipped++; continue; }
    bsSetBalance(year, month, code, token, amt);
    updated++;
  }

  alert(`✓ Imported ${updated} accounts${skipped?' ('+skipped+' unknown GL codes skipped)':''}`);
  input.value = '';
  renderAccEntity();
}

// ── Export CSV ────────────────────────────────────────────────────────────
function accExportCSV(year, month){
  const bal = bsBalancesForPeriod(year, month);
  const MONTH_NAMES = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const lines = ['GL Code,Account Name,Entity,Token,Amount'];
  for(const acct of BS_ACCOUNTS){
    const v = bal[acct.code];
    const amt = v ? (v[acct.glToken] ?? 0) : 0;
    lines.push(`"${acct.code}","${acct.name}","${acct.entity}","${acct.glToken}",${amt}`);
  }
  const blob = new Blob([lines.join('\n')], {type:'text/csv'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `gl_balances_${year}-${String(month).padStart(2,'0')}_${MONTH_NAMES[month]}${year}.csv`;
  a.click();
}

const PRICE_CACHE_KEY = 'tidelog_prices_v1';
const _priceCache = (() => {
  try {
    const raw = localStorage.getItem(PRICE_CACHE_KEY);
    return raw ? JSON.parse(raw) : {};
  } catch(e) { return {}; }
})();
function _savePriceCache() {
  try {
    // Keep only last 5000 entries to avoid storage bloat
    const keys = Object.keys(_priceCache);
    if(keys.length > 5000) {
      keys.slice(0, keys.length - 5000).forEach(k => delete _priceCache[k]);
    }
    localStorage.setItem(PRICE_CACHE_KEY, JSON.stringify(_priceCache));
  } catch(e) {}
}
async function getPriceAt(token, ts) {
  if(STABLE_TOKENS.has(token)) return 1;

  // TGE hardcode: 2021-08-09 ORCA price = $2.64956
  if(token === 'ORCA') {
    const d = new Date(ts * 1000);
    if(d.getUTCFullYear() === 2021 && d.getUTCMonth() === 7 && d.getUTCDate() === 9) return 2.64956;
  }

  const min1    = Math.floor(ts / 60) * 60;
  const mKey    = `${token}::${min1}`;
  if(_priceCache[mKey] != null) return _priceCache[mKey];

  const hourTs  = Math.floor(ts / 3600) * 3600;
  const hourKey = `${token}::${hourTs}`;
  if(_priceCache[hourKey] != null) { _priceCache[mKey] = _priceCache[hourKey]; return _priceCache[hourKey]; }

  const mint   = PRICE_MINTS[token];
  const coinId = token === 'SOL' ? 'coingecko:solana' : `solana:${ORCA_MINT}`;

  // 1. Birdeye — 1-minute OHLCV, most accurate for Solana tokens
  if(mint) {
    try {
      const from = ts - 120;
      const to   = ts + 120;
      const r = await fetch(
        `${PROXY_BASE}/proxy/birdeye?path=/defi/history_price&address=${mint}&address_type=token&type=1m&time_from=${from}&time_to=${to}`,
        { headers: authHeaders() }
      );
      if(r.ok) {
        const d = await r.json();
        const items = d?.data?.items || [];
        if(items.length > 0) {
          const closest = items.reduce((a,b) => {
            // Use the candle whose start is <= tx timestamp (floor), not nearest
            const aDiff = ts - a.unixTime;
            const bDiff = ts - b.unixTime;
            // Prefer candle that started before or at tx, closest in time
            if(aDiff >= 0 && bDiff >= 0) return aDiff < bDiff ? a : b; // both before tx, pick closest
            if(aDiff >= 0) return a; // only a is before tx
            if(bDiff >= 0) return b; // only b is before tx
            return Math.abs(aDiff) < Math.abs(bDiff) ? a : b; // both after, pick closest
          });
          const price = closest.value;
          if(price > 0) {
            _priceCache[mKey] = price;
            items.forEach(p => { const k=`${token}::${Math.floor(p.unixTime/60)*60}`; if(!_priceCache[k]) _priceCache[k]=p.value; });
            _savePriceCache();
            return price;
          }
        }
      }
    } catch(e) {}
  }

  // 2. DeFiLlama chart — minute candles fallback
  try {
    const r = await fetch(`https://coins.llama.fi/chart/${coinId}?start=${ts-300}&span=10&period=1m`);
    if(r.ok) {
      const d = await r.json();
      const prices = d?.coins?.[coinId]?.prices || [];
      if(prices.length > 0) {
        // Use floor candle (started before tx), not nearest
        const before = prices.filter(p => p.timestamp <= ts);
        const closest = before.length > 0
          ? before.reduce((a,b) => b.timestamp > a.timestamp ? b : a)
          : prices.reduce((a,b) => Math.abs(b.timestamp-ts) < Math.abs(a.timestamp-ts) ? b : a);
        if(closest.price > 0) {
          _priceCache[mKey] = closest.price;
          prices.forEach(p => { const k=`${token}::${Math.floor(p.timestamp/60)*60}`; if(!_priceCache[k]) _priceCache[k]=p.price; });
          _savePriceCache();
          return closest.price;
        }
      }
    }
  } catch(e) {}

  // 3. DeFiLlama historical — hourly fallback
  try {
    const r = await fetch(`https://coins.llama.fi/prices/historical/${ts}/${coinId}`);
    if(r.ok) {
      const d = await r.json();
      const price = d?.coins?.[coinId]?.price || 0;
      if(price > 0) { _priceCache[mKey] = price; _priceCache[hourKey] = price; _savePriceCache(); return price; }
    }
  } catch(e) {}

  // 4. CoinGecko historical — fallback for very old dates (2021+)
  if(token === 'ORCA') {
    try {
      const dateMs = ts * 1000;
      const d = new Date(dateMs);
      const day = String(d.getUTCDate()).padStart(2, '0');
      const month = String(d.getUTCMonth() + 1).padStart(2, '0');
      const year = d.getUTCFullYear();
      const dateStr = `${day}-${month}-${year}`;
      const r = await fetch(`https://api.coingecko.com/api/v3/coins/orca-so/history?date=${dateStr}&localization=false`);
      if(r.ok) {
        const d = await r.json();
        const price = d?.market_data?.current_price?.usd || 0;
        if(price > 0) { _priceCache[mKey] = price; _priceCache[hourKey] = price; _savePriceCache(); return price; }
      }
    } catch(e) {}
  }

  // 5. Jupiter live — last resort
  try {
    const r = await fetch(`https://api.jup.ag/price/v2?ids=${mint}`);
    const d = await r.json();
    const price = parseFloat(d?.data?.[mint]?.price || 0);
    if(price > 0) { _priceCache[mKey] = price; return price; }
  } catch(e) {}

  _priceCache[mKey] = 0;
  return 0;
}

// ══════════════════════════════════════════════════════════════════
// End-of-month price: uses CoinGecko daily history first (accurate daily close),
// then DeFiLlama historical as fallback. Cached under token::EOM::YYYY-MM key.
// Intentionally bypasses Birdeye intraday candles which are not suitable for
// monthly valuation (may return spot or interpolated prices).
async function getEOMPrice(token, year, month) {
  if(STABLE_TOKENS.has(token)) return 1;
  if(token === 'ORCA' && year === 2021 && month === 8) return 2.64956;

  const cacheKey = `${token}::EOM::${year}-${String(month).padStart(2,'0')}`;
  if(_priceCache[cacheKey] > 0) return _priceCache[cacheKey];

  // Last calendar day of the month (UTC)
  const lastDay = new Date(Date.UTC(year, month, 0, 23, 59, 59)); // day 0 of next month
  const endTs   = Math.floor(lastDay.getTime() / 1000);
  const dd      = String(lastDay.getUTCDate()).padStart(2, '0');
  const mm      = String(lastDay.getUTCMonth() + 1).padStart(2, '0');
  const dateStr = `${dd}-${mm}-${year}`; // CoinGecko format: DD-MM-YYYY

  // 1. CoinGecko daily history — gives actual daily close price
  if(token === 'ORCA') {
    try {
      const r = await fetch(
        `https://api.coingecko.com/api/v3/coins/orca-so/history?date=${dateStr}&localization=false`
      );
      if(r.ok) {
        const d = await r.json();
        const price = d?.market_data?.current_price?.usd || 0;
        if(price > 0) { _priceCache[cacheKey] = price; _savePriceCache(); return price; }
      }
    } catch(e) {}
  }

  // 2. DeFiLlama historical — hourly fallback
  const coinId = token === 'SOL' ? 'coingecko:solana' : `solana:${ORCA_MINT}`;
  try {
    const r = await fetch(`https://coins.llama.fi/prices/historical/${endTs}/${coinId}`);
    if(r.ok) {
      const d = await r.json();
      const price = d?.coins?.[coinId]?.price || 0;
      if(price > 0) { _priceCache[cacheKey] = price; _savePriceCache(); return price; }
    }
  } catch(e) {}

  return 0;
}

// ══════════════════════════════════════════════════════════════════
async function fetchWalletLive(w) {
  try {
    const [balRes, tokRes] = await Promise.all([
      heliusRPC('getBalance', [w.address]),
      fetch(HELIUS_RPC, {method:'POST',headers:authHeaders({'Content-Type':'application/json'}),credentials:'include',
        body:JSON.stringify({jsonrpc:'2.0',id:1,method:'getTokenAccountsByOwner',
          params:[w.address,{programId:'TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA'},{encoding:'jsonParsed'}]})})
        .then(r=>r.json())
    ]);

    const sol = (balRes?.result?.value || 0) / 1e9;
    const balances = {SOL: sol, ORCA:0, USDC:0, USDT:0};

    for(const acc of (tokRes?.result?.value || [])) {
      const info = acc.account?.data?.parsed?.info;
      if(!info) continue;
      const sym = getSym(info.mint);
      const amt = parseFloat(info.tokenAmount?.uiAmountString || 0);
      if(FOCUS_SET.has(sym) && amt > 0) balances[sym] = (balances[sym]||0) + amt;
    }
    return {balances, status:'ok'};
  } catch(e) {
    return {balances:{SOL:0,ORCA:0,USDC:0,USDT:0}, status:'error', error:e.message};
  }
}

async function fetchWalletHistorical(w, cutoffDate) {
  const cacheKey = w.address + '::' + cutoffDate;
  if(_histCache[cacheKey]) return {balances: _histCache[cacheKey], status:'ok (cached)'};

  const cutoffTs = Math.floor(new Date(cutoffDate+'T23:59:59Z').getTime()/1000);

  try {
    // Get token accounts
    const taRes = await fetch(HELIUS_RPC, {method:'POST',headers:authHeaders({'Content-Type':'application/json'}),credentials:'include',
      body:JSON.stringify({jsonrpc:'2.0',id:1,method:'getTokenAccountsByOwner',
        params:[w.address,{programId:'TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA'},{encoding:'jsonParsed'}]})});
    const taD = await taRes.json();
    const tokenAccounts = (taD?.result?.value||[]).map(a=>({
      pubkey: a.pubkey,
      mint:   a.account?.data?.parsed?.info?.mint,
    })).filter(a => a.mint && FOCUS_SET.has(getSym(a.mint)));

    // Helper: balance of one token account at cutoff
    async function fetchTaBal(ta) {
      let before;
      let oldestBlockTime = null;
      for(let page=0; page<8; page++) {
        const sigRes = await heliusRPC('getSignaturesForAddress', [ta.pubkey, {limit:50, ...(before?{before}:{})}]);
        const sigs = sigRes?.result || [];
        if(!sigs.length) break;
        for(const s of sigs) {
          if(s.blockTime != null) oldestBlockTime = s.blockTime;
          if(s.err) continue;
          if(s.blockTime != null && s.blockTime <= cutoffTs) {
            const txRes = await heliusRPC('getTransaction', [s.signature, {encoding:'jsonParsed',maxSupportedTransactionVersion:0}]);
            const tx = txRes?.result;
            if(tx) {
              // Try by accountIndex first
              const keys = (tx.transaction?.message?.accountKeys||[]).map(k=>typeof k==='string'?k:k.pubkey);
              const idx = keys.indexOf(ta.pubkey);
              let bal = idx >= 0 ? (tx.meta?.postTokenBalances||[]).find(b=>b.accountIndex===idx) : null;
              // Fallback: search postTokenBalances by owner
              if(!bal) bal = (tx.meta?.postTokenBalances||[]).find(b=>b.owner === ta.pubkey || b.owner === ta.owner);
              if(bal) return parseFloat(bal.uiTokenAmount?.uiAmountString||0);
              // tx found but ATA not in balances — continue to next tx
              continue;
            }
          }
        }
        before = sigs[sigs.length-1].signature;
        if(sigs.length < 50) break;
      }
      // Fallback: no tx found before cutoff.
      // If oldest known tx is AFTER cutoff → account didn't exist yet → 0.
      // Otherwise account was static in period → use current on-chain balance.
      if(oldestBlockTime !== null && oldestBlockTime > cutoffTs) return 0;
      try {
        const r = await heliusRPC('getAccountInfo', [ta.pubkey, {encoding:'jsonParsed'}]);
        const info = r?.result?.value?.data?.parsed?.info;
        return parseFloat(info?.tokenAmount?.uiAmountString || 0);
      } catch(e) { return 0; }
    }

    // Fetch SOL native balance at cutoff
    async function fetchSolBal() {
      let before;
      for(let page=0; page<8; page++) {
        const sigRes = await heliusRPC('getSignaturesForAddress', [w.address, {limit:50, ...(before?{before}:{})}]);
        const sigs = sigRes?.result || [];
        if(!sigs.length) break;
        for(const s of sigs) {
          if(s.err) continue;
          if(s.blockTime != null && s.blockTime <= cutoffTs) {
            const txRes = await heliusRPC('getTransaction', [s.signature, {encoding:'jsonParsed',maxSupportedTransactionVersion:0}]);
            const tx = txRes?.result;
            if(tx) {
              const keys = (tx.transaction?.message?.accountKeys||[]).map(k=>typeof k==='string'?k:k.pubkey);
              const idx = keys.indexOf(w.address);
              if(idx >= 0 && tx.meta?.postBalances?.[idx] != null)
                return tx.meta.postBalances[idx] / 1e9;
            }
            return 0;
          }
        }
        before = sigs[sigs.length-1].signature;
        if(sigs.length < 50) break;
      }
      return 0;
    }

    // Run all in parallel
    const [solBal, ...tokenBals] = await Promise.all([
      fetchSolBal(),
      ...tokenAccounts.map(ta => fetchTaBal(ta))
    ]);

    const balances = {SOL: solBal, ORCA:0, USDC:0, USDT:0};
    tokenAccounts.forEach((ta, i) => {
      const sym = getSym(ta.mint);
      if(FOCUS_SET.has(sym)) balances[sym] = (balances[sym]||0) + tokenBals[i];
    });

    _histCache[cacheKey] = balances;
    return {balances, status:'ok'};

  } catch(e) {
    return {balances:{SOL:0,ORCA:0,USDC:0,USDT:0}, status:'error', error:e.message};
  }
}

// ══════════════════════════════════════════════════════════════════
// TRANSACTION FETCHING + PARSING
// ══════════════════════════════════════════════════════════════════

// Wallet address → label lookup (built from ALL_WALLETS)
const WALLET_LABEL_MAP = {};
ALL_WALLETS.forEach(w => { WALLET_LABEL_MAP[w.address] = w.label; });
function walletLabel(addr) { return WALLET_LABEL_MAP[addr] || null; }

// Parse a raw Helius transaction into movements for a given wallet address
function parseTransaction(tx, walletAddress, walletLabel) {
  if(!tx) return [];
  const meta     = tx.meta;
  if(!meta) return [];
  const msg      = tx.transaction?.message;
  const keys     = (msg?.accountKeys||[]).map(k => typeof k==='string' ? k : k.pubkey);
  const walletIdx = keys.indexOf(walletAddress);
  const blockTime = tx.blockTime;
  const sig      = tx.transaction?.signatures?.[0] || '';
  const moves    = [];

  // ── Find counterparty for SOL transfers ───────────────────────
  // For a given delta direction, find the account with the opposite delta
  function findCounterparty(ourIdx, ourDelta) {
    if(!meta.preBalances || !meta.postBalances) return null;
    for(let i=0; i<keys.length; i++) {
      if(i === ourIdx) continue;
      const d = (meta.postBalances[i] - meta.preBalances[i]) / 1e9;
      // Counterparty has opposite sign delta of meaningful size
      if(ourDelta > 0 && d < -0.000001) return keys[i];
      if(ourDelta < 0 && d >  0.000001) return keys[i];
    }
    return null;
  }

  // ── Find counterparty for SPL token transfers ─────────────────
  // Find another account with the same mint, opposite delta, different owner
  function findTokenCounterparty(ourIdx, ourDelta, mint) {
    const pm = {}, qm = {};
    for(const b of (meta.preTokenBalances||[]))  pm[b.accountIndex] = {mint:b.mint, amt:parseFloat(b.uiTokenAmount?.uiAmountString||0)||0, owner:b.owner||''};
    for(const b of (meta.postTokenBalances||[])) qm[b.accountIndex] = {mint:b.mint, amt:parseFloat(b.uiTokenAmount?.uiAmountString||0)||0, owner:b.owner||''};

    const allIdxs2 = new Set([...Object.keys(pm).map(Number), ...Object.keys(qm).map(Number)]);

    for(const idx of allIdxs2) {
      if(idx === ourIdx) continue;
      const pre3  = pm[idx] || {mint: qm[idx]?.mint, amt:0, owner: qm[idx]?.owner||''};
      const post3 = qm[idx] || {mint: pm[idx]?.mint, amt:0, owner: pm[idx]?.owner||''};
      if((pre3.mint||post3.mint) !== mint) continue;
      const d = post3.amt - pre3.amt;
      if(Math.abs(d) < 0.000001) continue;
      // Must be opposite direction
      if(ourDelta > 0 && d >= 0) continue;
      if(ourDelta < 0 && d <= 0) continue;
      // Return the owner of this account (the wallet that owns the token account)
      const owner3 = post3.owner || pre3.owner;
      if(owner3 && owner3 !== walletAddress) return owner3;
      // If owner not in token balances, check if the token account pubkey itself is a known wallet
      const acctPubkey = keys[idx];
      if(acctPubkey && acctPubkey !== walletAddress) {
        // Check if this pubkey is a known wallet address
        if(WALLET_LABEL_MAP[acctPubkey]) return acctPubkey;
        // Otherwise return it as the counterparty token account — look up its owner from other indices
        // Try to find owner from any other postTokenBalance with same accountIndex
        return acctPubkey;
      }
    }

    // Fallback: for SOL-like transfers, check all account keys that had balance changes
    // and are known wallets (excluding our wallet and programs)
    if(!meta.preBalances || !meta.postBalances) return null;
    for(let i=0; i<keys.length; i++) {
      const addr = keys[i];
      if(addr === walletAddress) continue;
      if(!WALLET_LABEL_MAP[addr]) continue; // only known wallets
      const d = (meta.postBalances[i]||0) - (meta.preBalances[i]||0);
      if(ourDelta > 0 && d < -0.000001) return addr;
      if(ourDelta < 0 && d >  0.000001) return addr;
    }
    return null;
  }

  // ── SOL movement ──────────────────────────────────────────────
  if(walletIdx >= 0 && meta.preBalances && meta.postBalances &&
     walletIdx < meta.preBalances.length && walletIdx < meta.postBalances.length) {
    const pre   = meta.preBalances[walletIdx]  || 0;
    const post  = meta.postBalances[walletIdx] || 0;
    const delta = (post - pre) / 1e9;
    if(Math.abs(delta) >= 0.000001) {
      const counterparty = findCounterparty(walletIdx, delta);
      moves.push({
        date:         new Date(blockTime * 1000),
        blockTime,
        wallet:       walletLabel,
        walletAddr:   walletAddress,
        asset:        'SOL',
        dir:          delta > 0 ? 'In' : 'Out',
        qty:          Math.abs(delta),
        price:        0,
        usd:          0,
        gainShort:    0,
        gainLong:     0,
        category:     classifyCategory(meta, delta),
        txHash:       sig,
        priceSource:  'DeFiLlama',
        counterparty: counterparty || '',
      });
    }
  }

  // ── SPL token movements ───────────────────────────────────────
  const preMap  = {};
  const postMap = {};

  for(const b of (meta.preTokenBalances||[])) {
    preMap[b.accountIndex] = {
      mint:  b.mint,
      amt:   parseFloat(b.uiTokenAmount?.uiAmountString || '0') || 0,
      owner: b.owner || '',
    };
  }
  for(const b of (meta.postTokenBalances||[])) {
    postMap[b.accountIndex] = {
      mint:  b.mint,
      amt:   parseFloat(b.uiTokenAmount?.uiAmountString || '0') || 0,
      owner: b.owner || '',
    };
  }

  const allIdxs = new Set([
    ...Object.keys(preMap).map(Number),
    ...Object.keys(postMap).map(Number),
  ]);

  for(const idx of allIdxs) {
    const pre2  = preMap[idx]  || { mint: postMap[idx]?.mint, amt: 0, owner: postMap[idx]?.owner || '' };
    const post2 = postMap[idx] || { mint: preMap[idx]?.mint,  amt: 0, owner: preMap[idx]?.owner  || '' };
    const mint  = pre2.mint || post2.mint;
    if(!mint) continue;

    const sym = getSym(mint);
    if(!FOCUS_SET.has(sym)) continue;

    // Debug: log all ORCA token balance entries
    if(sym === 'ORCA') {
      console.log(`[PARSE] ${sig.slice(0,8)} ORCA idx=${idx} owner=${post2.owner||pre2.owner||'?'} walletAddr=${walletAddress.slice(0,8)} delta=${(post2.amt-pre2.amt).toFixed(4)}`);
    }

    // Owner resolution:
    // - postTokenBalances.owner is the wallet that owns the token account
    // - For new token accounts (created in this tx), preTokenBalances has no entry → owner only in post
    // - For closed token accounts, postTokenBalances has no entry → owner only in pre
    // - If owner field is empty (some older txs), check if accountKeys[idx] matches walletAddress
    const owner = post2.owner || pre2.owner;
    if(owner && owner !== walletAddress) continue;
    // If owner is missing, check the account pubkey itself
    if(!owner) {
      const acctPubkey = keys[idx];
      // Accept if account pubkey IS our wallet (native account) or unknown (could be our ATA)
      // We can't verify ATAs without extra lookup, so accept unknown owners for focus tokens
      // but reject if another wallet's address is at this index
      if(acctPubkey && WALLET_LABEL_MAP[acctPubkey] && acctPubkey !== walletAddress) continue;
      // Otherwise accept — it's likely our token account
    }

    const delta = post2.amt - pre2.amt;
    if(Math.abs(delta) < 0.000001) continue;

    const counterparty = findTokenCounterparty(idx, delta, mint);

    moves.push({
      date:         new Date(blockTime * 1000),
      blockTime,
      wallet:       walletLabel,
      walletAddr:   walletAddress,
      asset:        sym,
      dir:          delta > 0 ? 'In' : 'Out',
      qty:          Math.abs(delta),
      price:        0,
      usd:          0,
      gainShort:    0,
      gainLong:     0,
      category:     classifyCategory(meta, delta),
      txHash:       sig,
      priceSource:  'DeFiLlama',
      counterparty: counterparty || '',
    });
  }

  return moves;
}

function classifyCategory(meta, delta) {
  const logMsgs = meta?.logMessages || [];
  const logs = logMsgs.join(' ').toLowerCase();
  if(logs.includes('swap'))         return 'Swap';
  if(logs.includes('transfer'))     return 'Transfer';
  if(logs.includes('stake'))        return 'Stake';
  if(logs.includes('unstake'))      return 'Unstake';
  if(logs.includes('withdraw'))     return delta > 0 ? 'Withdrawal' : 'Deposit';
  if(logs.includes('deposit'))      return 'Deposit';
  return delta > 0 ? 'Deposit' : 'Withdrawal';
}

// Fetch ALL transactions for a wallet in a date range
async function fetchWalletTransactions(w, fromTs, toTs) {
  const txs = [];
  const seenSigs = new Set(); // deduplicate across wallet + ATA fetches

  console.log(`[TX] Fetching ${w.label} from ${new Date(fromTs*1000).toISOString().slice(0,10)} to ${new Date(toTs*1000).toISOString().slice(0,10)}`);

  // Get all token accounts (ATAs) for focus tokens — including CLOSED accounts
  let ataAddresses = [];
  try {
    // Current open ATAs (all SPL tokens at once)
    const taRes = await heliusRPC('getTokenAccountsByOwner', [
      w.address,
      {programId: 'TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA'},
      {encoding: 'jsonParsed'}
    ]);
    ataAddresses = (taRes?.result?.value || [])
      .filter(a => {
        const mint = a.account?.data?.parsed?.info?.mint;
        return mint && FOCUS_SET.has(getSym(mint));
      })
      .map(a => a.pubkey);
    console.log(`[TX] ${w.label} — ${ataAddresses.length} current ATAs`);
  } catch(e) {
    console.warn('[TX] ATA fetch failed:', e.message);
  }

  // ── Per-mint ATA fetch for USDC and USDT ────────────────────────
  // getTokenAccountsByOwner with programId returns only OPEN accounts.
  // We also query per-mint to catch any ATAs not in the generic list
  // (edge case: some wallets have multiple ATAs per mint).
  // This mirrors exactly what fetchOrcaHistory does for ORCA.
  const STABLE_MINTS = [
    { sym: 'USDC', mint: 'EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v' },
    { sym: 'USDT', mint: 'Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB' },
  ];
  const discoveredATAs = new Set(ataAddresses);
  for(const { sym, mint } of STABLE_MINTS) {
    try {
      const r = await heliusRPC('getTokenAccountsByOwner',
        [w.address, { mint }, { encoding: 'jsonParsed' }]);
      for(const a of (r?.result?.value || [])) {
        const ata = a.pubkey;
        if(ata && !discoveredATAs.has(ata)) {
          discoveredATAs.add(ata);
          console.log(`[TX] ${w.label} — added ${sym} ATA via per-mint query: ${ata.slice(0,8)}`);
        }
      }
    } catch(e) {
      console.warn(`[TX] Per-mint ATA fetch failed for ${sym}:`, e.message);
    }
  }

  // Discover historical/closed ATAs by scanning main wallet sigs and
  // extracting token account pubkeys from pre/postTokenBalances.
  // We scan the FULL history (no fromTs cutoff) to catch ATAs created
  // long before the requested period — this is the main reason USDC/USDT
  // Out txs were missing: their ATAs were created >1 year ago and had
  // already been missed by the previous 365-day lookback limit.
  try {
    let scanBefore = undefined;
    for(let pg = 0; pg < 50; pg++) {  // scan up to 5000 sigs — no time cutoff
      const r = await heliusRPC('getSignaturesForAddress',
        [w.address, {limit:100, ...(scanBefore?{before:scanBefore}:{})}]);
      const sigs = r?.result || [];
      if(!sigs.length) break;

      // Only fetch full tx data for sigs that aren't errors
      const valid = sigs.filter(s => !s.err && s.blockTime != null);
      for(let i = 0; i < valid.length; i += 10) {
        const batch = valid.slice(i, i+10);
        const txResults = await Promise.all(batch.map(s =>
          heliusRPC('getTransaction', [s.signature,
            {encoding:'jsonParsed', maxSupportedTransactionVersion:0}])
            .then(r=>r?.result).catch(()=>null)
        ));
        for(const tx of txResults) {
          if(!tx) continue;
          const keys = (tx.transaction?.message?.accountKeys||[]).map(k=>typeof k==='string'?k:k.pubkey);
          // Find token accounts owned by this wallet in pre/postTokenBalances
          for(const b of [...(tx.meta?.preTokenBalances||[]), ...(tx.meta?.postTokenBalances||[])]) {
            if(b.owner === w.address && FOCUS_SET.has(getSym(b.mint||''))) {
              const ata = keys[b.accountIndex];
              if(ata && !discoveredATAs.has(ata)) {
                discoveredATAs.add(ata);
                console.log(`[TX] ${w.label} — discovered historical ATA: ${ata.slice(0,8)} for ${getSym(b.mint)}`);
              }
            }
          }
        }
        if(i+10 < valid.length) await sleep(50);
      }

      if(sigs.length < 100) break;  // last page
      scanBefore = sigs[sigs.length-1].signature;
      await sleep(80);
    }
    ataAddresses = [...discoveredATAs];
    console.log(`[TX] ${w.label} — ${ataAddresses.length} total ATAs (incl. historical)`);
  } catch(e) {
    console.warn('[TX] Historical ATA discovery failed:', e.message);
  }

  // Also include statically known ATAs for this wallet from ATA_OWNER_MAP
  for(const [ata, owner] of Object.entries(ATA_OWNER_MAP)) {
    if(owner === w.address && ata !== owner && ata.length > 20 && !ataAddresses.includes(ata)) {
      ataAddresses.push(ata);
      console.log(`[TX] Added known ATA ${ata.slice(0,8)}… for ${w.label}`);
    }
  }

  // Fetch signatures from: wallet address + all focus ATAs (current + historical)
  const addressesToScan = [w.address, ...ataAddresses];

  for(const addr of addressesToScan) {
    let before = undefined;
    let page = 0;
    const MAX_PAGES = 30; // ~3000 sigs max per wallet per fetch

    while(page < MAX_PAGES) {
      let sigs;
      try {
        const r = await heliusRPC('getSignaturesForAddress', [addr, {limit: 100, ...(before ? {before} : {})}]);
        sigs = r?.result || [];
      } catch(e) {
        if(e?.message?.includes('429') || e?.message?.includes('Too Many')) {
          await sleep(2000); continue;
        }
        break;
      }
      if(!sigs.length) break;

      const inWindow     = sigs.filter(s => !s.err && s.blockTime != null && s.blockTime >= fromTs && s.blockTime <= toTs && !seenSigs.has(s.signature));
      const beforeWindow = sigs.filter(s => s.blockTime != null && s.blockTime < fromTs);

      inWindow.forEach(s => seenSigs.add(s.signature));

      // Fetch full tx in batches of 8
      for(let i=0; i<inWindow.length; i+=8) {
        const batch = inWindow.slice(i, i+8);
        const results = await Promise.all(batch.map(s =>
          heliusRPC('getTransaction', [s.signature, {encoding:'jsonParsed', maxSupportedTransactionVersion:0}])
            .then(r => r?.result).catch(() => null)
        ));
        for(const tx of results) {
          if(!tx) continue;
          const moves = parseTransaction(tx, w.address, w.label);
          txs.push(...moves);
        }
        if(i+8 < inWindow.length) await sleep(80);
      }

      console.log(`[TX] ${addr.slice(0,8)}… page ${page}: ${sigs.length} sigs oldest=${sigs[sigs.length-1]?.blockTime} (${new Date((sigs[sigs.length-1]?.blockTime||0)*1000).toISOString().slice(0,10)}), ${inWindow.length} in window, total moves: ${txs.length}`);

      const oldestOnPage = sigs[sigs.length-1]?.blockTime ?? 0;
      if(sigs.length < 100) break;
      if(oldestOnPage < fromTs) break;
      before = sigs[sigs.length-1].signature;
      page++;
      await sleep(100);
    }
  }

  console.log(`[TX] ${w.label} DONE — ${txs.length} total movements`);
  return txs;
}

// ══════════════════════════════════════════════════════════════════
// FIFO ENGINE (per entity, per token — internal transfers share lot pool)
// ══════════════════════════════════════════════════════════════════
const STABLE_TOKENS = new Set(['USDC','USDT']);

function computeFIFO(allTxs, periodFromTs) {
  const gainLoss   = [];
  const unrealized = [];

  // Group by wallet+token — FIFO is per wallet (matches Node40 behavior)
  // Internal transfers between wallets of the same entity move lots with original cost basis.
  const keys = [...new Set(allTxs.map(t => t.walletAddr + '::' + t.asset))];

  // Build a shared lot pool per entity+token to handle internal transfers correctly.
  // Each wallet has its own FIFO queue, but internal transfers move lots between queues.
  // We process all wallets of an entity together, sorted by blockTime across all wallets.
  const entityTokenKeys = [...new Set(allTxs.map(t => {
    const entity = ALL_WALLETS.find(w => w.address === t.walletAddr)?.entity || t.walletAddr;
    return entity + '::' + t.asset;
  }))];

  for(const etKey of entityTokenKeys) {
    const sepIdx = etKey.indexOf('::');
    const entity = etKey.slice(0, sepIdx);
    const token  = etKey.slice(sepIdx + 2);
    if(STABLE_TOKENS.has(token)) continue;

    const entityWalletAddrs = new Set(ALL_WALLETS.filter(w => w.entity === entity).map(w => w.address));

    // Per-wallet lot queues within the entity
    const walletQueues = {}; // walletAddr -> lot[]

    const moves = allTxs
      .filter(t => {
        const tEntity = ALL_WALLETS.find(w => w.address === t.walletAddr)?.entity || t.walletAddr;
        return tEntity === entity && t.asset === token;
      })
      .sort((a,b) => a.blockTime - b.blockTime);

    if(!moves.length) continue;

    // Identify internal transfers: same txHash, Out from wallet A + In to wallet B, BOTH same entity
    // This is the only reliable method — counterparty lookup causes false positives
    const internalTxHashes = new Set();
    // Group moves by txHash
    const byHash = {};
    for(const t of moves) {
      if(!t.txHash || t._synthetic) continue;
      if(!byHash[t.txHash]) byHash[t.txHash] = [];
      byHash[t.txHash].push(t);
    }
    for(const [hash, txMoves] of Object.entries(byHash)) {
      const outs = txMoves.filter(t => t.dir === 'Out');
      const ins  = txMoves.filter(t => t.dir === 'In');
      // Internal if: has both Out from entity wallet AND In to DIFFERENT entity wallet (same entity)
      const hasOut = outs.some(t => entityWalletAddrs.has(t.walletAddr));
      const hasIn  = ins.some(t  => entityWalletAddrs.has(t.walletAddr));
      if(hasOut && hasIn) {
        // Verify they are different wallets
        const outAddrs = new Set(outs.map(t=>t.walletAddr));
        const inAddrs  = new Set(ins.map(t=>t.walletAddr));
        const differentWallets = [...inAddrs].some(a => !outAddrs.has(a));
        if(differentWallets) internalTxHashes.add(hash);
      }
    }
    if(token==='ORCA') console.log('[FIFO-INTERNAL]', entity, internalTxHashes.size, 'internal hashes from', Object.keys(byHash).length, 'unique txHashes');

    // Helper: get most recent known price from any wallet lot before given date
    const getLastKnownPrice = (entityWallets, beforeDate) => {
      let lastPrice = 0;
      let lastTime = 0;
      for (const addr in entityWallets) {
        for (const lot of entityWallets[addr]) {
          if (lot.acqBlockTime < beforeDate && lot.costPerUnit > 0) {
            if (lot.acqBlockTime > lastTime) {
              lastPrice = lot.costPerUnit;
              lastTime = lot.acqBlockTime;
            }
          }
        }
      }
      return lastPrice;
    };

    const filteredMoves = moves; // process all, handle internals below

    // NOTE: orcaLedgerData is populated from allOrcaHistory at line ~2456, not here

    if(token === 'ORCA') {
      console.log('[FIFO-DEBUG]', entity, 'ORCA:', filteredMoves.length, 'moves,', internalTxHashes.size, 'internal tx hashes');
      filteredMoves.forEach((m,i) => console.log('[FIFO-MOVE]', i, m.dir, 'qty=' + m.qty?.toFixed(2), 'price=' + m.price?.toFixed(4), 'bt=' + m.blockTime, new Date(m.blockTime*1000).toISOString().slice(0,10), 'synth=' + !!m._synthetic, 'internal=' + internalTxHashes.has(m.txHash), 'hash=' + m.txHash?.slice(0,8)));
    }

    // Per-wallet FIFO queues — lots stay in originating wallet queue
    // Internal transfers move lots between queues preserving cost basis
    const walletLots = {}; // walletAddr -> lot[]
    const getQueue = (addr) => { if(!walletLots[addr]) walletLots[addr]=[]; return walletLots[addr]; };

    for(const m of filteredMoves) {
      const wQueue = getQueue(m.walletAddr);
      const wLabel = m.wallet || entity;
      const wAddr  = m.walletAddr;

      if(m.dir === 'In') {
        if(m._synthetic) {
          // Carry-forward synthetic lot — add directly
          const acqDate = m.date instanceof Date ? m.date : new Date(m.date);
          wQueue.push({ origQty: m.qty, remaining: m.qty, costPerUnit: m.price||0, acqDate, acqBlockTime: m.blockTime, acqTxHash: m.txHash });
        } else if(internalTxHashes.has(m.txHash)) {
          // Internal transfer In — move lots from sender wallet preserving cost basis
          const senderTx = filteredMoves.find(o => o.txHash===m.txHash && o.dir==='Out' && o.walletAddr!==m.walletAddr && entityWalletAddrs.has(o.walletAddr));
          if(senderTx) {
            const sQueue = getQueue(senderTx.walletAddr);
            let toMove = m.qty;
            while(toMove > 1e-8 && sQueue.length > 0) {
              const lot = sQueue[0];
              const moved = Math.min(lot.remaining, toMove);
              wQueue.push({ origQty: moved, remaining: moved, costPerUnit: lot.costPerUnit, acqDate: lot.acqDate, acqBlockTime: lot.acqBlockTime, acqTxHash: lot.acqTxHash });
              lot.remaining -= moved;
              toMove -= moved;
              if(lot.remaining < 1e-8) sQueue.shift();
            }
            // If sender had no lots (or not enough), create new lot at market price for remainder
            if(toMove > 1e-8) {
              const acqDate = m.date instanceof Date ? m.date : new Date(m.date);
              let costPerUnit = m.price || 0;
              // If price is 0/undefined, use most recent known price from any entity wallet
              if(costPerUnit <= 0) {
                costPerUnit = getLastKnownPrice(walletLots, m.blockTime);
              }
              wQueue.push({ origQty: toMove, remaining: toMove, costPerUnit, acqDate, acqBlockTime: m.blockTime, acqTxHash: m.txHash });
              console.warn(`[FIFO] Internal transfer ${m.txHash?.slice(0,8)}: sender had insufficient lots, created new lot @ ${costPerUnit} for ${toMove.toFixed(2)}`);
            }
          } else {
            // No sender found — create lot at market price as fallback
            const acqDate = m.date instanceof Date ? m.date : new Date(m.date);
            let costPerUnit = m.price || 0;
            // If price is 0/undefined, use most recent known price from any entity wallet
            if(costPerUnit <= 0) {
              costPerUnit = getLastKnownPrice(walletLots, m.blockTime);
            }
            wQueue.push({ origQty: m.qty, remaining: m.qty, costPerUnit, acqDate, acqBlockTime: m.blockTime, acqTxHash: m.txHash });
          }
        } else {
          // Normal external In — new lot at market price
          const acqDate = m.date instanceof Date ? m.date : new Date(m.date);
          let costPerUnit = m.price || 0;
          // If price is 0/undefined, use most recent known price from any entity wallet
          if(costPerUnit <= 0) {
            costPerUnit = getLastKnownPrice(walletLots, m.blockTime);
          }
          wQueue.push({ origQty: m.qty, remaining: m.qty, costPerUnit, acqDate, acqBlockTime: m.blockTime, acqTxHash: m.txHash });
        }
      } else {
        // Out
        if(internalTxHashes.has(m.txHash)) {
          // Internal transfer Out — lots will be moved when processing the In side
          // Just consume from queue silently (the In handler above does the actual move)
          // Skip — the In side handles the lot movement
          continue;
        }

        // External Out — dispose lots (gain/loss event)
        let toDispose = m.qty;
        const soldDate = m.date instanceof Date ? m.date : new Date(m.date);

        if(wQueue.length === 0) {
          console.warn('[FIFO] ⚠ Out of', token, '(' + m.qty?.toFixed(2) + ') for', wLabel, 'with NO lots! bt=' + m.blockTime);
        }

        while(toDispose > 1e-8 && wQueue.length > 0) {
          const lot      = wQueue[0];
          const consumed = Math.min(lot.remaining, toDispose);
          const costBasis  = consumed * lot.costPerUnit;
          const proceeds   = consumed * (m.price || 0);
          const gain       = proceeds > 0 ? proceeds - costBasis : 0; // no gain if no proceeds (price unknown)
          const msHeld     = soldDate.getTime() - lot.acqDate.getTime();
          const daysHeld   = Math.floor(msHeld / 86400000);
          const isLT       = daysHeld > 365;
          const gs         = isLT ? 0 : gain;
          const gl         = isLT ? gain : 0;

          gainLoss.push({
            soldDate,
            soldBlockTime: m.blockTime,
            acqDate:       lot.acqDate,
            account:       wLabel,
            walletAddr:    wAddr,
            asset:         token,
            qty:           consumed,
            acqPrice:      lot.costPerUnit,
            soldPrice:     m.price || 0,
            costBasis,
            proceeds,
            gainShort:     gs,
            gainLong:      gl,
            gain,
            days:          daysHeld,
            txHash:        m.txHash,
            acqTxHash:     lot.acqTxHash,
          });

          if(!m._synthetic && m.blockTime >= (periodFromTs || 0)) {
            m.gainShort = (m.gainShort || 0) + gs;
            m.gainLong  = (m.gainLong  || 0) + gl;
          }

          lot.remaining -= consumed;
          toDispose     -= consumed;
          if(lot.remaining < 1e-8) wQueue.shift();
        }
      }
    }

    // Remaining open lots → unrealized
    for(const [wAddr2, lots] of Object.entries(walletLots)) {
      const wLabel2 = ALL_WALLETS.find(w=>w.address===wAddr2)?.label || wAddr2;
      for(const lot of lots) {
        if(lot.remaining < 1e-8) continue;
        unrealized.push({
          token,
          wallet:       wLabel2,
          walletAddr:   wAddr2,
          acqDate:      lot.acqDate,
          acqPrice:     lot.costPerUnit,
          closingPrice: 0,
          lotOrig:      lot.origQty,
          lotRem:       lot.remaining,
          costBasis:    lot.remaining * lot.costPerUnit,
          unrealVal:    0,
          unrealGain:   0,
        });
      }
    }
  } // end entityTokenKeys loop

  const totalGain = gainLoss.reduce((s,g)=>s+g.gain,0);
  console.log('[FIFO]', gainLoss.length, 'total dispositions, gain=$' + totalGain.toFixed(2) + ',', unrealized.length, 'open lots');
  return {gainLoss, unrealized};
}

// Fill unrealized with closing prices
function enrichUnrealized(unrealized, prices) {
  for(const u of unrealized) {
    u.closingPrice = prices[u.token] || 0;
    u.unrealVal    = u.lotRem * u.closingPrice;
    u.unrealGain   = u.unrealVal - u.costBasis;
  }
}

// Synchronous price lookup from _priceCache — used for end-of-month valuation in Unrealized tab.
// Searches for the closest cached price at or before `ts` (Unix seconds).
// Falls back to last known price from orcaLedgerData if cache has nothing useful.
function _getPriceSyncApprox(token, ts) {
  if(STABLE_TOKENS.has(token)) return 1;
  // TGE hardcode
  if(token === 'ORCA') {
    const d = new Date(ts * 1000);
    if(d.getUTCFullYear() === 2021 && d.getUTCMonth() === 7 && d.getUTCDate() === 9) return 2.64956;
  }
  // Try exact minute/hour bucket
  const min1    = Math.floor(ts / 60) * 60;
  const hourTs  = Math.floor(ts / 3600) * 3600;
  if(_priceCache[`${token}::${min1}`])   return _priceCache[`${token}::${min1}`];
  if(_priceCache[`${token}::${hourTs}`]) return _priceCache[`${token}::${hourTs}`];
  // Scan cache for closest key <= ts
  const prefix = `${token}::`;
  let best = 0, bestTs = -1;
  for(const [k, v] of Object.entries(_priceCache)) {
    if(!k.startsWith(prefix) || !v) continue;
    const kt = parseInt(k.slice(prefix.length));
    if(kt <= ts && kt > bestTs) { best = v; bestTs = kt; }
  }
  if(best > 0) return best;
  // Last resort: last price from ledger data before ts
  let lastPrice = 0;
  for(const r of orcaLedgerData) {
    if(r.blockTime <= ts && r.price > 0) lastPrice = r.price;
  }
  return lastPrice;
}

// ══════════════════════════════════════════════════════════════════
// MAIN FETCH ORCHESTRATOR
// ══════════════════════════════════════════════════════════════════
// ── Snapshot Data Loading ──────────────────────────────────────────────────────
// Try to load pre-fetched snapshot data from server instead of fetching from Helius
async function tryLoadSnapshot() {
  const PROXY_BASE = 'https://tidelog-server-production.up.railway.app';
  const token = localStorage.getItem('tidelog_auth_token');
  
  if (!token) return null;
  
  try {
    const response = await fetch(`${PROXY_BASE}/api/snapshot/data`, {
      headers: { 'Authorization': `Bearer ${token}` },
      credentials: 'include'
    });
    
    if (!response.ok) {
      if (response.status === 404) {
        console.log('[Snapshot] No snapshot data available on server');
      } else {
        console.warn('[Snapshot] Failed to load:', response.status);
      }
      return null;
    }
    
    const result = await response.json();
    if (result.success && result.data?.transactions) {
      console.log(`[Snapshot] Loaded ${result.data.transactions.length} transactions from server`);
      console.log(`[Snapshot] Uploaded: ${result.data.metadata.uploadedAt}`);
      console.log(`[Snapshot] Date range: ${result.data.metadata.dateRange}`);
      return result.data.transactions;
    }
    
    return null;
  } catch (err) {
    console.warn('[Snapshot] Error loading snapshot:', err.message);
    return null;
  }
}

// ── Auto-load Snapshot on Startup ──────────────────────────────────────────────
// Automatically loads snapshot data when user logs in, without clicking "Fetch Data"
async function autoLoadSnapshotOnStartup() {
  console.log('[Auto-load] Checking for snapshot data...');
  
  const snapshotTxs = await tryLoadSnapshot();
  
  if (!snapshotTxs || snapshotTxs.length === 0) {
    console.log('[Auto-load] No snapshot available - user will need to fetch manually');
    return;
  }
  
  // Store transactions globally so they're available
  window.ALL_TXS = snapshotTxs;
  
  // Set status to show data is loaded
  const dates = snapshotTxs
    .map(t => new Date(t.date))
    .filter(d => !isNaN(d))
    .sort((a, b) => a - b);
  
  const dateRange = dates.length > 0 
    ? `${dates[0].toISOString().split('T')[0]} to ${dates[dates.length - 1].toISOString().split('T')[0]}`
    : 'Unknown';
  
  setStatus('idle', `${snapshotTxs.length.toLocaleString()} transactions loaded from snapshot`, dateRange);
  
  console.log(`[Auto-load] ✓ Loaded ${snapshotTxs.length} transactions automatically`);
  console.log(`[Auto-load] Date range: ${dateRange}`);
  console.log('[Auto-load] Data ready - user can now view reports or fetch new data');
}

async function fetchData() {
  const isPeriod = state.mode === 'period';
  let fromTs, toTs, fromDate, toDate;

  if(isPeriod) {
    fromDate = document.getElementById('dateFrom').value;
    toDate   = document.getElementById('dateTo').value;
    if(!fromDate || !toDate) { alert('Please select From and To dates.'); return; }
    if(fromDate > toDate)    { alert('From date must be before To date.'); return; }
    fromTs = Math.floor(new Date(fromDate + 'T00:00:00Z').getTime() / 1000);
    state.fromDate = fromDate;
    state.toDate = toDate;
    toTs   = Math.floor(new Date(toDate   + 'T23:59:59Z').getTime() / 1000);
    state.cutoffDate = toDate;
  } else {
    fromTs = null; toTs = null;
    state.cutoffDate = null;
  }

  const selectedAddresses = getSelectedWalletAddresses();
  const wallets = ALL_WALLETS.filter(w =>
    w.chain === 'SOL' && !w.external && (!state.entity || w.entity === state.entity) &&
    (!selectedAddresses || selectedAddresses.includes(w.address))
  );
  // fifoWallets = ALL wallets of entity, ignoring checkbox — needed so FIFO
  // always sees every wallet and can detect internal transfers correctly
  const fifoWallets = ALL_WALLETS.filter(w =>
    w.chain === 'SOL' && !w.external && (!state.entity || w.entity === state.entity)
  );

  setLoading(true, 'Fetching prices…', '', 5);
  setStatus('loading', 'Fetching prices…');

  // 1. Prices (end-of-period or live)
  state.prices = await fetchPrices(isPeriod ? toDate : null);

  // 2. Balances (as of toDate if period, else live)
  setLoading(true, 'Fetching wallet balances…', `0 / ${wallets.length}`, 10);
  const BATCH = 5;
  const balResults = [];
  for(let i=0; i<wallets.length; i+=BATCH) {
    const batch = wallets.slice(i, i+BATCH);
    const pct   = 10 + Math.round((i/wallets.length) * 35);
    setLoading(true, 'Fetching balances…',
      `${Math.min(i+BATCH,wallets.length)} / ${wallets.length} — ${batch[0].label.slice(0,30)}`, pct);

    const res = await Promise.all(batch.map(w =>
      isPeriod ? fetchWalletHistorical(w, toDate) : fetchWalletLive(w)
    ));
    batch.forEach((w,j) => {
      const bal = res[j].balances;
      const totalUSD = (bal.SOL||0)*state.prices.SOL + (bal.ORCA||0)*state.prices.ORCA + (bal.USDC||0) + (bal.USDT||0);
      balResults.push({...w, balances:bal, totalUSD, status:res[j].status, error:res[j].error});
    });
    if(i+BATCH < wallets.length) await sleep(100);
  }
  state.walletData = balResults;

  // 3. Transactions (only for period mode)
  // In incremental mode: preserve existing transactions for merging after fetch
  const _prevTransactions = state._wasIncremental ? (state.transactions || []) : [];
  state.transactions = [];
  state.gainLoss     = [];
  state.unrealized   = [];
  orcaLedgerGLMap    = {}; // reset G/L annotations on each fetch

  if(isPeriod) {
    // Try to load from snapshot first
    const snapshotTxs = await tryLoadSnapshot();
    let allTxs = [];
    
    if (snapshotTxs && snapshotTxs.length > 0) {
      // Filter snapshot transactions by entity, wallets, and date range
      const walletAddrs = new Set(fifoWallets.map(w => w.address));
      allTxs = snapshotTxs.filter(tx => {
        // Must be in selected wallets
        if (!walletAddrs.has(tx.walletAddr)) return false;
        // Must be in date range
        const txTs = new Date(tx.date).getTime() / 1000;
        return txTs >= fromTs && txTs <= toTs;
      });
      
      setLoading(true, 'Using cached snapshot…', `${allTxs.length} transactions loaded`, 75);
      console.log(`[Snapshot] Using ${allTxs.length} transactions from snapshot`);
    } else {
      // No snapshot available - fetch from Helius as usual
      setLoading(true, 'Fetching transactions…', `0 / ${wallets.length} wallets`, 46);

      for(let i=0; i<fifoWallets.length; i++) {
        const w   = fifoWallets[i];
        const pct = 46 + Math.round((i/fifoWallets.length) * 40);
        setLoading(true, 'Fetching transactions…',
          `${i+1} / ${fifoWallets.length} — ${w.label}`, pct);
        const txs = await fetchWalletTransactions(w, fromTs, toTs);
        allTxs.push(...txs);
      }
    }

    // 4. Enrich prices — priority: Helius exchange price → Jupiter historical → DeFiLlama daily
    setLoading(true, 'Enriching prices…', `${allTxs.length} movements`, 88);

    // Stablecoins always $1
    for(const tx of allTxs) {
      if(STABLE_TOKENS.has(tx.asset)) { tx.price = 1; tx.usd = tx.qty; }
    }

    // Group non-stable txs by hash for Helius enhanced batch
    const hashToMoves = new Map();
    for(const tx of allTxs) {
      if(STABLE_TOKENS.has(tx.asset)) continue;
      if(!hashToMoves.has(tx.txHash)) hashToMoves.set(tx.txHash, []);
      hashToMoves.get(tx.txHash).push(tx);
    }

    // Helius Enhanced API — gets tokenPrice per tx (most accurate)
    const hashes = [...hashToMoves.keys()];
    for(let i=0; i<hashes.length; i+=10) {
      const batch = hashes.slice(i, i+10);
      try {
        const r = await fetch(`${PROXY_BASE}/proxy/helius/transactions`, {
          method: 'POST',
          headers: authHeaders({'Content-Type':'application/json'}),
          credentials: 'include',
          body: JSON.stringify({transactions: batch})
        });
        if(r.ok) {
          const enhanced = await r.json();
          for(const etx of enhanced) {
            const moves = hashToMoves.get(etx.signature) || [];
            for(const m of moves) {
              // Always try Helius enhanced — it's more accurate than DeFiLlama hourly
              // Only skip if we already have an Exchange-grade price
              if(m.priceSource === 'Exchange') continue;
              const mint = PRICE_MINTS[m.asset];
              if(!mint) continue;

              // Method 1: tokenTransfers have tokenPrice (USD) set by Helius
              const tt = (etx.tokenTransfers||[]).find(t => t.mint === mint &&
                (t.fromUserAccount === m.walletAddr || t.toUserAccount === m.walletAddr));
              if(tt?.tokenPrice > 0) {
                m.price = tt.tokenPrice;
                m.usd   = m.qty * tt.tokenPrice;
                m.priceSource = 'Exchange';
                continue;
              }

              // Method 2: swap event — extract price from tokenInputs/tokenOutputs
              const swap = etx.events?.swap;
              if(swap) {
                const inp = [...(swap.tokenInputs||[]),...(swap.nativeInput?[swap.nativeInput]:[])];
                const out = [...(swap.tokenOutputs||[]),...(swap.nativeOutput?[swap.nativeOutput]:[])];
                const orcaInSwap = [...inp,...out].find(t => t.mint === mint || t.account === mint);
                const usdcInSwap = [...inp,...out].find(t =>
                  t.mint === PRICE_MINTS.USDC || t.mint === PRICE_MINTS.USDT);
                if(orcaInSwap && usdcInSwap) {
                  const p = Math.abs(usdcInSwap.rawTokenAmount?.uiAmount || usdcInSwap.amount/1e6 || 0) /
                            Math.abs(orcaInSwap.rawTokenAmount?.uiAmount || orcaInSwap.amount || 1);
                  if(p > 0.001 && p < 100000) {
                    m.price = p; m.usd = m.qty * p; m.priceSource = 'Exchange';
                    continue;
                  }
                }
              }

              // Method 3: implied price from USDC transfer in same tx
              const usdcTT = (etx.tokenTransfers||[]).find(t =>
                t.mint === PRICE_MINTS.USDC || t.mint === PRICE_MINTS.USDT);
              if(tt && usdcTT && Math.abs(tt.tokenAmount) > 0) {
                const p = Math.abs(usdcTT.tokenAmount) / Math.abs(tt.tokenAmount);
                if(p > 0.001 && p < 100000) {
                  m.price = p; m.usd = m.qty * p; m.priceSource = 'Exchange';
                  continue;
                }
              }
            }
          }
        }
      } catch(e) { console.warn('[Price] Helius enhanced failed:', e.message); }
      if(i+10 < hashes.length) await sleep(200);
    }

    // For txs still without price: bulk prefetch then fill gaps
    const needPrice = allTxs.filter(t => !STABLE_TOKENS.has(t.asset) && !(t.price > 0));
    console.log(`[Price] ${needPrice.length} movements need price lookup`);

    if(needPrice.length > 0) {
      // Group by token to do bulk DeFiLlama range calls per token
      const byToken = new Map();
      for(const tx of needPrice) {
        if(!byToken.has(tx.asset)) byToken.set(tx.asset, []);
        byToken.get(tx.asset).push(tx.blockTime);
      }
      setLoading(true, 'Prefetching historical prices…',
        `${[...byToken.keys()].join(', ')} · ${needPrice.length} movements`, 89);

      // Bulk prefetch: chunk full date range into yearly slices with daily resolution.
      // 1 call per token per year (4 years = 4 calls) instead of 22k individual lookups.
      const YEAR_MINS = 366 * 24 * 60; // ~1 year in minutes (covers leap years)
      for(const [token, timestamps] of byToken.entries()) {
        const coinId = token === 'SOL' ? 'coingecko:solana' : `solana:${ORCA_MINT}`;
        const minTs = Math.min(...timestamps);
        const maxTs = Math.max(...timestamps);

        // Align chunk start to start of year
        let chunkStart = Math.floor(minTs / 86400) * 86400;
        let chunkNum   = 0;
        while(chunkStart <= maxTs + 86400) {
          const ck = `${token}::bulk-d::${Math.floor(chunkStart/86400)}`;
          if(!_priceCache[ck]) {
            try {
              // Use period=1d for historical ranges (one price per day)
              const r = await fetch(
                `https://coins.llama.fi/chart/${coinId}?start=${chunkStart}&span=${YEAR_MINS}&period=1d`
              );
              if(r.ok) {
                const d = await r.json();
                const prices = d?.coins?.[coinId]?.prices || [];
                for(const p of prices) {
                  // Fill all 24 hourly slots for the day so existing hourly lookups hit cache
                  const dayStart = Math.floor(p.timestamp / 86400) * 86400;
                  for(let h = 0; h < 24; h++) {
                    const hk = `${token}::${dayStart + h * 3600}`;
                    if(!_priceCache[hk]) _priceCache[hk] = p.price;
                  }
                }
                _priceCache[ck] = 1;
                _savePriceCache();
                console.log(`[Price] Bulk chunk ${++chunkNum} for ${token}: ${prices.length} daily prices loaded`);
              }
            } catch(e) { console.warn('[Price] Bulk chunk failed:', e.message); }
            await sleep(300);
          } else { chunkNum++; }
          chunkStart += 366 * 86400; // advance by ~1 year in seconds
        }
      }

      // Now fetch per-minute Birdeye prices for unique minutes not yet cached
      const uniqueMinutes = new Map();
      for(const tx of needPrice) {
        const min1 = Math.floor(tx.blockTime / 60) * 60;
        const mKey = `${tx.asset}::${min1}`;
        if(!_priceCache[mKey] && !uniqueMinutes.has(mKey)) {
          uniqueMinutes.set(mKey, {token: tx.asset, ts: tx.blockTime});
        }
      }

      const minuteJobs = [...uniqueMinutes.entries()];
      console.log(`[Price] ${minuteJobs.length} individual price lookups remaining after bulk prefetch`);
      for(let i=0; i<minuteJobs.length; i+=8) {
        if(i % 80 === 0) {
          setLoading(true, 'Fetching remaining prices…',
            `${i} / ${minuteJobs.length} individual lookups`, 90);
        }
        await Promise.all(minuteJobs.slice(i,i+8).map(async ([k, {token, ts}]) => {
          if(_priceCache[k]) return;
          _priceCache[k] = await getPriceAt(token, ts);
        }));
        if(i+8 < minuteJobs.length) await sleep(100);
      }
    }

    // Apply prices to txs
    for(const tx of needPrice) {
      if(tx.price > 0) continue;
      const min1   = Math.floor(tx.blockTime / 60) * 60;
      const hourTs = Math.floor(tx.blockTime / 3600) * 3600;
      tx.price = _priceCache[`${tx.asset}::${min1}`] || _priceCache[`${tx.asset}::${hourTs}`] || 0;
      tx.usd   = tx.qty * tx.price;
      if(tx.price > 0) tx.priceSource = tx.priceSource || 'DeFiLlama';
    }

    // In incremental mode: merge new txs with preserved historical transactions
    if(state._wasIncremental && _prevTransactions.length > 0) {
      const existingKeys = new Set(_prevTransactions.map(t => `${t.txHash}::${t.walletAddr}::${t.asset}::${t.dir}`));
      const newOnly = allTxs.filter(t => !existingKeys.has(`${t.txHash}::${t.walletAddr}::${t.asset}::${t.dir}`));
      console.log(`[INCR] Merging: ${_prevTransactions.length} existing + ${newOnly.length} new txs`);
      allTxs = [..._prevTransactions, ...newOnly].sort((a,b) => (b.blockTime||0) - (a.blockTime||0));
    }
    state.transactions = allTxs;
    // Cache txs per wallet for trend charts (persists across period changes)
    try {
      const txByWallet = {};
      for(const t of allTxs) {
        const wa = t.walletAddr || t.wallet || '';
        if(!wa) continue;
        if(!txByWallet[wa]) txByWallet[wa] = [];
        txByWallet[wa].push({
          date: t.date instanceof Date ? t.date.toISOString() : t.date,
          dir:  t.dir,
          usd:  t.usd || 0,
          qty:  t.qty || 0,
          asset: t.asset || '',
          txHash: t.txHash || '',
          blockTime: t.blockTime || 0,
          wallet: t.wallet || '',           // ADD: entity name (Opco, Juku, etc)
          walletAddr: t.walletAddr || wa,  // ADD: wallet address
        });
      }
      for(const [wa, txs] of Object.entries(txByWallet)) {
        const key = `tx-history::${wa}`;
        // Merge with existing cache
        let existing = [];
        try { existing = JSON.parse(localStorage.getItem(key) || '[]'); } catch(e) {}
        const seenHk = new Set(existing.map(t => (t.txHash||'')+(t.blockTime||'')+t.dir));
        for(const t of txs) {
          const hk = (t.txHash||'')+(t.blockTime||'')+t.dir;
          if(!seenHk.has(hk)) { seenHk.add(hk); existing.push(t); }
        }
        existing.sort((a,b) => (a.blockTime||0)-(b.blockTime||0));
        localStorage.setItem(key, JSON.stringify(existing));
      }
    } catch(e) { console.warn('tx-history cache error:', e); }
    console.log(`[STATE] transactions: ${allTxs.length} total, ORCA In: ${allTxs.filter(t=>t.asset==='ORCA'&&t.dir==='In').length}, ORCA Out: ${allTxs.filter(t=>t.asset==='ORCA'&&t.dir==='Out').length}`);
    allTxs.filter(t=>t.asset==='ORCA'&&t.dir==='In').forEach(t=>console.log(`  [IN] ${t.qty?.toFixed(2)} from ${t.counterparty?.slice(0,20)} wallet=${t.wallet?.slice(0,25)} bt=${new Date(t.blockTime*1000).toISOString().slice(0,10)}`));

    // ── 5. FIFO — fetch ALL ORCA history, cache in localStorage, compute FIFO ──
    const FIFO_EXCLUDE = new Set([
      'GwH3Hiv5mACLX3ufTw1pFsrhSPon5tdw252DBs4Rx4PV', // Orca Multi-Sig Treasury
      'DWo8SNtdBDueSHzLzrTWxvjpbSBFSbMD4BnPYCxEofzg', // DAO Fee Treasury
    ]);
    const ORCA_HISTORY_KEY = `orca-history::${state.entity}`;

    let unrealized = [];
    if(isPeriod && fromTs > 0) {

      // ── Fetch ORCA txs for a wallet — full history or incremental (sinceTs) ──
      // sinceTs: if set, only fetch txs with blockTime > sinceTs (incremental mode)
      // knownSigs: Set of already-cached signatures to stop early on overlap
      async function fetchOrcaHistory(w, sinceTs = null, knownSigs = null) {
        const orcaMint = 'orcaEKTdK7LKz57vaAYr9QeNsVEPfiu6QeMU1kektZE';
        const moves = [];
        const seen  = new Set();
        const addrSet = new Set();
        const isIncremental = sinceTs != null;

        // Get current ORCA ATA
        try {
          const r = await heliusRPC('getTokenAccountsByOwner',
            [w.address, {mint: orcaMint}, {encoding:'jsonParsed'}]);
          (r?.result?.value||[]).forEach(a => addrSet.add(a.pubkey));
        } catch(e){}

        // Static ATAs
        for(const [ata, owner] of Object.entries(ATA_OWNER_MAP))
          if(owner === w.address) addrSet.add(ata);

        // Fallback to main address if no ATAs found
        if(addrSet.size === 0) addrSet.add(w.address);

        // Scan each ATA
        for(const addr of addrSet) {
          let before;
          for(let pg = 0; pg < 5000; pg++) {
            let sigs;
            try {
              const r = await heliusRPC('getSignaturesForAddress',
                [addr, {limit:100, ...(before?{before}:{})}]);
              sigs = r?.result || [];
            } catch(e) { await sleep(500); break; }
            if(!sigs.length) break;

            // In incremental mode: stop pagination when we hit txs older than sinceTs
            // or when we hit a signature already in the cache
            if(isIncremental) {
              const oldestInPage = sigs[sigs.length-1];
              if(oldestInPage.blockTime != null && oldestInPage.blockTime <= sinceTs) {
                // Filter to only txs newer than sinceTs in this page
                sigs = sigs.filter(s => s.blockTime == null || s.blockTime > sinceTs);
                if(!sigs.length) break;
                // After processing this batch, stop (don't paginate further)
                before = null; // will break after this page
              }
              // Early stop: if we hit a known cached signature, we've reached overlap
              if(knownSigs) {
                const overlapIdx = sigs.findIndex(s => knownSigs.has(s.signature));
                if(overlapIdx !== -1) {
                  sigs = sigs.slice(0, overlapIdx);
                  if(!sigs.length) { before = null; break; }
                  before = null; // stop after this page
                }
              }
            }

            const valid = sigs.filter(s => !s.err && s.blockTime != null && !seen.has(s.signature));
            valid.forEach(s => seen.add(s.signature));

            for(let i = 0; i < valid.length; i += 10) {
              const txs = await Promise.all(valid.slice(i,i+10).map(s =>
                heliusRPC('getTransaction',[s.signature,
                  {encoding:'jsonParsed',maxSupportedTransactionVersion:0}])
                  .then(r=>r?.result).catch(()=>null)
              ));
              for(const tx of txs) {
                if(!tx) continue;
                // Discover new ATAs
                const keys2 = (tx.transaction?.message?.accountKeys||[]).map(k=>typeof k==='string'?k:k.pubkey);
                for(const b of [...(tx.meta?.preTokenBalances||[]),...(tx.meta?.postTokenBalances||[])]) {
                  if(b.owner === w.address && b.mint === orcaMint) {
                    const ata = keys2[b.accountIndex];
                    if(ata && !addrSet.has(ata)) { addrSet.add(ata); registerATA(ata, w.address); }
                  }
                }
                moves.push(...parseTransaction(tx, w.address, w.label));
              }
              if(i+10 < valid.length) await sleep(50);
            }
            if(!before || sigs.length < 100) break;
            before = sigs[sigs.length-1].signature;
            await sleep(80);
          }
        }
        const orcaMoves = moves.filter(m => m.asset === 'ORCA');
        console.log(`[HIST] ${w.label.slice(0,30)}: ${orcaMoves.length} ORCA moves${isIncremental?' (incremental)':''}`);
        return orcaMoves;
      }

      // ── Load or fetch ORCA history (full or incremental) ──
      const fifoActive = fifoWallets.filter(w => !FIFO_EXCLUDE.has(w.address));
      let allOrcaHistory = [];

      function deduplicateAndSort(arr) {
        const seen = new Set();
        return arr.filter(t => {
          const k = (t.txHash||'noHash')+'::'+t.walletAddr+'::'+t.dir;
          if(seen.has(k)) return false;
          seen.add(k); return true;
        }).sort((a,b) => {
          if(a.blockTime !== b.blockTime) return a.blockTime - b.blockTime;
          if(a.dir !== b.dir) return a.dir === 'In' ? -1 : 1;
          return 0;
        });
      }

      const cached = (() => { try { const c = localStorage.getItem(ORCA_HISTORY_KEY); return c ? JSON.parse(c) : null; } catch(e){ return null; } })();

      if(cached && cached.length > 0) {
        allOrcaHistory = cached.map(t => ({...t, date: new Date(t.date)}));
        console.log(`[HIST] Loaded ${allOrcaHistory.length} ORCA txs from cache`);

        // Check if incremental update is requested (state.orcaIncrementalSince set by "Update" button)
        const incrSince = state.orcaIncrementalSince || null;

        if(incrSince) {
          // Incremental mode: only fetch txs newer than incrSince
          const sinceTs = Math.floor(new Date(incrSince + 'T00:00:00Z').getTime() / 1000);
          const knownSigs = new Set(allOrcaHistory.map(t => t.txHash).filter(Boolean));
          console.log(`[HIST] Incremental fetch since ${incrSince} (${sinceTs}), ${knownSigs.size} known sigs`);
          const newMoves = [];
          for(let i = 0; i < fifoActive.length; i++) {
            setLoading(true, 'Fetching new ORCA history…',
              `${i+1}/${fifoActive.length}: ${fifoActive[i].label.slice(0,25)}`, 85 + Math.floor(i/fifoActive.length*8));
            const moves = await fetchOrcaHistory(fifoActive[i], sinceTs, knownSigs);
            newMoves.push(...moves);
          }
          console.log(`[HIST] Incremental: ${newMoves.length} new ORCA moves fetched`);
          allOrcaHistory.push(...newMoves);
          // Clear incremental flag
          state.orcaIncrementalSince = null;
        } else {
          setLoading(true, 'Using cached ORCA history…', `${allOrcaHistory.length} txs`, 90);
        }

        // Always merge period txs (safety net for current period)
        const periodOrcaTxs = allTxs.filter(t => t.asset === 'ORCA');
        allOrcaHistory.push(...periodOrcaTxs);
        allOrcaHistory = deduplicateAndSort(allOrcaHistory);
        console.log(`[HIST] After merge+dedup: ${allOrcaHistory.length} txs`);

        // Save updated cache (includes any newly fetched incremental data)
        try { localStorage.setItem(ORCA_HISTORY_KEY, JSON.stringify(allOrcaHistory)); } catch(e){}

      } else {
        // No cache — full fetch
        for(let i = 0; i < fifoActive.length; i++) {
          setLoading(true, 'Fetching full ORCA history…',
            `${i+1}/${fifoActive.length}: ${fifoActive[i].label.slice(0,25)}`, 85 + Math.floor(i/fifoActive.length*8));
          const moves = await fetchOrcaHistory(fifoActive[i]);
          allOrcaHistory.push(...moves);
        }
        // Also include period txs that may not be in history (safety net)
        const periodOrcaTxs = allTxs.filter(t => t.asset === 'ORCA');
        allOrcaHistory.push(...periodOrcaTxs);

        allOrcaHistory = deduplicateAndSort(allOrcaHistory);
        console.log(`[HIST] Full fetch: ${allOrcaHistory.length} txs`);

        // Save to cache AFTER dedup
        try { localStorage.setItem(ORCA_HISTORY_KEY, JSON.stringify(allOrcaHistory)); } catch(e){}
        console.log(`[HIST] Cached ${allOrcaHistory.length} ORCA txs`);
        state.orcaIncrementalSince = null;
      }

      // ── Enrich prices ──
      setLoading(true, 'Enriching ORCA prices…', '', 93);
      const pMap2 = new Map();
      for(const tx of allOrcaHistory) {
        if(tx.price > 0) continue;
        const hTs = Math.floor(tx.blockTime/3600)*3600;
        pMap2.set(`ORCA::${hTs}`, tx.blockTime);
      }
      const pArr2 = [...pMap2.entries()];
      for(let i = 0; i < pArr2.length; i += 5) {
        await Promise.all(pArr2.slice(i,i+5).map(async([k, ts]) => {
          if(!_priceCache[k]) _priceCache[k] = await getPriceAt('ORCA', ts);
        }));
        if(i+5 < pArr2.length) await sleep(150);
      }
      for(const tx of allOrcaHistory) {
        if(tx.price > 0) continue;
        const hTs = Math.floor(tx.blockTime/3600)*3600;
        tx.price = _priceCache[`ORCA::${hTs}`] || 0;
        tx.usd   = tx.qty * tx.price;
      }

      // ── Detect internal transfers ──
      const entityAddrsSet = new Set(fifoActive.map(w => w.address));
      const internalHashes = new Set();
      const byHash2 = {};
      for(const t of allOrcaHistory) {
        if(!t.txHash) continue;
        if(!byHash2[t.txHash]) byHash2[t.txHash] = [];
        byHash2[t.txHash].push(t);
      }
      for(const [hash, txMoves] of Object.entries(byHash2)) {
        const outs = txMoves.filter(t => t.dir==='Out' && entityAddrsSet.has(t.walletAddr));
        const ins  = txMoves.filter(t => t.dir==='In'  && entityAddrsSet.has(t.walletAddr));
        if(outs.length && ins.length) {
          const outAddrs = new Set(outs.map(t=>t.walletAddr));
          const inAddrs  = new Set(ins.map(t=>t.walletAddr));
          if([...inAddrs].some(a => !outAddrs.has(a))) internalHashes.add(hash);
        }
      }
      console.log(`[FIFO] ${allOrcaHistory.length} ORCA txs total, ${internalHashes.size} internal hashes`);
      console.log(`[FIFO] ORCA Outs >= fromTs: ${allOrcaHistory.filter(t=>t.dir==='Out'&&t.blockTime>=fromTs).length}`);

      // ── Populate ORCA Ledger ──
      orcaLedgerData = allOrcaHistory.map(t => ({
        date:        t.date,
        blockTime:   t.blockTime,
        wallet:      t.wallet,
        walletAddr:  t.walletAddr,
        dir:         t.dir,
        qty:         t.qty,
        price:       t.price,
        usd:         t.usd,
        counterparty: t.counterparty,
        internal:    internalHashes.has(t.txHash),
        synthetic:   !!t._synthetic,
        txHash:      t.txHash,
      }));

      // Hardcoded genesis lots — TGE mints not captured by on-chain scan
      // Add genesis txs to orcaLedgerData so they appear in the ledger view
      const n40GenesisTxs = [
        {
          date:        new Date('2021-08-09T00:00:00Z'),
          blockTime:   1628467200,
          wallet:      'Orca Tokens Main',
          walletAddr:  'GjKxauMroc9MT27xXYyjLYNfy9nSS5EuHTmzhdkjCAR1',
          dir:         'In',
          qty:         87656098.41,
          price:       2.64956,
          usd:         87656098.41 * 2.64956,
          counterparty: '',
          internal:    false,
          synthetic:   true,
          txHash:      'n40-genesis-GjKX-20210809',
        },
      ];

      // Inject genesis rows into orcaLedgerData (sorted by blockTime)
      for(const g of n40GenesisTxs) {
        const idx = orcaLedgerData.findIndex(r => r.blockTime > g.blockTime);
        const row = {...g, internal: false, synthetic: true};
        if(idx === -1) orcaLedgerData.push(row);
        else orcaLedgerData.splice(idx, 0, row);
      }

      // ── Compute FIFO ──
      setLoading(true, 'Computing FIFO gain/loss…', '', 97);
      // orcaLedgerData is the source of truth (already includes genesis lots inserted above)
      const orcaForFifo = orcaLedgerData.map(t => ({
        ...t,
        asset:      t.asset || 'ORCA',   // computeFIFO groups by walletAddr+asset
        _synthetic: t.synthetic,          // computeFIFO checks _synthetic (underscore)
      })).sort((a,b) => a.blockTime - b.blockTime);
      const {gainLoss: allGainLoss, unrealized: _ur} = computeFIFO(orcaForFifo, fromTs);
      unrealized = _ur;
      enrichUnrealized(unrealized, state.prices);

      state.gainLoss = allGainLoss.filter(g => {
        const bt = g.soldBlockTime || Math.floor((g.soldDate instanceof Date ? g.soldDate.getTime() : new Date(g.soldDate).getTime())/1000);
        return bt >= fromTs && bt <= toTs;
      });
      state.unrealized = unrealized;

      const periodGain = state.gainLoss.reduce((s,g)=>s+g.gain,0);
      console.log(`[FIFO] Period: ${state.gainLoss.length} dispositions, gain=$${periodGain.toFixed(2)}`);

      // Build orcaLedgerGLMap: txHash+walletAddr → aggregated G/L for ALL disposals in that tx
      // (a single External Out may consume multiple lots → sum them all)
      orcaLedgerGLMap = {};
      for(const g of allGainLoss) {
        const k = (g.txHash||'') + '::' + (g.walletAddr||'');
        if(!orcaLedgerGLMap[k]) orcaLedgerGLMap[k] = {gain:0, gainShort:0, gainLong:0, proceeds:0, costBasis:0};
        const m = orcaLedgerGLMap[k];
        m.gain      += g.gain      || 0;
        m.gainShort += g.gainShort || 0;
        m.gainLong  += g.gainLong  || 0;
        m.proceeds  += g.proceeds  || 0;
        m.costBasis += g.costBasis || 0;
      }

      // Enrich state.transactions ST/LT gain using orcaLedgerGLMap (all-time, robust key lookup)
      // This replaces the old state.gainLoss find() loop which could fail on object identity mismatches
      for(const t of state.transactions) {
        const k = (t.txHash||'') + '::' + (t.walletAddr||'');
        const glEntry = orcaLedgerGLMap[k];
        if(glEntry) {
          t.gainShort = glEntry.gainShort;
          t.gainLong  = glEntry.gainLong;
        }
      }
    }

                // Populate wallet filter dropdowns
    // Include ORCA ledger wallet labels so the wallet filter works for ORCA rows too
    const txWallets = [...new Set([
      ...allTxs.map(t=>t.wallet),
      ...orcaLedgerData.filter(r=>!r.synthetic).map(r=>r.wallet),
    ].filter(Boolean))].sort();
    populateSelect('tx-wallet',  txWallets);
    populateSelect('gl-wallet',  [...new Set(state.gainLoss.map(r=>r.account))].sort());
    populateSelect('ur-wallet',  [...new Set(unrealized.map(r=>r.wallet))].sort());
  }

  // Always reset all filters to "All" before rendering
  ['tx-token','tx-dir','tx-wallet','tx-search',
   'gl-token','gl-term','gl-wallet',
   'ur-token','ur-wallet','ur-sign'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.value = '';
  });

  setLoading(false);

  const entityLabel = state.entity || 'All entities';
  const periodLabel = isPeriod ? `${fromDate} → ${toDate}` : 'Live balances';
  const totalUSD    = balResults.reduce((s,w)=>s+w.totalUSD,0);
  setStatus(isPeriod ? 'hist' : 'live',
    `${entityLabel} · ${periodLabel} · ${wallets.length} wallets`,
    `Total: ${fmtUSD(totalUSD,0)} USD · ${state.transactions.length} txs`);

  // Save entity status to localStorage for the coverage panel
  saveEntityStatus();

  // Persist transactions, gainLoss, unrealized to localStorage so refresh doesn't lose data
  try {
    const key = `tidelog-state::${state.entity||'all'}`;
    localStorage.setItem(key, JSON.stringify({
      fromDate:     state.fromDate,
      toDate:       state.toDate,
      transactions: state.transactions,
      gainLoss:     state.gainLoss,
      unrealized:   state.unrealized,
      walletData:   state.walletData,
      prices:       state.prices,
      ts:           new Date().toISOString(),
    }));
  } catch(e) { console.warn('Failed to persist state:', e.message); }

  // Auto-save disabled — use Save Snapshot manually when ready to deploy
  state._wasIncremental = false;

  // Defer render so all DOM resets are applied first
  setTimeout(renderAll, 0);
}

function populateSelect(id, values) {
  const sel = document.getElementById(id);
  if(!sel) return;
  sel.innerHTML = '<option value="">All wallets</option>';
  values.forEach(v => { const o=document.createElement('option'); o.value=o.textContent=v; sel.appendChild(o); });
  sel.value = ''; // always reset to "All wallets"
}

// ══════════════════════════════════════════════════════════════════
// RENDER: OVERVIEW
// ══════════════════════════════════════════════════════════════════
function renderOverview() {
  const p = state.prices || {};
  const ENTITIES   = ['Opco','Foundation','Juku','Zagreus'];
  const ENT_COLORS = {Opco:'#0077cc',Foundation:'#0a9e6a',Juku:'#e06b00',Zagreus:'#6b35d9'};
  const TOK_COLORS = {USDC:'#2775CA',USDT:'#26A17B',PYUSD:'#004085',SOL:'#9945FF',ORCA:'#00A8A8',ETH:'#627EEA'};
  const ALL_TOKS   = ['USDC','USDT','PYUSD','SOL','ORCA','ETH'];
  const STABLES    = new Set(['USDC','USDT','PYUSD']);

  function toUSD(tok, amt) {
    if(!amt) return 0;
    if(STABLES.has(tok)) return amt;
    return amt * (p[tok] || 0);
  }

  // Regular fetched wallets (internal entities only)
  const fetched = (state.walletData||[]).filter(w => ENTITIES.includes(w.entity));

  // overviewOnly wallets — use ovOnlyCache if available
  const ovOnlyWallets = ALL_WALLETS.filter(w => w.overviewOnly);
  const ovOnlyData = ovOnlyWallets.map(w => {
    const cached = window._ovOnlyCache?.[w.address];
    return { ...w, balances: cached || {}, _ovOnly: true, _loading: !cached };
  });

  // Combined dataset
  const iData = [...fetched, ...ovOnlyData];

  const modeLabel = state.cutoffDate ? `as of ${state.cutoffDate}` : 'live';
  document.getElementById('overviewTitle').textContent = 'Overview';
  document.getElementById('overviewSub').textContent =
    `Portfolio balances ${modeLabel} · ${iData.length} wallets · SOL $${p.SOL?.toFixed(2)||'—'} · ORCA $${p.ORCA?.toFixed(4)||'—'}`;

  // Grand totals
  const totAll = {};
  ALL_TOKS.forEach(t => { totAll[t] = iData.reduce((s,w)=>s+(w.balances?.[t]||0),0); });
  const grandTotal = ALL_TOKS.reduce((s,t)=>s+toUSD(t,totAll[t]),0);
  const pct = v => grandTotal>0 ? (v/grandTotal*100).toFixed(1) : '0.0';

  // ── Summary cards ─────────────────────────────────────────────────
  const stablesUSD = toUSD('USDC',totAll.USDC)+toUSD('USDT',totAll.USDT)+toUSD('PYUSD',totAll.PYUSD);
  const solUSD   = toUSD('SOL', totAll.SOL);
  const orcaUSD  = toUSD('ORCA',totAll.ORCA);
  const ethUSD   = toUSD('ETH', totAll.ETH);
  
  // ── Revenue KPI ───────────────────────────────────────────────────
  // Manual data from QB Account 40110 - Core Product Revenue
  const revenueData = {
    2025: {
      5: 562342.34 + 349752.70,  // May (2 entries)
      6: 961028.99,              // Jun
      7: 991663.86,              // Jul
      8: 714522.27 + 1219237.81, // Aug (2 entries: wallet + Sardine)
      9: 779485.04,              // Sep
      10: 763582.17,             // Oct
      11: 604374.65,             // Nov
      12: 689910.25,             // Dec
    },
    2026: {
      1: 344482.97,              // Jan
      2: 412176.54,              // Feb
    }
  };
  
  // Calculate YTD for each year
  const revenueYTD = {};
  for (const [year, months] of Object.entries(revenueData)) {
    let ytd = 0;
    for (const val of Object.values(months)) ytd += val;
    revenueYTD[year] = ytd;
  }
  
  const revenueMode = window._revenueKPIMode || 'ytd'; // 'month' or 'ytd'
  const revenueYear = window._revenueKPIYear || 2026; // default to 2026
  const currentMonth = new Date().getMonth() + 1; // 1-12
  
  let revenueValue = 0;
  if (revenueMode === 'ytd') {
    revenueValue = revenueYTD[revenueYear] || 0;
  } else {
    // Month mode - show current month
    revenueValue = revenueData[revenueYear]?.[currentMonth] || 0;
  }
  
  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const revenueLabel = revenueMode === 'month' 
    ? `${monthNames[currentMonth-1]} ${revenueYear}` 
    : `${revenueYear} YTD`;

  document.getElementById('overviewCards').innerHTML = `
    <div class="card" style="border-top:3px solid #06D6A0;cursor:pointer"
         onclick="ovToggleRevenueYear()"
         onmouseover="this.style.boxShadow='0 0 0 2px #06D6A044'" onmouseout="this.style.boxShadow=''">
      <div class="card-label">Revenue · ${revenueLabel} <span style="color:#06D6A0;font-size:0.6rem">⟳</span></div>
      <div class="card-value" style="color:#04a776">${fmtUSD(revenueValue,0)}</div>
      <div class="card-sub">Core Product Revenue · <span style="color:#06D6A0;cursor:pointer" onclick="event.stopPropagation();ovShowRevenueModal()">View breakdown</span></div>
    </div>
    <div class="card" style="border-top:3px solid var(--accent)">
      <div class="card-label">Total Portfolio</div>
      <div class="card-value blue">${fmtUSD(grandTotal,0)}</div>
      <div class="card-sub">${iData.length} wallets · ${ENTITIES.filter(e=>iData.some(w=>w.entity===e)).length} entities</div>
    </div>
    <div class="card" style="border-top:3px solid #2775CA;cursor:pointer"
         onclick="ovToggleDrilldown('stables')"
         onmouseover="this.style.boxShadow='0 0 0 2px #2775CA44'" onmouseout="this.style.boxShadow=''">
      <div class="card-label">Stablecoins <span style="color:#2775CA;font-size:0.6rem">▾</span></div>
      <div class="card-value">${fmtUSD(stablesUSD,0)}</div>
      <div class="card-sub">${pct(stablesUSD)}% · USDC ${fmtNum(totAll.USDC,0)} · USDT ${fmtNum(totAll.USDT,0)}</div>
      <div class="card-bar"><div class="card-bar-fill" style="width:${pct(stablesUSD)}%;background:#2775CA"></div></div>
    </div>
    <div class="card" style="border-top:3px solid #9945FF;cursor:pointer"
         onclick="ovToggleDrilldown('SOL')"
         onmouseover="this.style.boxShadow='0 0 0 2px #9945FF44'" onmouseout="this.style.boxShadow=''">
      <div class="card-label">SOL <span style="color:#9945FF;font-size:0.6rem">▾</span></div>
      <div class="card-value">${fmtUSD(solUSD,0)}</div>
      <div class="card-sub">${pct(solUSD)}% · ${fmtNum(totAll.SOL,2)} SOL · $${p.SOL?.toFixed(2)||'—'}</div>
      <div class="card-bar"><div class="card-bar-fill" style="width:${pct(solUSD)}%;background:#9945FF"></div></div>
    </div>
    <div class="card" style="border-top:3px solid #00A8A8;cursor:pointer"
         onclick="ovToggleDrilldown('ORCA')"
         onmouseover="this.style.boxShadow='0 0 0 2px #00A8A844'" onmouseout="this.style.boxShadow=''">
      <div class="card-label">ORCA <span style="color:#00A8A8;font-size:0.6rem">▾</span></div>
      <div class="card-value">${fmtUSD(orcaUSD,0)}</div>
      <div class="card-sub">${pct(orcaUSD)}% · ${fmtNum(totAll.ORCA,0)} ORCA · $${p.ORCA?.toFixed(4)||'—'}</div>
      <div class="card-bar"><div class="card-bar-fill" style="width:${pct(orcaUSD)}%;background:#00A8A8"></div></div>
    </div>
    ${ethUSD>0?`
    <div class="card" style="border-top:3px solid #627EEA;cursor:pointer"
         onclick="ovToggleDrilldown('ETH')"
         onmouseover="this.style.boxShadow='0 0 0 2px #627EEA44'" onmouseout="this.style.boxShadow=''">
      <div class="card-label">ETH <span style="color:#627EEA;font-size:0.6rem">▾</span></div>
      <div class="card-value">${fmtUSD(ethUSD,0)}</div>
      <div class="card-sub">${pct(ethUSD)}% · ${fmtNum(totAll.ETH,4)} ETH</div>
      <div class="card-bar"><div class="card-bar-fill" style="width:${pct(ethUSD)}%;background:#627EEA"></div></div>
    </div>`:''}`;

  // ── Entity cards ──────────────────────────────────────────────────
  const entCards = ENTITIES.map(ent => {
    const ws = iData.filter(w => w.entity === ent);
    const toks = {};
    ALL_TOKS.forEach(t => { toks[t] = ws.reduce((s,w)=>s+(w.balances?.[t]||0),0); });
    const total = ALL_TOKS.reduce((s,t)=>s+toUSD(t,toks[t]),0);
    if(!total && !ws.length) return '';
    const c = ENT_COLORS[ent]||'#888';
    const entPct = pct(total);
    const activeToks = ALL_TOKS.filter(t=>toks[t]>0);

    // "All Wallets" button + individual token buttons
    const btnAll = `
      <button onclick="event.stopPropagation();ovToggleDrilldown('entity:${ent}:all')"
        style="font-family:var(--mono);font-size:0.62rem;padding:3px 9px;border-radius:4px;
               border:1px solid ${c}55;background:${c}12;color:${c};cursor:pointer;font-weight:600;
               transition:background 0.15s"
        onmouseover="this.style.background='${c}25'" onmouseout="this.style.background='${c}12'">
        All ›
      </button>`;

    const tokRows = activeToks.map(t => {
      const tc  = TOK_COLORS[t]||'#888';
      const usd = toUSD(t, toks[t]);
      return `
        <div onclick="event.stopPropagation();ovToggleDrilldown('entity:${ent}:${t}')"
             style="display:flex;align-items:center;gap:8px;padding:5px 6px;border-radius:5px;
                    border-bottom:1px solid var(--border);cursor:pointer;transition:background 0.12s"
             onmouseover="this.style.background='${tc}10'" onmouseout="this.style.background=''">
          <span style="font-family:var(--mono);font-size:0.65rem;font-weight:700;padding:1px 6px;
                       border-radius:3px;background:${tc}18;color:${tc};min-width:40px;text-align:center">${t}</span>
          <span style="font-family:var(--mono);font-size:0.72rem;flex:1">${fmtNum(toks[t], t==='SOL'||t==='ETH'?4:2)}</span>
          <span style="font-family:var(--mono);font-size:0.7rem;color:var(--accent);min-width:72px;text-align:right">${fmtUSD(usd,0)}</span>
          <span style="font-family:var(--mono);font-size:0.62rem;color:var(--muted);min-width:36px;text-align:right">${(usd/grandTotal*100).toFixed(1)}%</span>
          <span style="font-family:var(--mono);font-size:0.65rem;color:var(--muted)">›</span>
        </div>`;
    }).join('');

    const hasOvOnly = ws.some(w=>w._ovOnly);
    const loadingBadge = hasOvOnly && ws.some(w=>w._loading)
      ? `<span style="font-family:var(--mono);font-size:0.6rem;color:var(--orange);margin-left:4px">⟳ fetching…</span>` : '';

    return `
      <div class="card" style="border-top:3px solid ${c}">
        <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:4px">
          <span style="font-family:var(--mono);font-size:0.85rem;font-weight:700;color:${c}">${ent}</span>
          ${loadingBadge}
          <span style="font-family:var(--mono);font-size:0.62rem;color:var(--muted);margin-left:auto">${ws.length} wallets</span>
          <span style="font-family:var(--mono);font-size:0.62rem;color:var(--muted)">${entPct}% of portfolio</span>
        </div>
        <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:8px">
          <span style="font-family:var(--mono);font-size:1.25rem;font-weight:600">${fmtUSD(total,0)}</span>
          ${btnAll}
        </div>
        <div class="card-bar" style="margin-bottom:12px"><div class="card-bar-fill" style="width:${entPct}%;background:${c}"></div></div>
        ${tokRows}
      </div>`;
  }).filter(Boolean).join('');

  // overviewOnly fetch status
  const ovStatus = ovOnlyWallets.length ? (() => {
    const loaded = ovOnlyWallets.filter(w => window._ovOnlyCache?.[w.address]).length;
    if(loaded === ovOnlyWallets.length) return '';
    return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;padding:8px 12px;
              background:var(--surface);border:1px solid var(--border);border-radius:6px;
              font-family:var(--mono);font-size:0.7rem;color:var(--muted)">
      <span style="color:var(--orange)">⟳</span>
      Fetching balances for ${ovOnlyWallets.length - loaded} overview-only wallets…
      <button onclick="ovFetchOnlyWallets()" style="margin-left:auto;font-family:var(--mono);font-size:0.65rem;
        padding:2px 8px;border-radius:4px;border:1px solid var(--border);background:var(--surface2);
        color:var(--accent);cursor:pointer">Fetch now</button>
    </div>`;
  })() : '';

  document.getElementById('ovMainBody').innerHTML = `
    ${ovStatus}
    <div style="margin-bottom:8px;font-family:var(--mono);font-size:0.62rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted)">By Entity</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;margin-bottom:24px">${entCards}</div>`;

  if(window._ovDrillKey) ovRenderDrilldown(window._ovDrillKey);
}

// ── Fetch overviewOnly wallet balances (live, no history) ─────────────────
window._ovOnlyCache = window._ovOnlyCache || {};

async function ovFetchOnlyWallets() {
  const wallets = ALL_WALLETS.filter(w => w.overviewOnly);
  for(const w of wallets) {
    if(window._ovOnlyCache[w.address]) continue;
    try {
      const url = `${PROXY_BASE}/proxy/helius/rpc`;
      const res = await fetch(url, {
        method:'POST', headers:authHeaders({'Content-Type':'application/json'}),
        credentials:'include',
        body: JSON.stringify({jsonrpc:'2.0',id:1,method:'getAssetsByOwner',
          params:{ownerAddress:w.address,displayOptions:{showFungible:true},page:1,limit:100}})
      });
      const json = await res.json();
      const bals = {};
      (json.result?.items||[]).forEach(item => {
        const sym = item.content?.metadata?.symbol || item.id;
        const decimals = item.token_info?.decimals ?? 0;
        const raw = item.token_info?.balance ?? 0;
        const amt = raw / Math.pow(10, decimals);
        if(amt > 0.001) bals[sym] = (bals[sym]||0) + amt;
      });
      // Also get SOL
      const solRes = await fetch(url, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({jsonrpc:'2.0',id:2,method:'getBalance',params:[w.address]})
      });
      const solJson = await solRes.json();
      const solAmt = (solJson.result?.value||0) / 1e9;
      if(solAmt > 0.001) bals.SOL = solAmt;
      window._ovOnlyCache[w.address] = bals;
    } catch(e) {
      window._ovOnlyCache[w.address] = {};
    }
    renderOverview();
  }
}

// Auto-fetch overviewOnly on tab open
const _origRenderOverview = null;

// ── Export Overview to Excel ──────────────────────────────────────────────
function exportOverviewExcel() {
  const ENTITIES   = ['Opco','Foundation','Juku','Zagreus'];
  const ALL_TOKS   = ['USDC','USDT','PYUSD','SOL','ORCA','ETH'];
  const STABLES    = new Set(['USDC','USDT','PYUSD']);
  const p          = state.prices || {};

  function toUSD(tok, amt) {
    if(!amt) return 0;
    if(STABLES.has(tok)) return amt;
    return amt * (p[tok] || 0);
  }

  const fetched  = (state.walletData||[]).filter(w => ENTITIES.includes(w.entity));
  const ovOnly   = ALL_WALLETS.filter(w => w.overviewOnly).map(w => ({
    ...w, balances: window._ovOnlyCache?.[w.address] || {}
  }));
  const iData    = [...fetched, ...ovOnly];
  const grandTotal = ALL_TOKS.reduce((s,t)=>s+iData.reduce((ss,w)=>ss+toUSD(t,w.balances?.[t]||0),0),0);

  const rows = [
    ['Tidelog — Portfolio Overview', '', '', '', '', '', '', '', '', ''],
    ['Generated', new Date().toISOString().slice(0,16).replace('T',' '), '', '', '', '', '', '', '', ''],
    ['Mode', state.cutoffDate ? `Historical: ${state.cutoffDate}` : 'Live', '', '', '', '', '', '', '', ''],
    ['SOL Price', p.SOL||'—', 'ORCA Price', p.ORCA||'—', '', '', '', '', '', ''],
    [],
    ['Entity', 'Wallet', 'Address', 'Total USD', 'USDC', 'USDT', 'PYUSD', 'SOL', 'ORCA (qty)', 'ORCA (USD)', 'ETH', '% Portfolio'],
  ];

  const sorted = [...iData]
    .map(w => ({...w, _usd: ALL_TOKS.reduce((s,t)=>s+toUSD(t,w.balances?.[t]||0),0)}))
    .sort((a,b) => (a.entity||'').localeCompare(b.entity||'') || b._usd - a._usd);

  sorted.forEach(w => {
    const b = w.balances || {};
    rows.push([
      w.entity || '—',
      w.label  || '—',
      w.address|| '—',
      w._usd,
      b.USDC  || 0,
      b.USDT  || 0,
      b.PYUSD || 0,
      b.SOL   || 0,
      b.ORCA  || 0,
      toUSD('ORCA', b.ORCA || 0),
      b.ETH   || 0,
      grandTotal > 0 ? +(w._usd/grandTotal*100).toFixed(2) : 0,
    ]);
  });

  // Entity subtotals
  rows.push([]);
  rows.push(['ENTITY TOTALS', '', '', '', '', '', '', '', '', '', '', '']);
  ENTITIES.forEach(ent => {
    const ws = iData.filter(w=>w.entity===ent);
    const toks = {};
    ALL_TOKS.forEach(t => { toks[t] = ws.reduce((s,w)=>s+(w.balances?.[t]||0),0); });
    const total = ALL_TOKS.reduce((s,t)=>s+toUSD(t,toks[t]),0);
    if(!total) return;
    rows.push([ent,'','',total,toks.USDC||0,toks.USDT||0,toks.PYUSD||0,toks.SOL||0,toks.ORCA||0,toUSD('ORCA',toks.ORCA||0),toks.ETH||0,
      grandTotal>0?+(total/grandTotal*100).toFixed(2):0]);
  });
  rows.push(['TOTAL','','',grandTotal,'','','','','','','',100]);

  // Build workbook via SheetJS
  const ws2 = XLSX.utils.aoa_to_sheet(rows);
  // Column widths
  ws2['!cols'] = [14,28,46,14,12,12,12,12,12,12,12,12].map(w=>({wch:w}));
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws2, 'Overview');
  const date = new Date().toISOString().slice(0,10);
  XLSX.writeFile(wb, `tidelog_overview_${date}.xlsx`);
}

// ── Drilldown ─────────────────────────────────────────────────────────────
window._ovDrillKey = null;

function ovToggleDrilldown(key) {
  if(window._ovDrillKey === key) {
    window._ovDrillKey = null;
    document.getElementById('ovDrilldown').innerHTML = '';
  } else {
    window._ovDrillKey = key;
    ovRenderDrilldown(key);
  }
}

function ovRenderDrilldown(key) {
  const ENTITIES   = ['Opco','Foundation','Juku','Zagreus'];
  const ENT_COLORS = {Opco:'#0077cc',Foundation:'#0a9e6a',Juku:'#e06b00',Zagreus:'#6b35d9'};
  const TOK_COLORS = {USDC:'#2775CA',USDT:'#26A17B',PYUSD:'#004085',SOL:'#9945FF',ORCA:'#00A8A8',ETH:'#627EEA'};
  const ALL_TOKS   = ['USDC','USDT','PYUSD','SOL','ORCA','ETH'];
  const STABLES    = new Set(['USDC','USDT','PYUSD']);
  const p = state.prices || {};

  function toUSD(tok, amt) {
    if(!amt) return 0;
    if(STABLES.has(tok)) return amt;
    return amt * (p[tok] || 0);
  }

  // Combined dataset: fetched + overviewOnly
  const fetched   = (state.walletData||[]).filter(w => ENTITIES.includes(w.entity));
  const ovOnly    = ALL_WALLETS.filter(w => w.overviewOnly).map(w => ({
    ...w, balances: window._ovOnlyCache?.[w.address] || {}
  }));
  const iData = [...fetched, ...ovOnly];

  const grandTotal = ALL_TOKS.reduce((s,t)=>s+iData.reduce((ss,w)=>ss+toUSD(t,w.balances?.[t]||0),0),0);

  // ── parse key ─────────────────────────────────────────────────────
  // formats: 'stables' | 'SOL' | 'ORCA' | 'ETH'
  //          'entity:Opco:all' | 'entity:Opco:USDC' | 'entity:Opco:SOL' ...
  let title, accentColor, wallets, filterToks, showEntityCol = false;

  if(key.startsWith('entity:')) {
    const parts = key.split(':');   // ['entity', 'Opco', 'all'|tok]
    const ent   = parts[1];
    const tok   = parts[2];         // 'all' or specific token
    const c     = ENT_COLORS[ent]||'#888';
    accentColor = c;
    wallets     = iData.filter(w => w.entity === ent);

    if(tok === 'all') {
      title      = `${ent} — All Wallets`;
      filterToks = ALL_TOKS;
    } else if(tok === 'stables') {
      title      = `${ent} — Stablecoins`;
      accentColor= '#2775CA';
      filterToks = ['USDC','USDT','PYUSD'];
      wallets    = wallets.filter(w => filterToks.some(t=>(w.balances?.[t]||0)>0));
    } else {
      title      = `${ent} — ${tok}`;
      accentColor= TOK_COLORS[tok]||c;
      filterToks = [tok];
      wallets    = wallets.filter(w => (w.balances?.[tok]||0)>0);
    }
  } else if(key === 'stables') {
    title       = 'Stablecoins — All Entities';
    accentColor = '#2775CA';
    filterToks  = ['USDC','USDT','PYUSD'];
    wallets     = iData.filter(w => filterToks.some(t=>(w.balances?.[t]||0)>0));
    showEntityCol = true;
  } else {
    title       = `${key} — All Entities`;
    accentColor = TOK_COLORS[key]||'var(--accent)';
    filterToks  = [key];
    wallets     = iData.filter(w => (w.balances?.[key]||0)>0);
    showEntityCol = true;
  }

  const sorted = [...wallets]
    .map(w => ({...w, _usd: filterToks.reduce((s,t)=>s+toUSD(t,w.balances?.[t]||0),0)}))
    .sort((a,b) => b._usd - a._usd);
  const subtotal = sorted.reduce((s,w)=>s+w._usd,0);

  const showToks = filterToks.length > 1
    ? filterToks.filter(t => wallets.some(w=>(w.balances?.[t]||0)>0))
    : filterToks;

  const thToks = showToks.map(t =>
    `<th class="num" style="color:${TOK_COLORS[t]||'var(--muted)'}">${t}</th>`
  ).join('');

  const rows = sorted.map(w => {
    const entC = ENT_COLORS[w.entity]||'#888';
    const tokCells = showToks.map(t => {
      const amt = w.balances?.[t]||0;
      const usd = toUSD(t,amt);
      if(!amt) return `<td class="num" style="color:var(--muted)">—</td>`;
      const tc = TOK_COLORS[t]||'#888';
      return `<td class="num">
        <div style="font-family:var(--mono);font-size:0.73rem;color:${tc};font-weight:600">${fmtNum(amt, t==='SOL'||t==='ETH'?4:0)}</div>
        ${STABLES.has(t)?'':`<div style="font-family:var(--mono);font-size:0.61rem;color:var(--muted)">${fmtUSD(usd,0)}</div>`}
      </td>`;
    }).join('');
    const rowPct = subtotal>0?(w._usd/subtotal*100).toFixed(1):'0.0';
    return `<tr style="cursor:pointer" data-addr="${w.address}" data-label="${(w.label||w.address).replace(/"/g,'&quot;')}" onclick="ovShowTrend(this.dataset.addr,this.dataset.label)" onmouseover="this.style.background='var(--hover)'" onmouseout="this.style.background=''">
      <td>
        <div style="font-family:var(--mono);font-size:0.73rem;font-weight:600">${w.label||'—'}</div>
        <div style="font-family:var(--mono);font-size:0.61rem;color:var(--muted)">${w.address?.slice(0,8)}…${w.address?.slice(-6)}</div>
      </td>
      ${showEntityCol?`<td><span style="padding:2px 7px;border-radius:4px;font-size:0.65rem;font-family:var(--mono);font-weight:600;background:${entC}18;color:${entC}">${w.entity}</span></td>`:''}
      <td class="num" style="font-family:var(--mono);font-weight:700;color:var(--accent)">${fmtUSD(w._usd,0)}</td>
      ${tokCells}
      <td class="num">
        <div style="display:flex;align-items:center;gap:5px;justify-content:flex-end">
          <div style="width:36px;height:3px;background:var(--border);border-radius:2px;overflow:hidden">
            <div style="height:100%;width:${Math.min(parseFloat(rowPct),100)}%;background:${accentColor};border-radius:2px"></div>
          </div>
          <span style="font-family:var(--mono);font-size:0.65rem;color:var(--muted)">${rowPct}%</span>
        </div>
      </td>
    </tr>`;
  }).join('');

  document.getElementById('ovDrilldown').innerHTML = `
    <div style="background:var(--surface);border:1px solid var(--border);border-top:3px solid ${accentColor};
                border-radius:var(--radius);padding:18px 20px;box-shadow:var(--shadow);margin-bottom:24px">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
        <span style="font-family:var(--mono);font-size:0.92rem;font-weight:700;color:${accentColor}">${title}</span>
        <span style="font-family:var(--mono);font-size:0.68rem;color:var(--muted)">${sorted.length} wallets</span>
        <span style="font-family:var(--mono);font-size:0.92rem;font-weight:600;color:var(--text);margin-left:auto">${fmtUSD(subtotal,0)}</span>
        <span style="font-family:var(--mono);font-size:0.68rem;color:var(--muted)">${grandTotal>0?(subtotal/grandTotal*100).toFixed(1):0}% of portfolio</span>
        <button onclick="ovToggleDrilldown('${key}')"
          style="font-family:var(--mono);font-size:0.7rem;padding:3px 10px;border-radius:5px;
                 border:1px solid var(--border);background:var(--surface2);color:var(--muted);cursor:pointer">✕ Close</button>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr>
            <th>Wallet</th>
            ${showEntityCol?'<th>Entity</th>':''}
            <th class="num">Total USD</th>
            ${thToks}
            <th class="num">%</th>
          </tr></thead>
          <tbody>${rows||`<tr><td colspan="10" style="color:var(--muted);padding:24px;text-align:center">No wallets with this token</td></tr>`}</tbody>
        </table>
      </div>
    </div>`;
}

// ── Revenue KPI Functions ─────────────────────────────────────────────────
function ovToggleRevenueYear() {
  // Toggle between 2025 and 2026
  window._revenueKPIYear = window._revenueKPIYear === 2025 ? 2026 : 2025;
  renderOverview(); // Re-render to update the card
}

function ovShowRevenueModal() {
  // Revenue data (same as in renderOverview)
  const revenueData = {
    2025: {
      5: 912095.04,    // May (562342.34 + 349752.70)
      6: 961028.99,    // Jun
      7: 991663.86,    // Jul
      8: 1933760.08,   // Aug (714522.27 + 1219237.81)
      9: 779485.04,    // Sep
      10: 763582.17,   // Oct
      11: 604374.65,   // Nov
      12: 689910.25    // Dec
    },
    2026: {
      1: 344482.97,    // Jan
      2: 412176.54     // Feb
    }
  };
  
  const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const revenueYear = window._revenueKPIYear || 2026;
  const yearData = revenueData[revenueYear] || {};
  
  let rows = '';
  let ytdTotal = 0;
  
  for (let m = 1; m <= 12; m++) {
    const revenue = yearData[m] || 0;
    ytdTotal += revenue;
    
    const hasData = revenue > 0;
    const rowStyle = hasData ? '' : 'opacity:0.4';
    
    rows += `<tr style="${rowStyle}">
      <td style="font-family:var(--mono);font-size:0.8rem">${monthNames[m-1]}</td>
      <td class="num" style="font-family:var(--mono);font-size:0.8rem;font-weight:600;color:${hasData?'#04a776':'var(--muted)'}">${hasData?fmtUSD(revenue,0):'—'}</td>
    </tr>`;
  }
  
  // Show modal
  const modal = document.getElementById('pnl-gl-modal') || createGenericModal();
  const title = document.getElementById('pnl-gl-modal-title');
  const body = document.getElementById('pnl-gl-modal-body');
  const tot = document.getElementById('pnl-gl-modal-total');
  
  if (title) title.textContent = `Core Product Revenue — ${revenueYear}`;
  if (tot) {
    tot.textContent = `${revenueYear} YTD: ${fmtUSD(ytdTotal,0)}`;
    tot.style.color = '#04a776';
  }
  
  if (body) body.innerHTML = `
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="text-align:left">Month</th>
            <th class="num">Revenue</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;
  
  if (modal) modal.style.display = 'block';
}

function createGenericModal() {
  // Fallback if modal doesn't exist
  const m = document.createElement('div');
  m.id = 'pnl-gl-modal';
  m.style.cssText = 'display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;overflow:auto';
  m.innerHTML = `<div style="background:var(--surface);margin:5% auto;padding:24px;max-width:600px;border-radius:8px">
    <div style="display:flex;justify-content:space-between;margin-bottom:16px">
      <h3 id="pnl-gl-modal-title" style="margin:0"></h3>
      <button onclick="document.getElementById('pnl-gl-modal').style.display='none'" style="cursor:pointer">✕</button>
    </div>
    <div id="pnl-gl-modal-total" style="font-size:1.2rem;font-weight:700;margin-bottom:16px"></div>
    <div id="pnl-gl-modal-body"></div>
  </div>`;
  document.body.appendChild(m);
  return m;
}

function entityBadge(e) {
  const colors = {Juku:'#e06b00',Opco:'#0077cc',Foundation:'#0a9e6a',Zagreus:'#6b35d9'};
  const c = colors[e] || '#888';
  return e ? `<span style="display:inline-block;padding:2px 8px;border-radius:4px;font-size:0.65rem;font-family:var(--mono);font-weight:600;background:${c}18;color:${c}">${e}</span>` : '—';
}

// ══════════════════════════════════════════════════════════════════
// RENDER: WALLETS TAB
// ══════════════════════════════════════════════════════════════════
function renderWallets() {
  const entity = document.getElementById('w-filter-entity').value;
  const chain  = document.getElementById('w-filter-chain').value;
  const type   = document.getElementById('w-filter-type').value;
  const search = document.getElementById('w-search').value.toLowerCase();

  const data = ALL_WALLETS.filter(w => {
    if(type === 'internal' && w.external) return false;
    if(type === 'external' && !w.external) return false;
    if(entity && w.entity !== entity) return false;
    if(chain  && w.chain  !== chain)  return false;
    if(search && !w.label.toLowerCase().includes(search) && !w.address.toLowerCase().includes(search)) return false;
    return true;
  });

  document.getElementById('walletsTbody').innerHTML = data.map(w => `
    <tr style="${w.external ? 'opacity:0.7' : ''}">
      <td class="label">${w.label}</td>
      <td>${entityBadge(w.entity)}</td>
      <td><span class="chain-tag">${w.chain}</span></td>
      <td class="muted" style="font-family:var(--mono);font-size:0.68rem">${(()=>{
        const addr = w.address;
        const tokenMap = GL_CODE_MAP[addr];
        if(tokenMap && Object.keys(tokenMap).length > 0) {
          return Object.entries(tokenMap)
            .map(([tok, gl]) => `<span title="${tok}" style="display:inline-block;margin:1px 2px 1px 0">${gl}<span style="font-size:0.6rem;color:var(--muted);margin-left:2px">${tok}</span></span>`)
            .join('<br>');
        }
        return w.accountCode || '—';
      })()}</td>
      <td><span style="font-size:0.68rem;padding:2px 7px;border-radius:4px;font-family:var(--mono);background:${w.external ? 'rgba(150,150,150,0.15)' : 'rgba(var(--accent-rgb,99,179,237),0.12)'};color:${w.external ? 'var(--muted)' : 'var(--accent)'}">${w.external ? 'External' : 'Internal'}</span></td>
      <td><span style="font-family:var(--mono);font-size:0.68rem;color:var(--muted)">${w.address}</span></td>
    </tr>
  `).join('');
}

// ══════════════════════════════════════════════════════════════════
// RENDER: TRANSACTIONS (placeholder — from Excel data or future Helius tx fetch)
// ══════════════════════════════════════════════════════════════════
let _txDebTimer = null;
function _txDebounce() { clearTimeout(_txDebTimer); _txDebTimer = setTimeout(renderTx, 180); }
let _wDebTimer = null;
function _wDebounce()  { clearTimeout(_wDebTimer);  _wDebTimer  = setTimeout(renderWallets, 180); }

// ── Virtual scroll state ─────────────────────────────────────────────────
const _txVS = { data: [], rowH: 34, visibleRows: 20, scrollTop: 0, renderFrom: 0 };


// ── TX checkbox selection ─────────────────────────────────────────
function txToggleHash(hash, checked) {
  if(!_qb.selectedHashes) _qb.selectedHashes = new Set();
  if(checked) _qb.selectedHashes.add(hash);
  else         _qb.selectedHashes.delete(hash);
  const allBox = document.getElementById('txSelectAll');
  if(allBox) {
    const visible = (_txVS?.data || []).map(r => r.txHash).filter(Boolean);
    const allChecked = visible.length > 0 && visible.every(h => _qb.selectedHashes.has(h));
    const anyChecked = visible.some(h => _qb.selectedHashes.has(h));
    allBox.checked = allChecked;
    allBox.indeterminate = !allChecked && anyChecked;
  }
}
function txToggleSelectAll(checked) {
  if(!_qb.selectedHashes) _qb.selectedHashes = new Set();
  const visible = (_txVS?.data || []).map(r => r.txHash).filter(Boolean);
  visible.forEach(h => checked ? _qb.selectedHashes.add(h) : _qb.selectedHashes.delete(h));
  renderTx();
}
function renderTx() {
  const token    = document.getElementById('tx-token').value;
  const dir      = document.getElementById('tx-dir').value;
  const wallet   = document.getElementById('tx-wallet').value;
  const search   = document.getElementById('tx-search').value.toLowerCase();
  const monthF   = document.getElementById('tx-month').value;
  const qbStatus = document.getElementById('tx-qb-status')?.value || '';

  const fromTs = state.fromDate ? Math.floor(new Date(state.fromDate+'T00:00:00Z').getTime()/1000) : 0;
  const toTs   = state.toDate   ? Math.floor(new Date(state.toDate  +'T23:59:59Z').getTime()/1000) : Infinity;

  const nonOrcaTxs = state.transactions.filter(t => (t.asset || t.token) !== 'ORCA');
  const orcaInLedgerForPeriod = orcaLedgerData.filter(
    r => !r.synthetic && r.blockTime >= fromTs && r.blockTime <= toTs
  );
  const orcaFallbackTxs = orcaInLedgerForPeriod.length === 0
    ? state.transactions.filter(t => (t.asset || t.token) === 'ORCA')
    : [];
  const orcaFromLedger = orcaInLedgerForPeriod.map(r => {
    const glKey = (r.txHash||'') + '::' + (r.walletAddr||'');
    const gl = orcaLedgerGLMap[glKey] || {};
    return {
      date:        r.date instanceof Date ? r.date : new Date(typeof r.date === 'number' ? r.date * 1000 : r.date),
      blockTime:   r.blockTime, wallet: r.wallet, walletAddr: r.walletAddr,
      asset: 'ORCA', dir: r.dir, qty: r.qty, price: r.price, usd: r.usd,
      gainShort: gl.gainShort || 0, gainLong: gl.gainLong || 0,
      category: r.internal ? 'TRANSFER' : 'TRADE', txHash: r.txHash,
      priceSource: r.price > 0 ? 'ledger' : '', counterparty: r.counterparty, _fromLedger: true,
    };
  });

  const allTxData = [...nonOrcaTxs, ...orcaFromLedger, ...orcaFallbackTxs];
  populateMonthSelect('tx-month', allTxData.map(t => t.date));

  const txEntityAddrs = state.entity ? new Set(ALL_WALLETS.filter(w=>w.entity===state.entity).map(w=>w.address)) : null;
  const _posted  = qbStatus ? qbGetPosted() : null;
  let data = allTxData.filter(t => {
    if(txEntityAddrs && !txEntityAddrs.has(t.walletAddr)) return false;
    if(token  && (t.asset||t.token)  !== token)  return false;
    if(dir    && t.dir    !== dir)    return false;
    if(wallet && t.wallet !== wallet) return false;
    if(monthF && _monthKey(t.date) !== monthF) return false;
    if(search && !(t.txHash||'').toLowerCase().includes(search) &&
                 !(t.wallet||'').toLowerCase().includes(search) &&
                 !((t.asset||t.token||'')).toLowerCase().includes(search)) return false;
    if(qbStatus === 'posted'     && !_posted.has(t.txHash)) return false;
    if(qbStatus === 'not_posted' &&  _posted.has(t.txHash)) return false;
    return true;
  });

  data = sortData(data, state.txSort.col, state.txSort.dir);
  document.getElementById('txCount').textContent = `${data.length.toLocaleString()} transactions`;

  // ── summary cards ──
  const totalIn  = data.filter(t=>t.dir==='In').reduce((s,t)=>s+Math.abs(t.usd||0),0);
  const totalOut = data.filter(t=>t.dir==='Out').reduce((s,t)=>s+Math.abs(t.usd||0),0);
  const totalST  = data.reduce((s,t)=>s+(t.gainShort||0),0);
  const totalLT  = data.reduce((s,t)=>s+(t.gainLong||0),0);
  document.getElementById('txCards').innerHTML = `
    <div class="card"><div class="card-label">Inflows</div><div class="card-value green">${fmtUSD(totalIn,0)}</div></div>
    <div class="card"><div class="card-label">Outflows</div><div class="card-value red">${fmtUSD(totalOut,0)}</div></div>
    <div class="card"><div class="card-label">ST Gain (on tx)</div><div class="card-value ${totalST>=0?'green':'red'}">${totalST>=0?'+':''}${fmtUSD(totalST)}</div></div>
    <div class="card"><div class="card-label">LT Gain (on tx)</div><div class="card-value ${totalLT>=0?'green':'red'}">${totalLT>=0?'+':''}${fmtUSD(totalLT)}</div></div>`;

  // ── empty state ──
  if(!data.length) {
    document.getElementById('txTbody').innerHTML = `<tr><td colspan="14" style="padding:32px;text-align:center;color:var(--muted);font-family:var(--sans);font-size:0.82rem">
      ${state.transactions.length === 0
        ? '⚠️ Select <strong>Period</strong> mode and click <strong>Fetch Data</strong> to load transactions.'
        : 'No transactions match the current filters.'}</td></tr>`;
    document.getElementById('txTotalsBody').innerHTML = '';
    document.getElementById('txVPad').style.paddingTop = '0';
    document.getElementById('txVPad').style.paddingBottom = '0';
    return;
  }

  // ── totals row (always rendered, pinned at bottom) ──
  const txPeriodStart = state.fromDate ? new Date(state.fromDate + 'T00:00:00Z').getTime()/1000 : 0;
  const totalQtyIn  = data.filter(t=>t.dir==='In').reduce((s,t)=>s+(t.qty||0),0);
  const totalQtyOut = data.filter(t=>t.dir==='Out').reduce((s,t)=>s+(t.qty||0),0);
  const totalUSDIn  = data.filter(t=>t.dir==='In').reduce((s,t)=>s+(t.usd||0),0);
  const totalUSDOut = data.filter(t=>t.dir==='Out').reduce((s,t)=>s+(t.usd||0),0);
  const totalST2    = data.reduce((s,t)=>s+(t.gainShort||0),0);
  const totalLT2    = data.reduce((s,t)=>s+(t.gainLong||0),0);
  const netQty      = totalQtyIn - totalQtyOut;
  const netUSD      = totalUSDIn - totalUSDOut;
  document.getElementById('txTotalsBody').innerHTML = `
    <tr style="font-weight:600;background:var(--surface2);font-size:0.72rem">
      <td class="muted" style="padding:7px 12px;font-size:0.65rem;letter-spacing:0.05em">TOTAL</td>
      <td colspan="6"></td>
      <td class="num ${netQty>=0?'gain-pos':'gain-neg'}" style="padding:7px 12px">${netQty>=0?'+':''}${fmtNum(netQty,2)}</td>
      <td class="num muted" style="padding:7px 12px"></td>
      <td class="num ${netUSD>=0?'':'gain-neg'}" style="padding:7px 12px">${netUSD>=0?'':'-'}${fmtUSD(Math.abs(netUSD))}</td>
      <td class="num ${totalST2>=0?'gain-pos':'gain-neg'}" style="padding:7px 12px">${totalST2!==0?(totalST2>0?'+':'')+fmtUSD(totalST2):'—'}</td>
      <td class="num ${totalLT2>=0?'gain-pos':'gain-neg'}" style="padding:7px 12px">${totalLT2!==0?(totalLT2>0?'+':'')+fmtUSD(totalLT2):'—'}</td>
      <td colspan="2"></td>
    </tr>`;

  // ── virtual scroll setup ──
  _txVS.data = data;
  _txVS.txPeriodStart = txPeriodStart;

  const vscroll = document.getElementById('txVScroll');
  const rowH = _txVS.rowH;
  const totalH = data.length * rowH;

  // Attach scroll listener once
  if(!vscroll._vsAttached) {
    vscroll._vsAttached = true;
    vscroll.addEventListener('scroll', () => {
      _txVS.scrollTop = vscroll.scrollTop;
      _txVsRender();
    }, { passive: true });
  }

  // Reset scroll on new dataset
  vscroll.scrollTop = 0;
  _txVS.scrollTop = 0;
  document.getElementById('txVPad').style.height = totalH + 'px';
  document.getElementById('txVPad').style.position = 'relative';

  _txVsRender();
}

function _txVsRender() {
  const { data, rowH, txPeriodStart } = _txVS;
  if(!data.length) return;

  const vscroll  = document.getElementById('txVScroll');
  const viewH    = vscroll.clientHeight || 560;
  const scrollTop= _txVS.scrollTop;

  // Add buffer of 5 rows above/below
  const firstRow  = Math.max(0, Math.floor(scrollTop / rowH) - 5);
  const lastRow   = Math.min(data.length - 1, Math.ceil((scrollTop + viewH) / rowH) + 5);
  const visCount  = lastRow - firstRow + 1;

  const tbody = document.getElementById('txTbody');
  tbody.style.transform = `translateY(${firstRow * rowH}px)`;

  const posted = qbGetPosted();
  tbody.innerHTML = data.slice(firstRow, lastRow + 1).map(t => {
    const dirCls   = t.dir==='In' ? 'gain-pos' : 'gain-neg';
    const walletName = walletLabel(t.walletAddr) || t.wallet || '—';
    const hashFull   = t.txHash || '';
    const hashShort  = hashFull ? hashFull.slice(0,8)+'…'+hashFull.slice(-4) : '—';
    const hashLink   = hashFull
      ? `<a href="https://solscan.io/tx/${hashFull}" target="_blank"
            style="font-family:var(--mono);font-size:0.63rem;color:var(--accent);text-decoration:none"
            title="${hashFull}">${hashShort}</a>` : '—';

    let cpCell = '—';
    if(t.counterparty) {
      const cpName  = walletLabel(t.counterparty);
      const cpShort = t.counterparty.slice(0,6)+'…'+t.counterparty.slice(-4);
      const cpLink  = `https://solscan.io/account/${t.counterparty}`;
      cpCell = cpName
        ? `<a href="${cpLink}" target="_blank" style="text-decoration:none;color:var(--text)" title="${t.counterparty}"><span style="font-size:0.74rem;font-weight:500;overflow:hidden;text-overflow:ellipsis;display:block;white-space:nowrap">${cpName}</span><span class="wallet-addr">${cpShort}</span></a>`
        : `<a href="${cpLink}" target="_blank" style="font-family:var(--mono);font-size:0.64rem;color:var(--muted);text-decoration:none" title="${t.counterparty}">${cpShort}</a>`;
    }

    const glEntry    = state.gainLoss?.find(g => g.txHash === t.txHash);
    const glAcqTs    = glEntry?.acqDate ? (glEntry.acqDate instanceof Date ? glEntry.acqDate.getTime()/1000 : new Date(glEntry.acqDate).getTime()/1000) : null;
    const txAcqWarn  = txPeriodStart > 0 && glAcqTs && glAcqTs < txPeriodStart;

    const addr  = t.walletAddr || '';
    const asset = t.asset || t.token || '';
    const tokenGL  = GL_CODE_MAP[addr]?.[asset];
    const walletGL = ALL_WALLETS.find(w=>w.address===addr)?.accountCode;
    const glCode   = tokenGL || walletGL || '—';

    // ── Counterparty GL ──────────────────────────────────────────
    const cpAddr   = t.counterparty || '';
    const cpTokenGL  = GL_CODE_MAP[cpAddr]?.[asset];
    const cpWalletGL = ALL_WALLETS.find(w=>w.address===cpAddr)?.accountCode;
    const cpGLCode   = cpTokenGL || cpWalletGL || null;

    // CP GL cell: known → show code; unknown → dropdown (QB accounts or empty)
    const cpGLCell = (() => {
      const hashKey  = hashFull + '::cpgl';
      const stored   = window._txCpGlOverrides?.[hashKey];
      // Check cpglmem (saved from previous posts) for this counterparty
      const txEnt    = ALL_WALLETS.find(w=>w.address===addr)?.entity || 'Opco';
      const memKey   = 'cpglmem::' + txEnt + '::' + (cpAddr||'__none__');
      const memGL    = (() => { try { return localStorage.getItem(memKey)||''; } catch(e){ return ''; } })();
      const current  = stored || cpGLCode || memGL || '';
      const glMap   = _qb?.glAccountMap || _qb?.glAccountMapByEntity?.[txEnt] || {};
      const glKeys  = Object.keys(glMap).filter(k => !k.startsWith('id:')).sort((a,b) => { const fa=a[0]||'0', fb=b[0]||'0'; return fa!==fb ? fa.localeCompare(fb) : a.localeCompare(b,undefined,{numeric:true}); });

      if(cpGLCode && !stored && !memGL) {
        // Known internal wallet, no override — show static
        return `<span style="font-family:var(--mono);font-size:0.66rem;color:var(--muted)">${cpGLCode}</span>`;
      }
      // Unknown — editable dropdown
      const opts = ['', ...glKeys].map(k =>
        `<option value="${k}" ${k===current?'selected':''}>${k ? (glMap[k]?.Name ? k+' · '+glMap[k].Name.slice(0,18) : k) : '—'}</option>`
      ).join('');
      return `<select onchange="_txSetCpGl('${hashKey}',this.value,'${cpAddr}','${hashFull}')"
        onfocus="if(!Object.keys(_qb.glAccountMap||{}).length) qbFetchAccountMap().then(()=>renderTx())"
        style="font-family:var(--mono);font-size:0.62rem;width:100%;background:var(--bg);border:1px solid ${current?'var(--accent)':'var(--border)'};color:${current?'var(--text)':'var(--muted)'};border-radius:4px;padding:2px 3px;cursor:pointer">
        ${opts}
      </select>`;
    })();

    // ── Description (auto-fill, editable) ───────────────────────
    const STABLES  = new Set(['USDC','USDT','PYUSD']);
    const dispAmt  = STABLES.has(asset) ? fmtNum(Math.abs(t.qty||0),2) : fmtNum(Math.abs(t.usd||0),2);
    const autoDesc = `${t.dir} - ${asset} - ${fmtNum(Math.abs(t.qty||0),2)} ${asset} - $${dispAmt} - ${hashFull}`;
    const descKey  = hashFull + '::desc';
    const storedDesc = window._txDescOverrides?.[descKey];
    const descVal  = (storedDesc !== undefined ? storedDesc : autoDesc).replace(/"/g,'&quot;');

    // ── Posted indicator ─────────────────────────────────────────
    const isPosted   = hashFull in posted;
    const postedDoc  = posted[hashFull] || '';
    const rowStyle = txAcqWarn
      ? 'background:rgba(240,165,0,0.05);box-shadow:inset 3px 0 0 #f0a500'
      : isPosted ? 'background:rgba(44,160,28,0.05);box-shadow:inset 3px 0 0 #2CA01C' : '';

    return `<tr${rowStyle?' style="'+rowStyle+'"':''}>
      <td style="padding:0 4px;text-align:center;vertical-align:middle"><input type="checkbox" style="cursor:pointer;accent-color:var(--accent);width:14px;height:14px" onchange="txToggleHash('${hashFull}',this.checked)" ${_qb.selectedHashes?.has(hashFull)?'checked':''}></td>
      <td class="muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.72rem">${fmtDate(t.date)}</td>
      <td style="font-family:var(--mono);font-size:0.64rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted)">${glCode}</td>
      <td style="overflow:hidden">
        <div style="font-size:0.74rem;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${walletName}</div>
        <div class="wallet-addr">${addr ? addr.slice(0,6)+'…'+addr.slice(-4) : ''}</div>
      </td>
      <td style="overflow:hidden">${cpCell}</td>
      <td style="padding:4px 6px;overflow:hidden">${cpGLCell}</td>
      <td>${tokenBadge(t.asset)}</td>
      <td class="${dirCls}" style="font-weight:600;font-size:0.78rem">${t.dir}</td>
      <td class="num ${dirCls}" style="font-size:0.72rem">${t.dir==='In'?'+':'-'}${fmtNum(Math.abs(t.qty||0),2)}</td>
      <td class="num muted" style="font-size:0.72rem">${fmtPrice(t.price)}</td>
      <td class="num ${t.dir==='Out'?'gain-neg':''}" style="font-size:0.72rem">${t.dir==='Out'?'-':''}${fmtUSD(Math.abs(t.usd||0))}</td>
      ${txAcqWarn
        ? `<td class="num" style="color:${(t.gainShort||0)>=0?'var(--green)':'var(--red)'}"><span style="color:#f0a500;font-weight:700;margin-right:2px" title="Cost basis from lot before period">⚠</span>${(t.gainShort||0)!==0?(t.gainShort>0?'+':'')+fmtUSD(t.gainShort):'—'}</td>`
        : gainCell(t.gainShort)}
      ${gainCell(t.gainLong)}
      <td style="padding:3px 5px;overflow:hidden">
        <input type="text" value="${descVal}"
          onchange="_txSetDesc('${descKey}',this.value)"
          style="width:100%;font-family:var(--mono);font-size:0.62rem;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:4px;padding:2px 5px;outline:none"
          onfocus="this.style.borderColor='var(--accent)'"
          onblur="this.style.borderColor='var(--border)'"
          title="${descVal}">
      </td>
      <td style="padding:6px 5px">${hashLink}</td>
      <td style="padding:4px 5px;text-align:center;vertical-align:middle">
        ${isPosted
          ? `<span style="font-family:var(--mono);font-size:0.58rem;color:#2CA01C;display:block;line-height:1.2" title="Posted to QB">${postedDoc || '✓'}</span>`
          : ''}
      </td>
    </tr>`;
  }).join('');
}


// ══════════════════════════════════════════════════════════════════
// RENDER: GAIN / LOSS
// ══════════════════════════════════════════════════════════════════
function renderGL() {
  const token  = document.getElementById('gl-token').value;
  const term   = document.getElementById('gl-term').value;
  const wallet = document.getElementById('gl-wallet').value;
  const monthF = document.getElementById('gl-month').value;

  populateMonthSelect('gl-month', state.gainLoss.map(r => r.soldDate));

  const glEntityAddrs = state.entity ? new Set(ALL_WALLETS.filter(w=>w.entity===state.entity).map(w=>w.address)) : null;
  let data = state.gainLoss.filter(r => {
    if(glEntityAddrs && !glEntityAddrs.has(r.walletAddr)) return false;
    if(token  && r.asset   !== token)  return false;
    if(wallet && r.account !== wallet) return false;
    if(monthF && _monthKey(r.soldDate) !== monthF) return false;
    if(term==='short' && (!r.gainShort || r.gainShort===0)) return false;
    if(term==='long'  && (!r.gainLong  || r.gainLong===0))  return false;
    return true;
  });

  data = sortData(data, state.glSort.col, state.glSort.dir);

  const totalST = data.reduce((s,r)=>s+(r.gainShort||0),0);
  const totalLT = data.reduce((s,r)=>s+(r.gainLong||0),0);
  const total   = totalST + totalLT;
  document.getElementById('glCount').textContent = `${data.length} dispositions`;

  document.getElementById('glCards').innerHTML = `
    <div class="card"><div class="card-label">Total Realized</div><div class="card-value ${total>=0?'green':'red'}">${total>=0?'+':''}${fmtUSD(total)}</div></div>
    <div class="card"><div class="card-label">Short-Term</div><div class="card-value ${totalST>=0?'green':'red'}">${totalST>=0?'+':''}${fmtUSD(totalST)}</div></div>
    <div class="card"><div class="card-label">Long-Term</div><div class="card-value ${totalLT>=0?'green':'red'}">${totalLT>=0?'+':''}${fmtUSD(totalLT)}</div></div>
    <div class="card"><div class="card-label">Lots Disposed</div><div class="card-value blue">${data.length}</div></div>
  `;

  const tbody = document.getElementById('glTbody');
  if(!data.length) {
    tbody.innerHTML = `<tr><td colspan="12" style="padding:32px;text-align:center;color:var(--muted);font-family:var(--sans);font-size:0.82rem">
      ${state.gainLoss.length===0
        ? '⚠️ Select <strong>Period</strong> mode and click <strong>Fetch Data</strong> to compute gain/loss.'
        : 'No results match filters.'}
    </td></tr>`;
    return;
  }

  tbody.innerHTML = data.map(r => {
    const hashShort = r.txHash ? r.txHash.slice(0,8)+'…'+r.txHash.slice(-4) : '—';
    const hashLink  = r.txHash
      ? `<a href="https://solscan.io/tx/${r.txHash}" target="_blank"
            style="font-family:var(--mono);font-size:0.65rem;color:var(--accent);text-decoration:none"
            title="${r.txHash}">${hashShort}</a>`
      : '—';
    const termLabel = r.days > 365 ? 'LT' : 'ST';
    const termColor = r.days > 365 ? 'var(--accent)' : 'var(--muted)';

    // Warn if acquisition date is before the selected period start
    const acqTs = r.acqDate instanceof Date ? r.acqDate.getTime()/1000 : new Date(r.acqDate).getTime()/1000;
    const periodStart = state.fromDate ? new Date(state.fromDate + 'T00:00:00Z').getTime()/1000 : 0;
    const acqBeforePeriod = periodStart > 0 && acqTs < periodStart && r.acqPrice > 0;
    const acqDateCell = acqBeforePeriod
      ? `<td style="background:rgba(240,165,0,0.1);border-left:3px solid #f0a500;padding-left:6px" title="⚠️ Lot acquired BEFORE period start (${fmtDate(r.acqDate)}) — cost basis may be inaccurate. Extend date range for precise results.">
           <span style="color:#f0a500;font-weight:700;margin-right:4px">⚠</span><span style="color:#f0a500">${fmtDate(r.acqDate)}</span>
         </td>`
      : `<td class="muted">${fmtDate(r.acqDate)}</td>`;

    return `<tr${acqBeforePeriod ? ' style="background:rgba(240,165,0,0.05)"' : ''}>
      <td class="muted">${fmtDate(r.soldDate)}</td>
      ${acqDateCell}
      <td style="font-size:0.75rem">${r.account||'—'}</td>
      <td>${tokenBadge(r.asset)}</td>
      <td class="num">${fmtNum(r.qty, 6)}</td>
      <td class="num muted">${fmtPrice(r.acqPrice)}</td>
      <td class="num muted">${fmtPrice(r.soldPrice)}</td>
      <td class="num">${fmtUSD(r.costBasis)}</td>
      <td class="num">${fmtUSD(r.proceeds)}</td>
      ${gainCell(r.gain)}
      ${gainCell(r.gainShort)}
      ${gainCell(r.gainLong)}
      <td class="num muted">${r.days >= 0 ? r.days+'d' : '—'} <span style="font-size:0.65rem;color:${termColor}">${termLabel}</span></td>
      <td>${hashLink}</td>
    </tr>`;
  }).join('');
}

// ══════════════════════════════════════════════════════════════════
// RENDER: UNREALIZED
// ══════════════════════════════════════════════════════════════════
function renderUR() {
  const token  = document.getElementById('ur-token').value;
  const wallet = document.getElementById('ur-wallet').value;
  const sign   = document.getElementById('ur-sign').value;
  const monthF = document.getElementById('ur-month').value;

  // Month select should show ALL months present in orcaLedgerData (not just acqDates of current lots)
  populateMonthSelect('ur-month', orcaLedgerData.map(r => r.blockTime));

  const urEntityAddrs = state.entity ? new Set(ALL_WALLETS.filter(w=>w.entity===state.entity).map(w=>w.address)) : null;

  // When a month is selected: compute unrealized as of the last moment of that month.
  // This answers "which lots were still open at the end of month X?" and values them
  // at the ORCA price at end of that month (from cache) rather than today's price.
  let baseUnrealized = state.unrealized;
  let closingLabel   = 'Current Price';
  let closingPriceAtDate = null;
  let priorPrice = null;
  let priorLabel = null;

  if(monthF && orcaLedgerData.length) {
    const [yy, mm] = monthF.split('-').map(Number);
    const endOfMonthTs = Math.floor(new Date(Date.UTC(yy, mm, 0, 23, 59, 59)).getTime() / 1000);

    const filteredForFifo = orcaLedgerData
      .filter(r => r.blockTime <= endOfMonthTs)
      .map(t => ({...t, asset: t.asset || 'ORCA', _synthetic: t.synthetic}))
      .sort((a, b) => a.blockTime - b.blockTime);

    if(filteredForFifo.length) {
      const {unrealized: monthUr} = computeFIFO(filteredForFifo, 0);
      const _MONTH_NAMES_UR = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      closingLabel = `EOM Price (${_MONTH_NAMES_UR[mm-1]} ${yy})`;

      const eomCacheKey = `ORCA::EOM::${monthF}`;
      closingPriceAtDate = (_priceCache[eomCacheKey] > 0) ? _priceCache[eomCacheKey] : null;
      if(!closingPriceAtDate) {
        getEOMPrice('ORCA', yy, mm).then(p => { if(p > 0) renderUR(); }).catch(() => {});
        closingPriceAtDate = null;
      }

      // ── Prior month price (month - 1) ──────────────────────────
      const priorMm = mm === 1 ? 12 : mm - 1;
      const priorYy = mm === 1 ? yy - 1 : yy;
      const priorMonthStr = `${priorYy}-${String(priorMm).padStart(2,'0')}`;
      const priorCacheKey = `ORCA::EOM::${priorMonthStr}`;
      priorLabel = `${_MONTH_NAMES_UR[priorMm-1]} ${priorYy}`;
      priorPrice = (_priceCache[priorCacheKey] > 0) ? _priceCache[priorCacheKey] : null;
      if(!priorPrice) {
        getEOMPrice('ORCA', priorYy, priorMm).then(p => { if(p > 0) renderUR(); }).catch(() => {});
      }

      const eomPrices = {ORCA: closingPriceAtDate || 0};
      enrichUnrealized(monthUr, eomPrices);
      baseUnrealized = monthUr;
    }
  }

  let data = baseUnrealized.filter(r => {
    if(urEntityAddrs && !urEntityAddrs.has(r.walletAddr)) return false;
    if(token  && r.token  !== token)  return false;
    if(wallet && r.wallet !== wallet) return false;
    if(sign==='gain' && r.unrealGain <= 0) return false;
    if(sign==='loss' && r.unrealGain >= 0) return false;
    return true;
  });

  // ── Group by walletAddr::token ──────────────────────────────────
  const groupMap = new Map();
  for(const r of data) {
    const key = (r.walletAddr||r.wallet||'') + '::' + r.token;
    if(!groupMap.has(key)) groupMap.set(key, {
      key, token: r.token, wallet: r.wallet, walletAddr: r.walletAddr,
      lots: [], totQty: 0, totCost: 0, totVal: 0, totGain: 0,
      minAcq: null, maxAcq: null, closingPrice: r.closingPrice,
    });
    const g = groupMap.get(key);
    g.lots.push(r);
    g.totQty  += r.lotRem;
    g.totCost += r.costBasis;
    g.totVal  += r.unrealVal;
    g.totGain += r.unrealGain;
    const d = r.acqDate instanceof Date ? r.acqDate : new Date(r.acqDate);
    if(!g.minAcq || d < g.minAcq) g.minAcq = d;
    if(!g.maxAcq || d > g.maxAcq) g.maxAcq = d;
  }
  // Sort groups (reuse state.urSort, mapping cols to group fields)
  const colMap = {unrealGain:'totGain', unrealVal:'totVal', costBasis:'totCost',
                  lotRem:'totQty', wallet:'wallet', token:'token', acqDate:'minAcq'};
  let groups = [...groupMap.values()];
  const sCol = colMap[state.urSort.col] || 'totGain';
  groups.sort((a,b) => {
    let va = a[sCol], vb = b[sCol];
    if(va instanceof Date) va = va.getTime();
    if(vb instanceof Date) vb = vb.getTime();
    if(typeof va==='string') return state.urSort.dir==='asc' ? va.localeCompare(vb) : vb.localeCompare(va);
    return state.urSort.dir==='asc' ? (va-vb) : (vb-va);
  });

  const totalGain  = groups.reduce((s,g)=>s+g.totGain,0);
  const totalVal   = groups.reduce((s,g)=>s+g.totVal,0);
  const totalCost  = groups.reduce((s,g)=>s+g.totCost,0);
  const totalLots  = data.length;
  document.getElementById('urCount').textContent = `${groups.length} wallets · ${totalLots} lots`;

  const priceTag = monthF
    ? (closingPriceAtDate
        ? ` <span style="font-size:0.68rem;color:var(--muted);font-weight:400">@ ${fmtUSD(closingPriceAtDate)}</span>`
        : ` <span style="font-size:0.68rem;color:var(--muted);font-weight:400;font-style:italic">fetching…</span>`)
    : '';
  const priorTag = monthF && priorLabel
    ? (priorPrice
        ? ` <span style="font-size:0.68rem;color:var(--muted);font-weight:400">@ ${fmtUSD(priorPrice)}</span>`
        : ` <span style="font-size:0.68rem;color:var(--muted);font-weight:400;font-style:italic">fetching…</span>`)
    : '';

  // Compute prior val and delta using prior price × qty
  const totalPriorVal = (priorPrice && monthF)
    ? groups.reduce((s,g) => s + g.totQty * priorPrice, 0)
    : null;
  const totalDelta = (totalPriorVal !== null) ? (totalVal - totalPriorVal) : null;

  document.getElementById('urCards').innerHTML = `
    <div class="card"><div class="card-label">Unrealized G/L</div><div class="card-value ${totalGain>=0?'green':'red'}">${totalGain>=0?'+':''}${fmtUSD(totalGain)}</div></div>
    <div class="card"><div class="card-label">${closingLabel}${priceTag}</div><div class="card-value blue">${fmtUSD(totalVal,0)}</div></div>
    <div class="card"><div class="card-label">Cost Basis</div><div class="card-value">${fmtUSD(totalCost,0)}</div></div>
    <div class="card"><div class="card-label">Prior Val. (${priorLabel||'—'})${priorTag}</div><div class="card-value">${totalPriorVal!==null?fmtUSD(totalPriorVal,0):'—'}</div></div>
    <div class="card"><div class="card-label">Δ Month vs ${priorLabel||'prior'}</div><div class="card-value ${totalDelta===null?'':totalDelta>=0?'green':'red'}">${totalDelta!==null?(totalDelta>=0?'+':'')+fmtUSD(totalDelta,0):'—'}</div></div>
    <div class="card"><div class="card-label">Open Lots</div><div class="card-value">${groups.length} wallets / ${totalLots}</div></div>
  `;

  const tbody = document.getElementById('urTbody');
  if(!groups.length) {
    tbody.innerHTML = `<tr><td colspan="10" style="padding:32px;text-align:center;color:var(--muted);font-family:var(--sans);font-size:0.82rem">
      ${state.unrealized.length===0
        ? '⚠️ Select <strong>Period</strong> mode and click <strong>Fetch Data</strong> to compute unrealized gains.'
        : 'No results match filters.'}
    </td></tr>`;
    return;
  }

  const rows = [];
  for(const g of groups) {
    const expanded = state.urExpanded.has(g.key);
    const pct  = g.totCost>0 ? (g.totGain/g.totCost)*100 : 0;
    const cls  = g.totGain>0?'gain-pos':g.totGain<0?'gain-neg':'gain-zero';
    const avgCost = g.totQty>0 ? g.totCost/g.totQty : 0;
    const curPrice = g.closingPrice || (g.totQty>0 ? g.totVal/g.totQty : 0);
    const acqRange = g.minAcq && g.maxAcq && g.minAcq.getTime()!==g.maxAcq.getTime()
      ? `${fmtDate(g.minAcq)} – ${fmtDate(g.maxAcq)}`
      : fmtDate(g.minAcq);
    const chevron = expanded ? '▾' : '▸';

    const safeKey = g.key.replace(/&/g,'&amp;').replace(/"/g,'&quot;');
    const gPriorVal = (priorPrice && monthF) ? g.totQty * priorPrice : null;
    const gDelta    = (gPriorVal !== null) ? (g.totVal - gPriorVal) : null;
    const dCls      = gDelta === null ? '' : gDelta >= 0 ? 'gain-pos' : 'gain-neg';
    rows.push(`<tr class="ur-group-row" data-urkey="${safeKey}" onclick="toggleURGroup(this.dataset.urkey)"
        style="cursor:pointer;background:${expanded?'rgba(255,255,255,0.04)':'transparent'};border-bottom:1px solid var(--border)">
      <td>${tokenBadge(g.token)}</td>
      <td style="font-size:0.75rem;font-weight:600">
        <span style="color:var(--muted);margin-right:5px">${chevron}</span>${g.wallet||'—'}
        <span style="font-size:0.63rem;color:var(--muted);display:block;margin-top:1px">${g.lots.length} lot${g.lots.length!==1?'s':''}</span>
      </td>
      <td class="muted" style="font-size:0.68rem">${acqRange}</td>
      <td class="num muted">${avgCost?fmtUSD(avgCost):'—'}</td>
      <td class="num muted">${curPrice?fmtUSD(curPrice):'—'}</td>
      <td class="num" style="font-weight:600">${fmtNum(g.totQty,4)}</td>
      <td class="num">${g.totCost?fmtUSD(g.totCost):'—'}</td>
      <td class="num">${g.totVal?fmtUSD(g.totVal):'—'}</td>
      <td class="num" style="color:#9945FF">${gPriorVal!==null?fmtUSD(gPriorVal):'—'}</td>
      <td class="num ${dCls}" style="font-weight:700">${gDelta!==null?(gDelta>=0?'+':'')+fmtUSD(gDelta):'—'}</td>
      <td class="num ${cls}" style="font-weight:700">${g.totGain?(g.totGain>0?'+':'')+fmtUSD(g.totGain):'—'}</td>
      <td class="num ${cls}">${g.totCost>0?pct.toFixed(1)+'%':'—'}</td>
    </tr>`);

    // Detail rows (lots) — only when expanded
    if(expanded) {
      const sortedLots = [...g.lots].sort((a,b)=>{
        const da = a.acqDate instanceof Date ? a.acqDate : new Date(a.acqDate);
        const db = b.acqDate instanceof Date ? b.acqDate : new Date(b.acqDate);
        return da - db;
      });
      for(const r of sortedLots) {
        const lPct = r.costBasis>0 ? (r.unrealGain/r.costBasis)*100 : 0;
        const lCls = r.unrealGain>0?'gain-pos':r.unrealGain<0?'gain-neg':'gain-zero';
        const lPriorVal = (priorPrice && monthF) ? r.lotRem * priorPrice : null;
        const lDelta    = (lPriorVal !== null) ? (r.unrealVal - lPriorVal) : null;
        const lDCls     = lDelta === null ? '' : lDelta >= 0 ? 'gain-pos' : 'gain-neg';
        rows.push(`<tr style="background:rgba(255,255,255,0.02);border-bottom:1px solid rgba(255,255,255,0.04)">
          <td></td>
          <td style="font-size:0.65rem;color:var(--muted);padding-left:22px">↳ lot</td>
          <td class="muted" style="font-size:0.65rem">${fmtDate(r.acqDate)}</td>
          <td class="num muted" style="font-size:0.65rem">${r.acqPrice?fmtUSD(r.acqPrice):'—'}</td>
          <td class="num muted" style="font-size:0.65rem">${r.closingPrice?fmtUSD(r.closingPrice):'—'}</td>
          <td class="num" style="font-size:0.65rem">${fmtNum(r.lotRem,4)}</td>
          <td class="num" style="font-size:0.65rem">${r.costBasis?fmtUSD(r.costBasis):'—'}</td>
          <td class="num" style="font-size:0.65rem">${r.unrealVal?fmtUSD(r.unrealVal):'—'}</td>
          <td class="num" style="font-size:0.65rem;color:#9945FF">${lPriorVal!==null?fmtUSD(lPriorVal):'—'}</td>
          <td class="num ${lDCls}" style="font-size:0.65rem">${lDelta!==null?(lDelta>=0?'+':'')+fmtUSD(lDelta):'—'}</td>
          <td class="num ${lCls}" style="font-size:0.65rem">${r.unrealGain?(r.unrealGain>0?'+':'')+fmtUSD(r.unrealGain):'—'}</td>
          <td class="num ${lCls}" style="font-size:0.65rem">${r.costBasis>0?lPct.toFixed(1)+'%':'—'}</td>
        </tr>`);
      }
    }
  }
  tbody.innerHTML = rows.join('');
}

function toggleURGroup(key) {
  if(state.urExpanded.has(key)) state.urExpanded.delete(key);
  else state.urExpanded.add(key);
  renderUR();
}

// ══════════════════════════════════════════════════════════════════
// SORT
// ══════════════════════════════════════════════════════════════════
function sortData(data, col, dir) {
  return [...data].sort((a,b) => {
    let va = a[col], vb = b[col];
    // Counterparty: sort by label not address
    if(col === 'counterparty') {
      const getLabel = addr => ALL_WALLETS.find(w=>w.address===addr)?.label || addr || '';
      va = getLabel(va); vb = getLabel(vb);
    }
    // Handle Date objects
    if(va instanceof Date) va = va.getTime();
    if(vb instanceof Date) vb = vb.getTime();
    // Handle strings
    if(typeof va === 'string' && typeof vb === 'string') {
      va = va.toLowerCase(); vb = vb.toLowerCase();
      if(va < vb) return dir==='asc' ? -1 : 1;
      if(va > vb) return dir==='asc' ?  1 : -1;
      return 0;
    }
    // Handle numbers / dates-as-numbers
    const na = parseFloat(va) || 0;
    const nb = parseFloat(vb) || 0;
    if(na < nb) return dir==='asc' ? -1 : 1;
    if(na > nb) return dir==='asc' ?  1 : -1;
    return 0;
  });
}

function attachSort(tableId, sortState, renderFn) {
  const tbl = document.getElementById(tableId);
  if(!tbl) return;
  tbl.querySelectorAll('thead th[data-col]').forEach(th => {
    th.addEventListener('click', ()=>{
      const col = th.dataset.col;
      sortState.dir = sortState.col===col && sortState.dir==='asc' ? 'desc' : 'asc';
      sortState.col = col;
      tbl.querySelectorAll('thead th').forEach(h=>{
        h.classList.remove('sort-asc','sort-desc');
        if(h.dataset.col===col) h.classList.add(sortState.dir==='asc'?'sort-asc':'sort-desc');
      });
      renderFn();
    });
  });
}

// Build address → label map from ALL_WALLETS for quick lookup
function walletLabelRender(addr) { return WALLET_LABEL_MAP[addr] || null; }

// Build a snapshot of open lots as of a given timestamp
// Used to save/restore FIFO state without re-fetching all history
function buildLotsSnapshot(txs, asOfTs) {
  const snapshot = {}; // key: walletAddr::token → [{remaining,costPerUnit,...}]
  const walletAddrs = [...new Set(txs.map(t=>t.walletAddr))];

  for(const wAddr of walletAddrs) {
    const wLabel = txs.find(t=>t.walletAddr===wAddr)?.wallet || wAddr;
    for(const token of FOCUS_TOKENS) {
      if(STABLE_TOKENS.has(token)) continue; // stablecoins: no lot tracking needed
      const moves = txs
        .filter(t => t.walletAddr===wAddr && t.asset===token && t.blockTime < asOfTs)
        .sort((a,b) => a.blockTime - b.blockTime);

      const lots = [];
      for(const m of moves) {
        if(m.dir === 'In') {
          lots.push({
            remaining:    m.qty,
            costPerUnit:  m.price || 0,
            acqDate:      m.date instanceof Date ? m.date.toISOString() : m.date,
            acqBlockTime: m.blockTime,
            acqTxHash:    m.txHash,
            wallet:       wLabel,
            walletAddr:   wAddr,
            token,
          });
        } else {
          let toDispose = m.qty;
          while(toDispose > 1e-8 && lots.length > 0) {
            const lot = lots[0];
            const consumed = Math.min(lot.remaining, toDispose);
            lot.remaining -= consumed;
            toDispose     -= consumed;
            if(lot.remaining < 1e-8) lots.shift();
          }
        }
      }

      const openLots = lots.filter(l => l.remaining >= 1e-8);
      if(openLots.length > 0) {
        snapshot[`${wAddr}::${token}`] = openLots;
      }
    }
  }
  return snapshot;
}


// ══════════════════════════════════════════════════════════════════
// RENDER: FIFO DEBUG — per-wallet balance view
// ══════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════
// RENDER: ORCA LEDGER
// ══════════════════════════════════════════════════════════════════

// Apply overrides (type changes, deleted rows) from user edits
// orcaLedgerOverrides: { [idx]: {internal: bool} } or 'deleted'
let orcaLedgerOverrides = {};

// ── Genesis price editor ───────────────────────────────────────────────────
function setGenesisPrice(idx, newVal) {
  const price = parseFloat(newVal);
  if(isNaN(price) || price <= 0) return;
  const row = orcaLedgerData[idx];
  if(!row || !row.synthetic) return;
  row.price = price;
  row.usd   = row.qty * price;
  const hKey = 'ORCA::' + (Math.floor(row.blockTime / 3600) * 3600);
  _priceCache[hKey] = price;
  _savePriceCache();
  recomputeFIFO();
}

function _applyPriceCacheToLedger() {
  for(const tx of orcaLedgerData) {
    if(tx.price > 0) continue;
    const min1   = Math.floor(tx.blockTime / 60) * 60;
    const hourTs = Math.floor(tx.blockTime / 3600) * 3600;
    const token  = tx.asset || 'ORCA';
    const p = _priceCache[`${token}::${min1}`] || _priceCache[`${token}::${hourTs}`] || 0;
    if(p > 0) { tx.price = p; tx.usd = tx.qty * p; }
  }
}

function recomputeFIFO() {
  const fromTs = state.fromDate ? Math.floor(new Date(state.fromDate+'T00:00:00Z').getTime()/1000) : 0;
  const toTs   = state.toDate   ? Math.floor(new Date(state.toDate  +'T23:59:59Z').getTime()/1000) : Infinity;
  const orcaForFifo = orcaLedgerData.map(t => ({
    ...t, asset: t.asset||'ORCA', _synthetic: t.synthetic,
  })).sort((a,b) => a.blockTime - b.blockTime);
  const {gainLoss: allGainLoss, unrealized: _ur} = computeFIFO(orcaForFifo, fromTs);
  enrichUnrealized(_ur, state.prices);
  state.gainLoss = allGainLoss.filter(g => {
    const bt = g.soldBlockTime || Math.floor(
      (g.soldDate instanceof Date ? g.soldDate.getTime() : new Date(g.soldDate).getTime()) / 1000);
    return bt >= fromTs && bt <= toTs;
  });
  state.unrealized = _ur;
  orcaLedgerGLMap = {};
  for(const g of allGainLoss) {
    const k = (g.txHash||'') + '::' + (g.walletAddr||'');
    if(!orcaLedgerGLMap[k]) orcaLedgerGLMap[k] = {gain:0,gainShort:0,gainLong:0,proceeds:0,costBasis:0};
    const m = orcaLedgerGLMap[k];
    m.gain+=g.gain||0; m.gainShort+=g.gainShort||0; m.gainLong+=g.gainLong||0;
    m.proceeds+=g.proceeds||0; m.costBasis+=g.costBasis||0;
  }
  for(const t of state.transactions) {
    const k = (t.txHash||'') + '::' + (t.walletAddr||'');
    const gl = orcaLedgerGLMap[k];
    if(gl) { t.gainShort = gl.gainShort; t.gainLong = gl.gainLong; }
  }
  renderOrcaLedger(); renderGL(); renderUR(); renderTx(); renderOverview();
}

function orcaLedgerShowAddRow() {
  // Populate wallet dropdown
  const sel = document.getElementById('ar-wallet');
  sel.innerHTML = ALL_WALLETS.map(w => `<option value="${w.address}">${w.label.slice(0,35)}</option>`).join('');
  // Default date to today
  document.getElementById('ar-date').value = new Date().toISOString().slice(0,10);
  document.getElementById('ol-add-modal').style.display = 'flex';
}

function orcaLedgerAddRow() {
  const dateStr  = document.getElementById('ar-date').value;
  const walletAddr = document.getElementById('ar-wallet').value;
  const dir      = document.getElementById('ar-dir').value;
  const qty      = parseFloat(document.getElementById('ar-qty').value) || 0;
  const price    = parseFloat(document.getElementById('ar-price').value) || 0;
  const isInt    = document.getElementById('ar-type').value === 'internal';
  const cp       = document.getElementById('ar-cp').value.trim();
  const hash     = document.getElementById('ar-hash').value.trim() || ('manual-' + Date.now());
  if(!dateStr || qty <= 0) { alert('Date and Qty are required'); return; }
  const wallet   = ALL_WALLETS.find(w => w.address === walletAddr);
  const dt       = new Date(dateStr + 'T12:00:00Z');
  const newRow = {
    date:        dt,
    blockTime:   Math.floor(dt.getTime()/1000),
    wallet:      wallet?.label || walletAddr.slice(0,8),
    walletAddr:  walletAddr,
    dir,
    qty,
    price,
    usd:         qty * price,
    counterparty: cp,
    internal:    isInt,
    synthetic:   true,
    txHash:      hash,
  };
  // Insert sorted by blockTime
  const insertIdx = orcaLedgerData.findIndex(r => r.blockTime > newRow.blockTime);
  if(insertIdx === -1) orcaLedgerData.push(newRow);
  else orcaLedgerData.splice(insertIdx, 0, newRow);
  document.getElementById('ol-add-modal').style.display = 'none';
  renderOrcaLedger();
}

function applyOrcaOverrides(data) {
  return data
    .map((r,i) => orcaLedgerOverrides[i] === 'deleted' ? null : orcaLedgerOverrides[i] ? {...r, ...orcaLedgerOverrides[i]} : r)
    .filter(Boolean);
}

function orcaLedgerSetType(idx, isInternal) {
  orcaLedgerOverrides[idx] = {...(orcaLedgerOverrides[idx]||{}), internal: isInternal};
  renderOrcaLedger();
}

function orcaLedgerDelete(idx) {
  orcaLedgerOverrides[idx] = 'deleted';
  renderOrcaLedger();
}

function copyToClipboard(text) {
  navigator.clipboard.writeText(text).catch(()=>{});
}

function renderOrcaLedger() {
  const wFilter    = document.getElementById('ol-wallet')?.value || '';
  const dirFilter  = document.getElementById('ol-dir')?.value || '';
  const typeFilter = document.getElementById('ol-type')?.value || '';
  const monthF     = document.getElementById('ol-month')?.value || '';
  const tbody      = document.getElementById('ol-body');
  const statusEl   = document.getElementById('ol-status');
  if(!tbody) return;

  if(!orcaLedgerData.length) {
    tbody.innerHTML = '<tr><td colspan="13" style="text-align:center;padding:32px;color:var(--muted)">⚠️ Fetch data first (Period mode).</td></tr>';
    if(statusEl) statusEl.textContent = '— fetch data first —';
    return;
  }

  // Entity filter: build address set for the selected entity
  const olEntityAddrs = state.entity
    ? new Set(ALL_WALLETS.filter(w => w.entity === state.entity).map(w => w.address))
    : null;

  // Populate wallet filter (only wallets matching current entity)
  const walletSel = document.getElementById('ol-wallet');
  if(walletSel) {
    const wallets = [...new Set(orcaLedgerData
      .filter(r => !olEntityAddrs || olEntityAddrs.has(r.walletAddr))
      .map(r => r.wallet))].sort();
    const cur = walletSel.value;
    walletSel.innerHTML = '<option value="">All wallets</option>' + wallets.map(w=>`<option value="${w}"${w===cur?' selected':''}>${w}</option>`).join('');
    if(cur && !wallets.includes(cur)) walletSel.value = ''; // reset if wallet no longer in entity
  }

  const fromTs = state.fromDate ? Math.floor(new Date(state.fromDate+'T00:00:00Z').getTime()/1000) : 0;
  const toTs   = state.toDate   ? Math.floor(new Date(state.toDate  +'T23:59:59Z').getTime()/1000) : Infinity;

  // Apply overrides first, then filter for display
  const effective = applyOrcaOverrides(orcaLedgerData);

  // Populate month filter from effective data (entity-filtered)
  populateMonthSelect('ol-month',
    effective.filter(r => !olEntityAddrs || olEntityAddrs.has(r.walletAddr))
             .map(r => r.blockTime));

  let displayData = effective.filter((r,_i) => {
    if(olEntityAddrs && !olEntityAddrs.has(r.walletAddr)) return false;
    if(wFilter && r.wallet !== wFilter) return false;
    if(dirFilter && r.dir !== dirFilter) return false;
    if(typeFilter === 'external' && r.internal) return false;
    if(typeFilter === 'internal' && !r.internal) return false;
    if(monthF && _monthKey(r.blockTime) !== monthF) return false;
    return true;
  });

  const extCount = effective.filter(r=>!r.internal&&!r.synthetic).length;
  const intCount = effective.filter(r=>r.internal).length;
  if(statusEl) statusEl.textContent = `${displayData.length} rows · ${extCount} external · ${intCount} internal`;

  // Compute running balance and lots per wallet using effective (post-override) data
  const walletBalance = {};
  const walletLots    = {};

  // Pre-compute balance+lots for all effective txs in order
  const balanceMap = {}; // idx in orcaLedgerData -> {balance, lotInfo}
  const _wb = {}, _wl = {};
  const _internalLotMap = {}; // txHash -> lot string captured from In side

  for(let i = 0; i < orcaLedgerData.length; i++) {
    if(orcaLedgerOverrides[i] === 'deleted') continue;
    const r = orcaLedgerOverrides[i] ? {...orcaLedgerData[i], ...orcaLedgerOverrides[i]} : orcaLedgerData[i];
    const addr = r.walletAddr;
    if(!_wb[addr]) _wb[addr] = 0;
    if(!_wl[addr]) _wl[addr] = [];
    const lots = _wl[addr];
    let lotInfo = '';

    if(r.dir === 'In') {
      _wb[addr] += r.qty;
      if(!r.internal) {
        lots.push({qty: r.qty, rem: r.qty, costPerUnit: r.price||0, acqDate: r.date});
        lotInfo = `+lot @ ${fmtPrice(r.price||0)}`;
      } else {
        // Internal In — find the sender wallet and move lots preserving cost basis
        const senderTx = orcaLedgerData.find((o,oi) =>
          orcaLedgerOverrides[oi] !== 'deleted' &&
          o.txHash === r.txHash && o.dir === 'Out' && o.walletAddr !== addr
        );
        if(senderTx) {
          const senderLots = _wl[senderTx.walletAddr] || [];
          let toMove = r.qty;
          const movedLots = [];
          for(const lot of senderLots) {
            if(toMove <= 1e-6) break;
            const take = Math.min(lot.rem, toMove);
            lots.push({qty: take, rem: take, costPerUnit: lot.costPerUnit, acqDate: lot.acqDate});
            movedLots.push(`${fmtNum(take,2)}@${fmtPrice(lot.costPerUnit)}`);
            lot.rem -= take; toMove -= take;
          }
          while(senderLots.length && senderLots[0].rem < 1e-6) senderLots.shift();
          // If sender lots didn't cover the full qty, create a fallback lot for the remainder
          if(toMove > 1e-6) {
            const fallbackPrice = r.price > 0 ? r.price : (movedLots.length > 0 ? lots[lots.length-1].costPerUnit : 0);
            lots.push({qty: toMove, rem: toMove, costPerUnit: fallbackPrice, acqDate: r.date});
            movedLots.push(`${fmtNum(toMove,2)}@${fmtPrice(fallbackPrice)} (mkt)`);
          }
          if(movedLots.length) {
            lotInfo = `← ${movedLots.join(', ')}`;
            _internalLotMap[r.txHash] = movedLots.join(', ');
          } else if(r.price > 0) {
            // Fallback: sender has no lots at all, create lot at market price
            lots.push({qty: r.qty, rem: r.qty, costPerUnit: r.price, acqDate: r.date});
            lotInfo = `← ${fmtNum(r.qty,2)}@${fmtPrice(r.price)} (mkt)`;
            _internalLotMap[r.txHash] = `${fmtNum(r.qty,2)}@${fmtPrice(r.price)} (mkt)`;
          } else {
            lotInfo = 'transfer in';
          }
        } else {
          lotInfo = 'transfer in';
        }
      }
    } else {
      _wb[addr] -= r.qty;
      if(!r.internal) {
        let toConsume = r.qty;
        const parts = [];
        for(const lot of lots) {
          if(toConsume <= 1e-6) break;
          const take = Math.min(lot.rem, toConsume);
          parts.push(`${fmtNum(take,2)}@${fmtPrice(lot.costPerUnit)}`);
          lot.rem -= take; toConsume -= take;
        }
        while(lots.length && lots[0].rem < 1e-6) lots.shift();
        lotInfo = parts.length ? parts.join(', ') : '⚠ no lots';
      } else {
        // Internal Out — lots already consumed by the In side (In processes before Out in sort)
        // Do NOT consume lots here again — only use display info from _internalLotMap
        const inLots = _internalLotMap[r.txHash];
        lotInfo = inLots ? `→ ${inLots}` : 'transfer out';
      }
    }
    balanceMap[i] = {balance: _wb[addr], lotInfo};
  }

  // Render only filtered rows
  const filteredIdxs = orcaLedgerData
    .map((_,i) => i)
    .filter(i => {
      if(orcaLedgerOverrides[i] === 'deleted') return false;
      const r = orcaLedgerOverrides[i] ? {...orcaLedgerData[i], ...orcaLedgerOverrides[i]} : orcaLedgerData[i];
      if(olEntityAddrs && !olEntityAddrs.has(r.walletAddr)) return false;
      if(wFilter && r.wallet !== wFilter) return false;
      if(dirFilter && r.dir !== dirFilter) return false;
      if(typeFilter === 'external' && r.internal) return false;
      if(typeFilter === 'internal' && !r.internal) return false;
      if(monthF && _monthKey(r.blockTime) !== monthF) return false;
      return true;
    });

  // When month filter is active, group rows by wallet name (then blockTime within wallet)
  // so that the same wallet always appears contiguously regardless of entity order in the ledger.
  if(monthF) {
    filteredIdxs.sort((a, b) => {
      const ra = orcaLedgerOverrides[a] ? {...orcaLedgerData[a], ...orcaLedgerOverrides[a]} : orcaLedgerData[a];
      const rb = orcaLedgerOverrides[b] ? {...orcaLedgerData[b], ...orcaLedgerOverrides[b]} : orcaLedgerData[b];
      const wa = ra.wallet || '', wb = rb.wallet || '';
      if(wa !== wb) return wa.localeCompare(wb);
      return (ra.blockTime || 0) - (rb.blockTime || 0);
    });
  }

  // Build wallet summary: remaining lots per wallet after all txs
  const walletSummary = {};
  // Include all wallets with positive balance, even if lots are exhausted
  const allSummaryAddrs = new Set([...Object.keys(_wb), ...Object.keys(_wl)]);
  for(const addr of allSummaryAddrs) {
    const balance = _wb[addr] || 0;
    if(balance < 1e-6) continue;
    const lots = (_wl[addr] || []).filter(l => l.rem >= 1e-6);
    const totalQty = lots.length ? lots.reduce((s,l) => s + l.rem, 0) : balance;
    const totalCost = lots.length ? lots.reduce((s,l) => s + l.rem * l.costPerUnit, 0) : 0;
    const avgCost = lots.length && totalQty > 0 ? totalCost / totalQty : 0;
    walletSummary[addr] = {totalQty: balance, avgCost, lots, noLotBasis: !lots.length};
  }

  // Detect last filtered index per wallet for summary row injection
  const lastIdxByWallet = {};
  filteredIdxs.forEach(i => {
    const r = orcaLedgerOverrides[i] ? {...orcaLedgerData[i], ...orcaLedgerOverrides[i]} : orcaLedgerData[i];
    lastIdxByWallet[r.walletAddr] = i;
  });

  // ── Virtual render: only first OL_PAGE_SIZE rows, load more on scroll ──
  window._olFilteredIdxs = filteredIdxs;
  window._olPageSize = 120;
  window._olRendered = 0;

  function olRenderChunk(from, count) {
    const chunk = filteredIdxs.slice(from, from + count);
    const html = chunk.map(i => {
    const r = orcaLedgerOverrides[i] ? {...orcaLedgerData[i], ...orcaLedgerOverrides[i]} : orcaLedgerData[i];
    const {balance, lotInfo} = balanceMap[i] || {balance: 0, lotInfo: ''};
    const isPeriod = r.blockTime >= fromTs && r.blockTime <= toTs;
    const rowBg  = isPeriod ? 'background:rgba(10,158,106,0.07)' : '';
    const dirCls = r.dir === 'In' ? 'color:var(--green)' : 'color:var(--red)';
    const lotCls = lotInfo.includes('⚠') ? 'color:var(--red)' : r.internal ? 'color:#6af' : r.dir==='In' ? 'color:var(--green)' : 'color:var(--muted)';
    // Format lots vertically when multiple
    const lotDisplay = (() => {
      const sep = lotInfo.startsWith('←') ? '←' : lotInfo.startsWith('→') ? '→' : '';
      const inner = sep ? lotInfo.slice(1).trim() : lotInfo;
      const parts = inner.split(', ').map(s => s.trim()).filter(Boolean);
      if(parts.length <= 1) return lotInfo;
      return (sep ? sep + ' ' : '') + parts.join(',<br>');
    })();

    // G/L cell — only for External Out rows (not internal, not synthetic)
    const glKey = (r.txHash||'') + '::' + (r.walletAddr||'');
    const glEntry = (!r.internal && !r.synthetic && r.dir === 'Out') ? orcaLedgerGLMap[glKey] : null;
    const glCell = (() => {
      if(!glEntry) return '<td style="text-align:right"></td>';
      const g = glEntry.gain;
      const isShort = glEntry.gainShort !== 0;
      const isLong  = glEntry.gainLong  !== 0;
      const termTag = isLong && !isShort
        ? '<span style="font-size:0.58rem;color:var(--muted);margin-left:3px">LT</span>'
        : '<span style="font-size:0.58rem;color:var(--muted);margin-left:3px">ST</span>';
      const col = g > 0.005 ? 'var(--green)' : g < -0.005 ? 'var(--red)' : 'var(--muted)';
      const sign = g > 0.005 ? '+' : '';
      return `<td style="text-align:right;font-family:var(--mono);font-size:0.70rem;font-weight:700;color:${col};white-space:nowrap">${sign}${fmtUSD(g)}${termTag}</td>`;
    })();

    // Wallet display: name + address copy
    const walletAddr = r.walletAddr || '';
    const walletShort = walletAddr ? walletAddr.slice(0,4)+'…'+walletAddr.slice(-4) : '';
    const walletCell = `<span style="font-size:0.72rem">${(r.wallet||'').slice(0,20)}</span><br>
      <span style="font-family:var(--mono);font-size:0.63rem;color:var(--muted);cursor:pointer" onclick="copyToClipboard('${walletAddr}')" title="Click to copy ${walletAddr}">${walletShort} 📋</span>`;

    // Counterparty display
    const cpAddr = r.counterparty || '';
    const cpWallet = ALL_WALLETS.find(w => w.address === cpAddr || w.address === resolveCounterparty(cpAddr));
    const cpName = cpWallet?.label || r.counterparty || '—';
    const cpShort = cpAddr.length > 10 ? cpAddr.slice(0,4)+'…'+cpAddr.slice(-4) : cpAddr;
    const cpCell = `<span style="font-size:0.7rem">${cpName.slice(0,20)}</span><br>
      <span style="font-family:var(--mono);font-size:0.63rem;color:var(--muted);cursor:pointer" onclick="copyToClipboard('${cpAddr}')" title="Click to copy ${cpAddr}">${cpShort} 📋</span>`;

    // Editable type dropdown
    const typeSelect = `<select onchange="orcaLedgerSetType(${i}, this.value==='internal')"
      style="font-size:0.68rem;border-radius:4px;border:1px solid var(--border);background:${r.synthetic?'#2a2a1a':r.internal?'#1a2035':'#1a2a1a'};color:${r.synthetic?'#c8b':r.internal?'#6af':'#6f6'};padding:2px 4px;cursor:pointer;font-family:var(--mono)">
      <option value="external" ${!r.internal&&!r.synthetic?'selected':''}>EXTERNAL</option>
      <option value="internal" ${r.internal?'selected':''}>INTERNAL</option>
      ${r.synthetic?'<option value="genesis" selected>GENESIS</option>':''}
    </select>`;

    const txLink = r.txHash && !r.txHash.startsWith('n40-')
      ? `<a href="https://solscan.io/tx/${r.txHash}" target="_blank" style="font-family:var(--mono);font-size:0.63rem;color:var(--accent)">${r.txHash.slice(0,8)}…</a>`
      : `<span style="font-family:var(--mono);font-size:0.63rem;color:var(--muted2)">${(r.txHash||'').slice(0,8)}</span>`;

    const isLastForWallet = lastIdxByWallet[r.walletAddr] === i;
    const summary = isLastForWallet && walletSummary[r.walletAddr];
    const summaryRow = summary ? (() => {
      const noLots = summary.noLotBasis;
      const lotsDetail = noLots
        ? '<span style="color:var(--red)">⚠ no cost basis — add genesis row</span>'
        : summary.lots.map(l => `${fmtNum(l.rem,2)}@${fmtPrice(l.costPerUnit)}`).join(',<br>');
      const avgStr = noLots ? '—' : fmtPrice(summary.avgCost) + ' avg';
      const usdStr = noLots ? '—' : fmtUSD(summary.totalQty * summary.avgCost);
      // Total realized G/L for this wallet (all time, from orcaLedgerGLMap)
      const walletTotalGL = Object.entries(orcaLedgerGLMap)
        .filter(([k]) => k.endsWith('::' + (r.walletAddr||'')))
        .reduce((s,[,v]) => s + v.gain, 0);
      const glTotalCell = Object.keys(orcaLedgerGLMap).length
        ? (() => {
            const col = walletTotalGL > 0.005 ? 'var(--green)' : walletTotalGL < -0.005 ? 'var(--red)' : 'var(--muted)';
            const sign = walletTotalGL > 0.005 ? '+' : '';
            return `<td style="text-align:right;font-family:var(--mono);font-size:0.68rem;font-weight:700;color:${col}">${sign}${fmtUSD(walletTotalGL)}<br><span style="font-size:0.58rem;color:var(--muted);font-weight:400">realized</span></td>`;
          })()
        : '<td></td>';
      return `<tr style="background:rgba(255,255,255,0.04);border-top:1px solid var(--border)">
        <td colspan="2" style="font-size:0.65rem;color:var(--muted);padding:4px 8px;font-style:italic">remaining balance</td>
        <td></td>
        <td style="text-align:right;font-family:var(--mono);font-size:0.72rem;font-weight:700;color:${noLots?'var(--red)':'var(--green)'}">${fmtNum(summary.totalQty,2)}</td>
        <td style="text-align:right;font-family:var(--mono);font-size:0.7rem;color:var(--muted)">${avgStr}</td>
        <td style="text-align:right;font-family:var(--mono);font-size:0.7rem;color:var(--muted)">${usdStr}</td>
        <td></td><td></td><td></td>
        <td style="font-size:0.63rem;font-family:var(--mono);color:var(--muted);max-width:160px;word-break:break-all">${lotsDetail}</td>
        ${glTotalCell}
        <td colspan="2"></td>
      </tr>`;
    })() : '';

    return `<tr style="${rowBg}">
      <td style="font-family:var(--mono);font-size:0.7rem;white-space:nowrap">${fmtDate(r.date)}</td>
      <td style="line-height:1.4">${walletCell}</td>
      <td style="${dirCls};font-weight:700;text-align:center;font-size:0.85rem">${r.dir==='In'?'↑':'↓'}</td>
      <td style="text-align:right;font-family:var(--mono);font-size:0.7rem;font-weight:600">${fmtNum(r.qty,2)}</td>
      <td style="text-align:right;font-family:var(--mono);font-size:0.7rem">${r.price>0?fmtPrice(r.price):'—'}</td>
      <td style="text-align:right;font-family:var(--mono);font-size:0.7rem">${(r.usd||0)>0?fmtUSD(r.usd):'—'}</td>
      <td style="text-align:right;font-family:var(--mono);font-size:0.72rem;font-weight:700;color:${balance<0?'var(--red)':'var(--text)'}">${fmtNum(balance,2)}</td>
      <td style="line-height:1.4">${cpCell}</td>
      <td>${typeSelect}</td>
      ${r.synthetic && (r.txHash||'').startsWith('n40-genesis')
        ? `<td style="font-family:var(--mono);font-size:0.67rem;color:var(--green)">+lot @<input
              type="number" step="0.00001" min="0" value="${r.price||0}"
              onchange="setGenesisPrice(${i}, this.value)"
              onclick="event.stopPropagation()"
              title="Edit genesis lot price — recalculates FIFO immediately"
              style="width:76px;margin-left:4px;background:#1a2a1a;border:1px solid #4a8a4a;color:#aef;font-family:var(--mono);font-size:0.67rem;padding:1px 4px;border-radius:3px;outline:none"
            ></td>`
        : `<td style="${lotCls};font-size:0.67rem;font-family:var(--mono);max-width:160px;word-break:break-all">${lotDisplay}</td>`}
      ${glCell}
      <td>${txLink}</td>
      <td><button onclick="orcaLedgerDelete(${i})" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:0.8rem;padding:2px 6px;border-radius:3px" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--muted)'" title="Delete this row">✕</button></td>
    </tr>${summaryRow}`;
    }).join('');
    if(from === 0) {
      tbody.innerHTML = html;
    } else {
      tbody.insertAdjacentHTML('beforeend', html);
    }
    window._olRendered = from + chunk.length;
  }

  olRenderChunk(0, window._olPageSize);

  // Attach scroll sentinel for load-more
  const vscroll = document.getElementById('olVScroll');
  if(vscroll) {
    vscroll._olHandler && vscroll.removeEventListener('scroll', vscroll._olHandler);
    vscroll._olHandler = () => {
      if(window._olRendered >= window._olFilteredIdxs.length) return;
      const { scrollTop, scrollHeight, clientHeight } = vscroll;
      if(scrollTop + clientHeight >= scrollHeight - 200) {
        olRenderChunk(window._olRendered, window._olPageSize);
      }
    };
    vscroll.addEventListener('scroll', vscroll._olHandler, { passive: true });
    vscroll.scrollTop = 0;
  }

  // Update pad height estimate (avg 44px/row including summary rows)
  const pad = document.getElementById('olVPad');
  if(pad) pad.style.minHeight = (filteredIdxs.length * 44) + 'px';
}

function renderFIFODebug() {
  const token     = document.getElementById('fd-token')?.value || 'ORCA';
  const wFilter   = document.getElementById('fd-wallet')?.value || '';
  const container = document.getElementById('fd-wallets-container');
  const statusEl  = document.getElementById('fd-status');
  if(!container) return;

  const txs = state.transactions;
  if(!txs || !txs.length) {
    container.innerHTML = '<div style="padding:32px;text-align:center;color:var(--muted);font-family:var(--sans)">⚠️ Fetch data first.</div>';
    return;
  }

  const entity = state.entity;
  const entityAddrs = new Set(ALL_WALLETS.filter(w => !w.external && (!entity || w.entity === entity)).map(w => w.address));
  const periodFromTs = state.fromDate ? Math.floor(new Date(state.fromDate+'T00:00:00Z').getTime()/1000) : 0;

  // Build per-wallet data from state
  const walletMap = {};
  const ensure = (addr, label) => {
    if(!walletMap[addr]) walletMap[addr] = {addr, label: label||WALLET_LABEL_MAP[addr]||addr.slice(0,8)+'…', movements:[], openLots:[], closingLots:[]};
    return walletMap[addr];
  };

  // Period movements
  for(const t of txs.filter(t => t.asset===token && (!entity || entityAddrs.has(t.walletAddr)))) {
    ensure(t.walletAddr, t.wallet).movements.push(t);
  }

  // Closing lots from unrealized
  for(const u of (state.unrealized||[]).filter(u => u.token===token && (!entity || entityAddrs.has(u.walletAddr)))) {
    ensure(u.walletAddr, u.wallet).closingLots.push(u);
  }

  // Opening lots: GL dispositions with acqDate before period + unrealized with acqDate before period
  const openKey = (addr, acqDate, acqPrice) => addr+'::'+fmtDate(acqDate)+'::'+parseFloat(acqPrice).toFixed(6);
  const openMap = {};
  const addOpen = (addr, label, acqDate, acqPrice, qty) => {
    const k = openKey(addr, acqDate, acqPrice);
    if(!openMap[k]) { openMap[k]={walletAddr:addr, label, acqDate, acqPrice, qty:0}; }
    openMap[k].qty += qty;
  };
  for(const g of (state.gainLoss||[]).filter(g => g.asset===token && (!entity || entityAddrs.has(g.walletAddr)))) {
    const acqTs = g.acqDate instanceof Date ? g.acqDate.getTime()/1000 : new Date(g.acqDate).getTime()/1000;
    if(periodFromTs > 0 && acqTs < periodFromTs) addOpen(g.walletAddr, g.account, g.acqDate, g.acqPrice, g.qty);
  }
  for(const u of (state.unrealized||[]).filter(u => u.token===token && (!entity || entityAddrs.has(u.walletAddr)))) {
    const acqTs = u.acqDate instanceof Date ? u.acqDate.getTime()/1000 : new Date(u.acqDate).getTime()/1000;
    if(periodFromTs > 0 && acqTs < periodFromTs) addOpen(u.walletAddr, u.wallet, u.acqDate, u.acqPrice, u.lotRem);
  }
  for(const lot of Object.values(openMap)) ensure(lot.walletAddr, lot.label).openLots.push(lot);

  // Populate wallet filter
  const wNames = [...new Set(Object.values(walletMap).map(w=>w.label))].sort();
  const fdSel = document.getElementById('fd-wallet');
  if(fdSel) {
    const cur = fdSel.value;
    fdSel.innerHTML = '<option value="">All wallets</option>'+wNames.map(n=>`<option value="${n}"${n===cur?' selected':''}>${n}</option>`).join('');
  }

  const wallets = Object.values(walletMap).filter(w => !wFilter || w.label===wFilter).sort((a,b)=>a.label.localeCompare(b.label));
  if(!wallets.length) { container.innerHTML='<div style="padding:32px;text-align:center;color:var(--muted)">No data.</div>'; return; }

  const totalOpen = wallets.reduce((s,w)=>s+w.openLots.reduce((ss,l)=>ss+l.qty,0),0);
  const totalClose = wallets.reduce((s,w)=>s+w.closingLots.reduce((ss,l)=>ss+l.lotRem,0),0);
  if(statusEl) statusEl.textContent = `${wallets.length} wallets · open: ${fmtNum(totalOpen,2)} ${token} · closing: ${fmtNum(totalClose,2)} ${token}`;

  const lotRows = (lots, qtyKey) => lots.length===0 ? '<span style="color:var(--muted2)">— none —</span>' :
    lots.sort((a,b)=>new Date(a.acqDate)-new Date(b.acqDate)).map(l=>`
      <div style="display:flex;gap:8px;padding:3px 0;border-bottom:1px solid var(--surface2);font-size:0.72rem">
        <span style="color:var(--muted);min-width:90px">${fmtDate(l.acqDate)}</span>
        <span style="font-weight:600;min-width:90px;text-align:right">${fmtNum(l[qtyKey]||l.qty||0,2)}</span>
        <span style="color:var(--muted);min-width:70px;text-align:right">@ ${fmtPrice(l.acqPrice)}</span>
        <span style="color:var(--muted2)">${fmtUSD((l[qtyKey]||l.qty||0)*l.acqPrice)}</span>
      </div>`).join('');

  const moveRows = (movs) => movs.length===0 ? '<span style="color:var(--muted2)">— none —</span>' :
    movs.sort((a,b)=>a.blockTime-b.blockTime).map(m=>{
      const dc = m.dir==='In'?'color:var(--green)':'color:var(--red)';
      const hl = m.txHash&&m.txHash!=='carry-fwd' ? `<a href="https://solscan.io/tx/${m.txHash}" target="_blank" style="font-family:var(--mono);font-size:0.65rem;color:var(--accent);text-decoration:none">${m.txHash.slice(0,6)}…</a>` : '';
      return `<div style="display:flex;gap:8px;padding:3px 0;border-bottom:1px solid var(--surface2);font-size:0.72rem;align-items:center">
        <span style="color:var(--muted);min-width:90px">${fmtDate(m.date)}</span>
        <span style="${dc};font-weight:700;width:20px">${m.dir==='In'?'↑':'↓'}</span>
        <span style="font-weight:600;min-width:90px;text-align:right">${fmtNum(m.qty,2)}</span>
        <span style="color:var(--muted);min-width:60px;text-align:right">@ ${fmtPrice(m.price)}</span>
        <span style="color:var(--muted2);font-size:0.65rem;flex:1">${m.category||''}</span>
        ${hl}
      </div>`;
    }).join('');

  container.innerHTML = wallets.map(w => {
    const openQty  = w.openLots.reduce((s,l)=>s+l.qty,0);
    const inQty    = w.movements.filter(m=>m.dir==='In').reduce((s,m)=>s+m.qty,0);
    const outQty   = w.movements.filter(m=>m.dir==='Out').reduce((s,m)=>s+m.qty,0);
    const closeQty = w.closingLots.reduce((s,l)=>s+l.lotRem,0);
    const expected = openQty + inQty - outQty;
    const delta    = closeQty - expected;
    const hasDelta = Math.abs(delta) > 0.01;
    return `<div class="section" style="margin-bottom:20px">
      <div class="section-header">
        <span class="section-title" style="display:flex;align-items:center;gap:10px">
          <span>${w.label}</span>
          <span style="font-family:var(--mono);font-size:0.65rem;color:var(--muted)">${w.addr.slice(0,8)}…${w.addr.slice(-6)}</span>
          ${hasDelta?`<span style="background:#fde8e6;color:var(--red);padding:2px 8px;border-radius:4px;font-size:0.68rem;font-weight:700">⚠ Δ${delta>0?'+':''}${fmtNum(delta,2)}</span>`:''}
        </span>
        <div style="display:flex;gap:16px;font-family:var(--mono);font-size:0.72rem;color:var(--muted)">
          <span>Open: <strong style="color:var(--text)">${fmtNum(openQty,2)}</strong></span>
          <span>+In: <strong style="color:var(--green)">${fmtNum(inQty,2)}</strong></span>
          <span>-Out: <strong style="color:var(--red)">${fmtNum(outQty,2)}</strong></span>
          <span>Closing: <strong style="color:${hasDelta?'var(--orange)':'var(--text)'}">${fmtNum(closeQty,2)}</strong></span>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;padding:14px">
        <div>
          <div style="font-size:0.68rem;font-weight:600;color:var(--muted);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px">Opening Lots (carry-forward)</div>
          ${lotRows(w.openLots, 'qty')}
          <div style="margin-top:6px;font-size:0.72rem;font-family:var(--mono);color:var(--muted)">Total: <strong>${fmtNum(openQty,2)} ${token}</strong></div>
        </div>
        <div>
          <div style="font-size:0.68rem;font-weight:600;color:var(--muted);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px">Period Movements</div>
          ${moveRows(w.movements)}
          <div style="margin-top:6px;font-size:0.72rem;font-family:var(--mono);color:var(--muted)">In: +${fmtNum(inQty,2)} · Out: -${fmtNum(outQty,2)} · Net: ${(inQty-outQty)>=0?'+':''}${fmtNum(inQty-outQty,2)}</div>
        </div>
        <div>
          <div style="font-size:0.68rem;font-weight:600;color:var(--muted);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px">Closing Lots (unrealized)</div>
          ${lotRows(w.closingLots, 'lotRem')}
          <div style="margin-top:6px;font-size:0.72rem;font-family:var(--mono);color:var(--muted)">Total: <strong>${fmtNum(closeQty,2)} ${token}</strong></div>
        </div>
      </div>
    </div>`;
  }).join('');
}

// ══════════════════════════════════════════════════════════════════
// RENDER ALL
// ══════════════════════════════════════════════════════════════════
function renderAll() {
  renderOverview();
  renderWallets();
  renderTx();
  renderGL();
  renderUR();
  if(state.activeTab === 'fifodebug') renderFIFODebug();
  if(state.activeTab === 'orcaledger') renderOrcaLedger();
}

// ══════════════════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════════════════
attachSort('txTable', state.txSort, renderTx);
attachSort('glTable', state.glSort, renderGL);
attachSort('urTable', state.urSort, renderUR);

renderWallets();
rebuildWalletDropdown();

function openAddWalletModal() {
  document.getElementById('aw-address').value = '';
  document.getElementById('aw-label').value = '';
  document.getElementById('aw-code').value = '';
  document.getElementById('aw-error').style.display = 'none';
  const m = document.getElementById('addWalletModal');
  m.style.display = 'flex';
}
function closeAddWalletModal() {
  document.getElementById('addWalletModal').style.display = 'none';
}
function submitAddWallet() {
  const address = document.getElementById('aw-address').value.trim();
  const label   = document.getElementById('aw-label').value.trim();
  const entity  = document.getElementById('aw-entity').value;
  const chain   = document.getElementById('aw-chain').value;
  const code    = document.getElementById('aw-code').value.trim();
  const errEl   = document.getElementById('aw-error');

  if(!address || address.length < 30) {
    errEl.textContent = 'Please enter a valid wallet address.';
    errEl.style.display = 'block';
    return;
  }
  if(!label) {
    errEl.textContent = 'Please enter a label.';
    errEl.style.display = 'block';
    return;
  }
  if(ALL_WALLETS.find(w => w.address === address)) {
    errEl.textContent = 'This address is already registered.';
    errEl.style.display = 'block';
    return;
  }

  const newWallet = { address, label, chain, entity };
  if(code) newWallet.accountCode = code;
  if(entity === 'External') newWallet.external = true;
  ALL_WALLETS.push(newWallet);
  WALLET_LABEL_MAP[address] = label;

  closeAddWalletModal();
  renderWallets();
}

function clearPriceCache() {
  Object.keys(_priceCache).forEach(k => delete _priceCache[k]);
  try { localStorage.removeItem(PRICE_CACHE_KEY); } catch(e) {}
  const el = document.getElementById('cacheStatus');
  if(el) el.textContent = 'Price cache cleared — next fetch rebuilds prices';
  setTimeout(() => { if(el) el.textContent = 'Helius RPC · Birdeye · DeFiLlama'; }, 3000);
}

function clearOrcaHistory() {
  const keys = Object.keys(localStorage).filter(k => k.startsWith('orca-history::'));
  keys.forEach(k => localStorage.removeItem(k));
  alert(`ORCA history cache cleared (${keys.length} entries). Click Fetch Data to rebuild.`);
}

function clearLotCache() {
  const keys = Object.keys(localStorage).filter(k => k.startsWith('tidelog_lots_'));
  keys.forEach(k => localStorage.removeItem(k));
  const el = document.getElementById('cacheStatus');
  if(el) el.textContent = `Cleared ${keys.length} cache entries — next fetch rebuilds history`;
  setTimeout(() => { if(el) el.textContent = 'Helius RPC · Jupiter · DeFiLlama'; }, 3000);
  console.log('[Cache] Cleared', keys.length, 'entries:', keys);
}

function debugFIFO() {
  const txs = state.transactions;
  if(!txs || !txs.length) { alert('No transactions loaded. Fetch data first.'); return; }

  console.group('=== FIFO DEBUG ===');

  // Show ORCA Out txs with their txHash
  const orcaOut = txs.filter(t => t.asset === 'ORCA' && t.dir === 'Out').sort((a,b)=>a.blockTime-b.blockTime);
  console.log('ORCA Out txs in state.transactions:');
  orcaOut.forEach(t => {
    console.log(`  ${new Date(t.blockTime*1000).toISOString().slice(0,16)} qty=${t.qty?.toFixed(2)} walletAddr=${t.walletAddr?.slice(0,8)} txHash=${t.txHash} gainShort=${t.gainShort}`);
  });

  // Re-run FIFO on all txs and show gainLoss with txHash
  console.log('\nRe-running FIFO on state.transactions:');
  const {gainLoss: gl} = computeFIFO(txs, null);
  console.log('dispositions:', gl.length);
  gl.forEach(g => {
    console.log(`  ${g.asset} qty=${g.qty?.toFixed(2)} gain=$${g.gain?.toFixed(2)} txHash=${g.txHash} walletAddr=${g.walletAddr?.slice(0,8)}`);
  });

  // Check propagation: does each gainLoss txHash match a state.transactions txHash?
  console.log('\nPropagation check:');
  const stateTxMap = new Map(orcaOut.map(t => [`${t.txHash}::${t.asset}::${t.walletAddr}`, t]));
  gl.filter(g=>g.asset==='ORCA').forEach(g => {
    const k = `${g.txHash}::${g.asset}::${g.walletAddr}`;
    const match = stateTxMap.has(k);
    if(!match) console.warn(`  ❌ NO MATCH: key=${k}`);
    else console.log(`  ✓ matched: ${k.slice(0,40)}`);
  });

  console.groupEnd();
  alert(`ORCA Out txs: ${orcaOut.length}\nFIFO dispositions: ${gl.length}\nCheck console for txHash matching`);
}

// Show cache status on load
(function checkCacheStatus() {
  const keys = Object.keys(localStorage).filter(k => k.startsWith('tidelog_lots_v1'));
  const el = document.getElementById('cacheStatus');
  if(!el) return;
  if(keys.length > 0) {
    try {
      const newest = keys.map(k => JSON.parse(localStorage.getItem(k))).filter(Boolean).sort((a,b)=>b.saved-a.saved)[0];
      if(newest) el.textContent = `Lot cache: ${new Date(newest.asOfTs*1000).toISOString().slice(0,10)} · ${Object.keys(newest.lots||{}).length} positions`;
    } catch(e) {}
  }
})();

// ── Entity Data Status ────────────────────────────────────────────────────
const ENTITY_STATUS_KEY = 'n40-entity-status-v1';

function saveEntityStatus() {
  const all = loadEntityStatuses();
  const key = state.entity || '__all__';

  // Compute actual date range from orcaLedgerData for current entity
  const rows = orcaLedgerData.filter(r => {
    if(!state.entity) return true;
    const ent = ALL_WALLETS.find(w => w.address === r.walletAddr)?.entity || '';
    return ent === state.entity;
  });
  const blockTimes = rows.map(r => r.blockTime).filter(Boolean);
  const minBt = blockTimes.length ? Math.min(...blockTimes) : null;
  const maxBt = blockTimes.length ? Math.max(...blockTimes) : null;

  all[key] = {
    entity:     state.entity || 'All',
    fromDate:   state.fromDate,
    toDate:     state.toDate,
    // If no on-chain data found, fall back to the fetch range dates so Update button still works
    dataFrom:   minBt ? new Date(minBt*1000).toISOString().slice(0,10) : (state.fromDate || null),
    dataTo:     maxBt ? new Date(maxBt*1000).toISOString().slice(0,10) : (state.toDate   || null),
    ledgerRows: rows.filter(r => !r.synthetic).length,
    glCount:    state.gainLoss.length,
    lastFetch:  new Date().toISOString(),
  };
  try { localStorage.setItem(ENTITY_STATUS_KEY, JSON.stringify(all)); } catch(e) {}
  renderEntityStatus();
}

function loadEntityStatuses() {
  try { return JSON.parse(localStorage.getItem(ENTITY_STATUS_KEY) || '{}'); } catch(e) { return {}; }
}

function renderEntityStatus() {
  const panel = document.getElementById('entityStatusPanel');
  if(!panel) return;
  const all = loadEntityStatuses();
  const TGE = '2021-08-09'; // earliest possible ORCA data
  const today = new Date().toISOString().slice(0,10);

  const entities = ['Juku', 'Opco', 'Foundation', 'Zagreus'];
  panel.innerHTML = entities.map(ent => {
    const s = all[ent];
    if(!s) return `
      <div style="display:flex;align-items:center;gap:6px;padding:3px 5px;border-radius:4px;opacity:0.45">
        <span style="font-size:0.7rem;color:var(--muted2)">○</span>
        <span style="font-family:var(--mono);font-size:0.67rem;color:var(--muted2);flex:1">${ent}</span>
        <span style="font-family:var(--mono);font-size:0.6rem;color:var(--muted2)">no data</span>
      </div>`;

    // Use toDate (until when was fetched) to determine if up to date — not dataTo (last actual tx)
    const fetchedTo = s.toDate || s.dataTo || null;
    const nextDay = fetchedTo ? (() => {
      const d = new Date(fetchedTo + 'T00:00:00Z');
      d.setUTCDate(d.getUTCDate() + 1);
      return d.toISOString().slice(0,10);
    })() : null;
    const isCurrent = nextDay && nextDay > today;
    const canUpdate = nextDay && !isCurrent;

    const missingHistory = s.dataFrom && s.dataFrom > TGE;
    const isStale = canUpdate; // has unfetched days
    const dot  = isStale ? '⚠' : '●';
    const dotC = isStale ? '#f0a500' : 'var(--green)';

    const tip = `Last fetch: ${new Date(s.lastFetch).toLocaleDateString()}\nFetched range: ${s.fromDate} → ${s.toDate}\nActual data:   ${s.dataFrom} → ${s.dataTo}\n${s.ledgerRows} ledger rows · ${s.glCount} dispositions${isStale ? `\n⚠ Not up to date — click ↑ to fetch ${nextDay} → ${today}` : '\n✓ Up to date'}`;

    return `
      <div title="${tip}" style="display:flex;align-items:center;gap:5px;padding:4px 6px;border-radius:5px;background:var(--surface2);border:1px solid var(--border)">
        <span style="color:${dotC};font-size:0.65rem;flex-shrink:0">${dot}</span>
        <div style="min-width:0;flex:1;overflow:hidden;cursor:default">
          <div style="font-family:var(--mono);font-size:0.67rem;color:var(--text);font-weight:600">${ent}</div>
          <div style="font-family:var(--mono);font-size:0.57rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${s.dataFrom||'?'} → ${s.dataTo||'?'}</div>
        </div>
        <div style="text-align:right;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:2px">
          <div style="font-family:var(--mono);font-size:0.65rem;font-weight:700;color:var(--accent)">${(s.ledgerRows||0).toLocaleString()}</div>
          <div style="font-family:var(--mono);font-size:0.55rem;color:var(--muted2)">rows</div>
        </div>
        ${canUpdate ? `<button onclick="triggerIncrementalFetch('${ent}','${nextDay}')" title="Fetch new data: ${nextDay} → ${today}" style="flex-shrink:0;padding:3px 6px;border-radius:4px;border:1px solid var(--accent);background:transparent;color:var(--accent);font-family:var(--mono);font-size:0.62rem;cursor:pointer;white-space:nowrap" onmouseover="this.style.background='var(--accent)';this.style.color='#000'" onmouseout="this.style.background='transparent';this.style.color='var(--accent)'">↑ Update</button>` : isCurrent ? `<span title="Data is up to date" style="flex-shrink:0;font-size:0.65rem;color:var(--green);opacity:0.7">✓</span>` : ''}
      </div>`;
  }).join('');
}

// ── Trigger incremental ORCA history fetch for a specific entity ──────────
function triggerIncrementalFetch(entity, sinceDate) {
  const today = new Date().toISOString().slice(0,10);

  // Switch to the entity and set period dates
  setEntity(entity);
  setMode('period');

  // Set date range to sinceDate → today
  const dfEl = document.getElementById('dateFrom');
  const dtEl = document.getElementById('dateTo');
  if(dfEl) dfEl.value = sinceDate;
  if(dtEl) dtEl.value = today;
  state.fromDate = sinceDate;
  state.toDate = today;

  // Mark that we want incremental ORCA fetch starting from sinceDate
  state.orcaIncrementalSince = sinceDate;
  state._wasIncremental = true; // triggers auto-save on completion

  console.log(`[INCR] Triggering incremental fetch for ${entity} since ${sinceDate}`);
  fetchData();
}
async function downloadSelf(autoTs) {
  // Collect all entity ORCA history caches from localStorage
  const orcaHistoryCache = {};
  for(const key of Object.keys(localStorage)) {
    if(key.startsWith('orca-history::')) {
      try { orcaHistoryCache[key] = JSON.parse(localStorage.getItem(key)); } catch(e) {}
    }
  }

  // Build a complete orcaLedgerData from ALL entities in cache,
  // not just the currently selected entity.
  // This means the snapshot is useful regardless of which entity was active when saved.
  const FIFO_EXCLUDE = new Set([
    'GwH3Hiv5mACLX3ufTw1pFsrhSPon5tdw252DBs4Rx4PV',
    'DWo8SNtdBDueSHzLzrTWxvjpbSBFSbMD4BnPYCxEofzg',
  ]);
  let allLedgerRows = [];
  const seenLedger = new Set();

  // Start with current orcaLedgerData (already enriched with prices + genesis lots)
  for(const r of (orcaLedgerData || [])) {
    const k = (r.txHash||'noHash')+'::'+r.walletAddr+'::'+r.dir;
    if(!seenLedger.has(k)) { seenLedger.add(k); allLedgerRows.push(r); }
  }

  // Merge in any other entity histories from localStorage that aren't already included
  for(const [key, history] of Object.entries(orcaHistoryCache)) {
    if(!Array.isArray(history)) continue;
    for(const t of history) {
      if(FIFO_EXCLUDE.has(t.walletAddr)) continue;
      const k = (t.txHash||'noHash')+'::'+t.walletAddr+'::'+t.dir;
      if(!seenLedger.has(k)) {
        seenLedger.add(k);
        allLedgerRows.push({
          date:        t.date,
          blockTime:   t.blockTime,
          wallet:      t.wallet,
          walletAddr:  t.walletAddr,
          dir:         t.dir,
          qty:         t.qty,
          price:       t.price || 0,
          usd:         t.usd   || 0,
          counterparty: t.counterparty || '',
          internal:    !!t.internal,
          synthetic:   !!t._synthetic || !!t.synthetic,
          txHash:      t.txHash,
        });
      }
    }
  }

  // Sort by blockTime ascending
  allLedgerRows.sort((a, b) => (a.blockTime||0) - (b.blockTime||0));

  // Serialize snapshot — keep only what's needed to restore the view.
  // priceCache is intentionally excluded: it can have 100k+ entries (tens of MB).
  // It will be rebuilt on demand when the user fetches again.

  // Trim transactions to only display fields (drop any raw Helius bloat)
  const trimTx = r => ({
    txHash:       r.txHash,
    blockTime:    r.blockTime,
    date:         r.date instanceof Date ? r.date.toISOString() : r.date,
    wallet:       r.wallet,
    walletAddr:   r.walletAddr,
    asset:        r.asset,
    dir:          r.dir,
    qty:          r.qty,
    price:        r.price,
    usd:          r.usd,
    counterparty: r.counterparty,
    internal:     r.internal,
    _synthetic:   r._synthetic,
  });

  // Trim orcaHistory cache to only FIFO-essential fields
  const trimOrca = t => ({
    txHash:       t.txHash,
    blockTime:    t.blockTime,
    date:         t.date instanceof Date ? t.date.toISOString() : (t.date || null),
    wallet:       t.wallet,
    walletAddr:   t.walletAddr,
    dir:          t.dir,
    qty:          t.qty,
    price:        t.price  || 0,
    usd:          t.usd    || 0,
    counterparty: t.counterparty || '',
    internal:     !!t.internal,
    _synthetic:   !!t._synthetic || !!t.synthetic,
  });

  const trimmedOrcaCache = {};
  for(const [key, history] of Object.entries(orcaHistoryCache)) {
    if(Array.isArray(history)) trimmedOrcaCache[key] = history.map(trimOrca);
  }

  const snap = {
    v: 5,
    ts: Date.now(),
    fromDate:   state.fromDate,
    toDate:     state.toDate,
    entity:     state.entity,
    orcaLedgerData: allLedgerRows.map(r => ({
      ...r, date: r.date instanceof Date ? r.date.toISOString() : r.date,
    })),
    orcaLedgerGLMap,
    gainLoss: (state.gainLoss || []).map(r => ({
      ...r,
      soldDate: r.soldDate instanceof Date ? r.soldDate.toISOString() : r.soldDate,
      acqDate:  r.acqDate  instanceof Date ? r.acqDate.toISOString()  : r.acqDate,
    })),
    unrealized: (state.unrealized || []).map(r => ({
      ...r,
      acqDate: r.acqDate instanceof Date ? r.acqDate.toISOString() : r.acqDate,
    })),
    transactions:     (state.transactions || []).map(trimTx),
    walletData:       state.walletData || [],
    prices:           state.prices     || {},
    orcaHistoryCache: trimmedOrcaCache,
    // priceCache deliberately excluded — too large, rebuilt on next fetch
    entityStatus:     loadEntityStatuses(),
    bsBalancesByMonth: BS_BALANCES_BY_MONTH || {},
    accOnchainMonthCache: accOnchainMonthCache || {},
    accPeriodPriceCache:  accPeriodPriceCache  || {},
  };

  const snapJson = JSON.stringify(snap);
  console.log(`[Snapshot] orcaLedger:${snap.orcaLedgerData.length} txs:${snap.transactions.length} orcaCache:${Object.values(trimmedOrcaCache).reduce((s,a)=>s+a.length,0)} gl:${snap.gainLoss.length} raw:${(snapJson.length/1024).toFixed(0)}KB`);

  // Compress with gzip (pako) → base64 → ~70-80% smaller than raw JSON
  let snapPayload, snapFormat;
  try {
    const compressed = pako.gzip(snapJson);
    // Convert Uint8Array to base64
    let binary = '';
    const chunk = 8192;
    for(let i = 0; i < compressed.length; i += chunk) {
      binary += String.fromCharCode(...compressed.subarray(i, i + chunk));
    }
    snapPayload = btoa(binary);
    snapFormat  = 'gz';
    console.log(`[Snapshot] Compressed: ${(snapPayload.length/1024).toFixed(0)}KB base64 (ratio ${(snapPayload.length/snapJson.length*100).toFixed(0)}%)`);
  } catch(e) {
    console.warn('[Snapshot] pako compression failed, using raw JSON:', e.message);
    snapPayload = snapJson;
    snapFormat  = 'json';
  }

  const tag = snapFormat === 'gz'
    ? `<div id="__n40d__" hidden style="display:none"></div>`
    : `<div id="__n40d__" data-fmt="json" hidden style="display:none">${snapPayload}</div>`;
  const label = `${state.entity||'tidelog'}_${state.fromDate||''}_${state.toDate||''}`;

  // Fetch the *source* HTML (not the live DOM which includes rendered tables = 40MB+)
  // Falls back to outerHTML only if fetch fails (e.g. file:// with strict CORS).
  async function buildAndDownload(sourceHtml) {
    let html = sourceHtml;
    // Remove any existing snapshot
    html = html.replace(/<div[^>]*id="__n40d__"[^>]*>[\s\S]*?<\/div>/g, '');
    // Insert snapshot after the last script closing tag.
    const lastScript = html.lastIndexOf('</scr' + 'ipt>');
    if(lastScript !== -1) {
      const insertAt = lastScript + ('</scr' + 'ipt>').length;
      html = html.slice(0, insertAt) + '\n' + tag + html.slice(insertAt);
    } else {
      html = html + '\n' + tag;
    }
    const blob = new Blob([html], {type: 'text/html'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = autoTs ? `tidelog_${autoTs}.html` : `tidelog_${label}.html`;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  }

  // Try to fetch the original source file (works when served via http/https)
  // For file:// protocol, fetch() is blocked by CORS — use the embedded source instead.
  let gotSource = false;
  try {
    const res = await fetch(window.location.href);
    if(!res.ok) throw new Error('fetch failed');
    const sourceHtml = await res.text();
    // Sanity check: fetched HTML should be close in size to the base file, not the rendered DOM
    if(sourceHtml.length < document.documentElement.outerHTML.length * 0.5) throw new Error('fetched HTML too small');
    console.log(`[Snapshot] Source HTML via fetch: ${(sourceHtml.length/1024).toFixed(0)} KB`);
    gotSource = true;
    await buildAndDownload(sourceHtml);
  } catch(e) {
    console.warn('[Snapshot] fetch() unavailable, using embedded source:', e.message);
  }

  if(!gotSource) {
    // Fallback for file:// protocol: use outerHTML but strip rendered table rows first
    document.querySelectorAll('tbody').forEach(tb => { tb.innerHTML = ''; });
    const stripped = document.documentElement.outerHTML;
    console.log(`[Snapshot] Fallback (stripped DOM): ${(stripped.length/1024).toFixed(0)} KB`);
    await buildAndDownload('<!DOCTYPE html>\n' + stripped);
  }
}

// ── Snapshot loader: runs at boot if a snapshot was embedded ──────────────
// Uses DOMContentLoaded so it runs AFTER all script tags (including the
// injected <script id="_n40snap"> that comes after this main block).
function _decodeSnapshot(raw) {
  // raw is a gz base64 string
  if(typeof raw === 'string') {
    try {
      const binary = atob(raw);
      const bytes  = new Uint8Array(binary.length);
      for(let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      const json = pako.ungzip(bytes, {to: 'string'});
      return JSON.parse(json);
    } catch(e) {
      console.error('[Snapshot] decompress failed:', e);
      return null;
    }
  }
  return null;
}

function loadSnapshot() {
  const n40el = document.getElementById('__n40d__');
  if(!n40el) return;
  const isFmtJson = n40el.dataset.fmt === 'json';
  const raw = n40el.textContent.trim();
  if(!raw) return;
  const s = isFmtJson ? (()=>{try{return JSON.parse(raw);}catch(e){return null;}})() : _decodeSnapshot(raw);
  if(!s || !s.orcaLedgerData?.length) return;

  // If localStorage already has fetch data, ignore the snapshot entirely.
  // The user's local data is always equal or more recent than the deployed snapshot.
  const localOrcaKeys = Object.keys(localStorage).filter(k => k.startsWith('orca-history::'));
  const hasLocalData  = localOrcaKeys.some(k => {
    try { const h = JSON.parse(localStorage.getItem(k)); return Array.isArray(h) && h.length > 0; } catch(e) { return false; }
  });
  if(hasLocalData) {
    console.log('[Snapshot] Local orca-history found — rebuilding from localStorage');
    const FIFO_EXCLUDE = new Set([
      'GwH3Hiv5mACLX3ufTwxvjpbSBFSbMD4BnPYCxEofzg',
      'DWo8SNtdBDueSHzLzrTWxvjpbSBFSbMD4BnPYCxEofzg',
    ]);
    const seen = new Set();
    const rows = [];
    for(const key of localOrcaKeys) {
      try {
        const history = JSON.parse(localStorage.getItem(key));
        if(!Array.isArray(history)) continue;
        for(const t of history) {
          if(FIFO_EXCLUDE.has(t.walletAddr)) continue;
          const k = (t.txHash||'noHash')+'::'+t.walletAddr+'::'+t.dir;
          if(!seen.has(k)) { seen.add(k); rows.push({...t, date: new Date(t.date)}); }
        }
      } catch(e) {}
    }
    rows.sort((a,b) => (a.blockTime||0) - (b.blockTime||0));
    orcaLedgerData = rows;

    // Restore dates from entity status
    const localStatus = loadEntityStatuses();
    const toDates   = Object.values(localStatus).map(e=>e.toDate).filter(Boolean).sort();
    const fromDates = Object.values(localStatus).map(e=>e.fromDate).filter(Boolean).sort();
    if(toDates.length)   { state.toDate   = toDates[toDates.length-1];   document.getElementById('dateTo').value   = state.toDate; }
    if(fromDates.length) { state.fromDate = fromDates[0];                 document.getElementById('dateFrom').value = state.fromDate; }

    // Restore transactions/gainLoss/unrealized from localStorage
    // Use the most recently saved state (any entity)
    let latestStateTs = 0;
    let latestStateKey = null;
    for(const key of Object.keys(localStorage)) {
      if(!key.startsWith('tidelog-state::')) continue;
      try {
        const d = JSON.parse(localStorage.getItem(key));
        const ts = d.ts ? new Date(d.ts).getTime() : 0;
        if(ts > latestStateTs) { latestStateTs = ts; latestStateKey = key; }
      } catch(e) {}
    }
    if(latestStateKey) {
      try {
        const d = JSON.parse(localStorage.getItem(latestStateKey));
        state.transactions = (d.transactions||[]).map(r=>({...r, date: new Date(r.date)}));
        state.gainLoss     = (d.gainLoss||[]).map(r=>({...r, soldDate:new Date(r.soldDate), acqDate:new Date(r.acqDate)}));
        state.unrealized   = (d.unrealized||[]).map(r=>({...r, acqDate:new Date(r.acqDate)}));
        state.walletData   = d.walletData || [];
        state.prices       = d.prices     || {};
        // If prices are empty (e.g. from broken snapshot), re-fetch
        if(!state.prices.SOL) {
          fetchPrices(state.toDate || null).then(p => {
            state.prices = p;
            if(state.unrealized?.length) enrichUnrealized(state.unrealized, p);
            renderAll();
          }).catch(()=>{});
        }
        if(d.fromDate) { state.fromDate = d.fromDate; document.getElementById('dateFrom').value = d.fromDate; }
        if(d.toDate)   { state.toDate   = d.toDate;   document.getElementById('dateTo').value   = d.toDate; }
      } catch(e) { console.warn('Failed to restore state from localStorage:', e.message); }
    }

    setTimeout(() => {
      repopulateTabWalletFilters();
      _applyPriceCacheToLedger();
      recomputeFIFO();
    }, 150);
    return;
  }

  // No local data — load snapshot normally (new user or cleared cache)
  if(s.fromDate) { document.getElementById('dateFrom').value = s.fromDate; state.fromDate = s.fromDate; }
  if(s.toDate)   { document.getElementById('dateTo').value   = s.toDate;   state.toDate   = s.toDate;   }
  if(s.entity) {
    state.entity = s.entity;
    const btn = document.querySelector(`.entity-tab-btn[data-entity="${s.entity}"]`);
    if(btn) { document.querySelectorAll('.entity-tab-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); }
  }

  // Restore orcaLedgerData
  orcaLedgerData = s.orcaLedgerData.map(r => ({...r, date: new Date(r.date)}));
  orcaLedgerGLMap = s.orcaLedgerGLMap || {};

  // Restore state
  state.gainLoss    = (s.gainLoss    ||[]).map(r=>({...r, soldDate:new Date(r.soldDate), acqDate:new Date(r.acqDate)}));
  state.unrealized  = (s.unrealized  ||[]).map(r=>({...r, acqDate:new Date(r.acqDate)}));
  state.transactions= (s.transactions||[]).map(r=>({...r, date:new Date(r.date)}));
  state.walletData  = s.walletData || [];
  state.prices      = s.prices     || {};
  if(!state.prices.SOL) fetchPrices(state.toDate||null).then(p=>{state.prices=p;if(state.unrealized?.length)enrichUnrealized(state.unrealized,p);renderAll();}).catch(()=>{});
  // ORCA history cache: only write entries that don't already exist locally
  // (local cache is more recent if user already fetched this entity)
  if(s.bsBalancesByMonth){
    for(const [month, data] of Object.entries(s.bsBalancesByMonth))
      BS_BALANCES_BY_MONTH[month] = data;
  } else if(s.bsBalances) {
    // compat: old snapshots had flat bsBalances → seed into 2026-02
    BS_BALANCES_BY_MONTH['2026-02'] = s.bsBalances;
  }
  if(s.accOnchainMonthCache) {
    for(const [k, v] of Object.entries(s.accOnchainMonthCache))
      accOnchainMonthCache[k] = v;
  }
  if(s.accPeriodPriceCache) {
    for(const [k, v] of Object.entries(s.accPeriodPriceCache))
      accPeriodPriceCache[k] = v;
  }
  if(s.orcaHistoryCache) {
    for(const [key, history] of Object.entries(s.orcaHistoryCache)) {
      if(!localStorage.getItem(key) && history?.length) {
        try { localStorage.setItem(key, JSON.stringify(history)); } catch(e) {}
      }
    }
  }
  // priceCache not restored from snapshot (excluded since v5 to keep file size small)
  // Entity status panel
  if(s.entityStatus) {
    try {
      const existing = loadEntityStatuses();
      const merged = {...s.entityStatus, ...existing}; // local wins
      localStorage.setItem(ENTITY_STATUS_KEY, JSON.stringify(merged));
    } catch(e) {}
  }

  // Populate wallet filter dropdowns (respects current entity if one is pre-selected)
  setTimeout(() => {
    repopulateTabWalletFilters();
    // recomputeFIFO ensures G/L is always consistent with the current orcaLedgerData
    // (e.g. genesis price patched in snapshot must be reflected in gain/loss calculations)
    _applyPriceCacheToLedger();
    recomputeFIFO();
    renderWallets();
    saveEntityStatus();   // update coverage panel from snapshot data
    renderEntityStatus(); // render even if no fetch has run yet
    const d = new Date(s.ts);
    setStatus('green', 'Snapshot loaded',
      `${orcaLedgerData.length} ledger rows · ${state.gainLoss.length} dispositions · saved ${d.toLocaleDateString()}`);
  }, 150);
}
// If DOM is still loading, wait for it; otherwise the _n40snap script has
// already run (e.g. it was in <head>), so call immediately.
if(document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', loadSnapshot);
} else {
  loadSnapshot();
}

// ── Import Snapshot from File ─────────────────────────────────────────────
function importSnapshot() {
  const input = document.getElementById('snapshotFileInput');
  if(input) { input.value = ''; input.click(); }
}

function handleSnapshotFile(event) {
  const file = event.target.files[0];
  if(!file) return;

  setStatus('yellow', 'Loading snapshot\u2026', 'Reading ' + file.name);

  const reader = new FileReader();
  reader.onload = function(e) {
    const html = e.target.result;

    // Extract snapshot: new gz format (id="__n40d__"), legacy (_n40snap)
    const matchGz     = html.match(/<div[^>]+id="__n40d__"[^>]*>([\s\S]*?)<\/div>/);
    const matchLegacy = html.match(/<script[^>]+id="_n40snap"[^>]*>\s*window\._N40_SNAPSHOT\s*=\s*([\s\S]*?);\s*<\/script>/);
    if(!matchGz && !matchLegacy) {
      setStatus('red', 'Import failed', 'No snapshot data found in selected file');
      alert('Snapshot n\u00e3o encontrado no arquivo.\nCertifique-se de carregar um arquivo salvo com "Save Snapshot".');
      return;
    }

    let s;
    try {
      if(matchGz) {
        s = _decodeSnapshot(matchGz[1].trim());
      } else {
        s = JSON.parse(matchLegacy[1].trim());
      }
    } catch(err) {
      setStatus('red', 'Import failed', 'Parse error: ' + err.message);
      alert('Erro ao ler snapshot: ' + err.message);
      return;
    }

    if(!s.orcaLedgerData?.length) {
      setStatus('red', 'Import failed', 'Snapshot contains no ledger data');
      alert('O arquivo selecionado n\u00e3o cont\u00e9m dados de ledger ORCA.');
      return;
    }

    // Restore date inputs
    if(s.fromDate) { document.getElementById('dateFrom').value = s.fromDate; state.fromDate = s.fromDate; }
    if(s.toDate)   { document.getElementById('dateTo').value   = s.toDate;   state.toDate   = s.toDate;   }

    // Restore entity tab selection
    if(s.entity) {
      state.entity = s.entity;
      const btn = document.querySelector('.entity-tab-btn[data-entity="' + s.entity + '"]');
      if(btn) {
        document.querySelectorAll('.entity-tab-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
      }
    }

    // Restore orcaLedgerData (re-parse dates)
    orcaLedgerData = s.orcaLedgerData.map(function(r){ return Object.assign({}, r, {date: new Date(r.date)}); });
    orcaLedgerGLMap = s.orcaLedgerGLMap || {};

    // Restore state arrays (re-parse dates)
    state.gainLoss     = (s.gainLoss    ||[]).map(function(r){ return Object.assign({}, r, {soldDate: new Date(r.soldDate), acqDate: new Date(r.acqDate)}); });
    state.unrealized   = (s.unrealized  ||[]).map(function(r){ return Object.assign({}, r, {acqDate: new Date(r.acqDate)}); });
    state.transactions = (s.transactions||[]).map(function(r){ return Object.assign({}, r, {date: new Date(r.date)}); });
    state.walletData   = s.walletData || [];
    state.prices       = s.prices     || {};
    if(!state.prices.SOL) fetchPrices(state.toDate||null).then(p=>{state.prices=p;if(state.unrealized?.length)enrichUnrealized(state.unrealized,p);renderAll();}).catch(()=>{});
    if(s.orcaHistoryCache) {
      Object.entries(s.orcaHistoryCache).forEach(function(entry){
        const key = entry[0], history = entry[1];
        if(!localStorage.getItem(key) && history && history.length) {
          try { localStorage.setItem(key, JSON.stringify(history)); } catch(ex) {}
        }
      });
    }
    // Restore price cache (local wins on conflict)
    if(s.priceCache) {
      var merged = 0;
      Object.entries(s.priceCache).forEach(function(entry){
        const k = entry[0], v = entry[1];
        if(!_priceCache[k]) { _priceCache[k] = v; merged++; }
      });
      if(merged > 0) { _savePriceCache(); console.log('[Import] Restored ' + merged + ' price cache entries'); }
    }
    // Restore entity status (local wins on conflict)
    if(s.entityStatus) {
      try {
        var existing = loadEntityStatuses();
        var mergedStatus = Object.assign({}, s.entityStatus, existing);
        localStorage.setItem(ENTITY_STATUS_KEY, JSON.stringify(mergedStatus));
      } catch(ex) {}
    }

    // Re-render everything
    setTimeout(function() {
      repopulateTabWalletFilters();
      _applyPriceCacheToLedger();
      recomputeFIFO();
      var d = s.ts ? new Date(s.ts) : new Date();
      setStatus('green', 'Snapshot imported',
        orcaLedgerData.length + ' ledger rows \u00b7 ' + state.gainLoss.length + ' dispositions \u00b7 from ' + file.name + ' (saved ' + d.toLocaleDateString() + ')');
    }, 150);
  };

  reader.onerror = function() {
    setStatus('red', 'Import failed', 'Could not read file');
    alert('Erro ao ler o arquivo.');
  };

  reader.readAsText(file);
}

// ── Excel Export: shared XLSX loader + CSV fallback ───────────────────────
function _runExport(label, header, rows, sheetName, colWidths, tryFn) {
  const tryXlsx = () => {
    try {
      const ws = XLSX.utils.aoa_to_sheet([header, ...rows]);
      ws['!cols'] = colWidths;
      ws['!freeze'] = {xSplit:0, ySplit:1};
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, sheetName);
      XLSX.writeFile(wb, `${label}.xlsx`);
    } catch(e) {
      console.warn('[Export] XLSX failed, falling back to CSV:', e.message);
      _exportCsv(label, header, rows);
    }
  };
  if(window.XLSX) { tryXlsx(); return; }
  const s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
  s.onload = tryXlsx;
  s.onerror = () => { console.warn('[Export] CDN failed, using CSV'); _exportCsv(label, header, rows); };
  document.head.appendChild(s);
}
function _exportCsv(label, header, rows) {
  const esc = v => { const s=String(v??''); return s.includes(',')||s.includes('"')||s.includes('\n')?`"${s.replace(/"/g,'""')}"`:s; };
  const csv = [header,...rows].map(r=>r.map(esc).join(',')).join('\n');
  const blob = new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download=`${label}.csv`;
  document.body.appendChild(a); a.click(); setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1000);
}

// ── Excel Export: Transactions ─────────────────────────────────────────────
function exportTxExcel() {
  if(!state.transactions?.length) { alert('No transaction data to export.'); return; }
  const tokenF  = document.getElementById('tx-token')?.value  || '';
  const dirF    = document.getElementById('tx-dir')?.value    || '';
  const walletF = document.getElementById('tx-wallet')?.value || '';
  const monthF  = document.getElementById('tx-month')?.value  || '';
  const searchF = document.getElementById('tx-search')?.value.toLowerCase() || '';
  const txEA = state.entity ? new Set(ALL_WALLETS.filter(w=>w.entity===state.entity).map(w=>w.address)) : null;
  const data = state.transactions.filter(t => {
    if(txEA && !txEA.has(t.walletAddr)) return false;
    if(tokenF  && t.asset  !== tokenF)  return false;
    if(dirF    && t.dir    !== dirF)    return false;
    if(walletF && t.wallet !== walletF) return false;
    if(monthF  && _monthKey(t.date)    !== monthF) return false;
    if(searchF && !(t.txHash||'').toLowerCase().includes(searchF) &&
                  !(t.wallet||'').toLowerCase().includes(searchF) &&
                  !(t.asset||'').toLowerCase().includes(searchF)) return false;
    return true;
  });
  const fmt  = (v,d=2) => typeof v==='number' ? parseFloat(v.toFixed(d)) : (v||'');
  const fmtD = d => d instanceof Date ? d.toISOString().slice(0,10) : (typeof d==='string'?d.slice(0,10):'');
  const label = `${state.entity||'tidelog'}_TX_${state.fromDate||''}_${state.toDate||''}`;
  const header = ['Date','Wallet','Token','Direction','Qty','Price','USD','ST Gain','LT Gain','Tx Hash'];
  const rows = data.map(r => [
    fmtD(r.date), r.wallet||'', r.asset||'', r.dir||'',
    fmt(r.qty,4), fmt(r.price,6), fmt(r.usd),
    fmt(r.gainShort), fmt(r.gainLong), r.txHash||'',
  ]);
  _runExport(label, header, rows, 'Transactions',
    [{wch:12},{wch:26},{wch:7},{wch:5},{wch:14},{wch:11},{wch:12},{wch:12},{wch:12},{wch:22}]);
}

// ── Excel Export: Unrealized ───────────────────────────────────────────────
function exportURExcel() {
  if(!state.unrealized?.length) { alert('No unrealized data to export.'); return; }
  const tokenF  = document.getElementById('ur-token')?.value  || '';
  const walletF = document.getElementById('ur-wallet')?.value || '';
  const signF   = document.getElementById('ur-sign')?.value   || '';
  const monthF  = document.getElementById('ur-month')?.value  || '';
  const urEA = state.entity ? new Set(ALL_WALLETS.filter(w=>w.entity===state.entity).map(w=>w.address)) : null;
  const data = state.unrealized.filter(r => {
    if(urEA && !urEA.has(r.walletAddr)) return false;
    if(tokenF  && r.token  !== tokenF)  return false;
    if(walletF && r.wallet !== walletF) return false;
    if(monthF  && _monthKey(r.acqDate) !== monthF) return false;
    if(signF==='gain' && r.unrealGain <= 0) return false;
    if(signF==='loss' && r.unrealGain >= 0) return false;
    return true;
  });
  const fmt  = (v,d=2) => typeof v==='number' ? parseFloat(v.toFixed(d)) : (v||'');
  const fmtD = d => d instanceof Date ? d.toISOString().slice(0,10) : (typeof d==='string'?d.slice(0,10):'');
  const label = `${state.entity||'node40'}_UR_${state.fromDate||''}_${state.toDate||''}`;
  const header = ['Wallet','Token','Qty (Rem.)','Acq Date','Acq Price $','Cost Basis','Closing Price $','Current Value','Unrealized G/L','% Change'];
  const rows = data.map(r => {
    const pct = r.costBasis>0 ? parseFloat(((r.unrealGain/r.costBasis)*100).toFixed(2)) : '';
    return [
      r.wallet||'', r.token||'', fmt(r.lotRem,4), fmtD(r.acqDate),
      fmt(r.acqPrice,6), fmt(r.costBasis), fmt(r.closingPrice,6),
      fmt(r.unrealVal), fmt(r.unrealGain), pct,
    ];
  });
  _runExport(label, header, rows, 'Unrealized',
    [{wch:26},{wch:7},{wch:14},{wch:12},{wch:11},{wch:14},{wch:13},{wch:14},{wch:14},{wch:10}]);
}

// ── Excel Export: ORCA Ledger ──────────────────────────────────────────────
function exportOLExcel() {
  if(!orcaLedgerData?.length) { alert('No ORCA Ledger data to export.'); return; }
  const wF    = document.getElementById('ol-wallet')?.value || '';
  const dirF  = document.getElementById('ol-dir')?.value   || '';
  const typeF = document.getElementById('ol-type')?.value  || '';
  const monthF= document.getElementById('ol-month')?.value || '';
  const olEA  = state.entity ? new Set(ALL_WALLETS.filter(w=>w.entity===state.entity).map(w=>w.address)) : null;
  const effective = applyOrcaOverrides(orcaLedgerData);
  const data = effective.filter(r => {
    if(olEA && !olEA.has(r.walletAddr)) return false;
    if(wF    && r.wallet !== wF) return false;
    if(dirF  && r.dir    !== dirF) return false;
    if(typeF === 'external' && r.internal) return false;
    if(typeF === 'internal' && !r.internal) return false;
    if(monthF && _monthKey(r.blockTime) !== monthF) return false;
    return true;
  });
  const fmt  = (v,d=2) => typeof v==='number' ? parseFloat(v.toFixed(d)) : (v||'');
  const label = `${state.entity||'node40'}_OrcaLedger_${state.fromDate||''}_${state.toDate||''}`;
  const header = ['Date','Wallet','Direction','Qty','Price','USD','Balance','Counterparty','Type','Tx Hash'];
  const rows = data.map(r => {
    const dt = new Date(r.blockTime*1000).toISOString().slice(0,10);
    const glEntry = orcaLedgerGLMap[(r.txHash||'')+'::'+r.walletAddr] || {};
    return [
      dt, r.wallet||'', r.dir||'', fmt(r.qty,4), fmt(r.price,6), fmt(r.usd),
      '', r.counterparty||'', r.internal?'Internal':'External', r.txHash||'',
    ];
  });
  _runExport(label, header, rows, 'ORCA-Ledger',
    [{wch:12},{wch:20},{wch:5},{wch:16},{wch:10},{wch:14},{wch:16},{wch:26},{wch:10},{wch:22}]);
}

// ── Excel Export: Gain/Loss ────────────────────────────────────────────────
function exportGLExcel() {
  if(!state.gainLoss?.length) { alert('No Gain/Loss data to export. Run a fetch first.'); return; }
  const tokenF  = document.getElementById('gl-token')?.value  || '';
  const termF   = document.getElementById('gl-term')?.value   || '';
  const walletF = document.getElementById('gl-wallet')?.value || '';
  const monthF  = document.getElementById('gl-month')?.value  || '';
  const glEA = state.entity ? new Set(ALL_WALLETS.filter(w=>w.entity===state.entity).map(w=>w.address)) : null;
  const data = state.gainLoss.filter(r => {
    if(glEA && !glEA.has(r.walletAddr)) return false;
    if(tokenF  && r.asset   !== tokenF)  return false;
    if(walletF && r.account !== walletF) return false;
    if(monthF  && _monthKey(r.soldDate) !== monthF) return false;
    if(termF==='short' && !(r.gainShort)) return false;
    if(termF==='long'  && !(r.gainLong))  return false;
    return true;
  });
  const fmt  = (v,d=2) => typeof v==='number' ? parseFloat(v.toFixed(d)) : (v||'');
  const fmtD = d => d instanceof Date ? d.toISOString().slice(0,10) : (typeof d==='string'?d.slice(0,10):'');
  const label = `${state.entity||'node40'}_GL_${state.fromDate||''}_${state.toDate||''}`;
  const header = ['Sold Date','Acq Date','Wallet','Token','Qty','Acq Price','Sold Price',
                  'Cost Basis','Proceeds','Total Gain','ST Gain','LT Gain','Days','Tx Hash'];
  const rows = data.map(r => [
    fmtD(r.soldDate), fmtD(r.acqDate), r.account||'', r.asset||'',
    fmt(r.qty,4), fmt(r.acqPrice,6), fmt(r.soldPrice,6),
    fmt(r.costBasis), fmt(r.proceeds), fmt(r.gain),
    fmt(r.gainShort), fmt(r.gainLong), r.days||0, r.txHash||'',
  ]);
  const sum = k => data.reduce((s,r)=>s+(r[k]||0),0);
  rows.push(['TOTAL','','','','','','',
    fmt(sum('costBasis')), fmt(sum('proceeds')), fmt(sum('gain')),
    fmt(sum('gainShort')), fmt(sum('gainLong')), '', '']);
  _runExport(label, header, rows, 'Gain-Loss',
    [{wch:12},{wch:12},{wch:26},{wch:7},{wch:14},{wch:11},{wch:11},
     {wch:14},{wch:14},{wch:14},{wch:14},{wch:14},{wch:7},{wch:22}]);
}

// ══════════════════════════════════════════════════════════════════
// P&L
// ══════════════════════════════════════════════════════════════════

let _pnlCache = {}; // key: 'Entity::YYYY-MM' → raw QB P&L data


// ── Connect QB companies — panel approach (popup blocker safe) ─────
function qbConnectAll() {
  // Toggle panel — if already open, close it
  const existing = document.getElementById('qb-connect-panel');
  if(existing) { existing.remove(); return; }

  const entities = Object.keys(QB_REALM_IDS);
  const entityColors = { Opco:'#06D6A0', Foundation:'#4CC9F0', Juku:'#F9C74F', Zagreus:'#F07167' };

  function updateGlobalBadge() {
    const badge = document.getElementById('pnl-qb-entities');
    if(!badge) return;
    const parts = entities.map(e => {
      const ok = _qb.tokens[QB_REALM_IDS[e]]?.accessToken;
      return `<span style="color:${ok?'var(--green)':'var(--muted)'}">${ok?'\u2713':'\u25cb'} ${e}</span>`;
    });
    badge.innerHTML = parts.join('<span style="color:var(--border)"> &middot; </span>');
  }

  const panel = document.createElement('div');
  panel.id = 'qb-connect-panel';
  panel.style.cssText = [
    'position:fixed','top:50%','left:50%','transform:translate(-50%,-50%)',
    'background:var(--surface)','border:1px solid var(--border)','border-radius:12px',
    'padding:24px','z-index:10000','min-width:360px','box-shadow:0 8px 32px rgba(0,0,0,0.4)',
  ].join(';');

  panel.innerHTML = `
    <div style="font-family:var(--mono);font-size:0.85rem;font-weight:700;color:var(--text);margin-bottom:6px;display:flex;justify-content:space-between;align-items:center">
      <span>&#x1F517; Connect QuickBooks</span>
      <button onclick="document.getElementById('qb-connect-panel').remove()" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;line-height:1">&#x2715;</button>
    </div>
    <div style="font-family:var(--mono);font-size:0.67rem;color:var(--muted);margin-bottom:18px">Click each company to open the QB authorisation window.</div>
    <div id="qb-connect-rows"></div>
    <button id="qb-connect-done" style="width:100%;margin-top:12px;padding:9px;font-family:var(--mono);font-size:0.75rem;border-radius:6px;border:1px solid var(--border);background:var(--accent);color:#fff;cursor:pointer;font-weight:600">Done</button>
  `;

  const rowsEl = panel.querySelector('#qb-connect-rows');

  entities.forEach(entity => {
    const realmId = QB_REALM_IDS[entity];
    const color   = entityColors[entity] || 'var(--accent)';
    const tok     = _qb.tokens[realmId];
    const isConn  = tok?.accessToken && Date.now() < tok.tokenExpiry;

    const row = document.createElement('div');
    row.style.cssText = `display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:8px;margin-bottom:8px;border:1px solid ${color}33;background:${color}0d`;
    row.innerHTML = `
      <span style="font-family:var(--mono);font-size:0.78rem;font-weight:700;color:${color}">${entity}</span>
      <span id="qcs-${entity}" style="font-family:var(--mono);font-size:0.67rem;color:${isConn?'var(--green)':'var(--muted)'};">${isConn?'\u2713 connected':'\u25cb not connected'}</span>
      <button id="qcb-${entity}" style="font-family:var(--mono);font-size:0.7rem;padding:5px 12px;border-radius:5px;cursor:pointer;border:1px solid ${color};background:${isConn?color+'22':color};color:${isConn?color:'#000'};font-weight:600">${isConn?'Re-auth':'Connect'}</button>
    `;
    rowsEl.appendChild(row);

    // Attach click — window.open MUST be synchronous inside a user gesture
    row.querySelector(`#qcb-${entity}`).addEventListener('click', function() {
      const authWin = window.open(
        PROXY_BASE + '/auth/qb/connect?entity=' + encodeURIComponent(entity) + '&realmId=' + realmId,
        'qb_auth_' + entity, 'width=600,height=700'
      );

      const btn2 = document.getElementById('qcb-' + entity);
      const st   = document.getElementById('qcs-' + entity);
      if(btn2) { btn2.disabled = true; btn2.textContent = '\u29d0 waiting\u2026'; }
      if(st)   { st.style.color = 'var(--muted)'; st.textContent = '\u29d0 authorising\u2026'; }

      function onMsg(event) {
        if(event.data?.type !== 'QB_AUTH_SUCCESS') return;
        window.removeEventListener('message', onMsg);
        clearInterval(poll);
        const rid = event.data.realmId || realmId;
        fetch(PROXY_BASE + '/auth/qb/load_tokens?realmId=' + rid, { credentials:'include' })
          .then(r => r.json())
          .then(d => {
            if(d.accessToken) {
              qbSaveTokens(d.accessToken, d.refreshToken, Math.round((d.expiry - Date.now())/1000), rid);
              if(st) { st.style.color='var(--green)'; st.textContent='\u2713 connected'; }
              if(btn2) { btn2.disabled=false; btn2.textContent='Re-auth'; btn2.style.background=color+'22'; btn2.style.color=color; }
              updateGlobalBadge();
            }
          })
          .catch(() => {
            if(st) { st.style.color='var(--red)'; st.textContent='\u26a0 failed'; }
            if(btn2) { btn2.disabled=false; btn2.textContent='Retry'; }
          });
      }
      window.addEventListener('message', onMsg);

      const poll = setInterval(() => {
        if(authWin?.closed) {
          clearInterval(poll);
          setTimeout(() => {
            window.removeEventListener('message', onMsg);
            if(btn2 && btn2.disabled) {
              btn2.disabled = false;
              btn2.textContent = 'Retry';
              if(st && st.textContent.includes('authorising')) {
                st.style.color = 'var(--muted)'; st.textContent = '\u25cb cancelled';
              }
            }
          }, 1000);
        }
      }, 500);
    });
  });

  panel.querySelector('#qb-connect-done').addEventListener('click', async () => {
    panel.remove();
    const connected = entities.filter(e => _qb.tokens[QB_REALM_IDS[e]]?.accessToken);
    if(connected.length > 0) {
      const opcoTok = _qb.tokens[QB_REALM_IDS['Opco']];
      if(opcoTok) { _qb.accessToken=opcoTok.accessToken; _qb.refreshToken=opcoTok.refreshToken; _qb.tokenExpiry=opcoTok.tokenExpiry; _qb.realmId=QB_REALM_IDS['Opco']; }
      await qbFetchAccountMap();
    }
  });

  document.body.appendChild(panel);
}


async function pnlConnectAndFetch() {
  const status = document.getElementById('pnl-status');
  const btn    = document.getElementById('pnl-fetch-btn');
  if(status) status.textContent = '⟳ connecting…';
  if(btn) btn.disabled = true;
  const ok = await qbAutoConnect();
  if(btn) btn.disabled = false;
  if(!ok) {
    // Auto-connect failed (no token or expired) — open OAuth popup
    if(status) status.textContent = 'Opening QB login…';
    qbConnect();
    return;
  }
  pnlFetch();
}

function pnlInit() {
  const mSel = document.getElementById('pnl-month');
  const ySel = document.getElementById('pnl-year');
  if(mSel) mSel.value = String(accPeriodMonth);
  if(ySel) ySel.value = String(accPeriodYear);
  // Also set range defaults
  const fmSel = document.getElementById('pnl-from-month');
  const fyS   = document.getElementById('pnl-from-year');
  const tmSel = document.getElementById('pnl-to-month');
  const tyS   = document.getElementById('pnl-to-year');
  if(fmSel) fmSel.value = '1';
  if(fyS)   fyS.value   = String(accPeriodYear);
  if(tmSel) tmSel.value = String(accPeriodMonth);
  if(tyS)   tyS.value   = String(accPeriodYear);
  // Show QB entity connection status
  const badge = document.getElementById('pnl-qb-entities');
  if(badge) {
    const entities = Object.keys(QB_REALM_IDS);
    const parts = entities.map(e => {
      const ok = _qb.tokens[QB_REALM_IDS[e]]?.accessToken;
      return `<span style="color:${ok ? 'var(--green)' : 'var(--muted)'}">${ok ? '✓' : '○'} ${e}</span>`;
    });
    badge.innerHTML = parts.join('<span style="color:var(--border)"> · </span>');
  }
  pnlFetch();
}

function pnlModeChange() {
  const mode = document.getElementById('pnl-mode')?.value || 'month';
  const single = document.getElementById('pnl-picker-single');
  const range  = document.getElementById('pnl-picker-range');
  if(mode === 'range') {
    if(single) single.style.display = 'none';
    if(range)  range.style.display  = 'flex';
  } else {
    if(single) single.style.display = 'flex';
    if(range)  range.style.display  = 'none';
    pnlFetch();
  }
}

// Fetch one month from QB, returns parsed data (uses cache)
async function pnlFetchMonth(entity, year, month) {
  const key     = `${entity}::${year}-${String(month).padStart(2,'0')}`;
  if(_pnlCache[key]) return _pnlCache[key];
  const realmId = QB_REALM_IDS[entity];
  if(!realmId) throw new Error(`No realm for ${entity}`);
  const accessToken = await qbEnsureToken(realmId);
  const lastDay   = new Date(year, month, 0).getDate();
  const startDate = `${year}-${String(month).padStart(2,'0')}-01`;
  const endDate   = `${year}-${String(month).padStart(2,'0')}-${String(lastDay).padStart(2,'0')}`;
  const path = `/v3/company/${realmId}/reports/ProfitAndLoss?start_date=${startDate}&end_date=${endDate}&accounting_method=Accrual&minorversion=65`;
  const res  = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`, {
    credentials: 'include',
    headers: { 'Authorization': `Bearer ${accessToken}` }
  });
  if(!res.ok) throw new Error(`HTTP ${res.status}`);
  const data = await res.json();
  _pnlCache[key] = data;
  return data;
}

async function pnlFetch() {
  const entity = document.getElementById('pnl-entity')?.value || 'Opco';
  const mode   = document.getElementById('pnl-mode')?.value   || 'month';
  const status = document.getElementById('pnl-status');
  const btn    = document.getElementById('pnl-fetch-btn');

  // ── All Entities mode ──
  if(entity === 'All') {
    if(status) status.textContent = '⟳ fetching all…';
    try {
      if(mode === 'month') {
        const month = parseInt(document.getElementById('pnl-month')?.value || accPeriodMonth);
        const year  = parseInt(document.getElementById('pnl-year')?.value  || accPeriodYear);
        const results = await Promise.allSettled(
          Object.keys(QB_REALM_IDS).map(e => pnlFetchMonth(e, year, month))
        );
        if(status) status.textContent = '✓ all loaded';
        pnlRenderAll(results, Object.keys(QB_REALM_IDS), year, month, 'month');
      } else if(mode === 'ytd') {
        const month = parseInt(document.getElementById('pnl-month')?.value || accPeriodMonth);
        const year  = parseInt(document.getElementById('pnl-year')?.value  || accPeriodYear);
        const results = await Promise.allSettled(
          Object.keys(QB_REALM_IDS).map(async e => {
            const realmId   = QB_REALM_IDS[e];
            const ytdKey    = `${e}::YTD-${year}-${String(month).padStart(2,'0')}`;
            if(_pnlCache[ytdKey]) return _pnlCache[ytdKey];
            const accessToken = await qbEnsureToken(realmId);
            const lastDay   = new Date(year, month, 0).getDate();
            const path = `/v3/company/${realmId}/reports/ProfitAndLoss?start_date=${year}-01-01&end_date=${year}-${String(month).padStart(2,'0')}-${String(lastDay).padStart(2,'0')}&accounting_method=Accrual&minorversion=65`;
            const res = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`, { credentials:'include', headers:{'Authorization':`Bearer ${accessToken}`} });
            if(!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            _pnlCache[ytdKey] = data;
            return data;
          })
        );
        if(status) status.textContent = '✓ all loaded';
        pnlRenderAll(results, Object.keys(QB_REALM_IDS), year, month, 'ytd');
      } else if(mode === 'range') {
        const fromMonth = parseInt(document.getElementById('pnl-from-month')?.value || 1);
        const fromYear  = parseInt(document.getElementById('pnl-from-year')?.value  || accPeriodYear);
        const toMonth   = parseInt(document.getElementById('pnl-to-month')?.value   || accPeriodMonth);
        const toYear    = parseInt(document.getElementById('pnl-to-year')?.value    || accPeriodYear);
        const months = [];
        let cy = fromYear, cm = fromMonth;
        while(cy < toYear || (cy === toYear && cm <= toMonth)) {
          months.push({year:cy, month:cm}); cm++; if(cm>12){cm=1;cy++;}
          if(months.length > 24) break;
        }
        if(!months.length) {
          if(status) status.textContent = `⚠ "From" date must be before "To" date`;
          return;
        }
        if(status) status.textContent = `⟳ fetching ${months.length} months × 4 entities…`;
        // Fetch all entities for all months (sequentially to avoid QB 429)
        const allDatasets = {};
        for(const ent of Object.keys(QB_REALM_IDS)) allDatasets[ent] = [];
        for(const m of months) {
          for(const ent of Object.keys(QB_REALM_IDS)) {
            try {
              const d = await pnlFetchMonth(ent, m.year, m.month);
              allDatasets[ent].push({year:m.year, month:m.month, data:d});
            } catch(e) {
              allDatasets[ent].push({year:m.year, month:m.month, data:null, error:e.message});
            }
            await new Promise(r=>setTimeout(r,150));
          }
          if(status) status.textContent = `⟳ ${allDatasets[Object.keys(QB_REALM_IDS)[0]].length}/${months.length} months…`;
        }
        if(status) status.textContent = `✓ ${months.length} months × 4 entities`;
        pnlRenderAllRange(allDatasets, months);
      }
    } catch(e) {
      if(status) status.textContent = `⚠ ${e.message}`;
    }
    return;
  }

  const entityRealmId = QB_REALM_IDS[entity];
  const hasEntityToken = entityRealmId && (_qb.tokens[entityRealmId]?.accessToken || _qb.accessToken);
  if(!hasEntityToken) qbLoadTokens();
  if(!(_qb.tokens[entityRealmId]?.accessToken || _qb.accessToken)) await qbAutoConnect();
  if(!(_qb.tokens[entityRealmId]?.accessToken || _qb.accessToken)) {
    if(status) status.textContent = '⚠ Not connected to QB';
    if(btn) btn.style.display = 'inline-flex';
    return;
  }
  if(btn) btn.style.display = 'none';
  if(status) status.textContent = '⟳ fetching…';

  try {
    if(mode === 'month') {
      const month = parseInt(document.getElementById('pnl-month')?.value || accPeriodMonth);
      const year  = parseInt(document.getElementById('pnl-year')?.value  || accPeriodYear);
      const data  = await pnlFetchMonth(entity, year, month);
      if(status) status.textContent = '✓ loaded';
      pnlRender(data, entity, year, month, 'month');

    } else if(mode === 'ytd') {
      const month = parseInt(document.getElementById('pnl-month')?.value || accPeriodMonth);
      const year  = parseInt(document.getElementById('pnl-year')?.value  || accPeriodYear);
      // QB supports start_date=YYYY-01-01 end_date=YYYY-MM-DD for YTD
      const realmId = QB_REALM_IDS[entity];
      const ytdKey  = `${entity}::YTD-${year}-${String(month).padStart(2,'0')}`;
      let data;
      if(_pnlCache[ytdKey]) {
        data = _pnlCache[ytdKey];
      } else {
        const accessToken = await qbEnsureToken(realmId);
        const lastDay   = new Date(year, month, 0).getDate();
        const startDate = `${year}-01-01`;
        const endDate   = `${year}-${String(month).padStart(2,'0')}-${String(lastDay).padStart(2,'0')}`;
        const path = `/v3/company/${realmId}/reports/ProfitAndLoss?start_date=${startDate}&end_date=${endDate}&accounting_method=Accrual&minorversion=65`;
        const res  = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`, {
          credentials: 'include',
          headers: { 'Authorization': `Bearer ${accessToken}` }
        });
        if(!res.ok) throw new Error(`HTTP ${res.status}`);
        data = await res.json();
        _pnlCache[ytdKey] = data;
      }
      if(status) status.textContent = '✓ loaded';
      pnlRender(data, entity, year, month, 'ytd');

    } else if(mode === 'range') {
      const fromMonth = parseInt(document.getElementById('pnl-from-month')?.value || 1);
      const fromYear  = parseInt(document.getElementById('pnl-from-year')?.value  || accPeriodYear);
      const toMonth   = parseInt(document.getElementById('pnl-to-month')?.value   || accPeriodMonth);
      const toYear    = parseInt(document.getElementById('pnl-to-year')?.value    || accPeriodYear);

      // Build list of (year, month) pairs
      const months = [];
      let cy = fromYear, cm = fromMonth;
      while(cy < toYear || (cy === toYear && cm <= toMonth)) {
        months.push({year: cy, month: cm});
        cm++; if(cm > 12) { cm = 1; cy++; }
        if(months.length > 24) break; // safety cap
      }

      if(status) status.textContent = `⟳ fetching ${months.length} months…`;
      const datasets = [];
      for(const m of months) {
        const d = await pnlFetchMonth(entity, m.year, m.month);
        datasets.push({year: m.year, month: m.month, data: d});
        if(status) status.textContent = `⟳ ${datasets.length}/${months.length}…`;
        if(datasets.length < months.length) await new Promise(r => setTimeout(r, 300)); // avoid QB 429
      }
      if(status) status.textContent = `✓ ${months.length} months loaded`;
      pnlRenderRange(datasets, entity);
    }
  } catch(e) {
    if(status) status.textContent = `⚠ ${e.message}`;
  }
}

// ── P&L All Entities — consolidated view ─────────────────────────
function pnlRenderAll(results, entityNames, year, month, mode) {
  const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const cards = document.getElementById('pnl-cards');
  const body  = document.getElementById('pnl-body');
  if(!cards || !body) return;

  function parseAmount(v) { return parseFloat(v) || 0; }

  function flattenSection(row) {
    const header = row.Header?.ColData?.[0]?.value || '';
    const items  = [];
    const subsections = [];
    function walkRows(rowArr) {
      for(const r of (rowArr||[])) {
        if(r.type === 'Section') { subsections.push(flattenSection(r)); }
        else {
          if(r.Rows?.Row) walkRows(r.Rows.Row);
          if(r.type === 'Data') {
            const cols = r.ColData || [];
            const name = cols[0]?.value || '—';
            const amt  = parseAmount(cols[1]?.value);
            if(name && name !== 'Net Income') items.push({name, amt});
          }
        }
      }
    }
    walkRows(row.Rows?.Row);
    const total = parseAmount(row.Summary?.ColData?.[1]?.value);
    return {title: header, items, subsections, total};
  }

  // Store results globally so we don't need to serialize into onclick
  window._pnlAllResults     = results;
  window._pnlAllEntityNames = entityNames;
  window._pnlAllYear        = year;
  window._pnlAllMonth       = month;
  window._pnlAllMode        = mode;

  // Parse each entity's data into sections
  const entitySections = {};
  let totalRevAll = 0, totalExpAll = 0;

  entityNames.forEach((ent, i) => {
    const res = results[i];
    if(res.status !== 'fulfilled' || !res.value) {
      entitySections[ent] = { error: res.reason?.message || 'Failed', sections: [] };
      return;
    }
    const data = res.value;
    const rawSections = [];
    for(const row of (data?.Rows?.Row||[])) {
      if(row.type === 'Section') rawSections.push(flattenSection(row));
    }
    const named = rawSections.filter(s => s.title.trim() !== '');
    const isIncome  = s => /^income|^revenue|other income/i.test(s.title);
    const isExpense = s => /expense/i.test(s.title);
    const rev = named.filter(isIncome).reduce((s,r)=>s+r.total,0);
    const exp = named.filter(isExpense).reduce((s,r)=>s+r.total,0);
    // Read net directly from QB's unnamed summary section
    const _netRows = (res.value?.Rows?.Row||[]).filter(r => r.type==='Section' && !r.Header?.ColData?.[0]?.value?.trim()); const _netRow = _netRows[_netRows.length-1];
    const net = _netRow ? (parseAmount(_netRow.Summary?.ColData?.[1]?.value)) : (
      named.filter(s=>/^income|^revenue/i.test(s.title)).reduce((s,r)=>s+r.total,0) -
      Math.abs(named.filter(s=>/^expenses?$/i.test(s.title)).reduce((s,r)=>s+r.total,0)) +
      named.filter(s=>/other income/i.test(s.title)).reduce((s,r)=>s+r.total,0) -
      Math.abs(named.filter(s=>/other expenses?/i.test(s.title)).reduce((s,r)=>s+r.total,0))
    );
    totalRevAll += rev;
    totalExpAll += Math.abs(exp);
    entitySections[ent] = { sections: named, rev, exp, net };
  });

  const netAll  = totalRevAll - totalExpAll;
  const netCls  = netAll >= 0 ? 'green' : 'red';
  const period  = mode === 'ytd'
    ? `Jan – ${MONTH_NAMES[month-1]} ${year}`
    : `${MONTH_NAMES[month-1]} ${year}`;

  // Cards — consolidated totals
  cards.innerHTML = `
    <div class="card"><div class="card-label">Total Revenue (All)</div><div class="card-value green">${fmtUSD(totalRevAll)}</div></div>
    <div class="card"><div class="card-label">Total Expenses (All)</div><div class="card-value red">${fmtUSD(totalExpAll)}</div></div>
    <div class="card"><div class="card-label">Net Income (All)</div><div class="card-value ${netCls}">${netAll>=0?'+':''}${fmtUSD(netAll)}</div></div>
    <div class="card"><div class="card-label">Period</div><div class="card-value" style="font-size:0.9rem">${period}</div></div>
  `;

  // Per-entity breakdown cards
  let html = `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin-bottom:24px">`;
  for(const ent of entityNames) {
    const ed = entitySections[ent];
    if(ed.error) {
      html += `<div class="card" style="border-color:var(--red)">
        <div class="card-label">${ent}</div>
        <div style="font-family:var(--mono);font-size:0.7rem;color:var(--red);margin-top:4px">⚠ ${ed.error}</div>
      </div>`;
    } else {
      const nc = ed.net >= 0 ? 'var(--green)' : 'var(--red)';
      html += `<div class="card">
        <div class="card-label" style="font-weight:700">${ent}</div>
        <div style="display:flex;justify-content:space-between;font-family:var(--mono);font-size:0.72rem;margin-top:8px">
          <span style="color:var(--muted)">Revenue</span><span style="color:var(--green)">${fmtUSD(ed.rev)}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-family:var(--mono);font-size:0.72rem;margin-top:4px">
          <span style="color:var(--muted)">Expenses</span><span style="color:var(--red)">${fmtUSD(ed.exp)}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-family:var(--mono);font-size:0.78rem;margin-top:8px;border-top:1px solid var(--border);padding-top:8px;font-weight:700">
          <span>Net</span><span style="color:${nc}">${ed.net>=0?'+':''}${fmtUSD(ed.net)}</span>
        </div>
      </div>`;
    }
  }
  html += `</div>`;

  // Date range for GL drilldown
  const _lastDay = new Date(year, month, 0).getDate();
  const _mm  = String(month).padStart(2,'0');
  const _sd  = mode === 'ytd' ? `${year}-01-01` : `${year}-${_mm}-01`;
  const _ed  = `${year}-${_mm}-${String(_lastDay).padStart(2,'0')}`;

  // Store entity amounts per account name for GL modal context
  window._pnlAllEntityAmounts = {};

  // Collect all unique section titles across all entities
  const allTitles = [];
  for(const ent of entityNames) {
    for(const sec of (entitySections[ent].sections||[])) {
      if(!allTitles.includes(sec.title)) allTitles.push(sec.title);
    }
  }

  if(!window._pnlExpanded) window._pnlExpanded = new Set();

  // For each section, show one expandable block with columns per entity
  for(const title of allTitles) {
    const isExp = /expense/i.test(title);
    const color = isExp ? 'var(--red)' : /other income/i.test(title) ? '#06A0C4' : 'var(--green)';

    // Collect all line items across entities for this section
    const allItems = new Map(); // name → {[entity]: amt}
    let sectionTotals = {};
    for(const ent of entityNames) {
      const sec = (entitySections[ent].sections||[]).find(s=>s.title===title);
      if(!sec) { sectionTotals[ent] = 0; continue; }
      sectionTotals[ent] = sec.total;
      const flat = [];
      function collectItems(s) { flat.push(...s.items); s.subsections.forEach(collectItems); }
      collectItems(sec);
      for(const item of flat) {
        if(!allItems.has(item.name)) allItems.set(item.name, {});
        allItems.get(item.name)[ent] = (allItems.get(item.name)[ent]||0) + item.amt;
        if(!window._pnlAllEntityAmounts[item.name]) window._pnlAllEntityAmounts[item.name] = {};
        window._pnlAllEntityAmounts[item.name][ent] = (window._pnlAllEntityAmounts[item.name][ent]||0) + item.amt;
      }
    }

    const rowTotal = entityNames.reduce((s,e)=>s+(sectionTotals[e]||0),0);
    const secKey = `all_${title}`;
    const isExpanded = window._pnlExpanded.has(secKey);

    // Use data-seckey instead of inline onclick with serialized data
    html += `<div style="margin-bottom:8px;border:1px solid var(--border);border-radius:8px;overflow:hidden">
      <div class="pnl-all-sec-toggle" data-seckey="${secKey}"
           style="display:flex;justify-content:space-between;align-items:center;padding:11px 18px;background:var(--surface);cursor:pointer;user-select:none">
        <span style="font-family:var(--sans);font-size:0.8rem;font-weight:600;color:${color}">${isExpanded?'▾':'▸'} ${title}</span>
        <span style="font-family:var(--mono);font-size:0.78rem;color:${color}">${fmtUSD(Math.abs(rowTotal))}</span>
      </div>`;

    if(isExpanded) {
      html += `<table style="width:100%;border-collapse:collapse">
        <thead><tr style="background:var(--bg)">
          <th style="padding:6px 18px;font-family:var(--mono);font-size:0.65rem;text-align:left;color:var(--muted);font-weight:500">Account</th>
          ${entityNames.map(e=>`<th style="padding:6px 12px;font-family:var(--mono);font-size:0.65rem;text-align:right;color:var(--muted);font-weight:500">${e}</th>`).join('')}
          <th style="padding:6px 18px;font-family:var(--mono);font-size:0.65rem;text-align:right;color:var(--muted);font-weight:500">Total</th>
        </tr></thead><tbody>`;

      for(const [name, byEnt] of allItems) {
        const rowSum = entityNames.reduce((s,e)=>s+(byEnt[e]||0),0);
        const glCode = name.match(/^(\d{4,})/)?.[1] || null;
        const encName = encodeURIComponent(name);
        const glBadge = glCode
          ? `<span class="pnl-gl-all-trigger" data-name="${encName}" data-startdate="${_sd}" data-enddate="${_ed}"
               style="font-family:var(--mono);font-size:0.6rem;color:var(--accent);background:var(--accent-bg);
               border-radius:3px;padding:1px 5px;margin-right:7px;cursor:pointer;border:1px solid var(--accent)"
               title="Click to see GL for all entities">${glCode}</span>`
          : '';
        html += `<tr style="border-top:1px solid var(--border)">
          <td style="padding:7px 18px;font-family:var(--sans);font-size:0.73rem;color:var(--text)">
            <div style="display:flex;align-items:center">
              ${glBadge}
              <span class="pnl-gl-all-trigger" data-name="${encName}" data-startdate="${_sd}" data-enddate="${_ed}"
                style="cursor:pointer">${name}</span>
            </div>
          </td>
          ${entityNames.map(e=>`<td style="padding:7px 12px;font-family:var(--mono);font-size:0.72rem;text-align:right;color:var(--muted)">${byEnt[e]?fmtUSD(Math.abs(byEnt[e])):'—'}</td>`).join('')}
          <td style="padding:7px 18px;font-family:var(--mono);font-size:0.72rem;text-align:right;font-weight:600;color:${color}">${fmtUSD(Math.abs(rowSum))}</td>
        </tr>`;
      }

      // Section total row
      html += `<tr style="border-top:2px solid var(--border);background:var(--surface)">
        <td style="padding:8px 18px;font-family:var(--mono);font-size:0.72rem;font-weight:700;color:${color}">Total ${title}</td>
        ${entityNames.map(e=>`<td style="padding:8px 12px;font-family:var(--mono);font-size:0.72rem;text-align:right;font-weight:600;color:${color}">${fmtUSD(Math.abs(sectionTotals[e]||0))}</td>`).join('')}
        <td style="padding:8px 18px;font-family:var(--mono);font-size:0.72rem;text-align:right;font-weight:700;color:${color}">${fmtUSD(Math.abs(rowTotal))}</td>
      </tr></tbody></table>`;
    }
    html += `</div>`;
  }

  // Net Income row
  html += `<div style="display:flex;justify-content:space-between;padding:14px 18px;background:var(--surface);border:1px solid var(--border);border-radius:8px;margin-top:4px">
    <span style="font-family:var(--mono);font-size:0.8rem;font-weight:700">Net Income</span>
    <div style="display:flex;gap:24px">
      ${entityNames.map(e=>{
        const ed=entitySections[e]; if(ed.error) return `<span style="font-family:var(--mono);font-size:0.75rem;color:var(--muted)">${e}: ⚠</span>`;
        const nc2=ed.net>=0?'var(--green)':'var(--red)';
        return `<span style="font-family:var(--mono);font-size:0.75rem;color:var(--muted)">${e}: <span style="color:${nc2};font-weight:600">${ed.net>=0?'+':''}${fmtUSD(ed.net)}</span></span>`;
      }).join('')}
      <span style="font-family:var(--mono);font-size:0.8rem;font-weight:700;color:${netCls}">${netAll>=0?'+':''}${fmtUSD(netAll)}</span>
    </div>
  </div>`;

  body.innerHTML = html;

  // Listeners handled by global document delegation (see bottom of file)
}

function pnlRenderAllRange(allDatasets, months) {
  const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const cards = document.getElementById('pnl-cards');
  const body  = document.getElementById('pnl-body');
  if(!cards || !body) return;
  if(!months || !months.length) {
    cards.innerHTML = `<div style="color:var(--red);font-family:var(--mono);font-size:0.8rem;padding:12px">⚠ Invalid date range — "From" must be before "To".</div>`;
    body.innerHTML = '';
    return;
  }

  function parseAmount(v) { return parseFloat(v) || 0; }

  window._pnlAllRangeDatasets = allDatasets;
  window._pnlAllRangeMonths   = months;

  const entities = Object.keys(allDatasets);

  // ── Parse helpers ──────────────────────────────────────────────────────────
  function flattenSection(row) {
    const header = row.Header?.ColData?.[0]?.value || '';
    const items  = [];
    const subsections = [];
    function walkRows(rowArr) {
      for(const r of (rowArr||[])) {
        if(r.type === 'Section') { subsections.push(flattenSection(r)); }
        else {
          if(r.Rows?.Row) walkRows(r.Rows.Row);
          if(r.type === 'Data') {
            const cols = r.ColData || [];
            const name = cols[0]?.value || '—';
            const amt  = parseAmount(cols[1]?.value);
            if(name && name !== 'Net Income') items.push({name, amt});
          }
        }
      }
    }
    walkRows(row.Rows?.Row);
    const total = parseAmount(row.Summary?.ColData?.[1]?.value);
    return {title: header, items, subsections, total};
  }

  function parseSections(data) {
    const out = [];
    for(const row of (data?.Rows?.Row||[])) {
      if(row.type === 'Section') {
        const sec = flattenSection(row);
        if(sec.title.trim()) out.push(sec);
      }
    }
    return out;
  }

  // ── Build merged section/item structure (union across all entities & months) ─
  const allTitles = [];
  const allItemsPerSection = new Map();

  for(const ent of entities) {
    for(const m of allDatasets[ent]) {
      if(!m.data) continue;
      for(const sec of parseSections(m.data)) {
        if(!allTitles.includes(sec.title)) allTitles.push(sec.title);
        if(!allItemsPerSection.has(sec.title)) allItemsPerSection.set(sec.title, []);
        const flat = [];
        function collectItems(s) { flat.push(...s.items); s.subsections.forEach(collectItems); }
        collectItems(sec);
        for(const item of flat) {
          const list = allItemsPerSection.get(sec.title);
          if(!list.find(i=>i.name===item.name)) list.push({name: item.name});
        }
      }
    }
  }

  // ── Get item amount: sum across all entities for a given month ─────────────
  function getItemAmtAllEntities(m, sectionTitle, itemName) {
    let total = 0;
    for(const ent of entities) {
      const ds = allDatasets[ent].find(d=>d.year===m.year&&d.month===m.month);
      if(!ds?.data) continue;
      for(const sec of parseSections(ds.data)) {
        if(sec.title !== sectionTitle) continue;
        const flat = [];
        function collectItems2(s) { flat.push(...s.items); s.subsections.forEach(collectItems2); }
        collectItems2(sec);
        const found = flat.find(i=>i.name===itemName);
        if(found) total += found.amt;
      }
    }
    return total;
  }

  function getSecTotalAllEntities(m, sectionTitle) {
    let total = 0;
    for(const ent of entities) {
      const ds = allDatasets[ent].find(d=>d.year===m.year&&d.month===m.month);
      if(!ds?.data) continue;
      for(const sec of parseSections(ds.data)) {
        if(sec.title === sectionTitle) total += sec.total;
      }
    }
    return total;
  }

  // ── Cards ──────────────────────────────────────────────────────────────────
  const isIncome  = t => /^income|^revenue|other income/i.test(t);
  const isExpense = t => /expense/i.test(t);
  let totalRev = 0, totalExp = 0;
  for(const ent of entities) {
    for(const m of allDatasets[ent]) {
      if(!m.data) continue;
      for(const sec of parseSections(m.data)) {
        if(isIncome(sec.title))  totalRev += sec.total;
        if(isExpense(sec.title)) totalExp += Math.abs(sec.total);
      }
    }
  }
  const totalNet = totalRev - totalExp;
  const netCls = totalNet >= 0 ? 'green' : 'red';
  const periodLabel = `${MONTH_NAMES[months[0].month-1]} ${months[0].year} – ${MONTH_NAMES[months[months.length-1].month-1]} ${months[months.length-1].year}`;

  cards.innerHTML = `
    <div class="card"><div class="card-label">Total Revenue</div><div class="card-value green">${fmtUSD(totalRev)}</div></div>
    <div class="card"><div class="card-label">Total Expenses</div><div class="card-value red">${fmtUSD(totalExp)}</div></div>
    <div class="card"><div class="card-label">Net Income</div><div class="card-value ${netCls}">${totalNet>=0?'+':''}${fmtUSD(totalNet)}</div></div>
    <div class="card"><div class="card-label">Period</div><div class="card-value" style="font-size:0.85rem">${periodLabel}</div></div>
  `;

  if(!window._pnlExpanded) window._pnlExpanded = new Set();

  // ── Table layout (colunas = meses) ─────────────────────────────────────────
  const N = months.length;
  const colLabels = months.map(m => `${MONTH_NAMES[m.month-1]} ${m.year}`);
  const colW = Math.max(90, Math.min(130, Math.floor(800/N)));
  const totalTableW = 260 + colW * N + 110;

  const thStyle = `padding:9px 12px;font-family:var(--mono);font-size:0.7rem;font-weight:700;text-align:right;white-space:nowrap;border-bottom:2px solid var(--border);color:var(--accent);width:${colW}px`;
  const tdNum   = `padding:7px 12px;font-family:var(--mono);font-size:0.73rem;text-align:right;white-space:nowrap;border-top:1px solid var(--border)`;
  const labelTh = `padding:9px 18px;font-family:var(--sans);font-size:0.75rem;font-weight:700;text-align:left;border-bottom:2px solid var(--border);color:var(--muted);width:260px`;
  const labelTd = (pl) => `padding:7px ${pl}px;font-family:var(--sans);font-size:0.75rem;text-align:left;border-top:1px solid var(--border)`;
  const thTotal = `padding:9px 14px;font-family:var(--mono);font-size:0.7rem;font-weight:700;text-align:right;white-space:nowrap;border-bottom:2px solid var(--border);color:var(--text);width:110px`;
  const tdTotal = `padding:7px 14px;font-family:var(--mono);font-size:0.73rem;text-align:right;white-space:nowrap;border-top:1px solid var(--border);font-weight:700`;

  function colorFor(t) {
    if(/expense/i.test(t))           return 'var(--red)';
    if(/other income|loss/i.test(t)) return '#06A0C4';
    return 'var(--green)';
  }

  let html = `<div style="overflow-x:auto;margin-top:4px;width:100%">
  <table style="table-layout:fixed;min-width:${totalTableW}px;width:100%;border-collapse:collapse">
    <colgroup>
      <col style="width:260px">
      ${colLabels.map(()=>`<col style="width:${colW}px">`).join('')}
      <col style="width:110px">
    </colgroup>
    <thead>
      <tr style="background:var(--surface2)">
        <th style="${labelTh}">Account</th>
        ${colLabels.map(l=>`<th style="${thStyle}">${l}</th>`).join('')}
        <th style="${thTotal}">Total</th>
      </tr>
    </thead>
    <tbody>`;

  for(const title of allTitles) {
    const color = colorFor(title);
    const secTotalsByMonth = months.map(m => getSecTotalAllEntities(m, title));
    const secGrandTotal = secTotalsByMonth.reduce((s,v)=>s+v, 0);

    // Section header row
    html += `<tr style="background:var(--surface2)">
      <td style="${labelTd(18)};font-weight:700;color:${color}">${title}</td>
      ${secTotalsByMonth.map(v=>`<td style="${tdNum};font-weight:700;color:${color}">${v!==0?fmtUSD(Math.abs(v)):'—'}</td>`).join('')}
      <td style="${tdTotal};color:${color}">${fmtUSD(Math.abs(secGrandTotal))}</td>
    </tr>`;

    // Item rows
    const items = allItemsPerSection.get(title) || [];
    for(const item of items) {
      const valsByMonth = months.map(m => getItemAmtAllEntities(m, title, item.name));
      const rowTotal = valsByMonth.reduce((s,v)=>s+v, 0);
      const glCode = item.name.match(/^(\d{4,})/)?.[1] || null;
      const encName = encodeURIComponent(item.name);

      const firstM = months[0];
      const lastM  = months[months.length-1];
      const _sd = `${firstM.year}-${String(firstM.month).padStart(2,'0')}-01`;
      const lastDay = new Date(lastM.year, lastM.month, 0).getDate();
      const _ed = `${lastM.year}-${String(lastM.month).padStart(2,'0')}-${String(lastDay).padStart(2,'0')}`;

      const glBadge = glCode
        ? `<span class="pnl-gl-all-trigger" data-name="${encName}" data-startdate="${_sd}" data-enddate="${_ed}"
             style="font-family:var(--mono);font-size:0.6rem;color:var(--accent);background:var(--accent-bg);
             border-radius:3px;padding:1px 5px;margin-right:7px;cursor:pointer;border:1px solid var(--accent)"
             title="Click to see GL for all entities">${glCode}</span>`
        : '';

      html += `<tr>
        <td style="${labelTd(32)};color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
          <div style="display:flex;align-items:center">
            ${glBadge}
            <span class="pnl-gl-all-trigger" data-name="${encName}" data-startdate="${_sd}" data-enddate="${_ed}"
              style="cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${item.name}</span>
          </div>
        </td>
        ${valsByMonth.map((v, i) => {
          const m = months[i];
          const mm = String(m.month).padStart(2,'0');
          const ld = new Date(m.year, m.month, 0).getDate();
          const sd = `${m.year}-${mm}-01`;
          const ed = `${m.year}-${mm}-${String(ld).padStart(2,'0')}`;
          return `<td style="${tdNum};color:var(--muted);cursor:pointer"
            class="pnl-gl-all-trigger pnl-gl-cell" data-name="${encName}" data-startdate="${sd}" data-enddate="${ed}"
            onmouseover="this.style.background='rgba(6,214,160,0.08)';this.style.color='var(--accent)'"
            onmouseout="this.style.background='';this.style.color='var(--muted)'"
          >${v!==0?fmtUSD(Math.abs(v)):'—'}</td>`;
        }).join('')}
        <td style="${tdTotal};color:${color}">${rowTotal!==0?fmtUSD(Math.abs(rowTotal)):'—'}</td>
      </tr>`;
    }
  }

  // Net Income footer row
  const netByMonth = months.map(m => {
    let net = 0;
    for(const ent of entities) {
      const ds = allDatasets[ent].find(d=>d.year===m.year&&d.month===m.month);
      if(!ds?.data) continue;
      const _netRows = (ds.data?.Rows?.Row||[]).filter(r => r.type==='Section' && !r.Header?.ColData?.[0]?.value?.trim());
      const _netRow = _netRows[_netRows.length-1];
      if(_netRow) { net += parseAmount(_netRow.Summary?.ColData?.[1]?.value); continue; }
      let r2=0, e2=0, oi=0, oe=0;
      for(const sec of parseSections(ds.data)) {
        const v = sec.total;
        if(/^income|^revenue/i.test(sec.title))  r2 += v;
        if(/^expenses?$/i.test(sec.title)) e2 += Math.abs(v);
        if(/other income/i.test(sec.title)) oi += v;
        if(/other expenses?/i.test(sec.title)) oe += Math.abs(v);
      }
      net += r2 - e2 + oi - oe;
    }
    return net;
  });
  const netGrandTotal = netByMonth.reduce((s,v)=>s+v,0);

  html += `<tr style="border-top:2px solid var(--border);background:var(--surface2)">
    <td style="${labelTd(18)};font-weight:800;color:var(--text)">Net Income</td>
    ${netByMonth.map(v=>`<td style="${tdNum};font-weight:800;color:${v>=0?'var(--green)':'var(--red)'};">${v>=0?'+':''}${fmtUSD(v)}</td>`).join('')}
    <td style="${tdTotal};color:${netGrandTotal>=0?'var(--green)':'var(--red)'}">${netGrandTotal>=0?'+':''}${fmtUSD(netGrandTotal)}</td>
  </tr>`;

  html += `</tbody></table></div>`;
  body.innerHTML = html;

  // Listeners handled by global document delegation (see bottom of file)
}



function pnlRender(data, entity, year, month, mode='month') {
  const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const cards  = document.getElementById('pnl-cards');
  const body   = document.getElementById('pnl-body');
  if(!cards || !body) return;

  function parseAmount(v) { return parseFloat(v) || 0; }

  function flattenSection(row) {
    const header = row.Header?.ColData?.[0]?.value || '';
    const items  = [];
    const subsections = [];
    function walkRows(rowArr) {
      for(const r of (rowArr||[])) {
        if(r.type === 'Section') {
          subsections.push(flattenSection(r));
        } else {
          if(r.Rows?.Row) walkRows(r.Rows.Row);
          if(r.type === 'Data') {
            const cols = r.ColData || [];
            const name = cols[0]?.value || '—';
            const id   = cols[0]?.id   || null;
            const amt  = parseAmount(cols[1]?.value);
            if(name && name !== 'Net Income') items.push({name, amt, id});
          }
        }
      }
    }
    walkRows(row.Rows?.Row);
    const summaryAmt = parseAmount(row.Summary?.ColData?.[1]?.value);
    return {title: header, items, subsections, total: summaryAmt};
  }

  const rawSections = [];
  for(const row of (data?.Rows?.Row||[])) {
    if(row.type === 'Section') rawSections.push(flattenSection(row));
  }

  // Filter out blank/empty sections (no title = QB summary rows like Net Income subtotals)
  const namedSections = rawSections.filter(s => s.title.trim() !== '');

  // Compute totals for cards
  const isIncome  = s => /^income|^revenue|other income/i.test(s.title);
  const isExpense = s => /expense/i.test(s.title);
  const totalRev  = namedSections.filter(isIncome).reduce((s,r)=>s+r.total,0);
  const totalExp  = namedSections.filter(isExpense).reduce((s,r)=>s+r.total,0);
  // Net Income: use QB's own calculation — look for Net Income row in raw data
  // QB has a final unnamed section or a row where ColData[0].value = 'Net Income'
  let netIncome = 0;
  const _netRows = (data?.Rows?.Row||[]).filter(r => r.type==='Section' && !r.Header?.ColData?.[0]?.value?.trim()); const _netRow = _netRows[_netRows.length-1];
  if(_netRow) {
    netIncome = parseAmount(_netRow.Summary?.ColData?.[1]?.value);
  }
  // Fallback: Income sections minus Expense sections (with correct signs from QB)
  if(netIncome === 0) {
    const _inc = namedSections.filter(s=>/^income|^revenue/i.test(s.title)).reduce((s,r)=>s+r.total,0);
    const _otherInc = namedSections.filter(s=>/other income/i.test(s.title)).reduce((s,r)=>s+r.total,0);
    const _exp = namedSections.filter(s=>/^expenses?$/i.test(s.title)).reduce((s,r)=>s+r.total,0);
    const _otherExp = namedSections.filter(s=>/other expenses?/i.test(s.title)).reduce((s,r)=>s+r.total,0);
    netIncome = _inc - Math.abs(_exp) + _otherInc - Math.abs(_otherExp);
  }

  const netCls = netIncome >= 0 ? 'green' : 'red';
  cards.innerHTML = `
    <div class="card"><div class="card-label">Total Revenue</div><div class="card-value green">${fmtUSD(totalRev)}</div></div>
    <div class="card"><div class="card-label">Total Expenses</div><div class="card-value red">${fmtUSD(Math.abs(totalExp))}</div></div>
    <div class="card"><div class="card-label">Net Income</div><div class="card-value ${netCls}">${netIncome>=0?'+':''}${fmtUSD(netIncome)}</div></div>
    <div class="card"><div class="card-label">Period</div><div class="card-value" style="font-size:0.9rem">${mode==='ytd'?`Jan – ${MONTH_NAMES[month-1]} ${year}`:MONTH_NAMES[month-1]+' '+year}</div></div>
  `;

  if(!window._pnlExpanded)   window._pnlExpanded   = new Set();
  if(!window._pnlGLExpanded) window._pnlGLExpanded = new Set(); // tracks expanded GL account ids

  function sectionColor(title) {
    if(/expense/i.test(title))      return 'var(--red)';
    if(/other income/i.test(title)) return '#06A0C4';
    return 'var(--green)';
  }

  // Render items table — clicking GL badge/name opens modal
  function renderItems(items, indent) {
    if(!items.length) return '';
    const lastDay = new Date(year, month, 0).getDate();
    const mm = String(month).padStart(2,'0');
    const _sd = mode === 'ytd' ? `${year}-01-01` : `${year}-${mm}-01`;
    const _ed = `${year}-${mm}-${String(lastDay).padStart(2,'0')}`;

    let html = `<table style="width:100%;border-collapse:collapse">`;
    for(const item of items) {
      const glCode  = item.name.match(/^(\d{4,})/)?.[1] || null;
      const encId   = encodeURIComponent(item.id || item.name);
      const encName = encodeURIComponent(item.name);
      const tAttrs  = `class="pnl-gl-trigger" data-id="${encId}" data-name="${encName}" data-year="${year}" data-month="${month}" data-startdate="${_sd}" data-enddate="${_ed}"`;

      const glBadge = glCode
        ? `<span ${tAttrs}
            style="font-family:var(--mono);font-size:0.6rem;color:var(--accent);background:var(--accent-bg);
            border-radius:3px;padding:1px 5px;margin-right:7px;cursor:pointer;border:1px solid var(--accent)"
            title="Click to see GL transactions">${glCode}</span>`
        : '';

      html += `<tr style="border-top:1px solid var(--border)">
        <td style="padding:8px 18px 8px ${indent}px;font-family:var(--sans);font-size:0.75rem;color:var(--text)">
          <div style="display:flex;align-items:center">
            ${glBadge}
            <span ${tAttrs} style="cursor:pointer">${item.name}</span>
          </div>
        </td>
        <td style="padding:8px 18px;font-family:var(--mono);font-size:0.75rem;text-align:right;color:var(--muted);white-space:nowrap">${fmtUSD(Math.abs(item.amt))}</td>
      </tr>`;
    }
    html += `</table>`;
    return html;
  }


  function renderSection(sec) {
    if(!sec || sec.title.trim() === '') return ''; // skip blank sections
    if(!sec.items.length && !sec.subsections.length && !sec.total) return '';
    const isExp   = window._pnlExpanded.has(sec.title);
    const chevron = isExp ? '▾' : '▸';
    const color   = sectionColor(sec.title);
    const safeTitle = sec.title.replace(/"/g,'&quot;'); // browser auto-decodes &quot; in dataset

    let html = `
      <div style="border:1px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:12px">
        <div class="pnl-sec-toggle" data-title="${safeTitle}" data-raw-title="${safeTitle}" style="display:flex;justify-content:space-between;align-items:center;
          padding:13px 18px;background:var(--surface2);cursor:pointer;user-select:none"
          onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='var(--surface2)'">
          <span style="font-family:var(--sans);font-size:0.82rem;font-weight:600;color:${color}">
            <span style="margin-right:7px;font-size:0.7rem">${chevron}</span>${sec.title}
          </span>
          <span style="font-family:var(--mono);font-size:0.85rem;font-weight:700;color:${color}">${fmtUSD(Math.abs(sec.total))}</span>
        </div>`;

    if(isExp) {
      html += renderItems(sec.items, 32);
      for(const sub of sec.subsections) {
        if(!sub.title.trim()) continue;
        const subExp  = window._pnlExpanded.has(sub.title);
        const subChev = subExp ? '▾' : '▸';
        const safeSubTitle = sub.title.replace(/"/g,"&quot;");
        html += `
          <div style="border-top:1px solid var(--border)">
            <div class="pnl-sec-toggle" data-title="${safeSubTitle}" style="display:flex;justify-content:space-between;align-items:center;
              padding:10px 18px 10px 32px;background:rgba(255,255,255,0.02);cursor:pointer;user-select:none"
              onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background='rgba(255,255,255,0.02)'">
              <span style="font-family:var(--sans);font-size:0.77rem;font-weight:600;color:var(--muted)">
                <span style="margin-right:6px;font-size:0.65rem">${subChev}</span>${sub.title}
              </span>
              <span style="font-family:var(--mono);font-size:0.77rem;color:var(--muted)">${fmtUSD(Math.abs(sub.total))}</span>
            </div>`;
        if(subExp) html += renderItems(sub.items, 48);
        html += `</div>`;
      }
    }
    html += `</div>`;
    return html;
  }

  const netRow = `<div style="display:flex;justify-content:flex-end;align-items:center;
    padding:14px 18px;border:1px solid var(--border);border-radius:8px;margin-top:4px">
    <span style="font-family:var(--sans);font-size:0.85rem;font-weight:700;color:var(--text);margin-right:32px">Net Income</span>
    <span style="font-family:var(--mono);font-size:0.92rem;font-weight:800;color:${netIncome>=0?'var(--green)':'var(--red)'}">
      ${netIncome>=0?'+':''}${fmtUSD(netIncome)}
    </span>
  </div>`;

  body.innerHTML = `<div style="width:100%;max-width:900px;margin:0 auto">` + namedSections.map(s => renderSection(s)).join('') + netRow + `</div>`;
  // Add click handler only once via a flag on the element
  if(!body._pnlClickBound) {
    body._pnlClickBound = true;
    body.addEventListener('click', function(e) {
      const glTrigger = e.target.closest('.pnl-gl-trigger');
      if(glTrigger) {
        e.stopPropagation();
        const id        = decodeURIComponent(glTrigger.dataset.id || '');
        const name      = decodeURIComponent(glTrigger.dataset.name || '');
        const year      = parseInt(glTrigger.dataset.year);
        const month     = parseInt(glTrigger.dataset.month);
        const startDate = glTrigger.dataset.startdate || null;
        const endDate   = glTrigger.dataset.enddate   || null;
        pnlGLDrill(e, id, id, name, year, month, startDate, endDate);
        return;
      }
      const toggle = e.target.closest('.pnl-sec-toggle');
      if(toggle) {
        const title = toggle.dataset.title;
        if(title) pnlToggle(title);
      }
    });
  }
}

// ── Range view: months as columns ────────────────────────────────────────
function pnlRenderRange(datasets, entity) {
  const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const cards = document.getElementById('pnl-cards');
  const body  = document.getElementById('pnl-body');
  if(!cards || !body) return;

  function parseAmt(v) { return parseFloat(v) || 0; }

  // Parse QB P&L into a clean tree: [{title, total, items:[{name,id,amt}], subsections:[...]}]
  // Only returns TOP-LEVEL sections (Income, Expenses etc) — not intermediate parent accounts
  function parseSections(data) {
    const sections = [];
    for(const row of (data?.Rows?.Row||[])) {
      if(row.type !== 'Section') continue;
      const title = row.Header?.ColData?.[0]?.value || '';
      if(!title.trim()) continue;
      const total = parseAmt(row.Summary?.ColData?.[1]?.value);
      const items = [];
      const subsections = [];

      function walkForItems(rows) {
        for(const r of (rows||[])) {
          if(r.type === 'Section') {
            const st = r.Header?.ColData?.[0]?.value || '';
            if(!st.trim()) continue;
            const stTotal = parseAmt(r.Summary?.ColData?.[1]?.value);
            const sitems = [];
            for(const sr of (r.Rows?.Row||[])) {
              if(sr.type === 'Data') {
                const nm = sr.ColData?.[0]?.value;
                const id = sr.ColData?.[0]?.id || null;
                const amt = parseAmt(sr.ColData?.[1]?.value);
                if(nm && nm !== 'Net Income') sitems.push({name:nm, id, amt});
              }
            }
            subsections.push({title:st, total:stTotal, items:sitems});
          } else if(r.type === 'Data') {
            const nm = r.ColData?.[0]?.value;
            const id = r.ColData?.[0]?.id || null;
            const amt = parseAmt(r.ColData?.[1]?.value);
            if(nm && nm !== 'Net Income') items.push({name:nm, id, amt});
          }
        }
      }
      walkForItems(row.Rows?.Row);
      sections.push({title, total, items, subsections});
    }
    return sections;
  }

  // Get amount for a specific item from raw data
  function getAmt(data, secTitle, subTitle, itemName) {
    for(const row of (data?.Rows?.Row||[])) {
      if(row.type !== 'Section') continue;
      if(row.Header?.ColData?.[0]?.value !== secTitle) continue;
      const rows = subTitle
        ? (row.Rows?.Row||[]).filter(r=>r.type==='Section'&&r.Header?.ColData?.[0]?.value===subTitle).flatMap(r=>r.Rows?.Row||[])
        : (row.Rows?.Row||[]).filter(r=>r.type==='Data');
      for(const r of rows) {
        if(r.type==='Data' && r.ColData?.[0]?.value === itemName)
          return parseAmt(r.ColData?.[1]?.value);
      }
      return 0;
    }
    return 0;
  }

  function getSecTotal(data, secTitle) {
    for(const row of (data?.Rows?.Row||[])) {
      if(row.type==='Section' && row.Header?.ColData?.[0]?.value===secTitle)
        return parseAmt(row.Summary?.ColData?.[1]?.value);
    }
    return 0;
  }

  function getSubTotal(data, secTitle, subTitle) {
    for(const row of (data?.Rows?.Row||[])) {
      if(row.type !== 'Section' || row.Header?.ColData?.[0]?.value !== secTitle) continue;
      for(const sub of (row.Rows?.Row||[])) {
        if(sub.type==='Section' && sub.Header?.ColData?.[0]?.value===subTitle)
          return parseAmt(sub.Summary?.ColData?.[1]?.value);
      }
    }
    return 0;
  }

  // Build unified structure from all datasets
  const refSections = parseSections(datasets[0].data);
  // Merge any sections/items that appear in later months but not first
  for(const ds of datasets.slice(1)) {
    for(const sec of parseSections(ds.data)) {
      let existing = refSections.find(s=>s.title===sec.title);
      if(!existing) { refSections.push({...sec, items:[], subsections:[]}); existing = refSections[refSections.length-1]; }
      for(const item of sec.items) {
        if(!existing.items.find(i=>i.name===item.name)) existing.items.push({name:item.name, id:item.id, amt:0});
      }
      for(const sub of sec.subsections) {
        let existingSub = existing.subsections.find(s=>s.title===sub.title);
        if(!existingSub) { existing.subsections.push({title:sub.title, total:0, items:[]}); existingSub = existing.subsections[existing.subsections.length-1]; }
        for(const item of sub.items) {
          if(!existingSub.items.find(i=>i.name===item.name)) existingSub.items.push({name:item.name, id:item.id, amt:0});
        }
      }
    }
  }

  const colLabels = datasets.map(ds => `${MONTH_NAMES[ds.month-1]} ${ds.year}`);
  const N = datasets.length;

  // Cards
  const isIncome  = t => /^income|^revenue|other income/i.test(t);
  const isExpense = t => /expense/i.test(t);
  let totalRev = 0, totalExp = 0;
  for(const ds of datasets) {
    for(const sec of refSections) {
      const v = getSecTotal(ds.data, sec.title);
      if(isIncome(sec.title))  totalRev += v;
      if(isExpense(sec.title)) totalExp += Math.abs(v);
    }
  }
  const net = totalRev - totalExp;
  const netCls = net >= 0 ? 'green' : 'red';
  cards.innerHTML = `
    <div class="card"><div class="card-label">Total Revenue</div><div class="card-value green">${fmtUSD(totalRev)}</div></div>
    <div class="card"><div class="card-label">Total Expenses</div><div class="card-value red">${fmtUSD(totalExp)}</div></div>
    <div class="card"><div class="card-label">Net Income</div><div class="card-value ${netCls}">${net>=0?'+':''}${fmtUSD(net)}</div></div>
    <div class="card"><div class="card-label">Period</div><div class="card-value" style="font-size:0.85rem">${colLabels[0]} – ${colLabels[N-1]}</div></div>
  `;

  // Table layout
  const colW = Math.max(100, Math.min(140, Math.floor(900/N)));
  const totalTableW = 260 + colW * N + 110;

  const thStyle = `padding:9px 12px;font-family:var(--mono);font-size:0.7rem;font-weight:700;text-align:right;white-space:nowrap;border-bottom:2px solid var(--border);color:var(--accent);width:${colW}px`;
  const tdNum   = `padding:7px 12px;font-family:var(--mono);font-size:0.73rem;text-align:right;white-space:nowrap;border-top:1px solid var(--border)`;
  const labelTh = `padding:9px 18px;font-family:var(--sans);font-size:0.75rem;font-weight:700;text-align:left;border-bottom:2px solid var(--border);color:var(--muted);width:260px`;
  const labelTd = (pl) => `padding:7px ${pl}px;font-family:var(--sans);font-size:0.75rem;text-align:left;border-top:1px solid var(--border)`;
  const thTotal = `padding:9px 14px;font-family:var(--mono);font-size:0.7rem;font-weight:700;text-align:right;white-space:nowrap;border-bottom:2px solid var(--border);color:var(--text);width:110px`;
  const tdTotal = `padding:7px 14px;font-family:var(--mono);font-size:0.73rem;text-align:right;white-space:nowrap;border-top:1px solid var(--border);font-weight:700`;

  function colorFor(t) {
    if(/expense/i.test(t))        return 'var(--red)';
    if(/other income|loss/i.test(t)) return '#06A0C4';
    return 'var(--green)';
  }

  let html = `<div style="overflow-x:auto;margin-top:4px;width:100%">
  <table style="table-layout:fixed;min-width:${totalTableW}px;width:100%;border-collapse:collapse">
    <colgroup>
      <col style="width:260px">
      ${colLabels.map(()=>`<col style="width:${colW}px">`).join('')}
      <col style="width:110px">
    </colgroup>
    <thead>
      <tr style="background:var(--surface2)">
        <th style="${labelTh}">Account</th>
        ${colLabels.map(l=>`<th style="${thStyle}">${l}</th>`).join('')}
        <th style="${thTotal}">Total</th>
      </tr>
    </thead>
    <tbody>`;

  for(const sec of refSections) {
    if(!sec.title.trim()) continue;
    const color = colorFor(sec.title);
    const totals = datasets.map(ds => getSecTotal(ds.data, sec.title));

    // Section header row
    html += `<tr style="background:var(--surface2)">
      <td style="${labelTd(18)};font-weight:700;color:${color}">${sec.title}</td>
      ${totals.map(v=>`<td style="${tdNum};font-weight:700;color:${color}">${v!==0?fmtUSD(Math.abs(v)):'—'}</td>`).join('')}
      <td style="${tdTotal};color:${color}">${fmtUSD(Math.abs(totals.reduce((s,v)=>s+v,0)))}</td>
    </tr>`;

    // Direct items (not in any subsection)
    for(const item of sec.items) {
      const vals = datasets.map(ds => getAmt(ds.data, sec.title, null, item.name));
      const glCode = item.name.match(/^(\d{4,})/)?.[1] || null;
      const encName = encodeURIComponent(item.name);
      const encId   = encodeURIComponent(item.id || '');
      html += `<tr>
        <td style="${labelTd(32)};color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
          ${glCode?`<span class="pnl-gl-trigger" data-id="${encId}" data-name="${encName}" data-year="${datasets[0].year}" data-month="${datasets[0].month}" style="font-family:var(--mono);font-size:0.6rem;color:var(--accent);background:var(--accent-bg);border-radius:3px;padding:1px 5px;margin-right:6px;cursor:pointer;border:1px solid var(--accent)">${glCode}</span>`:''}${item.name}
        </td>
        ${datasets.map((ds,i)=>{
          const v = vals[i];
          const mm = String(ds.month).padStart(2,'0');
          const lastDay = new Date(ds.year,ds.month,0).getDate();
          const sd = `${ds.year}-${mm}-01`;
          const ed = `${ds.year}-${mm}-${String(lastDay).padStart(2,'0')}`;
          return `<td style="${tdNum};color:var(--muted);${glCode?'cursor:pointer;':''}"
            ${glCode?`class="pnl-gl-trigger" data-id="${encId}" data-name="${encName}" data-startdate="${sd}" data-enddate="${ed}" data-year="${ds.year}" data-month="${ds.month}"
            onmouseover="this.style.background='rgba(6,214,160,0.08)';this.style.color='var(--accent)'"
            onmouseout="this.style.background='';this.style.color='var(--muted)'"`:''} 
          >${v!==0?fmtUSD(Math.abs(v)):'—'}</td>`;
        }).join('')}
        <td style="${tdTotal};color:var(--muted)">${vals.reduce((s,v)=>s+v,0)!==0?fmtUSD(Math.abs(vals.reduce((s,v)=>s+v,0))):'—'}</td>
      </tr>`;
    }

    // Subsections
    for(const sub of sec.subsections) {
      if(!sub.title.trim()) continue;
      const subTotals = datasets.map(ds => getSubTotal(ds.data, sec.title, sub.title));
      html += `<tr style="background:rgba(255,255,255,0.02)">
        <td style="${labelTd(24)};font-weight:600;color:var(--muted);font-size:0.72rem">${sub.title}</td>
        ${subTotals.map(v=>`<td style="${tdNum};color:var(--muted);font-weight:600">${v!==0?fmtUSD(Math.abs(v)):'—'}</td>`).join('')}
        <td style="${tdTotal};color:var(--muted)">${fmtUSD(Math.abs(subTotals.reduce((s,v)=>s+v,0)))}</td>
      </tr>`;
      for(const item of sub.items) {
        const vals = datasets.map(ds => getAmt(ds.data, sec.title, sub.title, item.name));
        const glCode = item.name.match(/^(\d{4,})/)?.[1] || null;
        const encName = encodeURIComponent(item.name);
        const encId   = encodeURIComponent(item.id || '');
        const badge = glCode ? `<span class="pnl-gl-trigger" data-id="${encId}" data-name="${encName}" data-year="${datasets[0].year}" data-month="${datasets[0].month}" style="font-family:var(--mono);font-size:0.6rem;color:var(--accent);background:var(--accent-bg);border-radius:3px;padding:1px 5px;margin-right:6px;cursor:pointer;border:1px solid var(--accent)">${glCode}</span>` : '';
        html += `<tr>
          <td style="${labelTd(42)};color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            ${glCode?`<span class="pnl-gl-trigger" data-id="${encId}" data-name="${encName}" data-year="${datasets[0].year}" data-month="${datasets[0].month}" style="font-family:var(--mono);font-size:0.6rem;color:var(--accent);background:var(--accent-bg);border-radius:3px;padding:1px 5px;margin-right:6px;cursor:pointer;border:1px solid var(--accent)">${glCode}</span>`:''}${item.name}
          </td>
          ${datasets.map((ds,i)=>{
            const v = vals[i];
            const mm = String(ds.month).padStart(2,'0');
            const lastDay = new Date(ds.year,ds.month,0).getDate();
            const sd = `${ds.year}-${mm}-01`;
            const ed = `${ds.year}-${mm}-${String(lastDay).padStart(2,'0')}`;
            return `<td style="${tdNum};color:var(--muted);${glCode?'cursor:pointer;':''}"
              ${glCode?`class="pnl-gl-trigger" data-id="${encId}" data-name="${encName}" data-startdate="${sd}" data-enddate="${ed}" data-year="${ds.year}" data-month="${ds.month}"
              onmouseover="this.style.background='rgba(6,214,160,0.08)';this.style.color='var(--accent)'"
              onmouseout="this.style.background='';this.style.color='var(--muted)'"`:''} 
            >${v!==0?fmtUSD(Math.abs(v)):'—'}</td>`;
          }).join('')}
          <td style="${tdTotal};color:var(--muted)">${vals.reduce((s,v)=>s+v,0)!==0?fmtUSD(Math.abs(vals.reduce((s,v)=>s+v,0))):'—'}</td>
        </tr>`;
      }
    }
  }

  // Net Income footer
  const netByMonth = datasets.map(ds => {
    // Read Net Income directly from QB summary row (most reliable)
    const _netRows = (ds.data?.Rows?.Row||[]).filter(r => r.type==='Section' && !r.Header?.ColData?.[0]?.value?.trim()); const _netRow = _netRows[_netRows.length-1];
    if(_netRow) return parseAmt(_netRow.Summary?.ColData?.[1]?.value);
    // Fallback
    let r=0, e=0, oi=0, oe=0;
    for(const sec of refSections) {
      const v = getSecTotal(ds.data, sec.title);
      if(/^income|^revenue/i.test(sec.title))  r += v;
      if(/^expenses?$/i.test(sec.title)) e += Math.abs(v);
      if(/other income/i.test(sec.title)) oi += v;
      if(/other expenses?/i.test(sec.title)) oe += Math.abs(v);
    }
    return r - e + oi - oe;
  });
  html += `<tr style="border-top:2px solid var(--border);background:var(--surface2)">
    <td style="${labelTd(18)};font-weight:800;color:var(--text)">Net Income</td>
    ${netByMonth.map(v=>`<td style="${tdNum};font-weight:800;color:${v>=0?'var(--green)':'var(--red)'}">${v>=0?'+':''}${fmtUSD(v)}</td>`).join('')}
    <td style="${tdTotal};color:${netByMonth.reduce((s,v)=>s+v,0)>=0?'var(--green)':'var(--red)'}">${netByMonth.reduce((s,v)=>s+v,0)>=0?'+':''}${fmtUSD(netByMonth.reduce((s,v)=>s+v,0))}</td>
  </tr>`;

  html += `</tbody></table></div>`;
  body.innerHTML = html;

  // Shared GL click handler (set once, handles both range and single/ytd modes)
  if(!body._pnlClickBound) {
    body._pnlClickBound = true;
    body.addEventListener('click', function(e) {
      const glTrigger = e.target.closest('.pnl-gl-trigger');
      if(glTrigger) {
        e.stopPropagation();
        const id        = decodeURIComponent(glTrigger.dataset.id || '');
        const name      = decodeURIComponent(glTrigger.dataset.name || '');
        const year      = parseInt(glTrigger.dataset.year);
        const month     = parseInt(glTrigger.dataset.month);
        const startDate = glTrigger.dataset.startdate || null;
        const endDate   = glTrigger.dataset.enddate   || null;
        pnlGLDrill(e, id, id, name, year, month, startDate, endDate);
        return;
      }
      const toggle = e.target.closest('.pnl-sec-toggle');
      if(toggle) {
        const title = toggle.dataset.title;
        if(title) pnlToggle(title);
      }
    });
  }
}

function pnlToggle(title) {
  if(!window._pnlExpanded) window._pnlExpanded = new Set();
  if(window._pnlExpanded.has(title)) window._pnlExpanded.delete(title);
  else window._pnlExpanded.add(title);
  const entity = document.getElementById('pnl-entity')?.value || 'Opco';
  const mode   = document.getElementById('pnl-mode')?.value   || 'month';
  const month  = parseInt(document.getElementById('pnl-month')?.value);
  const year   = parseInt(document.getElementById('pnl-year')?.value);
  const mm     = String(month).padStart(2,'0');
  let key;
  if(mode === 'ytd')   key = `${entity}::YTD-${year}-${mm}`;
  else if(mode === 'range') key = null; // range uses pnlRenderRange separately
  else                 key = `${entity}::${year}-${mm}`;
  if(key && _pnlCache[key]) pnlRender(_pnlCache[key], entity, year, month, mode);
}

// ── GL Drilldown: fetch QB GeneralLedger for a specific account ────────────
let _pnlGLCache = {}; // key: 'accountId::YYYY-MM'

let _pnlGLFetching = false; // lock to avoid QB 429 from rapid clicks

// ── GL Drilldown for All Entities consolidated view ───────────────
async function pnlGLDrillAll(accountName, startDate, endDate) {
  const modal = document.getElementById('pnl-gl-modal');
  const body  = document.getElementById('pnl-gl-modal-body');
  const badge = document.getElementById('pnl-gl-modal-badge');
  const title = document.getElementById('pnl-gl-modal-title');
  const tot   = document.getElementById('pnl-gl-modal-total');
  if(!modal) return;

  const glCode    = accountName.match(/^(\d{4,})/)?.[1] || '';
  const cleanName = accountName.replace(/^\d+\s*/, '');

  badge.textContent = glCode;
  title.textContent = `${cleanName}  ·  All Entities  ·  ${startDate.slice(0,7)}${startDate.slice(0,7)!==endDate.slice(0,7)?` → ${endDate.slice(0,7)}`:''}`;
  tot.textContent   = '⟳ loading…';
  tot.style.color   = 'var(--muted)';
  body.innerHTML    = `<div style="padding:32px;text-align:center;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">⟳ fetching from all companies…</div>`;
  modal.style.display = 'block';

  if(_pnlGLFetching) {
    body.innerHTML = `<div style="padding:24px;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">⟳ Another account is loading, please wait a moment.</div>`;
    return;
  }

  const entities      = Object.keys(QB_REALM_IDS);
  const entityAmounts = window._pnlAllEntityAmounts?.[accountName] || {};
  const entityColors  = { 'Opco': '#06D6A0', 'Foundation': '#4CC9F0', 'Juku': '#F9C74F', 'Zagreus': '#F07167' };

  _pnlGLFetching = true;
  let grandTotal = 0;
  let allHtml    = '';

  function parseAmount(v) { return parseFloat((v||'').replace(/,/g,'')) || 0; }

  for(const entity of entities) {
    const realmId  = QB_REALM_IDS[entity];
    const entColor = entityColors[entity] || 'var(--accent)';
    const entAmt   = entityAmounts[entity];

    allHtml += `<div style="padding:10px 20px;background:${entColor}18;border-bottom:2px solid ${entColor};display:flex;justify-content:space-between;align-items:center">
      <span style="font-family:var(--mono);font-size:0.78rem;font-weight:700;color:${entColor}">${entity}</span>
      ${entAmt!=null ? `<span style="font-family:var(--mono);font-size:0.72rem;color:${entAmt>=0?'var(--green)':'var(--red)'}">${entAmt>=0?'+':''}${fmtUSD(entAmt)} (P&L)</span>` : ''}
    </div>`;

    try {
      const accessToken = await qbEnsureToken(realmId);
      const cacheKey    = `all::${accountName}::${realmId}::${startDate}::${endDate}`;

      let cached = _pnlGLCache[cacheKey];
      if(!cached) {
        // Look up accountId by name — same logic as pnlGLDrill
        let accountId = null;
        const cleanNameForQuery = accountName.replace(/^\d+\s*/, '').replace(/'/g, "\\'");
        const listPath = `/v3/company/${realmId}/query?query=${encodeURIComponent(`SELECT * FROM Account WHERE Name = '${cleanNameForQuery}' MAXRESULTS 5`)}&minorversion=65`;
        try {
          const listRes = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(listPath)}&realmId=${realmId}`, {
            credentials: 'include', headers: { 'Authorization': `Bearer ${accessToken}` }
          });
          if(listRes.ok) {
            const listData = await listRes.json();
            accountId = listData?.QueryResponse?.Account?.[0]?.Id || null;
          }
        } catch(_) {}

        if(!accountId) {
          allHtml += `<div style="padding:16px 20px;font-family:var(--mono);font-size:0.72rem;color:var(--muted)">Account not found in this company.</div>`;
          continue;
        }

        // Use GeneralLedger — same as pnlGLDrill individual, which works correctly
        const path = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${startDate}&end_date=${endDate}&account=${accountId}&accounting_method=Accrual&minorversion=65`;
        const res  = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`, {
          credentials: 'include', headers: { 'Authorization': `Bearer ${accessToken}` }
        });
        if(!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        cached = { data, accountName, accountId };
        _pnlGLCache[cacheKey] = cached;
      }

      // Parse GL rows — same as pnlGLRender
      const txns = [];
      function walkGL(rows) {
        for(const row of (rows||[])) {
          if(row.type === 'Section') { walkGL(row.Rows?.Row); continue; }
          if(row.type !== 'Data') continue;
          const cols = row.ColData || [];
          const date = cols[0]?.value || '';
          if(!date || !date.match(/\d{4}/)) continue;
          txns.push({
            date,
            type:   cols[1]?.value || '',
            docNum: cols[2]?.value || '',
            name:   cols.length >= 9 ? '' : cols[3]?.value || '',
            memo:   cols.length >= 9 ? cols[5]?.value || '' : cols[4]?.value || '',
            split:  cols.length >= 9 ? (cols[6]?.value || '') : (cols[5]?.value || ''),
            amount: cols.length >= 9 ? parseAmount(cols[7]?.value) : parseAmount(cols[6]?.value),
          });
        }
      }
      walkGL(cached.data?.Rows?.Row);

      if(!txns.length) {
        allHtml += `<div style="padding:16px 20px;font-family:var(--mono);font-size:0.72rem;color:var(--muted)">No transactions for this account in this period.</div>`;
      } else {
        const entTotal = entAmt != null ? entAmt : txns.reduce((s,t) => s + t.amount, 0);
        grandTotal += entTotal;
        const tc = entTotal >= 0 ? 'var(--green)' : 'var(--red)';
        allHtml += `<div style="padding:4px 20px;font-family:var(--mono);font-size:0.68rem;color:var(--muted);border-bottom:1px solid var(--border)">${txns.length} transaction${txns.length!==1?'s':''} · Total: <span style="color:${tc};font-weight:600">${entTotal>=0?'+':''}${fmtUSD(entTotal)}</span></div>`;
        allHtml += `<table style="width:100%;border-collapse:collapse;font-family:var(--mono);font-size:0.71rem">
          <thead><tr style="background:var(--surface2)">
            <th style="padding:6px 12px 6px 20px;text-align:left;color:var(--muted);font-weight:500">Date</th>
            <th style="padding:6px 12px;text-align:left;color:var(--muted);font-weight:500">Ref</th>
            <th style="padding:6px 12px;text-align:left;color:var(--muted);font-weight:500">Name</th>
            <th style="padding:6px 12px;text-align:left;color:var(--muted);font-weight:500">Memo</th>
            <th style="padding:6px 12px;text-align:left;color:var(--muted);font-weight:500">Split</th>
            <th style="padding:6px 20px 6px 12px;text-align:right;color:var(--muted);font-weight:500">Amount</th>
          </tr></thead><tbody>`;
        for(const t of txns) {
          const ac = t.amount >= 0 ? 'var(--green)' : 'var(--red)';
          allHtml += `<tr style="border-top:1px solid var(--border)" onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background=''">
            <td style="padding:6px 12px 6px 20px;color:var(--muted);white-space:nowrap">${t.date}</td>
            <td style="padding:6px 12px;color:var(--muted);font-size:0.65rem">${t.docNum||'—'}</td>
            <td style="padding:6px 12px;color:var(--text);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(t.name||'—').replace(/</g,'&lt;')}</td>
            <td style="padding:6px 12px;color:var(--text);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(t.memo||'—').replace(/</g,'&lt;')}</td>
            <td style="padding:6px 12px;color:var(--muted);font-size:0.64rem;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(t.split||'—').replace(/</g,'&lt;')}</td>
            <td style="padding:6px 20px 6px 12px;text-align:right;color:${ac};font-weight:600;white-space:nowrap">${t.amount>=0?'+':''}${fmtUSD(t.amount)}</td>
          </tr>`;
        }
        allHtml += `</tbody></table>`;
      }
    } catch(e) {
      allHtml += `<div style="padding:16px 20px;font-family:var(--mono);font-size:0.72rem;color:var(--red)">⚠ ${e.message}</div>`;
    }

    await new Promise(r => setTimeout(r, 150)); // avoid QB 429
  }

  _pnlGLFetching = false;
  body.innerHTML  = allHtml;
  const gtc = grandTotal >= 0 ? 'var(--green)' : 'var(--red)';
  tot.textContent = `${grandTotal>=0?'+':''}${fmtUSD(grandTotal)} (all)`;
  tot.style.color = gtc;
}

// Global event delegation for All Entities consolidated view
document.addEventListener('click', (e) => {
  // pnl-all-sec-toggle (month/ytd consolidated sections)
  const allToggle = e.target.closest('.pnl-all-sec-toggle');
  if(allToggle) {
    const secKey = allToggle.dataset.seckey;
    if(!secKey) return;
    if(!window._pnlExpanded) window._pnlExpanded = new Set();
    if(window._pnlExpanded.has(secKey)) window._pnlExpanded.delete(secKey);
    else window._pnlExpanded.add(secKey);
    if(window._pnlAllResults) {
      pnlRenderAll(window._pnlAllResults, window._pnlAllEntityNames, window._pnlAllYear, window._pnlAllMonth, window._pnlAllMode);
    }
    return;
  }

  // pnl-allrange-sec-toggle (range consolidated sections)
  const rangeToggle = e.target.closest('.pnl-allrange-sec-toggle');
  if(rangeToggle) {
    const secKey = rangeToggle.dataset.seckey;
    if(!secKey) return;
    if(!window._pnlExpanded) window._pnlExpanded = new Set();
    if(window._pnlExpanded.has(secKey)) window._pnlExpanded.delete(secKey);
    else window._pnlExpanded.add(secKey);
    if(window._pnlAllRangeDatasets) {
      pnlRenderAllRange(window._pnlAllRangeDatasets, window._pnlAllRangeMonths);
    }
    return;
  }

  // pnl-gl-all-trigger (GL drilldown for consolidated)
  const glTrigger = e.target.closest('.pnl-gl-all-trigger');
  if(glTrigger) {
    e.stopPropagation();
    const name      = decodeURIComponent(glTrigger.dataset.name || '');
    const startDate = glTrigger.dataset.startdate || '';
    const endDate   = glTrigger.dataset.enddate   || '';
    if(name && startDate && endDate) pnlGLDrillAll(name, startDate, endDate);
    return;
  }
});

async function pnlGLDrill(event, itemKey, accountId, accountName, year, month, startDate, endDate) {
  if(event) event.stopPropagation();

  const modal = document.getElementById('pnl-gl-modal');
  const body  = document.getElementById('pnl-gl-modal-body');
  const badge = document.getElementById('pnl-gl-modal-badge');
  const title = document.getElementById('pnl-gl-modal-title');
  const tot   = document.getElementById('pnl-gl-modal-total');
  if(!modal) return;

  const glCode    = accountName.match(/^(\d{4,})/)?.[1] || accountId || '';
  const cleanName = accountName.replace(/^\d+\s*/, '');

  // Compute date range
  if(!startDate || !endDate) {
    const mode = document.getElementById('pnl-mode')?.value || 'month';
    if(mode === 'ytd') {
      const y = year || parseInt(document.getElementById('pnl-year')?.value);
      const m = month || parseInt(document.getElementById('pnl-month')?.value);
      const lastDay = new Date(y, m, 0).getDate();
      startDate = `${y}-01-01`;
      endDate   = `${y}-${String(m).padStart(2,'0')}-${String(lastDay).padStart(2,'0')}`;
    } else {
      const y = year, m = month;
      const lastDay = new Date(y, m, 0).getDate();
      const mm = String(m).padStart(2,'0');
      startDate = `${y}-${mm}-01`;
      endDate   = `${y}-${mm}-${String(lastDay).padStart(2,'0')}`;
    }
  }

  const periodLabel = startDate === endDate?.slice(0,7)+'-01'
    ? startDate.slice(0,7)
    : `${startDate} → ${endDate}`;

  badge.textContent = glCode;
  title.textContent = `${cleanName}  ·  ${startDate.slice(0,7)}${startDate.slice(0,7)!==endDate.slice(0,7)?` → ${endDate.slice(0,7)}`:''}`;
  tot.textContent   = '⟳ loading…';
  tot.style.color   = 'var(--muted)';
  body.innerHTML    = `<div style="padding:32px;text-align:center;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">⟳ fetching from QuickBooks…</div>`;
  modal.style.display = 'block';

  const entity   = document.getElementById('pnl-entity')?.value || 'Opco';
  const realmId  = QB_REALM_IDS[entity];
  const cacheKey = `${accountId||accountName}::${startDate}::${endDate}`;

  if(_pnlGLCache[cacheKey]) {
    pnlGLRender(body, tot, _pnlGLCache[cacheKey], accountName, accountId, null, false);
    return;
  }

  // Prevent simultaneous QB requests (causes 429)
  if(_pnlGLFetching) {
    body.innerHTML = `<div style="padding:24px;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">⟳ Another account is loading, please wait a moment and try again.</div>`;
    tot.textContent = '…';
    return;
  }

  _pnlGLFetching = true;
  try {
    const accessToken = await qbEnsureToken(realmId);

    let path;
    if(accountId) {
      path = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${startDate}&end_date=${endDate}&account=${accountId}&accounting_method=Accrual&minorversion=65`;
    } else {
      const listPath = `/v3/company/${realmId}/query?query=${encodeURIComponent(`SELECT * FROM Account WHERE Name = '${accountName.replace(/'/g,"\\'")}' MAXRESULTS 5`)}&minorversion=65`;
      const listRes  = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(listPath)}&realmId=${realmId}`, {
        credentials: 'include',
        headers: { 'Authorization': `Bearer ${accessToken}` }
      });
      if(listRes.ok) {
        const listData = await listRes.json();
        const foundId  = listData?.QueryResponse?.Account?.[0]?.Id;
        if(foundId) {
          accountId = foundId;
          path = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${startDate}&end_date=${endDate}&account=${foundId}&accounting_method=Accrual&minorversion=65`;
        }
      }
      if(!path) path = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${startDate}&end_date=${endDate}&accounting_method=Accrual&minorversion=65`;
    }

    const res = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`, {
      credentials: 'include',
      headers: { 'Authorization': `Bearer ${accessToken}` }
    });
    if(!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    _pnlGLCache[cacheKey] = {data, accountName, accountId};
    pnlGLRender(body, tot, {data, accountName, accountId}, accountName, accountId, null, null);
  } catch(e) {
    body.innerHTML = `<div style="padding:24px;font-family:var(--mono);font-size:0.75rem;color:var(--red)">⚠ ${e.message}</div>`;
    tot.textContent = '⚠ error';
  } finally {
    _pnlGLFetching = false;
  }
}

function pnlGLModalClose(e) {
  const modal = document.getElementById('pnl-gl-modal');
  // Close if clicking the backdrop or the flex wrapper (not the modal card itself)
  if(e && e.target !== modal && !e.target.closest('#pnl-gl-modal > div')) return;
  if(e && e.target.closest('[style*="border-radius:12px"]')) return;
  modal.style.display = 'none';
}

function pnlGLRender(body, totEl, cacheObj, accountName, accountId, filterClass, hasClassColumn) {
  const data = cacheObj?.data || cacheObj;
  const txns = [];
  function parseAmount(v) { return parseFloat((v||'').replace(/,/g,'')) || 0; }

  function walkSection(rows) {
    for(const row of (rows || [])) {
      if(row.type === 'Section') {
        walkSection(row.Rows?.Row);
      } else if(row.type === 'Data') {
        const cols = row.ColData || [];
        const date = cols[0]?.value || '';
        if(!date || !date.match(/\d{4}/)) continue;
        // Detect layout from ColData length:
        // 8 cols: tx_date,txn_type,doc_num,name,klass_name,memo,subt_nat,rbal_nat
        // 7 cols: tx_date,txn_type,doc_num,name,memo,subt_nat,rbal_nat (no klass)
        // QB GL column layouts vary by company:
        // 9 cols: date,type,doc,no,empty,memo,split,amount,balance  (Zagreus)
        // 8 cols: date,type,doc,name,klass,memo,amount,balance       (Opco with klass)
        // 7 cols: date,type,doc,name,memo,amount,balance             (Opco without klass)
        // Detect by col count: amount is always cols[length-2], balance is cols[length-1]
        const n = cols.length;
        const hasKlass = n === 8 && cols[4]?.value !== undefined;
        txns.push({
          date,
          type:    cols[1]?.value || '',
          docNum:  cols[2]?.value || '',
          name:    n === 9 ? '' : cols[3]?.value || '',
          cls:     hasKlass ? (cols[4]?.value || '') : '',
          memo:    n === 9 ? (cols[5]?.value || '') : (hasKlass ? cols[5]?.value : cols[4]?.value) || '',
          split:   n === 9 ? (cols[6]?.value || '') : '',
          amount:  parseAmount(cols[n - 2]?.value),
          balance: parseAmount(cols[n - 1]?.value),
        });
      }
    }
  }

  walkSection(data?.Rows?.Row);

  // Filter by class if requested (By Department drill)
  const filtered = !filterClass ? txns
    : filterClass === 'Not specified' ? txns.filter(t => !t.cls)
    : txns.filter(t => t.cls === filterClass);

  if(!filtered.length) {
    body.innerHTML = `<div style="padding:40px;text-align:center;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">No transactions found for this period.</div>`;
    if(totEl) { totEl.textContent = '$0.00'; totEl.style.color = 'var(--muted)'; }
    return;
  }

  const total = filtered.reduce((s,t) => s + t.amount, 0);
  if(totEl) {
    totEl.textContent = `${total>=0?'+':''}${fmtUSD(total)}`;
    totEl.style.color = total >= 0 ? 'var(--green)' : 'var(--red)';
  }

  // Sub-header: count
  let html = `
    <div style="padding:8px 20px;font-family:var(--mono);font-size:0.68rem;color:var(--muted);border-bottom:1px solid var(--border)">
      ${filtered.length} transaction${filtered.length!==1?'s':''}${filterClass ? ` · class: ${filterClass}` : ''}
    </div>
    <table style="width:100%;border-collapse:collapse;font-family:var(--mono);font-size:0.72rem">
      <thead style="position:sticky;top:0;z-index:1">
        <tr style="background:var(--surface2);border-bottom:1px solid var(--border)">
          <th style="padding:8px 12px 8px 20px;text-align:left;color:var(--muted);font-weight:500;white-space:nowrap">Transaction date</th>
          <th style="padding:8px 12px;text-align:left;color:var(--muted);font-weight:500">Ref</th>
          <th style="padding:8px 12px;text-align:left;color:var(--muted);font-weight:500">Name</th>
          <th style="padding:8px 12px;text-align:left;color:var(--muted);font-weight:500">Memo / Description</th>
          <th style="padding:8px 12px;text-align:left;color:var(--muted);font-weight:500">Account full name</th>
          <th style="padding:8px 20px 8px 12px;text-align:right;color:var(--muted);font-weight:500">Amount</th>
        </tr>
      </thead>
      <tbody>`;

  for(const t of filtered) {
    const amtColor = t.amount >= 0 ? 'var(--green)' : 'var(--red)';
    const nameEsc = (t.name||'—').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const memoEsc = (t.memo||'—').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const splitEsc = (t.split||'—').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    html += `<tr style="border-top:1px solid var(--border)"
      onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background=''">
      <td style="padding:7px 12px 7px 20px;color:var(--muted);white-space:nowrap">${t.date}</td>
      <td style="padding:7px 12px;color:var(--muted);font-size:0.66rem;white-space:nowrap">${t.docNum||'—'}</td>
      <td style="padding:7px 12px;color:var(--text);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${nameEsc}">${nameEsc}</td>
      <td style="padding:7px 12px;color:var(--text);max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${memoEsc}">${memoEsc}</td>
      <td style="padding:7px 12px;color:var(--muted);font-size:0.66rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${splitEsc}">${splitEsc}</td>
      <td style="padding:7px 20px 7px 12px;text-align:right;color:${amtColor};white-space:nowrap;font-weight:600">${t.amount>=0?'+':''}${fmtUSD(t.amount)}</td>
    </tr>`;
  }

  html += `</tbody></table>`;
  body.innerHTML = html;
}


// ══════════════════════════════════════════════════════════════════
// QUICKBOOKS INTEGRATION
// ══════════════════════════════════════════════════════════════════

const QB_CLIENT_ID   = 'ABmbezrnpifjJjUxUa7079Cx5gnwYbniys5tZgHKc2AqHBguFz';
const QB_REALM_IDS   = {
  'Opco':       '9341452247586809',
  'Zagreus':    '9130352128221356',
  'Juku':       '9130357942134196',
  'Foundation': '9130352128225976',
};
const QB_REDIRECT    = 'https://tidelog-server-production.up.railway.app/auth/qb/callback';
const QB_MIN_DATE    = '2026-02-01'; // safety guard — never post before Feb 2026

// Wallets that post as monthly bulk (sum of inflows only, one JE per token per month)
const QB_BULK_WALLETS = new Set([
  '4LN4syXHf5NiC6pc3Wvo8t4U1jvseSKaH6V2i28TkLsa', // Revenue - Team Protocol Fees
  'DrhE25wu3PRGtBCtzsry6ToiGjhwBzCnYGpvv53qxh9X',  // Panama Opco - Climate Fund
]);
const QB_BASE_URL    = 'https://quickbooks.api.intuit.com';
const QB_PROXY_URL   = `${PROXY_BASE}/proxy/qb`;
const QB_AUTH_URL    = 'https://appcenter.intuit.com/connect/oauth2';
const QB_TOKEN_URL   = `${PROXY_BASE}/auth/qb/token`;
const QB_POSTED_KEY  = 'qb_posted_hashes'; // localStorage key for posted tx hashes

function qbRealmFor(entity) {
  const id = QB_REALM_IDS[entity];
  if(!id) throw new Error(`No QuickBooks company mapped for entity "${entity}". Supported: ${Object.keys(QB_REALM_IDS).join(', ')}.`);
  return id;
}

// ── State ──────────────────────────────────────────────────────────
const _qb = {
  accessToken:  null,   // token da empresa activa (Opco por defeito)
  refreshToken: null,
  tokenExpiry:  null,
  realmId:      null,
  tokens: {},           // { [realmId]: { accessToken, refreshToken, tokenExpiry } }
  selectedHashes: new Set(),
  filteredData:   [],
  previewEntries: [],
};

// ── Token persistence (multi-entity) ──────────────────────────────

// Guarda token para uma empresa específica (por realmId).
// Se for o realmId activo, actualiza também os campos de atalho.
function qbSaveTokens(access, refresh, expiresIn, realmId) {
  const rid    = realmId || _qb.realmId || QB_REALM_IDS['Opco'];
  const expiry = Date.now() + (expiresIn - 60) * 1000;
  _qb.tokens[rid] = { accessToken: access, refreshToken: refresh, tokenExpiry: expiry };
  // Se é o realmId activo, actualiza atalhos
  if(!_qb.realmId || _qb.realmId === rid) {
    _qb.accessToken  = access;
    _qb.refreshToken = refresh;
    _qb.tokenExpiry  = expiry;
    _qb.realmId      = rid;
  }
  // Persistir no localStorage (all tokens)
  try {
    localStorage.setItem('qb_tokens_v2', JSON.stringify(_qb.tokens));
  } catch(e) {}
  // Persistir no servidor (fire and forget)
  fetch(`${PROXY_BASE}/auth/qb/save_tokens`, {
    method: 'POST',
    credentials: 'include',
    headers: authHeaders({ 'Content-Type': 'application/json' }),
    body: JSON.stringify({ accessToken: access, refreshToken: refresh, expiry, realmId: rid }),
  }).catch(()=>{});
}

// Carrega tokens do localStorage para _qb.tokens (todos os realmIds)
function qbLoadTokens() {
  try {
    const raw = localStorage.getItem('qb_tokens_v2');
    if(raw) {
      const stored = JSON.parse(raw);
      Object.assign(_qb.tokens, stored);
    }
    // Compatibilidade com versão antiga (single token)
    const old = localStorage.getItem('qb_tokens');
    if(old) {
      const { access, refresh, expiry } = JSON.parse(old);
      const opcoId = QB_REALM_IDS['Opco'];
      if(access && !_qb.tokens[opcoId]) {
        _qb.tokens[opcoId] = { accessToken: access, refreshToken: refresh, tokenExpiry: expiry };
      }
      localStorage.removeItem('qb_tokens'); // migrar uma vez só
    }
    // Activa o primeiro token válido como token corrente
    for(const [rid, t] of Object.entries(_qb.tokens)) {
      if(t.accessToken && Date.now() < t.tokenExpiry + 3600000) {
        _qb.accessToken  = t.accessToken;
        _qb.refreshToken = t.refreshToken;
        _qb.tokenExpiry  = t.tokenExpiry;
        _qb.realmId      = rid;
        return true;
      }
    }
    return false;
  } catch(e) { return false; }
}

// Devolve token para uma empresa específica (ou o activo por defeito)
function qbTokenFor(realmId) {
  return _qb.tokens[realmId] || null;
}

// Refresh all expired QB tokens silently on startup
async function qbRefreshAllTokens() {
  for (const [entity, realmId] of Object.entries(QB_REALM_IDS)) {
    const t = _qb.tokens[realmId];
    if (!t?.refreshToken) continue;
    if (Date.now() < (t.tokenExpiry || 0) - 1800000) continue; // refresh if < 30 min remaining
    try {
      const res = await fetch(`${PROXY_BASE}/auth/qb/token`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ grant_type: 'refresh_token', refresh_token: t.refreshToken, realmId })
      });
      if (!res.ok) continue;
      const d = await res.json();
      if (d.access_token) {
        qbSaveTokens(d.access_token, d.refresh_token || t.refreshToken, d.expires_in || 3600, realmId);
        console.log(`[QB] Refreshed token for ${entity}`);
      }
    } catch(e) { console.warn(`[QB] Token refresh failed for ${entity}:`, e.message); }
  }
}

async function qbAutoConnect() {
  try {
    // Tenta carregar tokens de TODAS as empresas do servidor
    const res = await fetch(`${PROXY_BASE}/auth/qb/load_tokens`, { credentials: 'include', signal: AbortSignal.timeout(5000) });
    if(!res.ok) return false;
    const data = await res.json();

    let connectedCount = 0;

    // Formato {entities:[{realmId,expiry,expired},...]} — servidor tem lista
    if(data.entities?.length) {
      for(const ent of data.entities) {
        if(ent.expired || !ent.realmId) continue;
        try {
          const r2 = await fetch(`${PROXY_BASE}/auth/qb/load_tokens?realmId=${ent.realmId}`, { credentials: 'include', signal: AbortSignal.timeout(4000) });
          if(!r2.ok) continue;
          const d2 = await r2.json();
          if(d2.accessToken) {
            qbSaveTokens(d2.accessToken, d2.refreshToken, Math.round((d2.expiry - Date.now())/1000), ent.realmId);
            connectedCount++;
          }
        } catch(e) { /* skip */ }
      }
    }

    // Formato legado {accessToken,...} — servidor tem apenas uma empresa
    if(!connectedCount && data.accessToken) {
      const rid = data.realmId || QB_REALM_IDS['Opco'];
      qbSaveTokens(data.accessToken, data.refreshToken, Math.round((data.expiry - Date.now())/1000), rid);
      connectedCount++;
    }

    if(!connectedCount) return false;

    // Token activo = Opco (ou o primeiro disponível)
    const opcoId = QB_REALM_IDS['Opco'];
    const active = _qb.tokens[opcoId] || Object.values(_qb.tokens)[0];
    if(active) {
      _qb.accessToken  = active.accessToken;
      _qb.refreshToken = active.refreshToken;
      _qb.tokenExpiry  = active.tokenExpiry;
      _qb.realmId      = opcoId;
    }

    const connectedEntities = Object.entries(QB_REALM_IDS)
      .filter(([,rid]) => _qb.tokens[rid]?.accessToken)
      .map(([name]) => name)
      .join(' + ');

    const expiresIn = Math.round(((active?.tokenExpiry||0) - Date.now()) / 60000);
    qbSetConnStatus(true, `Connected · ${connectedEntities} · expires in ${expiresIn}min`);
    qbLog(`✓ Auto-connected QB: ${connectedEntities}`, 'var(--green)');
    await qbFetchAccountMap();
    qbRefreshAllTokens(); // non-blocking refresh of expired tokens
    // Set up periodic refresh every 45 minutes
    if (!window._qbRefreshInterval) {
      window._qbRefreshInterval = setInterval(() => qbRefreshAllTokens(), 45 * 60 * 1000);
    }
    return true;
  } catch(e) {
    qbLog('Auto-connect failed: ' + e.message, 'var(--muted)');
    return false;
  }
}

function qbClearTokens() {
  _qb.accessToken = _qb.refreshToken = _qb.tokenExpiry = null;
  _qb.tokens = {};
  try { localStorage.removeItem('qb_tokens'); localStorage.removeItem('qb_tokens_v2'); } catch(e) {}
}

// ── Posted hashes (anti-duplicate) ────────────────────────────────

function qbGetPostedRaw() {
  try {
    const raw = JSON.parse(localStorage.getItem(QB_POSTED_KEY) || '{}');
    return Array.isArray(raw) ? Object.fromEntries(raw.map(h=>[h,''])) : raw;
  } catch(e) { return {}; }
}
function qbMarkPosted(hashes, docNumber, hashMap) {
  const raw = qbGetPostedRaw();
  if(hashMap) { Object.assign(raw, hashMap); }
  else { hashes.forEach(h => { raw[h] = docNumber || ''; }); }
  try { localStorage.setItem(QB_POSTED_KEY, JSON.stringify(raw)); } catch(e) {}
}
function qbGetPosted() {
  // Returns object {hash: docNumber} with .has() for compat
  try {
    const raw = JSON.parse(localStorage.getItem(QB_POSTED_KEY) || '{}');
    const obj = Array.isArray(raw) ? Object.fromEntries(raw.map(h=>[h,''])) : (raw || {});
    obj.has = (k) => k in obj;
    return obj;
  } catch(e) {
    const o = {}; o.has = () => false; return o;
  }
}

// ── UI helpers ────────────────────────────────────────────────────
function qbSetConnStatus(connected, label) {
  // Optional elements — only update if they exist in the DOM
  const connStatus = document.getElementById('qb-conn-status');
  const connectBtn = document.getElementById('qb-connect-btn');
  const disconnBtn = document.getElementById('qb-disconnect-btn');
  const previewBtn = document.getElementById('qb-preview-btn');
  if(connStatus) connStatus.textContent = label;
  if(connectBtn) connectBtn.style.display    = connected ? 'none' : '';
  if(disconnBtn) disconnBtn.style.display = connected ? '' : 'none';
  if(previewBtn) { previewBtn.style.opacity = connected ? '1' : '0.4'; previewBtn.style.pointerEvents = connected ? '' : 'none'; }

  // tx tab "Connect QB" button — show when not connected, hide when connected
  const txConnBtn = document.getElementById('tx-qb-connect-btn');
  if(txConnBtn) txConnBtn.style.display = connected ? 'none' : '';

  qbLog(label, connected ? 'var(--green)' : 'var(--red)');
}

function qbLog(msg, color) {
  console.log('[QB]', msg); // always log to console
  const el = document.getElementById('qb-log-content');
  const d  = document.getElementById('qb-log');
  if(!el || !d) return;
  d.style.display = '';
  const ts = new Date().toISOString().slice(11,19);
  el.innerHTML += `<span style="color:${color||'var(--muted)'}"><span style="color:var(--muted2)">[${ts}]</span> ${msg}</span>\n`;
  el.scrollTop = el.scrollHeight;
}

// ── GL resolution ─────────────────────────────────────────────────
function qbResolveGL(walletAddr, token) {
  // Priority 1: GL_CODE_MAP (per-wallet per-token)
  const tokenGL = GL_CODE_MAP[walletAddr]?.[token];
  if(tokenGL) return tokenGL;
  // Priority 2: accountCode on wallet
  const w = ALL_WALLETS.find(w => w.address === walletAddr);
  return w?.accountCode || null;
}

// For In txs: which account to credit? Use a mapping per token type.
// For USDC/USDT/PYUSD In: credit "Undeposited Funds" or a revenue placeholder
// For SOL/ORCA In: credit cost basis account
// The QB account name lookup happens via listAccounts at runtime.
// Here we store the GL debit/credit logic:
function qbBuildJournalLines(tx, glMap) {
  // glMap: { glCode -> { Id, Name } } from QB accounts
  const token   = tx.asset || tx.token || '';
  const usd     = Math.abs(tx.usd || 0);
  const assetGL = qbResolveGL(tx.walletAddr, token);
  if(!assetGL || usd < 0.005) return null;

  const assetAcct = glMap[assetGL];
  if(!assetAcct) return null;

  const isIn    = tx.dir === 'In';
  const isOut   = tx.dir === 'Out';
  const hasGain = isOut && ((tx.gainShort || 0) !== 0 || (tx.gainLong || 0) !== 0);

  // Simple transfer / stablecoin: debit asset In, credit suspense
  // SOL/ORCA Out with gain: also post realized gain/loss
  // Counterparty account: use "Uncategorized" unless we find a match
  const counterGL = tx.counterparty ? qbResolveGL(tx.counterparty, token) : null;
  const counterAcct = counterGL ? glMap[counterGL] : null;

  const lines = [];

  if(isIn) {
    // Debit: asset account
    lines.push({ AccountRef: { value: assetAcct.Id, name: assetAcct.Name },
                 Amount: +usd.toFixed(2), PostingType: 'Debit', Description: `${token} received — ${tx.wallet}` });
    // Credit: counterparty asset account OR suspense
    if(counterAcct) {
      lines.push({ AccountRef: { value: counterAcct.Id, name: counterAcct.Name },
                   Amount: +usd.toFixed(2), PostingType: 'Credit', Description: `Transfer from ${tx.counterparty?.slice(0,8)}` });
    } else {
      // Credit suspense — will need _qbSuspenseId set at runtime
      lines.push({ AccountRef: { value: '__SUSPENSE__', name: 'Suspense / Undeposited' },
                   Amount: +usd.toFixed(2), PostingType: 'Credit', Description: `${token} In — counterparty unresolved` });
    }
  }

  if(isOut) {
    const costBasis = usd - (tx.gainShort || 0) - (tx.gainLong || 0);
    // Credit: asset account (at proceeds)
    lines.push({ AccountRef: { value: assetAcct.Id, name: assetAcct.Name },
                 Amount: +usd.toFixed(2), PostingType: 'Credit', Description: `${token} disposed — ${tx.wallet}` });
    // Debit: counterparty OR suspense (at proceeds)
    if(counterAcct) {
      lines.push({ AccountRef: { value: counterAcct.Id, name: counterAcct.Name },
                   Amount: +usd.toFixed(2), PostingType: 'Debit', Description: `Transfer to ${tx.counterparty?.slice(0,8)}` });
    } else {
      lines.push({ AccountRef: { value: '__SUSPENSE__', name: 'Suspense / Undeposited' },
                   Amount: +usd.toFixed(2), PostingType: 'Debit', Description: `${token} Out — counterparty unresolved` });
    }
    // If gain/loss: add separate lines
    if(hasGain) {
      const totalGain = (tx.gainShort || 0) + (tx.gainLong || 0);
      const gainAbs = Math.abs(totalGain);
      const isGain  = totalGain > 0;
      // We'll resolve GL accounts for gain/loss at runtime via _qbGainAcctId / _qbLossAcctId
      lines.push({ AccountRef: { value: isGain ? '__GAIN_ACCT__' : '__LOSS_ACCT__',
                                  name: isGain ? 'Realized Gain' : 'Realized Loss' },
                   Amount: +gainAbs.toFixed(2),
                   PostingType: isGain ? 'Credit' : 'Debit',
                   Description: `Realized ${(tx.gainShort||0)!==0?'ST':'LT'} ${isGain?'gain':'loss'} on ${token}` });
      // Balancing entry for cost basis
      lines.push({ AccountRef: { value: assetAcct.Id, name: assetAcct.Name },
                   Amount: +gainAbs.toFixed(2),
                   PostingType: isGain ? 'Debit' : 'Credit',
                   Description: `Cost basis adj — ${fmtUSD(costBasis)} basis` });
    }
  }

  return lines;
}

// ── Connect OAuth ─────────────────────────────────────────────────
// qbConnect([entity]) — abre OAuth para uma empresa específica.
// Se entity não for fornecida, mostra um picker com as 4 empresas.
function qbConnect(entity) {
  const allEntities = Object.keys(QB_REALM_IDS);

  // Se não foi especificada a empresa, mostra selector simples
  if(!entity) {
    const already = allEntities.filter(e => {
      const t = _qb.tokens[QB_REALM_IDS[e]];
      return t?.accessToken && Date.now() < t.tokenExpiry;
    });
    const options = allEntities.map(e => {
      const connected = already.includes(e) ? ' ✓' : '';
      return `<option value="${e}">${e}${connected}</option>`;
    }).join('');
    const sel = prompt(`Conectar QB para qual empresa?\n\n${allEntities.map((e,i)=>`${i+1}. ${e}${already.includes(e)?' ✓':''}`).join('\n')}\n\nEscreve o nome:`);
    if(!sel) return;
    entity = allEntities.find(e => e.toLowerCase() === sel.trim().toLowerCase());
    if(!entity) { alert(`Empresa "${sel}" não encontrada. Opções: ${allEntities.join(', ')}`); return; }
  }

  const realmId = QB_REALM_IDS[entity];
  if(!realmId) { alert(`Sem realmId para "${entity}"`); return; }

  const authWin = window.open(`${PROXY_BASE}/auth/qb/connect?entity=${encodeURIComponent(entity)}&realmId=${realmId}`, 'qb_auth', 'width=600,height=700');

  const onMsg = async (event) => {
    if(event.data?.type !== 'QB_AUTH_SUCCESS') return;
    window.removeEventListener('message', onMsg);
    clearTimeout(timeout);
    const connectedRealmId = event.data.realmId || realmId;
    const connectedEntity  = event.data.entity  || entity;
    try {
      const res  = await fetch(`${PROXY_BASE}/auth/qb/load_tokens?realmId=${connectedRealmId}`, { credentials: 'include' });
      const data = await res.json();
      if(data.accessToken) {
        qbSaveTokens(data.accessToken, data.refreshToken, Math.round((data.expiry - Date.now())/1000), connectedRealmId);

        // Actualiza token activo para Opco se possível, senão para este
        const opcoId = QB_REALM_IDS['Opco'];
        const active = _qb.tokens[opcoId] || _qb.tokens[connectedRealmId];
        if(active) {
          _qb.accessToken  = active.accessToken;
          _qb.refreshToken = active.refreshToken;
          _qb.tokenExpiry  = active.tokenExpiry;
          _qb.realmId      = opcoId || connectedRealmId;
        }

        const connectedList = Object.entries(QB_REALM_IDS)
          .filter(([,rid]) => _qb.tokens[rid]?.accessToken)
          .map(([name]) => name).join(' + ');

        qbLog(`✓ QB conectado: ${connectedEntity} (realm: ${connectedRealmId})`, 'var(--green)');
        qbSetConnStatus(true, `Connected · ${connectedList} · expires ${new Date(_qb.tokenExpiry).toLocaleTimeString()}`);
        await qbFetchAccountMap();
      }
    } catch(e) { qbLog('Erro a carregar tokens após auth: ' + e.message, 'var(--red)'); }
  };
  window.addEventListener('message', onMsg);
  const timeout = setTimeout(() => window.removeEventListener('message', onMsg), 180000);
}

function qbDisconnect() {
  qbClearTokens();
  _qb.glAccountMap = null;
  qbSetConnStatus(false, 'Not connected');
  qbLog('Disconnected', 'var(--muted)');
}

// ── Fetch QB accounts → build GL code map ─────────────────────────
async function qbFetchAccountMap() {
  // Load accounts for each mapped entity separately (different QB companies)
  _qb.glAccountMapByEntity = {};

  for(const [entity, realmId] of Object.entries(QB_REALM_IDS)) {
    // Skip entities that already failed with 401 (no token for that company)
    if((_qb.entityAuthFailed||{})[entity]) {
      qbLog(`⏭ Skipping ${entity} — no valid token`, '#aaa'); continue;
    }
    qbLog(`Fetching chart of accounts — ${entity} (${realmId})…`);
    try {
      const res = await qbApiGet(`/v3/company/${realmId}/query?query=SELECT * FROM Account MAXRESULTS 1000`);
      if(!res?.QueryResponse?.Account) {
        qbLog(`❌ Failed to fetch accounts for ${entity}`, 'var(--red)'); continue;
      }
      const accounts = res.QueryResponse.Account;
      const map = {};
      let mappedCount = 0, noNumCount = 0;
      accounts.forEach(a => {
        if(a.AcctNum) {
          const key = String(a.AcctNum).trim();
          map[key] = { Id: a.Id, Name: a.Name, Type: a.AccountType };
          mappedCount++;
        } else {
          noNumCount++;
        }
        map[`id:${a.Id}`] = { Id: a.Id, Name: a.Name, AcctNum: a.AcctNum };
      });
      _qb.glAccountMapByEntity[entity] = map;
      // Debug: check if our key GL codes are present
      const testCodes = entity==='Opco' ? ['1133072','1132923','1132942'] : ['1132503','1132803'];
      const found = testCodes.filter(c => map[c]);
      const missing = testCodes.filter(c => !map[c]);
      qbLog(`  ${entity}: ${mappedCount} with AcctNum, ${noNumCount} without · GL check: ✓[${found.join(',')}] ✗[${missing.join(',')}]`, missing.length?'#f0a500':'var(--green)');

      // Find special accounts per entity
      const findAcct = (kws) => accounts.find(a => kws.some(k=>(a.Name||'').toLowerCase().includes(k)));
      const suspense = findAcct(['suspense','undeposited','clearing']);
      const gainAcct = findAcct(['realized gain','capital gain']);
      const lossAcct = findAcct(['realized loss','capital loss']);
      if(!_qb.specialByEntity) _qb.specialByEntity = {};
      _qb.specialByEntity[entity] = {
        suspenseId: suspense?.Id,
        gainAcctId: gainAcct?.Id,
        lossAcctId: lossAcct?.Id,
      };
      qbLog(`  ✓ ${entity}: ${accounts.length} accounts · Suspense: ${suspense?.Name||'⚠'} · Gain: ${gainAcct?.Name||'⚠'} · Loss: ${lossAcct?.Name||'⚠'}`, 'var(--green)');
    } catch(err) {
      if(err.message && err.message.includes('401')) {
        _qb.entityAuthFailed = _qb.entityAuthFailed||{};
        _qb.entityAuthFailed[entity] = true;
        qbLog(`❌ ${entity}: no token (401) — skipping future fetches`, 'var(--red)');
      } else {
        qbLog(`❌ ${entity}: ${err.message}`, 'var(--red)');
      }
    }
  }

  // Keep a combined map for backward compat (used in CP GL dropdown)
  _qb.glAccountMap = Object.values(_qb.glAccountMapByEntity).reduce((acc, m) => ({...acc, ...m}), {});
  qbRenderTable();
  if(state.activeTab === 'transactions') renderTx();

  // Fetch vendors for each entity
  _qb.vendorsByEntity = _qb.vendorsByEntity || {};
  for(const [entity, realmId] of Object.entries(QB_REALM_IDS)) {
    if((_qb.entityAuthFailed||{})[entity]) { continue; }
    try {
      const vres = await qbApiGet(`/v3/company/${realmId}/query?query=SELECT * FROM Vendor MAXRESULTS 1000`);
      const vendors = vres?.QueryResponse?.Vendor || [];
      _qb.vendorsByEntity[entity] = vendors.map(v => ({ Id: v.Id, Name: v.DisplayName || v.PrintOnCheckName || v.CompanyName || v.GivenName || '' }))
        .filter(v => v.Name).sort((a,b) => a.Name.localeCompare(b.Name));
      qbLog(`  ✓ ${entity}: ${_qb.vendorsByEntity[entity].length} vendors`, 'var(--green)');
    } catch(err) {
      qbLog(`  ⚠ Vendors ${entity}: ${err.message}`, '#f0a500');
    }
  }
}

// ── API helpers ───────────────────────────────────────────────────
// qbEnsureToken([realmId]) — garante token válido para a empresa dada.
// Devolve o accessToken actualizado.
async function qbEnsureToken(realmId) {
  const rid = realmId || _qb.realmId || QB_REALM_IDS['Opco'];
  const t   = _qb.tokens[rid] || { accessToken: _qb.accessToken, refreshToken: _qb.refreshToken, tokenExpiry: _qb.tokenExpiry };
  if(!t.accessToken) throw new Error(`Not connected to QuickBooks (${rid})`);

  if(Date.now() > (t.tokenExpiry || 0) - 1800000) { // refresh if expires in < 30 min
    // First try to sync from server (server may have a fresher token)
    try {
      const syncRes = await fetch(`${PROXY_BASE}/auth/qb/load_tokens?realmId=${rid}`, { credentials: 'include' });
      if (syncRes.ok) {
        const syncData = await syncRes.json();
        if (syncData.accessToken && syncData.expiry > Date.now()) {
          qbSaveTokens(syncData.accessToken, syncData.refreshToken, Math.round((syncData.expiry - Date.now()) / 1000), rid);
          return _qb.tokens[rid].accessToken;
        }
      }
    } catch(e) { /* fall through to local refresh */ }

    // Server token also expired — do local refresh
    const res = await fetch(`${PROXY_BASE}/auth/qb/token`, {
      method: 'POST',
      credentials: 'include',
      headers: authHeaders({ 'Content-Type': 'application/json' }),
      body: JSON.stringify({ grant_type: 'refresh_token', refresh_token: t.refreshToken, realmId: rid }),
    });
    if(!res.ok) throw new Error(`Token refresh failed for ${rid} — please reconnect`);
    const data = await res.json();
    qbSaveTokens(data.access_token, data.refresh_token || t.refreshToken, data.expires_in || 3600, rid);
    return _qb.tokens[rid].accessToken;
  }
  return t.accessToken;
}

async function qbApiGet(path, realmId) {
  const rid         = realmId || _qb.realmId || Object.values(QB_REALM_IDS)[0] || '';
  const accessToken = await qbEnsureToken(rid);
  const proxyUrl    = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${rid}`;
  const res = await fetch(proxyUrl, {
    credentials: 'include',
    headers: { 'Authorization': `Bearer ${accessToken}` }
  });
  if(!res.ok) { qbLog(`❌ API error ${res.status}: ${path}`, 'var(--red)'); return null; }
  return res.json();
}
async function qbApiPostForEntity(entity, body) {
  const realmId     = QB_REALM_IDS[entity];
  if(!realmId) throw new Error(`No realmId for entity "${entity}"`);
  const accessToken = await qbEnsureToken(realmId);
  const path        = `/v3/company/${realmId}/journalentry?minorversion=65`;
  const proxyUrl    = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
  const res = await fetch(proxyUrl, {
    method: 'POST',
    credentials: 'include',
    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${accessToken}` },
    body: JSON.stringify(body),
  });
  const data = await res.json();
  if(!res.ok) {
    const qbErr = data?.Fault?.Error?.[0];
    const detail = qbErr?.Detail || '';
    const msg = (qbErr?.Message || `HTTP ${res.status}`) + (detail ? ' — ' + detail : '');
    throw new Error(msg);
  }
  return data;
}

// qbApiPostForEntity — see proxy version above

async function qbApiPost(path, body) {
  const rid         = _qb.realmId || QB_REALM_IDS['Opco'];
  const accessToken = await qbEnsureToken(rid);
  const res = await fetch(`${QB_BASE_URL}${path}`, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${accessToken}`,
      'Content-Type': 'application/json',
      Accept: 'application/json',
    },
    body: JSON.stringify(body),
  });
  const data = await res.json();
  if(!res.ok) {
    const qbErr = data?.Fault?.Error?.[0];
    const detail = qbErr?.Detail || '';
    const msg = (qbErr?.Message || `HTTP ${res.status}`) + (detail ? ' — ' + detail : '');
    throw new Error(msg);
  }
  return data;
}

// ── Tab init ──────────────────────────────────────────────────────
function qbInitTab() {
  if(qbLoadTokens() && !_qb.glAccountMap) {
    const connectedList = Object.entries(QB_REALM_IDS)
      .filter(([,rid]) => _qb.tokens[rid]?.accessToken)
      .map(([name]) => name).join(' + ') || 'Opco';
    qbSetConnStatus(true, `Connected · ${connectedList} · expires ${new Date(_qb.tokenExpiry).toLocaleTimeString()}`);
    qbFetchAccountMap();
  } else if(_qb.accessToken) {
    const connectedList = Object.entries(QB_REALM_IDS)
      .filter(([,rid]) => _qb.tokens[rid]?.accessToken)
      .map(([name]) => name).join(' + ') || 'Opco';
    qbSetConnStatus(true, `Connected · ${connectedList}`);
    qbRenderTable();
  } else {
    qbSetConnStatus(false, 'Not connected');
  }
  qbFilterChange();
}

// ── Filter + render transaction table ─────────────────────────────
function qbFilterChange() {
  const entity = document.getElementById('qb-entity')?.value || '';
  const token  = document.getElementById('qb-token')?.value  || '';
  const wallet = document.getElementById('qb-wallet')?.value || '';
  const month  = document.getElementById('qb-month')?.value  || '';
  const dir    = document.getElementById('qb-dir')?.value    || '';

  const fromTs = state.fromDate ? Math.floor(new Date(state.fromDate+'T00:00:00Z').getTime()/1000) : 0;
  const toTs   = state.toDate   ? Math.floor(new Date(state.toDate  +'T23:59:59Z').getTime()/1000) : Infinity;
  const ENTITIES = new Set(['Opco','Foundation']);

  // Combine transactions + orca ledger (same as renderTx)
  const nonOrcaTxs = state.transactions.filter(t => (t.asset||t.token) !== 'ORCA');
  const orcaInPeriod = orcaLedgerData.filter(r => !r.synthetic && r.blockTime >= fromTs && r.blockTime <= toTs);
  const orcaRows = orcaInPeriod.map(r => {
    const glKey = (r.txHash||'') + '::' + (r.walletAddr||'');
    const gl = orcaLedgerGLMap[glKey] || {};
    return { ...r, asset:'ORCA', gainShort:gl.gainShort||0, gainLong:gl.gainLong||0,
             date: r.date instanceof Date ? r.date : new Date(r.blockTime*1000) };
  });
  const allTxs = [...nonOrcaTxs, ...orcaRows];

  const entityAddrs = entity
    ? new Set(ALL_WALLETS.filter(w=>w.entity===entity).map(w=>w.address))
    : new Set(ALL_WALLETS.filter(w=>ENTITIES.has(w.entity)).map(w=>w.address));

  const posted = qbGetPosted();

  let data = allTxs.filter(t => {
    const addr = t.walletAddr || '';
    const tok  = t.asset || t.token || '';
    const d    = typeof t.date === 'string' ? t.date : t.date?.toISOString?.() || '';
    if(!entityAddrs.has(addr)) return false;
    if(!ENTITIES.has(ALL_WALLETS.find(w=>w.address===addr)?.entity || '')) return false;
    if(token  && tok   !== token)  return false;
    if(wallet && t.wallet !== wallet) return false;
    if(month  && d.slice(0,7) !== month) return false;
    if(dir    && t.dir !== dir) return false;
    // Safety guard: never show pre-Feb 2026
    if(d < QB_MIN_DATE) return false;
    // Must have GL code
    if(!qbResolveGL(addr, tok)) return false;
    return true;
  });

  data = sortData(data, 'date', 'desc');
  _qb.filteredData = data;

  // Populate wallet + month filters
  const walletSel = document.getElementById('qb-wallet');
  if(walletSel) {
    const cur = walletSel.value;
    const wallets = [...new Set(data.map(t=>t.wallet).filter(Boolean))].sort();
    walletSel.innerHTML = '<option value="">All wallets</option>' + wallets.map(w=>`<option${w===cur?' selected':''}>${w}</option>`).join('');
  }
  populateMonthSelect('qb-month', data.map(t=>t.date));

  document.getElementById('qb-filter-count').textContent =
    `${data.length.toLocaleString()} transactions · ${[...new Set(data.map(t=>t.walletAddr))].length} wallets`;

  qbRenderTable();
}

function qbRenderTable() {
  const posted = qbGetPosted();
  const tbody = document.getElementById('qb-tx-tbody');
  if(!tbody) return;

  const glMap = _qb.glAccountMap || {};

  tbody.innerHTML = _qb.filteredData.map(t => {
    const tok   = t.asset || t.token || '';
    const addr  = t.walletAddr || '';
    const hash  = t.txHash || '';
    const d     = typeof t.date === 'string' ? t.date.slice(0,10) : t.date?.toISOString?.()?.slice(0,10);
    const assetGL = qbResolveGL(addr, tok);
    const cpGL    = t.counterparty ? qbResolveGL(t.counterparty, tok) : null;
    const isPosted = posted.has(hash);
    const isChecked = _qb.selectedHashes.has(hash);

    // Debit / Credit GL code display
    const debitGL  = t.dir==='In'  ? assetGL : (cpGL||'Suspense');
    const creditGL = t.dir==='In'  ? (cpGL||'Suspense') : assetGL;

    // QB account name if loaded
    const debitName  = glMap[debitGL]?.Name  || debitGL;
    const creditName = glMap[creditGL]?.Name || creditGL;

    const usd = Math.abs(t.usd||0);
    const gs  = t.gainShort||0;
    const gl  = t.gainLong||0;

    const rowBg = isPosted ? 'background:rgba(44,160,28,0.06)' : '';

    return `<tr style="${rowBg}${isPosted?';opacity:0.65':''}">
      <td style="padding:6px 10px;text-align:center">
        ${isPosted
          ? '<span style="color:var(--green);font-size:0.8rem" title="Already posted">✓</span>'
          : `<input type="checkbox" data-hash="${hash}" ${isChecked?'checked':''} onchange="_qbCheck(this)" style="cursor:pointer">`}
      </td>
      <td class="muted" style="font-size:0.72rem;white-space:nowrap">${d||'—'}</td>
      <td style="font-size:0.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${t.wallet}">${t.wallet||'—'}</td>
      <td>${tokenBadge(tok)}</td>
      <td class="${t.dir==='In'?'gain-pos':'gain-neg'}" style="font-weight:600;font-size:0.78rem">${t.dir}</td>
      <td class="num" style="font-size:0.72rem">${fmtUSD(usd)}</td>
      <td style="font-size:0.68rem;font-family:var(--mono);color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${debitName}">${debitName}</td>
      <td style="font-size:0.68rem;font-family:var(--mono);color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${creditName}">${creditName}</td>
      <td class="num" style="font-size:0.7rem;color:${gs>0?'var(--green)':gs<0?'var(--red)':'var(--muted)'}">${gs!==0?(gs>0?'+':'')+fmtUSD(gs):'—'}</td>
      <td class="num" style="font-size:0.7rem;color:${gl>0?'var(--green)':gl<0?'var(--red)':'var(--muted)'}">${gl!==0?(gl>0?'+':'')+fmtUSD(gl):'—'}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="10" style="padding:24px;text-align:center;color:var(--muted);font-size:0.8rem">No transactions — fetch data first (Feb 2026+)</td></tr>';
}

function _qbCheck(checkbox) {
  const hash = checkbox.dataset.hash;
  if(checkbox.checked) _qb.selectedHashes.add(hash);
  else _qb.selectedHashes.delete(hash);
}

function qbToggleAll(checked) {
  const boxes = document.querySelectorAll('#qb-tx-tbody input[type=checkbox]');
  boxes.forEach(cb => {
    cb.checked = checked;
    const hash = cb.dataset.hash;
    if(checked) _qb.selectedHashes.add(hash);
    else _qb.selectedHashes.delete(hash);
  });
}

function qbSelectAll()  { document.getElementById('qb-check-all').checked = true;  qbToggleAll(true);  }
function qbSelectNone() { document.getElementById('qb-check-all').checked = false; qbToggleAll(false); }

// ── Preview ───────────────────────────────────────────────────────
function qbPreview() {
  if(!_qb.accessToken) { alert('Connect to QuickBooks first'); return; }
  if(!_qb.selectedHashes.size) { alert('Select at least one transaction'); return; }

  const glMap = _qb.glAccountMap || {};
  const posted = qbGetPosted();
  const selected = _qb.filteredData.filter(t => _qb.selectedHashes.has(t.txHash) && !posted.has(t.txHash));

  if(!selected.length) { alert('All selected transactions are already posted'); return; }

  // Build journal entries — group by date + txHash for multi-token txs
  const entries = [];
  for(const tx of selected) {
    const lines = qbBuildJournalLines(tx, glMap);
    if(!lines) continue;

    // Resolve placeholder IDs
    lines.forEach(l => {
      if(l.AccountRef.value === '__SUSPENSE__') l.AccountRef.value = _qb.suspenseId || '0';
      if(l.AccountRef.value === '__GAIN_ACCT__') l.AccountRef.value = _qb.gainAcctId || '0';
      if(l.AccountRef.value === '__LOSS_ACCT__') l.AccountRef.value = _qb.lossAcctId || '0';
    });

    const d = typeof tx.date === 'string' ? tx.date.slice(0,10) : tx.date?.toISOString?.()?.slice(0,10);
    entries.push({
      _tx: tx,
      TxnDate:   d,
      DocNumber: tx.txHash?.slice(0,12),
      PrivateNote: `Tidelog · ${tx.txHash}`,
      Line: lines.map((l,i) => ({
        Id: String(i+1),
        DetailType: 'JournalEntryLineDetail',
        Amount: l.Amount,
        Description: l.Description,
        JournalEntryLineDetail: {
          PostingType: l.PostingType,
          AccountRef:  l.AccountRef,
        }
      })),
    });
  }

  _qb.previewEntries = entries;

  // Render preview modal
  const modal = document.getElementById('qb-preview-modal');
  const content = document.getElementById('qb-preview-content');
  document.getElementById('qb-preview-count').textContent = `${entries.length} journal entries · ${selected.length} transactions`;

  content.innerHTML = entries.map((e,i) => {
    const totalDebit  = e.Line.filter(l=>l.JournalEntryLineDetail.PostingType==='Debit').reduce((s,l)=>s+l.Amount,0);
    const totalCredit = e.Line.filter(l=>l.JournalEntryLineDetail.PostingType==='Credit').reduce((s,l)=>s+l.Amount,0);
    const balanced = Math.abs(totalDebit - totalCredit) < 0.01;

    return `<div style="border:1px solid var(--border);border-radius:6px;padding:12px 14px;margin-bottom:10px;background:var(--bg)">
      <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px">
        <span style="font-size:0.72rem;font-weight:700;color:var(--text)">${e.TxnDate}</span>
        <span style="font-family:var(--mono);font-size:0.65rem;color:var(--muted)">${e.DocNumber}</span>
        ${tokenBadge(e._tx.asset||e._tx.token||'')}
        <span class="${e._tx.dir==='In'?'gain-pos':'gain-neg'}" style="font-size:0.72rem;font-weight:600">${e._tx.dir}</span>
        <span style="font-size:0.72rem;color:var(--text)">${fmtUSD(Math.abs(e._tx.usd||0))}</span>
        <span style="margin-left:auto;font-size:0.65rem;font-family:var(--mono);color:${balanced?'var(--green)':'var(--red)'}">
          ${balanced?'✓ balanced':'⚠ unbalanced'}
        </span>
      </div>
      <table style="width:100%;font-size:0.68rem;font-family:var(--mono);border-collapse:collapse">
        <tr style="color:var(--muted);border-bottom:1px solid var(--border)">
          <th style="text-align:left;padding:3px 6px">Account</th>
          <th style="text-align:right;padding:3px 6px">Debit</th>
          <th style="text-align:right;padding:3px 6px">Credit</th>
          <th style="text-align:left;padding:3px 6px">Note</th>
        </tr>
        ${e.Line.map(l => `<tr style="border-bottom:1px solid var(--border)">
          <td style="padding:3px 6px;color:var(--text)">${l.JournalEntryLineDetail.AccountRef.name||l.JournalEntryLineDetail.AccountRef.value}</td>
          <td style="text-align:right;padding:3px 6px;color:var(--text)">${l.JournalEntryLineDetail.PostingType==='Debit'?fmtUSD(l.Amount):''}</td>
          <td style="text-align:right;padding:3px 6px;color:var(--muted)">${l.JournalEntryLineDetail.PostingType==='Credit'?fmtUSD(l.Amount):''}</td>
          <td style="padding:3px 6px;color:var(--muted2);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${l.Description||''}</td>
        </tr>`).join('')}
        <tr style="font-weight:700;border-top:2px solid var(--border)">
          <td style="padding:4px 6px;color:var(--muted)">TOTAL</td>
          <td style="text-align:right;padding:4px 6px">${fmtUSD(totalDebit)}</td>
          <td style="text-align:right;padding:4px 6px;color:var(--muted)">${fmtUSD(totalCredit)}</td>
          <td></td>
        </tr>
      </table>
    </div>`;
  }).join('');

  modal.style.display = 'flex';
}

function qbClosePreview() {
  document.getElementById('qb-preview-modal').style.display = 'none';
}

// ── Post to QB ────────────────────────────────────────────────────
async function qbPost() {
  const entries = _qb.previewEntries;
  if(!entries.length) return;

  const btn = document.getElementById('qb-post-btn');
  btn.disabled = true;
  btn.textContent = 'Posting…';
  qbClosePreview();

  let ok = 0, fail = 0;
  const postedHashes = [];
  const postedHashMap = {};

  for(const entry of entries) {
    const { _tx, ...jePayload } = entry;
    try {
      const res = await qbApiPost(
        `/v3/company/${QB_REALM_ID}/journalentry?minorversion=65`,
        jePayload
      );
      const jeId = res?.JournalEntry?.Id;
      qbLog(`✓ Posted JE #${jeId} · ${entry.TxnDate} · ${fmtUSD(Math.abs(_tx.usd||0))} · ${_tx.txHash?.slice(0,12)}`, 'var(--green)');
      postedHashes.push(_tx.txHash);
      ok++;
    } catch(err) {
      qbLog(`❌ Failed: ${_tx.txHash?.slice(0,12)} — ${err.message}`, 'var(--red)');
      fail++;
    }
    // Small delay to respect QB rate limits (10 req/sec)
    await new Promise(r => setTimeout(r, 110));
  }

  qbMarkPosted(postedHashes, null, postedHashMap);
  postedHashes.forEach(h => _qb.selectedHashes.delete(h));
  qbRenderTable();

  btn.disabled = false;
  btn.textContent = 'Post to QuickBooks';
  qbLog(`── Done: ${ok} posted, ${fail} failed ──`, ok>0?'var(--green)':'var(--red)');
}


// ── Tx Description + CP GL overrides (in-memory) ─────────────────
window._txDescOverrides = {};
window._txCpGlOverrides = {};

function _txSetDesc(key, val) {
  window._txDescOverrides[key] = val;
}

// ── CP GL Memory — persists by counterparty address ───────────────
const CP_GL_MEMORY_KEY = 'cp_gl_memory';

function cpGlMemoryGet() {
  try { return JSON.parse(localStorage.getItem(CP_GL_MEMORY_KEY) || '{}'); }
  catch(e) { return {}; }
}

function cpGlMemorySet(cpAddr, glCode) {
  if(!cpAddr || !glCode) return;
  const mem = cpGlMemoryGet();
  mem[cpAddr] = glCode;
  try { localStorage.setItem(CP_GL_MEMORY_KEY, JSON.stringify(mem)); } catch(e) {}
}

function cpGlMemoryGet1(cpAddr) {
  if(!cpAddr) return null;
  return cpGlMemoryGet()[cpAddr] || null;
}

// ── Extra split lines in modal ────────────────────────────────────────────────
function _txModalAddLine(hashFull, baseUsd) {
  window._modalExtraLines = window._modalExtraLines || {};
  if(!window._modalExtraLines[hashFull]) window._modalExtraLines[hashFull] = [];
  window._modalExtraLines[hashFull].push({ usd: parseFloat(baseUsd) || 0, debit: '', credit: '' });
  _txRebuildModal();
}
function _txExtraLineSet(hashFull, idx, field, val) {
  const lines = (window._modalExtraLines||{})[hashFull];
  if(lines && lines[idx] !== undefined) lines[idx][field] = val;
}
function _txExtraLineRemove(hashFull, idx) {
  const lines = (window._modalExtraLines||{})[hashFull];
  if(lines) { lines.splice(idx, 1); _txRebuildModal(); }
}
function _txRebuildModal() {
  // Rebuild modal HTML using stored entries — regenerates rows with current state
  const entries    = _qb._modalEntries || [];
  const bulkGroups = _qb.bulkGroups   || [];
  if(!entries.length && !bulkGroups.length) return;
  // Preserve scroll position
  const modal = document.getElementById('txQbModal');
  const scrollEl = modal?.querySelector('div[style*="overflow-y"]');
  const scrollTop = scrollEl?.scrollTop || 0;
  // Re-run the modal show function which rebuilds all rows from scratch
  txQbShowModal(entries.map(e => e.t), bulkGroups);
  requestAnimationFrame(() => {
    const newScrollEl = document.getElementById('txQbModal')?.querySelector('div[style*="overflow-y"]');
    if(newScrollEl) newScrollEl.scrollTop = scrollTop;
  });
}

function _txSetCpGl(key, val, cpAddr, hashFull) {
  window._txCpGlOverrides = window._txCpGlOverrides || {};
  window._txCpGlOverrides[key] = val;
  // Save to CP GL memory by counterparty address
  if(cpAddr && val) cpGlMemorySet(cpAddr, val);
  // Batch fill: if this row is selected, apply same CP GL to all other selected rows
  if(hashFull && val && _qb.selectedHashes?.has(hashFull)) {
    const visData = _txVS?.data || [];
    for(const tx of visData) {
      const h = tx.txHash || tx.hash || '';
      if(h && h !== hashFull && _qb.selectedHashes.has(h)) {
        window._txCpGlOverrides[h + '::cpgl'] = val;
      }
    }
    // Re-render to show updated dropdowns
    if(typeof renderTx === 'function') renderTx();
  }
}

// ── txQbPost — open QB post modal ───────────────────────────────────────────────
async function txQbPost() {
  if(!_qb.accessToken) {
    const ok = await qbAutoConnect();
    if(!ok) {
      alert('Servidor QB não está a correr.\nAbre o terminal e executa:\nnode qb_auth_server_tidelog.js');
      return;
    }
  }
  const totalAccounts = Object.values(_qb.glAccountMapByEntity||{}).reduce((s,m)=>s+Object.keys(m).length,0);
  if(totalAccounts === 0) {
    qbLog('Loading account map…', 'var(--muted)');
    await qbFetchAccountMap();
  }

  const visibleData = _txVS.data || [];
  if(!visibleData.length) { alert('No transactions loaded. Fetch data first.'); return; }

  // If any rows are selected, only post those; otherwise post all visible
  const hasSelection = _qb.selectedHashes?.size > 0;
  const sourceData   = hasSelection
    ? visibleData.filter(t => _qb.selectedHashes.has(t.txHash))
    : visibleData;

  const eligible = sourceData.filter(t => {
    const d = typeof t.date==='string' ? t.date : t.date?.toISOString?.() || '';
    return d >= QB_MIN_DATE;
  });
  if(!eligible.length) {
    alert('No transactions from Feb 2026 onwards in current filter.\n\nAdjust filters and try again.');
    return;
  }

  const posted = qbGetPosted();

  // ── Bulk wallets: In only → one JE per wallet+token+month ────
  const bulkTxs   = eligible.filter(t => QB_BULK_WALLETS.has(t.walletAddr) && t.dir === 'In');
  // Normal: everything else (including Out from bulk wallets)
  const normalTxs = eligible.filter(t => !(QB_BULK_WALLETS.has(t.walletAddr) && t.dir === 'In'));

  const bulkGroups     = _qbBuildBulkGroups(bulkTxs, posted);
  const normalUnposted = normalTxs.filter(t => !posted.has(t.txHash||''));

  if(!bulkGroups.length && !normalUnposted.length) {
    alert('All visible transactions are already posted to QuickBooks.');
    return;
  }

  _qb.bulkGroups    = bulkGroups;
  _qb.txPreviewData = normalUnposted;
  txQbShowModal(normalUnposted, bulkGroups);
}

// ── Build bulk groups: one entry per wallet+token+month ──────────
function _qbBuildBulkGroups(bulkTxs, posted) {
  const groups = {};
  for(const t of bulkTxs) {
    const d   = typeof t.date==='string' ? t.date : t.date?.toISOString?.() || '';
    const mon = d.slice(0,7); // YYYY-MM
    const tok = t.asset || t.token || '';
    const key = `bulk::${t.walletAddr}::${tok}::${mon}`;
    if(posted.has(key)) continue;
    if(!groups[key]) {
      const [yr,mo] = mon.split('-').map(Number);
      const lastDay = new Date(yr, mo, 0).getDate();
      groups[key] = {
        key, mon, tok,
        txnDate:    `${mon}-${String(lastDay).padStart(2,'0')}`,
        walletAddr: t.walletAddr,
        wallet:     walletLabel(t.walletAddr) || t.walletAddr.slice(0,8),
        entity:     ALL_WALLETS.find(w=>w.address===t.walletAddr)?.entity || '',
        totalQty: 0, totalUsd: 0, count: 0,
      };
    }
    groups[key].totalQty += Math.abs(t.qty  || 0);
    groups[key].totalUsd += Math.abs(t.usd  || 0);
    groups[key].count++;
  }
  return Object.values(groups);
}

function txQbShowModal(txList, bulkGroups) {
  bulkGroups = bulkGroups || [];
  const glMap  = _qb.glAccountMap || {};
  const STABLES = new Set(['USDC','USDT','PYUSD']);

  // ── 1. Inject datalist for QB account autocomplete ───────────
  const datalistId = 'qb-acct-list';
  let dl = document.getElementById(datalistId);
  if(!dl) { dl = document.createElement('datalist'); dl.id = datalistId; document.body.appendChild(dl); }
  dl.innerHTML = Object.keys(glMap).filter(k=>!k.startsWith('id:')).map(k => {
    const nm = glMap[k]?.Name || '';
    return '<option value="'+k+'">'+(nm ? k+' · '+nm : k)+'</option>';
  }).join('');

  // ── 2. Build INDIVIDUAL entries ──────────────────────────────
  const entries = txList.map(t => {
    const asset   = t.asset || t.token || '';
    const addr    = t.walletAddr || '';
    const hashFull= t.txHash || '';
    const descKey = hashFull+'::desc';
    const cpKey   = hashFull+'::cpgl';
    const tokenGL  = GL_CODE_MAP[addr]?.[asset];
    const walletGL = ALL_WALLETS.find(w=>w.address===addr)?.accountCode;
    const glCode   = tokenGL || walletGL;
    const cpAddr    = t.counterparty || '';
    const cpTokenGL = GL_CODE_MAP[cpAddr]?.[asset];
    const cpWalGL   = ALL_WALLETS.find(w=>w.address===cpAddr)?.accountCode;
    const cpGLCode  = window._txCpGlOverrides?.[cpKey] || cpTokenGL || cpWalGL || null;
    const dispAmt  = STABLES.has(asset) ? Math.abs(t.qty||0) : Math.abs(t.usd||0);
    const autoDesc = t.dir+' - '+asset+' - '+fmtNum(Math.abs(t.qty||0),2)+' '+asset+' - $'+fmtNum(dispAmt,2)+' - '+hashFull;
    const desc     = window._txDescOverrides?.[descKey] ?? autoDesc;
    const usd = Math.abs(t.usd||0);
    const txEntity   = ALL_WALLETS.find(w=>w.address===addr)?.entity || '';
    const entityGLMap= _qb.glAccountMapByEntity?.[txEntity] || glMap;
    const assetAcct  = glCode   ? entityGLMap[glCode]   : null;
    const cpAcct     = cpGLCode ? entityGLMap[cpGLCode] : null;
    const debitName  = t.dir==='In'  ? (assetAcct?.Name||glCode||'?') : (cpAcct?.Name||cpGLCode||'Suspense');
    const creditName = t.dir==='In'  ? (cpAcct?.Name||cpGLCode||'Suspense') : (assetAcct?.Name||glCode||'?');
    const d = typeof t.date==='string' ? t.date.slice(0,10) : t.date?.toISOString?.()?.slice(0,10);
    const hasGain   = t.dir==='Out' && ((t.gainShort||0)!==0||(t.gainLong||0)!==0);
    const totalGain = (t.gainShort||0)+(t.gainLong||0);
    return { t, d, asset, usd, glCode, cpGLCode, assetAcct, cpAcct,
             debitName, creditName, desc, hasGain, totalGain, hashFull };
  }).filter(e => e.glCode);

  if(!entries.length && !bulkGroups.length) {
    alert('No transactions with GL codes in current selection. Make sure GL codes are mapped.');
    return;
  }

  // ── 3. Build modal ───────────────────────────────────────────
  let modal = document.getElementById('txQbModal');
  if(!modal) {
    modal = document.createElement('div');
    modal.id = 'txQbModal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;align-items:flex-start;justify-content:center;padding-top:40px;overflow-y:auto';
    document.body.appendChild(modal);
  }
  modal.style.display = 'flex';

  const totalUSD     = entries.reduce((s,e)=>s+e.usd, 0);
  const bulkTotalUSD = bulkGroups.reduce((s,g)=>s+g.totalUsd, 0);
  const grandTotal   = totalUSD + bulkTotalUSD;
  const iStyle = 'width:100%;font-family:var(--mono);font-size:0.62rem;background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:3px;padding:2px 5px;outline:none';

  // ── 4. Build BULK rows ───────────────────────────────────────
  let bulkRows = '';
  for(let i=0; i<bulkGroups.length; i++) {
    const g  = bulkGroups[i];
    const bm = _qb.glAccountMapByEntity?.[g.entity] || glMap;
    const bs = _qb.specialByEntity?.[g.entity] || {};
    const bgc = GL_CODE_MAP[g.walletAddr]?.[g.tok] || ALL_WALLETS.find(w=>w.address===g.walletAddr)?.accountCode;
    const ba  = bgc ? bm[bgc] : null;
    const bsi = bs.suspenseId;
    const bsa = bsi ? bm['id:'+bsi] : null;
    const dv  = (window._txCpGlOverrides?.[g.key+'::debit']  ?? ba?.Name  ?? bgc ?? '').replace(/"/g,'&quot;');
    const cv  = (window._txCpGlOverrides?.[g.key+'::credit'] ?? bsa?.Name ?? (bsi?'Suspense':'') ).replace(/"/g,'&quot;');
    const dok = !!ba; const cok = !!(bsa||bsi);
    const dispA = STABLES.has(g.tok) ? fmtNum(g.totalQty,2) : fmtNum(g.totalUsd,2);
    const autoD = 'IN - '+g.tok+' - '+fmtNum(g.totalQty,2)+' '+g.tok+' - $'+dispA+' - '+g.mon+' - '+g.count+' txs';
    const dsc   = (window._txDescOverrides?.[g.key+'::desc'] ?? autoD).replace(/"/g,'&quot;');
    g._descKey = g.key+'::desc'; g._autoDesc = autoD;
    const dk = g.key+'::debit'; const ck = g.key+'::credit';
    const bg2 = i%2===0 ? 'background:var(--bg)' : '';
    bulkRows +=
      '<tr style="border-bottom:1px solid var(--border);'+bg2+'">'
      +'<td style="padding:5px 8px;font-family:var(--mono);white-space:nowrap;color:var(--accent)">'+g.txnDate+'</td>'
      +'<td style="padding:5px 8px;font-size:0.68rem;color:var(--accent)">'+g.entity+'</td>'
      +'<td style="padding:5px 8px;font-size:0.69rem;max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+g.wallet+'</td>'
      +'<td style="padding:5px 8px">'+tokenBadge(g.tok)+'</td>'
      +'<td style="padding:5px 8px;text-align:right;font-weight:600">'+fmtUSD(g.totalUsd)+'</td>'
      +'<td style="padding:5px 8px;text-align:right;color:var(--muted)">'+g.count+'</td>'
      +'<td style="padding:5px 8px;min-width:140px"><input list="'+datalistId+'" value="'+dv+'" placeholder="GL code…" onchange="(window._txCpGlOverrides=window._txCpGlOverrides||{})[\''+dk+'\']=this.value" style="'+iStyle+';border-color:'+(dok?'var(--border)':'#d44')+'" onfocus="this.style.borderColor=\'var(--accent)\'" onblur="this.style.borderColor=this.value?\'var(--accent)\':(\''+( dok?'var(--border)':'#d44')+'\')"></td>'
      +'<td style="padding:5px 8px;min-width:140px"><input list="'+datalistId+'" value="'+cv+'" placeholder="GL code…" onchange="(window._txCpGlOverrides=window._txCpGlOverrides||{})[\''+ck+'\']=this.value" style="'+iStyle+';border-color:'+(cok?'var(--border)':'#d44')+'" onfocus="this.style.borderColor=\'var(--accent)\'" onblur="this.style.borderColor=this.value?\'var(--accent)\':(\''+( cok?'var(--border)':'#d44')+'\')"></td>'
      +'<td style="padding:5px 8px"><input value="'+dsc+'" onchange="_txSetDesc(\''+g.key+'::desc\',this.value)" style="'+iStyle+'"></td>'
      +'</tr>';
  }

  // ── 5. Build INDIVIDUAL rows ─────────────────────────────────
  // Override maps for modal edits
  if(!window._modalCpGlOverrides) window._modalCpGlOverrides = {};

  // ── CP GL memory helpers ──────────────────────────────────────
  const _cpGlMemKey  = (entity, cpAddr) => 'cpglmem::' + entity + '::' + (cpAddr||'__none__');
  const _cpGlMemGet  = (entity, cpAddr) => { try { return localStorage.getItem(_cpGlMemKey(entity,cpAddr))||''; } catch(e){return '';} };
  const _cpGlMemSave = (entity, cpAddr, glCode) => { try { if(glCode) localStorage.setItem(_cpGlMemKey(entity,cpAddr), glCode); } catch(e){} };
  if(!window._modalVendorOverrides) window._modalVendorOverrides = {};

  const _buildCpGlDropdown = (e) => {
    const entity  = ALL_WALLETS.find(w=>w.address===e.t.walletAddr)?.entity || 'Opco';
    const glMap   = _qb.glAccountMapByEntity?.[entity] || _qb.glAccountMap || {};
    const glKeys  = Object.keys(glMap).filter(k => !k.startsWith('id:')).sort((a,b) => { const fa=a[0]||'0', fb=b[0]||'0'; return fa!==fb ? fa.localeCompare(fb) : a.localeCompare(b,undefined,{numeric:true}); });
    const current = window._modalCpGlOverrides[e.hashFull] || e.cpGLCode || '';
    const opts = ['<option value="">— (auto)</option>',
      ...glKeys.map(k => {
        const name = glMap[k]?.Name || '';
        const sel  = current === k ? ' selected' : '';
        return '<option value="' + k + '"' + sel + '>' + k + ' · ' + name.slice(0,18) + '</option>';
      })
    ].join('');
    return '<select data-hash="' + e.hashFull + '" onchange="window._modalCpGlOverrides[this.dataset.hash]=this.value" style="width:100%;font-family:var(--mono);font-size:0.62rem;background:#fff;border:1px solid #d0d5dd;color:#1a1a2e;border-radius:3px;padding:2px 4px">' + opts + '</select>';
  };

  const _buildVendorDropdown = (e) => {
    const entity  = ALL_WALLETS.find(w=>w.address===e.t.walletAddr)?.entity || 'Opco';
    const vendors = _qb.vendorsByEntity?.[entity] || [];
    if(!vendors.length) return '<span style="font-size:0.6rem;color:var(--muted)">connect QB</span>';
    // Auto-match by counterparty label
    const cpAddr  = e.t.counterparty || '';
    const cpName  = ALL_WALLETS.find(w=>w.address===cpAddr)?.label || cpAddr;
    const autoMatch = vendors.find(v => cpName && cpName.length > 3 && (
      v.Name.toLowerCase().includes(cpName.toLowerCase().slice(0,5)) ||
      cpName.toLowerCase().includes(v.Name.toLowerCase().slice(0,5))
    ));
    // Pre-populate override with auto-match if not already set by user
    if(autoMatch && !window._modalVendorOverrides[e.hashFull]) {
      window._modalVendorOverrides[e.hashFull] = autoMatch.Id;
    }
    const current = window._modalVendorOverrides[e.hashFull] || autoMatch?.Id || '';
    const sid = 'vdr_' + e.hashFull.slice(0,8);
    const opts = ['<option value="">— no vendor</option>',
      ...vendors.map(v => {
        const sel = current === v.Id ? ' selected' : '';
        return '<option value="' + v.Id + '"' + sel + '>' + v.Name + '</option>';
      })
    ].join('');
    return '<select id="' + sid + '" data-hash="' + e.hashFull + '" onchange="window._modalVendorOverrides[this.dataset.hash]=this.value" style="width:100%;font-family:var(--mono);font-size:0.62rem;background:#fff;border:1px solid #d0d5dd;color:#1a1a2e;border-radius:3px;padding:2px 4px">' + opts + '</select>';
  };

  let indivRows = '';
  for(let i=0; i<entries.length; i++) {
    const e   = entries[i];
    const ent = ALL_WALLETS.find(w=>w.address===e.t.walletAddr)?.entity||'—';
    const dv2 = (e.desc||'').replace(/"/g,'&quot;');
    const bg3 = i%2===0 ? 'background:var(--bg)' : '';
    // ── build inline dropdowns ──────────────────────────────────
    const _ent    = ALL_WALLETS.find(w=>w.address===e.t.walletAddr)?.entity||'Opco';
    const _glMap  = (_qb.glAccountMapByEntity||{})[_ent]||_qb.glAccountMap||{};
    const _glKeys = Object.keys(_glMap).filter(k=>!k.startsWith('id:')).sort((a,b)=>{const fa=a[0]||'0',fb=b[0]||'0';return fa!==fb?fa.localeCompare(fb):a.localeCompare(b,undefined,{numeric:true});});
    const _cpMem   = _cpGlMemGet(_ent, e.t.counterparty||'');
    const _curCp  = (window._modalCpGlOverrides||{})[e.hashFull] || _cpMem || e.cpGLCode || '';
    let _cpOpts   = '<option value="">—</option>';
    for(const k of _glKeys){const n=(_glMap[k]?.Name||'').slice(0,18);_cpOpts+='<option value="'+k+'"'+(_curCp===k?' selected':'')+'>'+k+' · '+n+'</option>';}
    const _cpSel  = '<select data-hash="'+e.hashFull+'" data-ent="'+_ent+'" data-cp="'+(e.t.counterparty||'')+'" onchange="(window._modalCpGlOverrides=window._modalCpGlOverrides||{})[this.dataset.hash]=this.value; _cpGlMemSave(this.dataset.ent,this.dataset.cp,this.value)" style="width:100%;font-size:0.59rem;font-family:var(--mono);background:#fff;border:1px solid #ccc;border-radius:3px;padding:2px 3px;cursor:pointer">'+_cpOpts+'</select>';

    const _vdrs   = ((_qb.vendorsByEntity||{})[_ent])||[];
    const _cpAddr = e.t.counterparty||'';
    const _cpLbl  = (ALL_WALLETS.find(w=>w.address===_cpAddr)||{}).label||_cpAddr||'';
    const _autoV  = _vdrs.find(v=>_cpLbl.length>2&&(v.Name.toLowerCase().includes(_cpLbl.toLowerCase().slice(0,5))||_cpLbl.toLowerCase().includes(v.Name.toLowerCase().slice(0,5))));
    // Pre-populate override with auto-match if not already set by user
    if(_autoV && !(window._modalVendorOverrides||{})[e.hashFull]) {
      window._modalVendorOverrides = window._modalVendorOverrides || {};
      window._modalVendorOverrides[e.hashFull] = _autoV.Id;
    }
    const _curV   = (window._modalVendorOverrides||{})[e.hashFull]||_autoV?.Id||'';
    let _vOpts    = '<option value="">— no vendor</option>';
    for(const v of _vdrs){_vOpts+='<option value="'+v.Id+'"'+(_curV===v.Id?' selected':'')+'>'+v.Name+'</option>';}
    const _vSel   = _vdrs.length ? '<select data-hash="'+e.hashFull+'" onchange="(window._modalVendorOverrides=window._modalVendorOverrides||{})[this.dataset.hash]=this.value" style="width:100%;font-size:0.59rem;font-family:var(--mono);background:#fff;border:1px solid #ccc;border-radius:3px;padding:2px 3px;cursor:pointer">'+_vOpts+'</select>' : '<span style="font-size:0.59rem;color:#aaa">—</span>';

    const usdVal = (window._modalUsdOverrides||{})[e.hashFull] ?? e.usd;
    const usdInput = '<input type="number" step="0.01" value="'+usdVal.toFixed(2)+'" data-hash="'+e.hashFull+'" onchange="(window._modalUsdOverrides=window._modalUsdOverrides||{})[this.dataset.hash]=parseFloat(this.value)||0" style="width:80px;text-align:right;font-family:var(--mono);font-size:0.7rem;background:#fff;border:1px solid #d0d5dd;border-radius:3px;padding:2px 5px;color:var(--text)">';

    indivRows +=
      '<tr style="border-bottom:1px solid var(--border);'+bg3+'">'
      +'<td style="padding:5px 8px;font-family:var(--mono);white-space:nowrap">'+e.d+'</td>'
      +'<td style="padding:5px 8px;font-size:0.68rem;color:var(--accent)">'+ent+'</td>'
      +'<td style="padding:5px 8px">'+tokenBadge(e.asset)+'</td>'
      +'<td style="padding:5px 8px;font-weight:600;color:'+(e.t.dir==='In'?'var(--green)':'var(--red)')+'">'+e.t.dir+'</td>'
      +'<td style="padding:3px 5px">'+usdInput+'</td>'
      +'<td style="padding:5px 8px;font-family:var(--mono);font-size:0.68rem">'+e.debitName+'</td>'
      +'<td style="padding:5px 8px;font-family:var(--mono);font-size:0.68rem;color:var(--muted)">'+e.creditName+'</td>'
      +'<td style="padding:3px 5px;min-width:130px">'+_cpSel+'</td>'
      +'<td style="padding:3px 5px;min-width:170px">'+_vSel+'</td>'
      +'<td style="padding:5px 8px;font-family:var(--mono);font-size:0.65rem;color:'+(e.hasGain?(e.totalGain>0?'var(--green)':'var(--red)'):'var(--muted)')+'">'      +(e.hasGain        ? ((e.t.gainShort||0)!==0 ? '<div>ST '+(e.t.gainShort>0?'+':'')+fmtUSD(e.t.gainShort)+'</div>' : '')          +((e.t.gainLong||0)!==0 ? '<div>LT '+(e.t.gainLong>0?'+':'')+fmtUSD(e.t.gainLong)+'</div>' : '')        : '—')      +'</td>'
      +'<td style="padding:5px 8px"><input value="'+dv2+'" onchange="_txSetDesc(\''+e.hashFull+'::desc\',this.value)" style="'+iStyle+'"></td>'
      +'<td style="padding:3px 5px;white-space:nowrap"><button onclick="_txModalAddLine(\''+e.hashFull+'\','+e.usd.toFixed(2)+')" title="Add extra split line" style="font-size:0.65rem;font-family:var(--mono);padding:2px 7px;border-radius:3px;border:1px solid var(--accent);background:var(--accent-bg);color:var(--accent);cursor:pointer">+ line</button></td>'
      +'</tr>';

    // Render extra split lines for this hash
    const extras = (window._modalExtraLines||{})[e.hashFull] || [];
    const _glKeys2 = Object.keys(_glMap).filter(k=>!k.startsWith('id:')).sort((a,b)=>{const fa=a[0]||'0',fb=b[0]||'0';return fa!==fb?fa.localeCompare(fb):a.localeCompare(b,undefined,{numeric:true});});
    extras.forEach((xl, xi) => {
      let xDebitOpts='<option value="">— debit</option>', xCreditOpts='<option value="">— credit</option>';
      for(const k of _glKeys2){const n=(_glMap[k]?.Name||'').slice(0,18);xDebitOpts+='<option value="'+k+'"'+(xl.debit===k?' selected':'')+'>'+k+' · '+n+'</option>';}
      for(const k of _glKeys2){const n=(_glMap[k]?.Name||'').slice(0,18);xCreditOpts+='<option value="'+k+'"'+(xl.credit===k?' selected':'')+'>'+k+' · '+n+'</option>';}
      indivRows +=
        '<tr style="border-bottom:1px solid var(--border);background:#e8f9f9">'
        +'<td colspan="3" style="padding:3px 8px;font-size:0.62rem;color:var(--muted);font-family:var(--mono)">↳ split '+(xi+1)+'</td>'
        +'<td></td>'
        +'<td style="padding:3px 5px"><input type="number" step="0.01" value="'+xl.usd.toFixed(2)+'" onchange="_txExtraLineSet(\''+e.hashFull+'\','+xi+',\'usd\',parseFloat(this.value)||0)" style="width:80px;text-align:right;font-family:var(--mono);font-size:0.7rem;background:#fff;border:1px solid #d0d5dd;border-radius:3px;padding:2px 5px"></td>'
        +'<td style="padding:3px 5px;min-width:130px"><select onchange="_txExtraLineSet(\''+e.hashFull+'\','+xi+',\'debit\',this.value)" style="width:100%;font-size:0.59rem;font-family:var(--mono);background:#fff;border:1px solid #ccc;border-radius:3px;padding:2px 3px">'+xDebitOpts+'</select></td>'
        +'<td style="padding:3px 5px;min-width:130px"><select onchange="_txExtraLineSet(\''+e.hashFull+'\','+xi+',\'credit\',this.value)" style="width:100%;font-size:0.59rem;font-family:var(--mono);background:#fff;border:1px solid #ccc;border-radius:3px;padding:2px 3px">'+xCreditOpts+'</select></td>'
        +'<td colspan="4"></td>'
        +'<td style="padding:3px 5px"><button onclick="_txExtraLineRemove(\''+e.hashFull+'\','+xi+')" style="font-size:0.65rem;font-family:var(--mono);padding:2px 6px;border-radius:3px;border:1px solid var(--red);background:#fff5f5;color:var(--red);cursor:pointer">✕</button></td>'
        +'</tr>';
    });
  }

  // ── 6. Assemble modal HTML ───────────────────────────────────
  const bulkSection = bulkGroups.length
    ? '<div style="font-size:0.7rem;font-weight:700;color:var(--accent);font-family:var(--mono);padding:6px 0 5px;border-bottom:1px solid var(--border);margin-bottom:8px">BULK — '+bulkGroups.length+' monthly summar'+(bulkGroups.length===1?'y':'ies')+'</div>'
      +'<div style="overflow-x:auto;margin-bottom:16px"><table style="width:100%;min-width:860px;border-collapse:collapse;font-size:0.72rem">'
      +'<thead><tr style="border-bottom:2px solid var(--border)">'
      +'<th style="padding:5px 8px;text-align:left;color:var(--muted);white-space:nowrap">Date</th>'
      +'<th style="padding:5px 8px;text-align:left;color:var(--muted)">Company</th>'
      +'<th style="padding:5px 8px;text-align:left;color:var(--muted)">Wallet</th>'
      +'<th style="padding:5px 8px;text-align:left;color:var(--muted)">Token</th>'
      +'<th style="padding:5px 8px;text-align:right;color:var(--muted)">Total USD</th>'
      +'<th style="padding:5px 8px;text-align:right;color:var(--muted)">Txs</th>'
      +'<th style="padding:5px 8px;text-align:left;color:var(--muted);min-width:140px">Debit</th>'
      +'<th style="padding:5px 8px;text-align:left;color:var(--muted);min-width:140px">Credit</th>'
      +'<th style="padding:5px 8px;text-align:left;color:var(--muted)">Description</th>'
      +'</tr></thead><tbody>'+bulkRows+'</tbody></table></div>'
    : '';

  const indivSection = entries.length
    ? (bulkGroups.length ? '<div style="font-size:0.7rem;font-weight:700;color:var(--muted);font-family:var(--mono);padding:6px 0 5px;border-bottom:1px solid var(--border);margin-bottom:8px">INDIVIDUAL — '+entries.length+' transaction'+(entries.length===1?'':'s')+'</div>' : '')
      +'<table style="width:100%;border-collapse:collapse;font-size:0.72rem">'
      +'<thead><tr style="border-bottom:2px solid var(--border)">'
      +'<th style="padding:6px 8px;color:var(--muted);white-space:nowrap">Date</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">Company</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">Token</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">Dir</th>'
      +'<th style="padding:6px 8px;text-align:right;color:var(--muted)">USD</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">Debit Account</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">Credit Account</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">CP GL</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">Vendor / Supplier</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">G/L</th>'
      +'<th style="padding:6px 8px;color:var(--muted)">Description</th>'
      +'</tr></thead><tbody>'+indivRows+'</tbody></table>'
    : '';

  // Cache sections for rebuild (add line / remove line)
  _qb._lastBulkSection  = bulkSection;
  _qb._lastIndivSection = indivSection;
  _qb._lastGrandTotal   = grandTotal;
  _qb.bulkGroups        = bulkGroups;
  _txBuildModalHTML(entries, bulkGroups);
}

function _txBuildModalHTML(entries, bulkGroups) {
  const modal = document.getElementById('txQbModal');
  if(!modal) return;

  // Re-run the indiv/bulk section builders using stored entries
  // (sections are already built in txQbPost — we store them on _qb)
  const bulkSection  = _qb._lastBulkSection  || '';
  const indivSection = _qb._lastIndivSection || '';
  const grandTotal   = _qb._lastGrandTotal   || 0;

  modal.innerHTML =
    '<div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:24px;width:min(1200px,97vw);margin:0 auto 40px;overflow-x:auto">'
    +'<div style="display:flex;align-items:center;gap:12px;margin-bottom:18px">'
    +'<div style="font-size:0.92rem;font-weight:700;color:var(--text)">Post to QuickBooks</div>'
    +'<span style="font-size:0.72rem;font-family:var(--mono);color:var(--muted)">'+(entries.length+bulkGroups.length)+' journal entries · '+fmtUSD(grandTotal)+' total</span>'
    +'<div style="margin-left:auto;display:flex;gap:8px">'
    +'<button onclick="document.getElementById(\'txQbModal\').style.display=\'none\';" style="padding:6px 14px;border-radius:5px;border:1px solid var(--border);background:var(--surface2);color:var(--muted);font-size:0.75rem;font-family:var(--mono);cursor:pointer">Cancel</button>'
    +'<button onclick="txQbExecutePost()" style="padding:6px 20px;border-radius:5px;border:none;background:#2CA01C;color:#fff;font-size:0.75rem;font-family:var(--mono);font-weight:700;cursor:pointer">✓ Confirm &amp; Post</button>'
    +'</div></div>'
    +'<div style="max-height:65vh;overflow-y:auto">'
    +bulkSection+indivSection
    +'</div></div>';

  _qb._modalEntries = entries;
}

async function txQbExecutePost() {
  const modal      = document.getElementById('txQbModal');
  const entries    = _qb._modalEntries || [];
  const bulkGroups = _qb.bulkGroups   || [];

  // ── Debug: show log immediately ──────────────────────────────
  const logDiv = document.getElementById('qb-log');
  if(logDiv) logDiv.style.display = '';
  qbLog(`txQbExecutePost called — ${entries.length} individual, ${bulkGroups.length} bulk`, 'var(--muted)');
  qbLog(`QB token: ${_qb.accessToken ? '✓ present ('+_qb.accessToken.slice(0,8)+'…)' : '❌ MISSING'}`, _qb.accessToken ? 'var(--green)' : 'var(--red)');

  if(!entries.length && !bulkGroups.length) {
    qbLog('❌ Nothing to post — _qb._modalEntries is empty', 'var(--red)');
    return;
  }

  if(!_qb.accessToken) {
    qbLog('❌ No QB access token — please reconnect', 'var(--red)');
    return;
  }

  const confirmBtn = modal?.querySelector('button:last-child') || document.querySelector('#txQbModal button:last-child');
  if(confirmBtn) { confirmBtn.disabled = true; confirmBtn.textContent = 'Posting…'; }
  if(modal) modal.style.display = 'none';

  let ok = 0, fail = 0;
  const postedHashes = [];
  const postedHashMap = {};

  // ── BULK groups (monthly summary per wallet+token) ───────────
  for(const g of bulkGroups) {
    const glMap    = _qb.glAccountMapByEntity?.[g.entity] || _qb.glAccountMap || {};
    const special  = _qb.specialByEntity?.[g.entity] || {};
    const glCode   = GL_CODE_MAP[g.walletAddr]?.[g.tok]
                  || ALL_WALLETS.find(w=>w.address===g.walletAddr)?.accountCode;
    const assetAcct = glCode ? glMap[glCode] : null;
    if(!assetAcct?.Id) {
      qbLog(`⚠ Bulk skip: ${g.wallet} ${g.tok} ${g.mon} — GL ${glCode||'?'} not in QB (${g.entity})`, '#f0a500');
      fail++; continue;
    }
    const STABLES  = new Set(['USDC','USDT','PYUSD']);
    const dispAmt  = STABLES.has(g.tok) ? fmtNum(g.totalQty,2) : fmtNum(g.totalUsd,2);
    const autoDesc = `IN - ${g.tok} - ${fmtNum(g.totalQty,2)} ${g.tok} - $${dispAmt} - ${g.mon} - ${g.count} txs`;
    const desc     = window._txDescOverrides?.[g.key+'::desc'] ?? autoDesc;
    const amount   = +g.totalUsd.toFixed(2);
    // Resolve credit account — prefer manual override from modal
    const manualCreditVal = window._txCpGlOverrides?.[g.key+'::credit'];
    const manualDebitVal  = window._txCpGlOverrides?.[g.key+'::debit'];
    const bGlMapX = _qb.glAccountMapByEntity?.[g.entity] || _qb.glAccountMap || {};

    const resolveAcct = (hint) => {
      if(!hint) return null;
      const trimmed = String(hint).trim();
      if(bGlMapX[trimmed]) return bGlMapX[trimmed];
      return Object.values(bGlMapX).find(a => a.Name && a.Name.toLowerCase().includes(trimmed.toLowerCase())) || null;
    };

    const finalDebit  = manualDebitVal  ? (resolveAcct(manualDebitVal)  || assetAcct) : assetAcct;
    const suspId      = special.suspenseId;
    const suspAcct    = suspId ? bGlMapX['id:'+suspId] : null;
    const finalCredit = manualCreditVal ? (resolveAcct(manualCreditVal) || suspAcct || assetAcct)
                      : (suspAcct || assetAcct);

    qbLog(`  Bulk ${g.tok} ${g.mon}: Debit=${finalDebit?.Name||'?'} · Credit=${finalCredit?.Name||'?'}`, 'var(--muted)');

    const payload  = {
      TxnDate: g.txnDate,
      DocNumber: `BULK-${g.tok}-${g.mon}`,
      PrivateNote: `Tidelog bulk · ${g.wallet} · ${g.tok} · ${g.mon} · ${g.count} txs`,
      Line: [
        { Id:'1', DetailType:'JournalEntryLineDetail', Amount:amount, Description:desc,
          JournalEntryLineDetail:{ PostingType:'Debit',  AccountRef:{ value:finalDebit.Id,  name:finalDebit.Name  } } },
        { Id:'2', DetailType:'JournalEntryLineDetail', Amount:amount, Description:desc,
          JournalEntryLineDetail:{ PostingType:'Credit', AccountRef:{ value:finalCredit.Id, name:finalCredit.Name } } },
      ],
    };
    try {
      const res = await qbApiPostForEntity(g.entity, payload);
      const jeId = res?.JournalEntry?.Id;
      const docNum = `BULK-${g.tok}-${g.mon}`;
      qbLog(`✓ BULK JE #${jeId} · ${g.entity} · ${g.wallet} · ${g.tok} · ${g.mon} · ${fmtUSD(g.totalUsd)} · ${g.count} txs`, 'var(--green)');
      // Mark all txs in this bulk group with the docNumber
      if(g.txHashes) g.txHashes.forEach(h => postedHashMap[h] = docNum);
      postedHashes.push(g.key);
      ok++;
    } catch(err) {
      qbLog(`❌ BULK ${g.entity} ${g.tok} ${g.mon} — ${err.message}`, 'var(--red)');
      fail++;
    }
    await new Promise(r => setTimeout(r, 110));
  }

  // ── INDIVIDUAL entries ───────────────────────────────────────
  for(const e of entries) {
    const { t, d, asset, glCode, cpGLCode, hasGain, totalGain, hashFull, desc } = e;
    const usd        = (window._modalUsdOverrides||{})[hashFull] ?? e.usd; // user may override USD
    const STABLES    = new Set(['USDC','USDT','PYUSD']);
    const txEntity   = ALL_WALLETS.find(w=>w.address===t.walletAddr)?.entity || '';
    const glMap      = _qb.glAccountMapByEntity?.[txEntity] || _qb.glAccountMap || {};
    const special    = _qb.specialByEntity?.[txEntity] || {};
    const assetAcctR = glCode ? glMap[glCode] : null;

    const assetId = assetAcctR?.Id;
    // Apply modal overrides (user may have changed CP GL or vendor in confirm dialog)
    const modalCpGl = window._modalCpGlOverrides?.[hashFull];
    const effectiveCpGL = modalCpGl || cpGLCode;
    const cpId    = effectiveCpGL ? glMap[effectiveCpGL]?.Id : (special.suspenseId || null);
    const vendorId = window._modalVendorOverrides?.[hashFull] || null;
    // 70150 = Realized Gain/Loss account (fixed GL code)
    const gainAcct70150 = glMap['70150'];
    const gainId  = gainAcct70150?.Id || (totalGain > 0 ? special.gainAcctId : special.lossAcctId);

    // ── Skip In side of same-entity internal transfers ──────────
    // If counterparty wallet belongs to same entity, the Out side already
    // covers both accounts in a single JE — no need to post the In side.
    const cpEntity = ALL_WALLETS.find(w => w.address === t.counterparty)?.entity;
    if(t.dir === 'In' && cpEntity && cpEntity === txEntity) {
      qbLog(`   ↷ Skipped ${hashFull.slice(0,12)} — internal transfer within ${txEntity} (In side redundant)`, '#888');
      continue;
    }

    if(!assetId) {
      qbLog(`⚠ Skipped ${hashFull.slice(0,12)} — GL code ${glCode} not in QB (${txEntity})`, '#f0a500');
      fail++; continue;
    }

    const lines = [];
    const addLine = (acctId, acctName, postType, amount, note) => lines.push({
      DetailType: 'JournalEntryLineDetail',
      Amount: +Math.abs(amount).toFixed(2),
      Description: note,
      JournalEntryLineDetail: {
        PostingType: postType,
        AccountRef: { value: acctId, name: acctName },
      }
    });

    if(t.dir === 'In') {
      addLine(assetId, assetAcctR?.Name||glCode, 'Debit',  usd, desc);
      addLine(cpId||assetId, glMap[`id:${cpId}`]?.Name||cpGLCode||'Suspense', 'Credit', usd, desc);
    } else {
      addLine(assetId, assetAcctR?.Name||glCode, 'Credit', usd, desc);
      addLine(cpId||assetId, glMap[`id:${cpId}`]?.Name||cpGLCode||'Suspense', 'Debit',  usd, desc);
      // ── Realized Gain/Loss entry (ST + LT combined → 70150) ──
      if(hasGain && gainId) {
        const gainST  = t.gainShort || 0;
        const gainLT  = t.gainLong  || 0;
        const gl70150 = gainAcct70150?.Name || '70150';
        // Post ST and LT as separate lines if both non-zero, else combined
        const gainEntries = [];
        if(gainST !== 0) gainEntries.push({ amt: gainST, label: desc });
        if(gainLT !== 0) gainEntries.push({ amt: gainLT, label: desc });
        if(!gainEntries.length) gainEntries.push({ amt: totalGain, label: desc });
        for(const ge of gainEntries) {
          const abs = Math.abs(ge.amt);
          const isPos = ge.amt > 0;
          // Gain: Credit 70150, Debit asset (to record disposal at gain)
          // Loss: Debit 70150, Credit asset (to record disposal at loss)
          addLine(gainId,  gl70150,               isPos?'Credit':'Debit',  abs, ge.label);
          addLine(assetId, assetAcctR?.Name||glCode, isPos?'Debit':'Credit', abs, ge.label);
        }
      }
    }

    // If vendor is set, add EntityRef to AP lines
    qbLog(`   [DEBUG] vendorId="${vendorId}" cpId="${cpId}" cpIdStr="${String(cpId||'')}" effectiveCpGL="${effectiveCpGL}" glMap[cpGL]=${JSON.stringify(glMap[effectiveCpGL]||null)}`, '#aaa');
    qbLog(`   [DEBUG] lines acctIds: ` + lines.map(l=>String(l.JournalEntryLineDetail?.AccountRef?.value||'')).join(' | '), '#aaa');
    const finalLines = lines.map((l,i) => {
      const line = { Id: String(i+1), ...l };
      // QB AP lines need EntityRef as Name field — compare as string
      const lineAcctId = String(l.JournalEntryLineDetail?.AccountRef?.value||'');
      const cpIdStr    = String(cpId||'');
      if(vendorId && cpIdStr && lineAcctId === cpIdStr) {
        line.JournalEntryLineDetail = {
          ...line.JournalEntryLineDetail,
          Entity: { Type: 'Vendor', EntityRef: { value: String(vendorId) } },
        };
        qbLog('   → Vendor '+vendorId+' attached to AP line (acct '+lineAcctId+')', '#888');
      }
      return line;
    });

    // QB AP lines require EntityRef at line level via JournalEntryLineDetail.Entity
    // Format confirmed: { Type: "Vendor", EntityRef: { value: "id" } }
    const payload = {
      TxnDate:     d,
      DocNumber:   hashFull.slice(0,12),
      PrivateNote: `Tidelog · ${hashFull}`,
      Line: finalLines,
    };
    // Log payload for debug
    qbLog('   Payload lines: ' + finalLines.map(l => {
      const d = l.JournalEntryLineDetail;
      return d.PostingType+'('+d.AccountRef.value+')' + (d.Entity ? '+vendor:'+d.Entity.EntityRef.value : '');
    }).join(' | '), '#888');

    try {
      const res = await qbApiPostForEntity(txEntity, payload);
      const jeId = res?.JournalEntry?.Id;
      const docNum = hashFull.slice(0,12);
      qbLog(`✓ JE #${jeId} · ${d} · ${t.dir} ${asset} · ${fmtUSD(usd)} · ${docNum}`, 'var(--green)');
      postedHashMap[hashFull] = docNum;
      postedHashes.push(hashFull);
      // Persist CP GL choice to memory for this counterparty wallet
      if(effectiveCpGL && t.counterparty) {
        try { localStorage.setItem('cpglmem::'+txEntity+'::'+t.counterparty, effectiveCpGL); } catch(e){}
      }
      // Clear modal overrides for this tx
      delete window._modalCpGlOverrides?.[hashFull];
      delete window._modalVendorOverrides?.[hashFull];

      // ── Intercompany: also mark the counterparty entity as posted ──
      const cpWalletEnt = ALL_WALLETS.find(w=>w.address===t.counterparty)?.entity;
      if(cpWalletEnt && cpWalletEnt !== txEntity) {
        postedHashMap[hashFull] = docNum; // already set, ensures both entities see it
        qbLog(`   ↔ Intercompany: also marking ${cpWalletEnt} side as posted`, '#888');
      }

      // ── Extra split lines for this tx ──────────────────────────
      const extraLines = (window._modalExtraLines||{})[hashFull] || [];
      for(const xl of extraLines) {
        if(!xl.debit && !xl.credit) continue;
        const xlGlMap  = _qb.glAccountMapByEntity?.[txEntity] || _qb.glAccountMap || {};
        const xlDebtId = xl.debit  ? xlGlMap[xl.debit]?.Id  : null;
        const xlCredId = xl.credit ? xlGlMap[xl.credit]?.Id : null;
        if(!xlDebtId || !xlCredId) { qbLog(`   ⚠ Extra line skipped — missing GL account`, '#f0a500'); continue; }
        const xlPayload = {
          TxnDate:     d,
          DocNumber:   hashFull.slice(0,12)+'x',
          PrivateNote: `Tidelog split · ${hashFull}`,
          Line: [
            { Id:'1', DetailType:'JournalEntryLineDetail', Amount: xl.usd, Description: desc,
              JournalEntryLineDetail:{ PostingType:'Debit',  AccountRef:{ value: xlDebtId,  name: xl.debit  } } },
            { Id:'2', DetailType:'JournalEntryLineDetail', Amount: xl.usd, Description: desc,
              JournalEntryLineDetail:{ PostingType:'Credit', AccountRef:{ value: xlCredId, name: xl.credit } } },
          ],
        };
        try {
          const xlRes = await qbApiPostForEntity(txEntity, xlPayload);
          qbLog(`   ✓ Split JE #${xlRes?.JournalEntry?.Id} · ${fmtUSD(xl.usd)} · ${xl.debit}→${xl.credit}`, 'var(--green)');
        } catch(xlErr) {
          qbLog(`   ❌ Split line failed: ${xlErr.message}`, 'var(--red)');
        }
        await new Promise(r => setTimeout(r, 110));
      }

      ok++;
    } catch(err) {
      qbLog(`❌ ${hashFull.slice(0,12)} — ${err.message}`, 'var(--red)');
      qbLog(`   Debit: ${assetId||'?'} (${glCode}) · Credit: ${cpId||'suspense'} (${cpGLCode||'none'}) · $${usd.toFixed(2)}`, '#f0a500');
      fail++;
    }
    await new Promise(r => setTimeout(r, 110));
  }

  qbMarkPosted(postedHashes, null, postedHashMap);
  const doneMsg = `── Done: ${ok} posted, ${fail} failed ──`;
  qbLog(doneMsg, ok>0?'var(--green)':'var(--red)');
  if(ok > 0) {
    // Show success toast
    const toast = document.createElement('div');
    const docNums = [...new Set(Object.values(postedHashMap))].filter(Boolean).join(', ');
    toast.innerHTML = `<div>✓ ${ok} journal entr${ok===1?'y':'ies'} posted to QuickBooks</div>${docNums?`<div style="font-size:0.68rem;opacity:0.85;margin-top:3px">${docNums}</div>`:''}`;
    toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#2CA01C;color:#fff;padding:12px 20px;border-radius:8px;font-family:var(--mono);font-size:0.78rem;font-weight:600;z-index:99999;box-shadow:0 4px 20px rgba(0,0,0,0.4)';
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 8000);
  }
  if(fail > 0) alert(`${fail} entr${fail===1?'y':'ies'} failed to post. Check the QB log below for details.`);
  if(confirmBtn) { confirmBtn.disabled = false; confirmBtn.textContent = '✓ Confirm & Post'; }
  _txVsRender();
}

</script>

<!-- ── Wallet Trend Modal ──────────────────────────────────────── -->
<div id="walletTrendModal" style="display:none;position:fixed;inset:0;background:rgba(255,255,255,0.75);z-index:9000;align-items:flex-start;justify-content:center;padding-top:5vh;overflow-y:auto;backdrop-filter:blur(4px)">
  <div style="background:#ffffff;border-radius:14px;padding:28px 32px;width:min(980px,94vw);margin:auto;box-shadow:0 8px 40px rgba(0,0,0,0.15);position:relative;border:1px solid #e8eaed">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
      <div>
        <div id="trendModalTitle" style="font-family:var(--mono);font-size:1rem;font-weight:700;color:var(--text)"></div>
        <div id="trendModalAddr" style="font-family:var(--mono);font-size:0.62rem;color:var(--muted);margin-top:2px"></div>
        <div id="trendModalInfo" style="font-family:var(--mono);font-size:0.65rem;color:var(--accent);margin-top:4px"></div>
      </div>
      <button onclick="document.getElementById('walletTrendModal').style.display='none'"
        style="background:none;border:none;cursor:pointer;color:var(--muted);font-size:1.4rem;line-height:1;padding:4px 8px">×</button>
    </div>
    <!-- Toggle buttons -->
    <div style="display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap">
      <button id="trendBtnIn"  onclick="trendSetMode('in')"  style="font-family:var(--mono);font-size:0.72rem;padding:4px 14px;border-radius:6px;border:1.5px solid var(--green);background:var(--green);color:#fff;cursor:pointer;font-weight:600">In</button>
      <button id="trendBtnOut" onclick="trendSetMode('out')" style="font-family:var(--mono);font-size:0.72rem;padding:4px 14px;border-radius:6px;border:1.5px solid var(--red);background:transparent;color:var(--red);cursor:pointer;font-weight:600">Out</button>
      <button id="trendBtnNet" onclick="trendSetMode('net')" style="font-family:var(--mono);font-size:0.72rem;padding:4px 14px;border-radius:6px;border:1.5px solid var(--accent);background:transparent;color:var(--accent);cursor:pointer;font-weight:600">Net</button>
      <button id="trendBtnAll" onclick="trendSetMode('all')" style="font-family:var(--mono);font-size:0.72rem;padding:4px 14px;border-radius:6px;border:1.5px solid var(--muted);background:transparent;color:var(--muted);cursor:pointer;font-weight:600">All</button>
    </div>
    <div style="position:relative;height:360px"><canvas id="trendChart"></canvas></div>
    <div id="trendNoData" style="display:none;text-align:center;padding:40px;color:var(--muted);font-family:var(--mono);font-size:0.8rem">No transaction data found for this wallet</div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
// ── Wallet Trend Modal ────────────────────────────────────────────
let _trendChart = null;
let _trendAddr  = null;
let _trendMode  = 'in';

function ovShowTrend(addr, label) {
  _trendAddr = addr;
  document.getElementById('trendModalTitle').textContent = label;
  document.getElementById('trendModalAddr').textContent  = addr;
  const _infoEl = document.getElementById('trendModalInfo'); if(_infoEl) _infoEl.textContent = '';
  document.getElementById('walletTrendModal').style.display = 'flex';
  trendSetMode('in');
}

function trendSetMode(mode) {
  _trendMode = mode;
  // Update button styles
  const btns = { in:'trendBtnIn', out:'trendBtnOut', net:'trendBtnNet', all:'trendBtnAll' };
  const colors = { in:'var(--green)', out:'var(--red)', net:'var(--accent)', all:'var(--muted)' };
  Object.entries(btns).forEach(([m, id]) => {
    const btn = document.getElementById(id);
    const col = colors[m];
    const active = (m === mode) || (mode === 'all' && m !== 'all') || (m === 'all' && mode === 'all');
    btn.style.background   = active ? col : 'transparent';
    btn.style.color        = active ? '#fff' : col;
    btn.style.borderColor  = col;
  });
  trendRender();
}

function trendRender() {
  const target = (_trendAddr || '').toLowerCase();

  // Use tx-history:: cache (per wallet, all periods) + state.transactions as fallback
  const seenHashes = new Set();
  const allTxsForWallet = [];

  // 1. Per-wallet tx cache (built from all fetched periods)
  try {
    const cached = JSON.parse(localStorage.getItem(`tx-history::${_trendAddr}`) || '[]');
    for(const t of cached) {
      const hk = (t.txHash||'') + (t.blockTime||'') + t.dir;
      if(seenHashes.has(hk)) continue;
      seenHashes.add(hk);
      allTxsForWallet.push(t);
    }
  } catch(e) {}

  // 2. orcaHistory cache (ORCA txs, keyed by entity)
  for(const key of Object.keys(localStorage)) {
    if(!key.startsWith('orca-history::')) continue;
    try {
      const hist = JSON.parse(localStorage.getItem(key) || '[]');
      for(const t of hist) {
        const wa = (t.walletAddr || '').toLowerCase();
        if(wa !== target) continue;
        const hk = (t.txHash||'') + (t.blockTime||'') + (t.dir||'');
        if(seenHashes.has(hk)) continue;
        seenHashes.add(hk);
        allTxsForWallet.push(t);
      }
    } catch(e) {}
  }

  // 3. state.transactions (current period, catches anything not yet cached)
  for(const t of (state.transactions || [])) {
    const wa = (t.walletAddr || t.wallet || '').toLowerCase();
    if(wa !== target) continue;
    const hk = (t.txHash||'') + (t.blockTime||'') + (t.dir||'');
    if(seenHashes.has(hk)) continue;
    seenHashes.add(hk);
    allTxsForWallet.push(t);
  }

  const txs = allTxsForWallet;

  // Build months from transaction data
  const monthMap = {}; // { 'YYYY-MM': { in: 0, out: 0 } }
  txs.forEach(t => {
    const raw = t.date;
    const d   = raw instanceof Date ? raw.toISOString().slice(0,10) : (raw || '');
    const m   = d.slice(0,7); // YYYY-MM
    if(!m || m.length < 7) return;
    if(!monthMap[m]) monthMap[m] = { in: 0, out: 0 };
    const usd = Math.abs(t.usd || t.qty || 0);
    const dir = t.dir || t.direction || '';
    if(dir === 'In')  monthMap[m].in  += usd;
    else if(dir === 'Out') monthMap[m].out += usd;
  });

  const months = Object.keys(monthMap).sort();
  const canvas = document.getElementById('trendChart');
  const noData = document.getElementById('trendNoData');

  const infoEl = document.getElementById('trendModalInfo');
  if(infoEl) infoEl.textContent = txs.length > 0 ? `${txs.length} txs · ${months.length} months` : 'No data in loaded period';

  if(months.length === 0) {
    canvas.style.display = 'none';
    noData.style.display = 'block';
    return;
  }
  canvas.style.display = 'block';
  noData.style.display = 'none';

  const labels = months.map(m => {
    const [y, mo] = m.split('-');
    return new Date(+y, +mo-1).toLocaleString('en', {month:'short', year:'2-digit'});
  });

  const datasets = [];
  if(_trendMode === 'in' || _trendMode === 'all') {
    datasets.push({
      label: 'In',
      data: months.map(m => +(monthMap[m].in.toFixed(2))),
      borderColor: '#06D6A0', backgroundColor: '#06D6A022',
      tension: 0.35, fill: _trendMode === 'in', pointRadius: 4, pointHoverRadius: 7,
    });
  }
  if(_trendMode === 'out' || _trendMode === 'all') {
    datasets.push({
      label: 'Out',
      data: months.map(m => +(monthMap[m].out.toFixed(2))),
      borderColor: '#d93025', backgroundColor: '#d9302522',
      tension: 0.35, fill: _trendMode === 'out', pointRadius: 4, pointHoverRadius: 7,
    });
  }
  if(_trendMode === 'net' || _trendMode === 'all') {
    datasets.push({
      label: 'Net',
      data: months.map(m => +((monthMap[m].in - monthMap[m].out).toFixed(2))),
      borderColor: '#00A8A8', backgroundColor: '#00A8A822',
      tension: 0.35, fill: _trendMode === 'net', pointRadius: 4, pointHoverRadius: 7,
    });
  }

  if(_trendChart) { _trendChart.destroy(); _trendChart = null; }
  _trendChart = new Chart(canvas, {
    type: 'line',
    data: { labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { color: '#444', font: { family: 'IBM Plex Mono', size: 11 } } },
        tooltip: {
          callbacks: {
            label: ctx => ` ${ctx.dataset.label}: $${ctx.parsed.y.toLocaleString('en', {minimumFractionDigits:2, maximumFractionDigits:2})}`
          }
        }
      },
      scales: {
        x: { ticks: { color:'#666', font:{family:'IBM Plex Mono',size:10} }, grid:{color:'#e8eaed'} },
        y: { ticks: { color:'#666', font:{family:'IBM Plex Mono',size:10},
              callback: v => '$' + (v>=1000 ? (v/1000).toFixed(0)+'k' : v) },
             grid:{color:'#ffffff08'} }
      }
    }
  });
}

// Close on backdrop click
document.getElementById('walletTrendModal').addEventListener('click', function(e) {
  if(e.target === this) this.style.display = 'none';
});
// Close on Escape
document.addEventListener('keydown', e => {
  if(e.key === 'Escape') document.getElementById('walletTrendModal').style.display = 'none';
});


