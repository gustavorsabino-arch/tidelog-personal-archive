// Dynamically register a token account → owner mapping.
// Called during pre-period history scan so the main FIFO can detect internal transfers.
// IMPORTANT: Only called from history scan, NOT from parseTransaction during period fetch,
// to avoid interfering with the owner filter that decides which wallet owns each movement.
function registerATA(ataAddress, ownerAddress) {
  if(!ataAddress || !ownerAddress) return;
  if(ATA_OWNER_MAP[ataAddress]) return; // already known
  if(WALLET_LABEL_MAP[ownerAddress]) {
    ATA_OWNER_MAP[ataAddress] = ownerAddress;
    console.log(`[ATA] Discovered: ${ataAddress.slice(0,8)}… → ${ownerAddress.slice(0,8)}… (${WALLET_LABEL_MAP[ownerAddress]})`);
  }
}

// Resolve a counterparty address (which may be an ATA) to a wallet owner address
function resolveCounterparty(cpAddr) {
  if(!cpAddr) return cpAddr;
  // Direct match in ATA map (catches dynamically discovered ATAs)
  if(ATA_OWNER_MAP[cpAddr]) return ATA_OWNER_MAP[cpAddr];
  // Check if any known wallet address starts with this cp (ATA prefix match)
  const match = ALL_WALLETS.find(w => w.address.startsWith(cpAddr) || cpAddr.startsWith(w.address.slice(0,20)));
  if(match) return match.address;
  return cpAddr;
}

