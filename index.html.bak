// ══════════════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════════════
const fmtUSD = (n, dec=2) => {
  if(n == null || isNaN(n)) return '—';
  const abs = Math.abs(n);
  const s = abs.toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec});
  return (n < 0 ? '-' : '') + '$' + s;
};

// Price display — never round, show enough decimals to be meaningful
const fmtPrice = (n) => {
  if(n == null || isNaN(n) || n === 0) return '—';
  // Show up to 6 significant decimals
  if(n >= 1000) return '$' + n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  if(n >= 1)    return '$' + n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:6});
  return '$' + n.toPrecision(6);
};

const fmtNum = (n, dec=4) => {
  if(n == null || isNaN(n)) return '—';
  const abs = Math.abs(n);
  const minDec = Math.min(2, dec);
  return (n < 0 ? '-' : '') + abs.toLocaleString('en-US', {minimumFractionDigits:minDec, maximumFractionDigits:Math.max(minDec, dec)});
};

const fmtDate = v => {
  if(!v) return '—';
  const d = v instanceof Date ? v : new Date(v);
  if(isNaN(d)) return String(v).slice(0,10);
  return d.toISOString().slice(0,10);
};

// Display name for departments (UI only - backend keeps original)
const deptDisplayName = dept => dept === 'Finance & Accounting' ? 'Finance' : dept;

const getSym = mint => KNOWN_SOL[mint] || mint.slice(0,6)+'…';

const gainCell = v => {
  if(!v || v === 0) return `<td class="num gain-zero">—</td>`;
  const cls = v > 0 ? 'gain-pos' : 'gain-neg';
  return `<td class="num ${cls}">${v > 0 ? '+' : ''}${fmtUSD(v)}</td>`;
};

const tokenBadge = t => `<span class="token-badge ${t}">${t}</span>`;

// ══════════════════════════════════════════════════════════════════
// UI CONTROLS
// ══════════════════════════════════════════════════════════════════
function setEntity(e) {
  state.entity = e;
  document.querySelectorAll('.entity-tab').forEach(b => b.classList.toggle('active', b.dataset.entity === e));
  document.querySelectorAll('.sb-item[onclick]').forEach(b => {
    const m = b.getAttribute('onclick').match(/setEntity\('(.*)'\)/);
    if(m) b.classList.toggle('active', m[1] === e);
  });
  rebuildWalletDropdown();
  repopulateTabWalletFilters();
  renderOrcaLedger();
  renderTx();
  renderGL();
  renderUR();
  renderOverview();
}

// Rebuild the per-tab wallet filter dropdowns to only show wallets
// belonging to the currently selected entity.
// ── Month/Year filter helper ──────────────────────────────────────────────
const _MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function populateMonthSelect(elId, dates) {
  const sel = document.getElementById(elId);
  if(!sel) return;
  const cur = sel.value;
  const months = new Set();
  for(const d of dates) {
    if(!d) continue;
    const dt = (d instanceof Date) ? d : new Date(typeof d === 'number' ? d * 1000 : d);
    if(isNaN(dt)) continue;
    months.add(`${dt.getUTCFullYear()}-${String(dt.getUTCMonth()+1).padStart(2,'0')}`);
  }
  const sorted = [...months].sort().reverse(); // most recent first
  sel.innerHTML = '<option value="">All months</option>' +
    sorted.map(m => {
      const [y, mo] = m.split('-');
      const lbl = `${_MONTH_NAMES[parseInt(mo)-1]} ${y}`;
      return `<option value="${m}"${m===cur?' selected':''}>${lbl}</option>`;
    }).join('');
  if(cur && !months.has(cur)) sel.value = '';
}
function _monthKey(d) {
  if(!d) return '';
  const dt = (d instanceof Date) ? d : new Date(typeof d === 'number' ? d * 1000 : d);
  return isNaN(dt) ? '' : `${dt.getUTCFullYear()}-${String(dt.getUTCMonth()+1).padStart(2,'0')}`;
}

function repopulateTabWalletFilters() {
  const entity = state.entity;
  const addrs = new Set(ALL_WALLETS.filter(w => !entity || w.entity === entity).map(w => w.address));
  populateSelect('gl-wallet',  [...new Set((state.gainLoss   ||[]).filter(r=>addrs.has(r.walletAddr)).map(r=>r.account))].sort());
  populateSelect('ur-wallet',  [...new Set((state.unrealized ||[]).filter(r=>addrs.has(r.walletAddr)).map(r=>r.wallet))].sort());
  // tx-wallet: combine wallets from state.transactions (non-ORCA) + orcaLedgerData (ORCA source of truth)
  const txWallets = new Set([
    ...(state.transactions||[]).filter(t=>addrs.has(t.walletAddr)&&(t.asset||t.token)!=='ORCA').map(t=>t.wallet),
    ...(orcaLedgerData||[]).filter(r=>addrs.has(r.walletAddr)&&!r.synthetic).map(r=>r.wallet),
  ]);
  populateSelect('tx-wallet', [...txWallets].sort());
}

function rebuildWalletDropdown() {
  const entity = state.entity;
  const wallets = ALL_WALLETS.filter(w => w.chain === 'SOL' && !w.external && (!entity || w.entity === entity));
  const list = document.getElementById('walletCheckboxList');
  if(!list) return;
  list.innerHTML = wallets.map(w => `
    <label style="display:flex;align-items:center;gap:8px;padding:5px 12px;cursor:pointer;font-family:var(--mono);font-size:0.72rem;color:var(--text)" onmouseover="this.style.background='var(--surface2)'" onmouseout="this.style.background=''">
      <input type="checkbox" checked value="${w.address}" onchange="updateWalletFilterLabel()" style="accent-color:var(--accent)">
      <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${w.label}</span>
      <span style="color:var(--muted);font-size:0.65rem">${w.address.slice(0,6)}…</span>
    </label>
  `).join('');
  updateWalletFilterLabel();
}

function updateWalletFilterLabel() {
  const all = document.querySelectorAll('#walletCheckboxList input[type=checkbox]');
  const checked = document.querySelectorAll('#walletCheckboxList input[type=checkbox]:checked');
  const lbl = document.getElementById('walletFilterLabel');
  if(!lbl) return;
  if(checked.length === 0) lbl.textContent = 'No wallets';
  else if(checked.length === all.length) lbl.textContent = 'All wallets';
  else lbl.textContent = `${checked.length} wallet${checked.length>1?'s':''}`;
}

function selectAllWallets(checked) {
  document.querySelectorAll('#walletCheckboxList input[type=checkbox]').forEach(cb => cb.checked = checked);
  updateWalletFilterLabel();
}

function getSelectedWalletAddresses() {
  const checked = document.querySelectorAll('#walletCheckboxList input[type=checkbox]:checked');
  if(!checked.length) return null; // null = use entity filter (no wallet filter active)
  const all = document.querySelectorAll('#walletCheckboxList input[type=checkbox]');
  if(checked.length === all.length) return null; // all selected = no filter
  return [...checked].map(cb => cb.value);
}

function toggleWalletDropdown() {
  const dd = document.getElementById('walletDropdown');
  dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
}

// Close dropdown when clicking outside
document.addEventListener('click', e => {
  const wrap = document.getElementById('walletFilterWrap');
  if(wrap && !wrap.contains(e.target)) {
    const dd = document.getElementById('walletDropdown');
    if(dd) dd.style.display = 'none';
  }
});

function setMode(m) {
  state.mode = m;
  document.getElementById('modeLive').classList.toggle('active', m === 'live');
  document.getElementById('modeHist').classList.toggle('active', m === 'period');
  const pi = document.getElementById('periodInputs');
  if(m === 'period') { pi.style.display = 'flex'; }
  else { pi.style.display = 'none'; }
}

// Set default period to current month
(function initDates(){
  const now = new Date();
  const y = now.getFullYear(), mo = String(now.getMonth()+1).padStart(2,'0');
  const lastDay = new Date(y, now.getMonth()+1, 0).getDate();
  document.getElementById('dateFrom').value = `${y}-${mo}-01`;
  document.getElementById('dateTo').value   = `${y}-${mo}-${String(lastDay).padStart(2,'0')}`;
  // Render entity status from localStorage (shows history of previous fetches)
  setTimeout(renderEntityStatus, 0);
})();

function switchTab(t) {
  state.activeTab = t;
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === `tab-${t}`));
  document.querySelectorAll('.sb-item[data-tab]').forEach(b => b.classList.toggle('active', b.dataset.tab === t));
  if(t === 'orcaledger') { renderOrcaLedger(); return; }
  if(t === 'accounting') { accInitPeriod(); return; }
  if(t === 'pnl') { pnlInit(); return; }
  if(t === 'budget') { budgetInit(); return; }
  if(state.transactions.length || state.gainLoss.length || state.unrealized.length) {
    if(t === 'transactions') { renderTx(); if(!_qb.accessToken) qbAutoConnect(); }
    else if(t === 'gainloss')  renderGL();
    else if(t === 'unrealized') renderUR();
    else if(t === 'overview')  { renderOverview(); ovFetchOnlyWallets(); }
    else if(t === 'wallets')   renderWallets();
    else if(t === 'fifodebug') renderFIFODebug();
  }
}

function setStatus(dot, text, meta='') {
  const d = document.getElementById('statusDot');
  d.className = 'status-dot ' + dot;
  document.getElementById('statusText').textContent = text;
  document.getElementById('statusMeta').textContent = meta;
}

function setLoading(visible, msg='', detail='', pct=0) {
  const el = document.getElementById('loadingOverlay');
  el.classList.toggle('visible', visible);
  if(msg) document.getElementById('loadingMsg').textContent = msg;
  if(detail) document.getElementById('loadingDetail').textContent = detail;
  document.getElementById('loadingBar').style.width = pct + '%';
  document.getElementById('fetchBtn').disabled = visible;
}

// ══════════════════════════════════════════════════════════════════
// HELIUS RPC
// ══════════════════════════════════════════════════════════════════
async function heliusRPC(method, params, retries=4) {
  for(let i=0; i<retries; i++) {
    try {
      const r = await fetch(HELIUS_RPC, {
        method:'POST', headers:authHeaders({'Content-Type':'application/json'}),
        credentials:'include',
        body: JSON.stringify({jsonrpc:'2.0',id:1,method,params})
      });
      if(r.status === 429) {
        await sleep(1500 * (i+1)); // 1.5s, 3s, 4.5s
        continue;
      }
      if(!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();
      if(d.error) throw new Error(d.error.message || JSON.stringify(d.error));
      return d;
    } catch(e) {
      if(i < retries-1) await sleep(600*(i+1));
      else throw e;
    }
  }
}

// Direct Helius RPC (bypass Railway proxy) — for Balance Sheet to avoid shared rate limits
const HELIUS_API_KEY = '1afef755-6b8d-4bf8-8195-7942143998e5';
async function heliusRPCDirect(method, params, retries=4) {
  const endpoint = `https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}`;
  for(let i=0; i<retries; i++) {
    try {
      const r = await fetch(endpoint, {
        method:'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({jsonrpc:'2.0',id:1,method,params})
      });
      if(r.status === 429) {
        const backoff = 2000 * Math.pow(2, i); // 2s, 4s, 8s, 16s
        console.log(`[Helius] 429 rate limit, waiting ${backoff/1000}s...`);
        await sleep(backoff);
        continue;
      }
      if(!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();
      if(d.error) throw new Error(d.error.message || JSON.stringify(d.error));
      return d;
    } catch(e) {
      if(i < retries-1) await sleep(1000*(i+1));
      else throw e;
    }
  }
}

