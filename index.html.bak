// Returns auth headers for all proxy requests — uses token from localStorage (cross-site auth)
function authHeaders(extra) {
  const token = localStorage.getItem('tidelog_auth_token');
  const h = { ...(extra || {}) };
  if (token) h['X-Auth-Token'] = token;
  return h;
}
