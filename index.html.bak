// PRICE FETCHING — Jupiter (primary, no CORS) + DeFiLlama (historical)
// ══════════════════════════════════════════════════════════════════

const PRICE_MINTS = {
  SOL:  'So11111111111111111111111111111111111111112',
  ORCA: ORCA_MINT,
  USDC: 'EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v',
  USDT: 'Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB',
};

// Jupiter price API — no CORS issues, free, browser-friendly
async function fetchPricesJupiter() {
  // Use Birdeye for current prices (same API key we already have)
  try {
    const [solR, orcaR] = await Promise.all([
      fetch(`${PROXY_BASE}/proxy/birdeye?path=/defi/price&address=${PRICE_MINTS.SOL}`, { headers: authHeaders() }),
      fetch(`${PROXY_BASE}/proxy/birdeye?path=/defi/price&address=${PRICE_MINTS.ORCA}`, { headers: authHeaders() })
    ]);
    const solD  = await solR.json();
    const orcaD = await orcaR.json();
    const sol  = solD?.data?.value  || 0;
    const orca = orcaD?.data?.value || 0;
    if(!sol) throw new Error('Empty Birdeye response');
    console.log(`[Prices] Birdeye: SOL=${sol} ORCA=${orca}`);
    return { SOL: sol, ORCA: orca, USDC: 1, USDT: 1 };
  } catch(e) {
    // Fallback to DeFiLlama
    console.warn('[Prices] Birdeye failed, trying DeFiLlama:', e.message);
    const coins = `coingecko:solana,solana:${ORCA_MINT}`;
    const r = await fetch(`https://coins.llama.fi/prices/current/${coins}`);
    if(!r.ok) throw new Error(`DeFiLlama HTTP ${r.status}`);
    const d = await r.json();
    const sol  = d?.coins?.['coingecko:solana']?.price || 0;
    const orca = d?.coins?.[`solana:${ORCA_MINT}`]?.price || 0;
    if(!sol) throw new Error('Empty DeFiLlama response');
    return { SOL: sol, ORCA: orca, USDC: 1, USDT: 1 };
  }
}

// DeFiLlama historical — try first, fall back to Jupiter
async function fetchPricesHistorical(dateStr) {
  const ts = Math.floor(new Date(dateStr+'T23:59:59Z').getTime()/1000);
  try {
    const coins = `coingecko:solana,solana:${ORCA_MINT}`;
    const r = await fetch(`https://coins.llama.fi/prices/historical/${ts}/${coins}`);
    if(!r.ok) throw new Error(`DeFiLlama HTTP ${r.status}`);
    const d = await r.json();
    const sol  = d?.coins?.['coingecko:solana']?.price || 0;
    const orca = d?.coins?.[`solana:${ORCA_MINT}`]?.price || 0;
    if(sol > 0) {
      console.log(`[Prices] Historical ${dateStr}: SOL=${sol} ORCA=${orca}`);
      return { SOL: sol, ORCA: orca, USDC: 1, USDT: 1 };
    }
    throw new Error('Empty DeFiLlama response');
  } catch(e) {
    console.warn('[Prices] DeFiLlama failed, using Jupiter live:', e.message);
    return fetchPricesJupiter();
  }
}

async function fetchPrices(cutoff=null) {
  try {
    const p = cutoff ? await fetchPricesHistorical(cutoff) : await fetchPricesJupiter();
    console.log('[Prices]', p);
    return p;
  } catch(e) {
    console.warn('[Prices] All sources failed:', e.message);
    return { SOL:0, ORCA:0, USDC:1, USDT:1 };
  }
}

