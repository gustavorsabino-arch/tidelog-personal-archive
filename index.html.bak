// ── STATE ─────────────────────────────────────────────────────────────────────
let teamData = BUDGET_INITIAL_TEAM.map(p => ({...p}));
let activeDept = BUDGET_DEPTS[0], activeMDept = null, editingId = null; // activeDept set by permissions or first dept
// Single shared period state (used by all tabs)
let BUDGET_P = { mode:'ytd', m:0, from:0, to:11 };
let budgetEntity = 'All'; // current entity filter
// budgetQBActuals declared below with budgetQBActualsByClass

// ── UNIFIED CONTROLS ──────────────────────────────────────────────────────────
function budgetEntityChange() {
  budgetEntity = document.getElementById('budget-entity-sel').value;
  budgetRerender();
}
function budgetModeChange() {
  const mode = document.getElementById('budget-mode-sel').value;
  BUDGET_P.mode = mode;
  document.getElementById('budget-picker-month').style.display = mode==='month'?'flex':'none';
  document.getElementById('budget-picker-range').style.display = mode==='range'?'flex':'none';
  budgetRerender();
}
function budgetPickerChange() {
  BUDGET_P.m    = parseInt(document.getElementById('budget-m')?.value||0);
  BUDGET_P.from = parseInt(document.getElementById('budget-from')?.value||0);
  BUDGET_P.to   = parseInt(document.getElementById('budget-to')?.value||11);
  budgetRerender();
}
async function budgetYearChange() {
  // Reset edit data so new year loads fresh from server
  _editBudgetData = null;
  await budgetLoadBudgetLines();
  budgetPickerChange();
}
function budgetRerender() {
  const activeTab = document.querySelector('#tab-budget .tab-view.active')?.id?.replace('bgt-','');
  if (activeTab === 'overview') budgetRenderOverview();
  else if (activeTab === 'departments') budgetRenderDeptDetail();
  else if (activeTab === 'monthly') budgetRenderMonthly();
  else if (activeTab === 'headcount') budgetRenderHeadcount();
  else if (activeTab === 'edit') budgetRenderEdit();
}

// ── QB ACTUALS FETCH ──────────────────────────────────────────────────────────
async function budgetFetchActuals() {
  const btn = document.getElementById('budget-fetch-btn');
  const status = document.getElementById('budget-qb-status');
  btn.textContent = '⏳ Fetching…'; btn.style.opacity = '.6';
  
  // Show loading indicator in table for restricted users
  if (window.USER_PERMISSIONS && window.USER_PERMISSIONS.budgetDepartments) {
    const tbody = document.getElementById('dept-tbody');
    if (tbody) {
      tbody.innerHTML = '<tr><td colspan="13" style="text-align:center;padding:40px;color:var(--muted);font-family:var(--mono);font-size:.78rem">⟳ Fetching actuals from QuickBooks...</td></tr>';
    }
  }

  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];
  const token = getBudgetToken();
  budgetQBActuals = budgetQBActuals || {};
  budgetQBActualsByClass = budgetQBActualsByClass || {};

  let fetched = 0, errors = 0;

  // 0. Fetch accounts first (needed for GL acctId lookup)
  if (!window._budgetAcctIdMap) window._budgetAcctIdMap = {};
  if (!window._budgetAcctNameMap) window._budgetAcctNameMap = {};
  for (const entity of entities) {
    const realmId = QB_REALM_IDS[entity];
    if (!realmId) continue;
    try {
      status.textContent = `Loading ${entity} accounts…`;
      const path = `/v3/company/${realmId}/query?query=select * from Account MAXRESULTS 1000&minorversion=65`;
      const url = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
      const r = await fetch(url, { headers: { 'X-Auth-Token': token } });
      if (!r.ok) continue;
      const data = await r.json();
      if (!_budgetAcctIdMap[entity]) _budgetAcctIdMap[entity] = {};
      if (!_budgetAcctNameMap[entity]) _budgetAcctNameMap[entity] = {};
      (data?.QueryResponse?.Account || []).forEach(a => {
        if (a.AcctNum) {
          _budgetAcctIdMap[entity][a.AcctNum] = a.Id;
          _budgetAcctNameMap[entity][a.AcctNum] = a.Name;
        }
      });
    } catch(e) {}
  }

  for (const entity of entities) {
    const realmId = QB_REALM_IDS[entity];
    if (!realmId) continue;
    try {
      status.textContent = `Fetching ${entity}…`;
      const mode = document.getElementById('budget-mode-sel')?.value || 'ytd';
      const yr = document.getElementById('budget-year-sel')?.value || '2026';
      let fetchStart, fetchEnd;
      if (mode === 'ytd') {
        fetchStart = `${yr}-01-01`; fetchEnd = `${yr}-12-31`;
      } else if (mode === 'month') {
        const m = parseInt(document.getElementById('budget-m')?.value || 0);
        const mm = String(m+1).padStart(2,'0');
        fetchStart = `${yr}-${mm}-01`;
        fetchEnd   = `${yr}-${mm}-${new Date(parseInt(yr), m+1, 0).getDate()}`;
      } else {
        const f = parseInt(document.getElementById('budget-from')?.value || 0);
        const t = parseInt(document.getElementById('budget-to')?.value || 11);
        fetchStart = `${yr}-${String(f+1).padStart(2,'0')}-01`;
        fetchEnd   = `${yr}-${String(t+1).padStart(2,'0')}-${new Date(parseInt(yr), t+1, 0).getDate()}`;
      }

      // 1. P&L normal — totais por conta
      if (!budgetQBActuals[entity]) budgetQBActuals[entity] = {};
      
      if (mode === 'month') {
        const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
        
        // Fetch current month AND all previous months (0 to currentMonth)
        for (let m = 0; m <= currentMonth; m++) {
          const mm = String(m+1).padStart(2,'0');
          const mStart = `${yr}-${mm}-01`;
          const mEnd = `${yr}-${mm}-${new Date(parseInt(yr), m+1, 0).getDate()}`;
          
          status.textContent = `Fetching ${entity} month ${m+1}...`;
          
          const mPath = `/v3/company/${realmId}/reports/ProfitAndLoss?start_date=${mStart}&end_date=${mEnd}&accounting_method=Accrual&minorversion=65`;
          const mUrl = `${QB_PROXY_URL}?path=${encodeURIComponent(mPath)}&realmId=${realmId}`;
          try {
            const mR = await fetch(mUrl, { headers: { 'X-Auth-Token': token } });
            if (mR.ok) {
              const mData = await mR.json();
              const parsed = budgetParseQBReport(mData);
              budgetQBActuals[entity][m] = parsed;
              console.log(`[FETCH] Saved ${entity} month ${m} (${BUDGET_MONTHS[m]}):`, Object.keys(parsed).length, 'accounts');
            } else {
              console.error(`[FETCH] Failed ${entity} month ${m} HTTP ${mR.status}`);
            }
          } catch(e) { console.error(`[FETCH] Failed ${entity} month ${m}`, e); }
        }
      } else {
        // For YTD/range modes
        const path = `/v3/company/${realmId}/reports/ProfitAndLoss?start_date=${fetchStart}&end_date=${fetchEnd}&accounting_method=Accrual&minorversion=65`;
        const url = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
        try {
          const r = await fetch(url, { headers: { 'X-Auth-Token': token } });
          if (!r.ok) { errors++; continue; }
          const data = await r.json();
          budgetQBActuals[entity] = budgetParseQBReport(data);
        } catch(e) { errors++; continue; }
      }


      // 2. GL por conta mapeada — para obter breakdown por class
      if (!budgetQBActualsByClass[entity]) budgetQBActualsByClass[entity] = {};

      const allAcctNums = [...new Set(budgetMapping.flatMap(m => m.accounts))];
      const acctIdMap = _budgetAcctIdMap?.[entity] || {};

      if (mode === 'month') {
        // Fetch GL by class for EVERY month from 0 to currentMonth
        const currentMonthGL = parseInt(document.getElementById('budget-m')?.value || 0);

        // Zagreus GL doesn't return class data — use P&L by Class instead
        const useGLForClass = entity !== 'Zagreus';

        for (let mIdx = 0; mIdx <= currentMonthGL; mIdx++) {
          const mm2 = String(mIdx+1).padStart(2,'0');
          const mStart = `${yr}-${mm2}-01`;
          const mEnd = `${yr}-${mm2}-${new Date(parseInt(yr), mIdx+1, 0).getDate()}`;
          budgetQBActualsByClass[entity][mIdx] = {}; // always reset — never keep stale data
          const classTarget = budgetQBActualsByClass[entity][mIdx];
          const monthActuals = budgetQBActuals[entity]?.[mIdx] || {};
          status.textContent = `Fetching ${entity} GL by class month ${mIdx+1}…`;

          if (!useGLForClass) {
            // Zagreus: use Excel GL data directly (QB P&L by Class column names may differ)
            if (ZAGREUS_GL_2026) {
              for (const acctNum of allAcctNums) {
                classTarget[acctNum] = classTarget[acctNum] || {};
                for (const [cls, rows] of Object.entries(ZAGREUS_GL_2026[String(acctNum)] || {})) {
                  // Filter by month date range (Excel format: MM/DD/YYYY)
                  const toExcel = d => { const [y,mo,day] = d.split('-'); return `${mo}/${day}/${y}`; };
                  const eStart = toExcel(mStart), eEnd = toExcel(mEnd);
                  const monthTotal = rows
                    .filter(r => r.date >= eStart && r.date <= eEnd)
                    .reduce((s, r) => s + r.amount, 0);
                  // Store the net amount (can be negative for refunds/credits)
                  if (monthTotal !== 0) {
                    classTarget[acctNum][cls] = (classTarget[acctNum][cls] || 0) + monthTotal;
                  }
                }
              }
            }
            continue; // skip per-account GL loop
          }

          for (const acctNum of allAcctNums) {
            const acctId = acctIdMap[String(acctNum)];
            if (!acctId) continue;
            if (!monthActuals[acctNum]) continue; // skip if no spend this month
            try {
              const glPath = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${mStart}&end_date=${mEnd}&account=${acctId}&columns=tx_date,txn_type,doc_num,name,klass_name,memo,subt_nat_amount,rbal_nat_amount&accounting_method=Accrual&minorversion=65`;
              const glUrl = `${QB_PROXY_URL}?path=${encodeURIComponent(glPath)}&realmId=${realmId}`;
              const gr = await fetch(glUrl, { headers: { 'X-Auth-Token': token } });
              if (!gr.ok) continue;
              const glData = await gr.json();
              classTarget[acctNum] = budgetParseGLByClass(glData);
            } catch(e) {}
          }
        }
      } else {
        // YTD/range: single fetch, store flat
        const classTarget = budgetQBActualsByClass[entity];
        const entityActuals = budgetQBActuals[entity] || {};
        status.textContent = `Fetching ${entity} GL by class…`;
        for (const acctNum of allAcctNums) {
          const acctId = acctIdMap[String(acctNum)];
          if (!acctId) continue;
          if (!entityActuals[acctNum]) continue;
          try {
            const glPath = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${fetchStart}&end_date=${fetchEnd}&account=${acctId}&columns=tx_date,txn_type,doc_num,name,klass_name,memo,subt_nat_amount,rbal_nat_amount&accounting_method=Accrual&minorversion=65`;
            const glUrl = `${QB_PROXY_URL}?path=${encodeURIComponent(glPath)}&realmId=${realmId}`;
            const gr = await fetch(glUrl, { headers: { 'X-Auth-Token': token } });
            if (!gr.ok) continue;
            const glData = await gr.json();
            classTarget[acctNum] = budgetParseGLByClass(glData);
          } catch(e) {}
        }
      }
      fetched++;
    } catch(e) { errors++; }
  }

  // (accounts already fetched above)

  if (window.qbLoadTokens) qbLoadTokens();

  btn.style.opacity = '1';
  btn.textContent = '↺ Fetch Actuals from QB';
  if (errors > 0) status.textContent = `✓ ${fetched} fetched · ✗ ${errors} failed`;
  else status.textContent = `✓ Actuals updated (${new Date().toLocaleTimeString()})`;

  // Fetch YTD actuals immediately after main fetch for mode=month
  const mode = document.getElementById('budget-mode-sel')?.value || 'month';
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
  if (mode === 'month' && currentMonth > 0) {
    console.log('[Budget Fetch] Fetching YTD actuals...');
    await budgetFetchActualsYTD();
    window._lastYTDFetch = `${yr}-${currentMonth}`;
  }

  // currentMonth already declared above = parseInt(document.getElementById('budget-m')?.value || 0);
  // mode already declared = document.getElementById('budget-mode-sel')?.value || 'ytd';
  status.textContent = mode === 'month' ? `✓ Fetched ${currentMonth + 1} months` : `✓ Fetched actuals`;
  btn.textContent = '↻ Fetch Actuals from QB'; btn.style.opacity = '1';
  
  const activeTab = document.querySelector('#tab-budget .tab-view.active')?.id?.replace('bgt-','');
  
  console.log('[Budget Fetch] Fetch completed. Rendering...', {
    activeTab,
    hasActuals: !!budgetQBActuals,
    hasActualsByClass: !!budgetQBActualsByClass,
    activeDept,
    isRestricted: !!(window.USER_PERMISSIONS && window.USER_PERMISSIONS.budgetDepartments)
  });
  
  if (activeTab === 'overview') {
    budgetRenderOverview();
  } else if (activeTab === 'departments') {
    // Immediate render
    budgetRenderDeptDetail();
    
    // For restricted users, do aggressive refresh with verification
    if (window.USER_PERMISSIONS && window.USER_PERMISSIONS.budgetDepartments) {
      console.log('[Budget Fetch] Scheduling re-renders for restricted user');
      setTimeout(() => {
        console.log('[Budget Fetch] Re-render 1 (100ms)');
        budgetRenderDeptDetail();
      }, 100);
      setTimeout(() => {
        console.log('[Budget Fetch] Re-render 2 (300ms)');
        budgetRenderDeptDetail();
      }, 300);
      setTimeout(() => {
        console.log('[Budget Fetch] Re-render 3 (600ms)');
        budgetRenderDeptDetail();
      }, 600);
    }
  }
}

// ── FETCH YTD ACTUALS (Jan to current month) ─────────────────────────────────
async function budgetFetchActualsYTD() {
  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];
  const token = getBudgetToken();
  
  // Initialize YTD storage
  if (!budgetQBActualsYTD) budgetQBActualsYTD = {};
  if (!budgetQBActualsByClassYTD) budgetQBActualsByClassYTD = {};
  
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
  const mm = String(currentMonth+1).padStart(2,'0');
  const fetchStart = `${yr}-01-01`;
  const fetchEnd = `${yr}-${mm}-${new Date(parseInt(yr), currentMonth+1, 0).getDate()}`;
  
  // Store which month this YTD is for (so we don't use Feb YTD when viewing Jan)
  window._budgetYTDMonth = currentMonth;
  
  console.log(`[Budget YTD] Fetching ${fetchStart} → ${fetchEnd}`);

  for (const entity of entities) {
    const realmId = QB_REALM_IDS[entity];
    if (!realmId) continue;
    try {
      // 1. P&L YTD — totais por conta
      const path = `/v3/company/${realmId}/reports/ProfitAndLoss?start_date=${fetchStart}&end_date=${fetchEnd}&accounting_method=Accrual&minorversion=65`;
      const url = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
      const qbYTDTok = await qbEnsureToken(realmId);
      const r = await fetch(url, { credentials: 'include', headers: { 'Authorization': `Bearer ${qbYTDTok}` } });
      if (!r.ok) continue;
      const data = await r.json();
      budgetQBActualsYTD[entity] = budgetParseQBReport(data);

      // 2. GL por conta mapeada YTD — breakdown por class
      if (!budgetQBActualsByClassYTD[entity]) budgetQBActualsByClassYTD[entity] = {};
      const allAcctNums = [...new Set(budgetMapping.flatMap(m => m.accounts))];
      const acctIdMap = _budgetAcctIdMap?.[entity] || {};
      
      for (const acctNum of allAcctNums) {
        const acctId = acctIdMap[String(acctNum)];
        if (!acctId) continue;
        if (!budgetQBActualsYTD[entity][acctNum]) continue;
        try {
          const glPath = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${fetchStart}&end_date=${fetchEnd}&account=${acctId}&columns=tx_date,txn_type,doc_num,name,klass_name,memo,subt_nat_amount,rbal_nat_amount&accounting_method=Accrual&minorversion=65`;
          const glUrl = `${QB_PROXY_URL}?path=${encodeURIComponent(glPath)}&realmId=${realmId}`;
          const gr = await fetch(glUrl, { headers: { 'X-Auth-Token': token } });
          if (!gr.ok) continue;
          const glData = await gr.json();
          budgetQBActualsByClassYTD[entity][acctNum] = budgetParseGLByClass(glData);
        } catch(e) {}
      }
    } catch(e) { 
      console.error(`[Budget YTD] Error fetching ${entity}:`, e);
    }
  }
  
  console.log('[Budget YTD] Fetch complete');
  return true;
}

