let _editBudgetData = null;

function budgetGetEditDataForYear(yr) {
  if (!_editBudgetData) {
    // Fallback: 2025 tem dados hardcoded, outros anos começam vazios
    _editBudgetData = yr === '2025' ? JSON.parse(JSON.stringify(BUDGET_2025_BY_ACCT)) : {};
  }
  return _editBudgetData;
}

function budgetRenderEdit() {
  const el = document.getElementById('edit-budget-body');
  if (!el) return;
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const nonCompData = budgetGetEditDataForYear(yr);
  const compData    = budgetCalcCompFromTeam();

  const getAcctName = (acct) => {
    for (const ent of ['Opco','Zagreus','Juku','Foundation']) {
      const name = window._budgetAcctNameMap?.[ent]?.[String(acct)];
      if (name) return name;
    }
    return '';
  };

  const thS  = `style="font-family:var(--mono);font-size:0.65rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;padding:6px 8px;text-align:right;white-space:nowrap;border-bottom:2px solid var(--border)"`;
  const thSL = `style="font-family:var(--mono);font-size:0.65rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;padding:6px 8px;text-align:left;border-bottom:2px solid var(--border)"`;

  let html = `
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap">
    <div style="font-family:var(--mono);font-size:0.78rem;color:var(--muted)">
      Editing <strong style="color:var(--text)">${yr} Budget</strong> — annual values per QB account per department.
      <span style="color:var(--accent)">●</span> Salary & bonus pulled live from Team Tracker.
    </div>
    <button id="edit-budget-save-btn" onclick="budgetSaveBudgetLines()"
      style="margin-left:auto;font-family:var(--mono);font-size:.68rem;padding:5px 16px;border-radius:5px;border:1px solid var(--accent);background:var(--accent-bg);color:var(--accent);cursor:pointer">
      💾 Save Budget
    </button>
    <span id="edit-budget-status" style="font-family:var(--mono);font-size:.68rem;color:var(--muted)"></span>
  </div>
  <div style="overflow-x:auto">
  <table style="width:100%;border-collapse:collapse;min-width:1000px">
    <thead><tr>
      <th ${thSL}>Account</th>
      <th ${thSL}>Name</th>
      <th ${thSL}>Budget Line</th>
      ${BUDGET_DEPTS.map(d=>`<th ${thS}>${d.replace(' & ','&<br>')}</th>`).join('')}
      <th ${thS}>Total</th>
    </tr></thead>
    <tbody>`;

  // Track dept totals across all rows
  const deptGrandTotals = {};
  BUDGET_DEPTS.forEach(d => deptGrandTotals[d] = 0);
  let grandTotal = 0;

  // Track subtotals per category
  const deptCatTotals = {};
  let catTotal = 0;
  let lastCat = '';

  const emitCatSubtotal = (cat) => {
    if (!cat || !deptCatTotals[cat]) return '';
    const cols = BUDGET_DEPTS.map(d => {
      const v = deptCatTotals[cat][d] || 0;
      return `<td style="padding:4px 8px;text-align:right;font-family:var(--mono);font-size:0.72rem;font-weight:600;color:var(--muted)">
        ${v > 0 ? '$'+Math.round(v).toLocaleString() : '—'}
      </td>`;
    }).join('');
    const t = Object.values(deptCatTotals[cat]).reduce((s,v)=>s+v,0);
    return `<tr style="background:var(--surface2);border-top:1px solid var(--border);border-bottom:2px solid var(--border)">
      <td colspan="3" style="padding:4px 8px;font-family:var(--mono);font-size:0.65rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em">Subtotal — ${cat}</td>
      ${cols}
      <td style="padding:4px 8px;text-align:right;font-family:var(--mono);font-size:0.72rem;font-weight:700;color:var(--text)">
        ${t > 0 ? '$'+Math.round(t).toLocaleString() : '—'}
      </td>
    </tr>`;
  };

  for (const row of budgetMapping) {
    if (row.cat !== lastCat) {
      // Emit subtotal for previous category
      html += emitCatSubtotal(lastCat);
      lastCat = row.cat;
      if (!deptCatTotals[lastCat]) { deptCatTotals[lastCat] = {}; BUDGET_DEPTS.forEach(d => deptCatTotals[lastCat][d] = 0); }
      html += `<tr><td colspan="${BUDGET_DEPTS.length + 4}" style="padding:10px 8px 3px;font-family:var(--mono);font-size:0.63rem;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.08em;background:var(--surface2)">${row.cat}</td></tr>`;
    }
    for (const acct of row.accounts) {
      const acctKey    = String(acct);
      const isComp     = COMP_ACCTS.has(acctKey);
      const sourceData = isComp ? compData : nonCompData;
      const name       = getAcctName(acctKey);
      let rowTotal = 0;
      let deptCells = '';

      for (const d of BUDGET_DEPTS) {
        const val = (sourceData[acctKey]?.[d]) || 0;
        rowTotal += val;
        deptGrandTotals[d] += val;
        grandTotal += val;
        deptCatTotals[lastCat][d] += val;
        if (isComp) {
          deptCells += `<td style="padding:2px 8px;text-align:right;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">
            ${val > 0 ? '$'+Math.round(val).toLocaleString() : '—'}
          </td>`;
        } else {
          deptCells += `<td style="padding:2px 4px;text-align:right">
            <input type="text"
              data-acct="${acctKey}" data-dept="${d}"
              value="${val > 0 ? Math.round(val).toLocaleString() : ''}"
              placeholder="—"
              onfocus="this.select()"
              onchange="budgetLineEditCell(this)"
              style="width:72px;text-align:right;font-family:var(--mono);font-size:0.75rem;padding:2px 5px;border:1px solid var(--border);border-radius:4px;background:var(--surface);color:var(--text)"
              onfocusin="this.style.borderColor='var(--accent)'"
              onfocusout="this.style.borderColor='var(--border)'">
          </td>`;
        }
      }

      const compBadge = isComp
        ? `<span style="font-family:var(--mono);font-size:0.6rem;padding:1px 5px;border-radius:3px;background:var(--accent-bg);color:var(--accent);margin-left:4px">Team Tracker</span>`
        : '';

      const rowBg = isComp ? 'var(--surface2)' : '';
      html += `<tr style="border-bottom:1px solid var(--border);background:${rowBg}" onmouseenter="this.style.background='var(--surface2)'" onmouseleave="this.style.background='${rowBg}'" >
        <td style="padding:4px 8px;font-family:var(--mono);font-size:0.75rem;color:var(--accent)">${acct}</td>
        <td style="padding:4px 8px;font-size:0.8rem;color:var(--muted);white-space:nowrap;max-width:180px;overflow:hidden;text-overflow:ellipsis" title="${name}">${name||'—'}${compBadge}</td>
        <td style="padding:4px 8px;font-size:0.78rem;color:var(--text)">${row.line}</td>
        ${deptCells}
        <td style="padding:4px 8px;text-align:right;font-family:var(--mono);font-size:0.75rem;font-weight:600;color:var(--text)" id="edit-rowtotal-${acctKey}">
          ${rowTotal > 0 ? '$'+Math.round(rowTotal).toLocaleString() : '—'}
        </td>
      </tr>`;
    }
  }
  // Emit subtotal for last category
  html += emitCatSubtotal(lastCat);

  // Grand total row by department
  html += `<tr style="border-top:2px solid var(--border);background:var(--surface2)">
    <td colspan="3" style="padding:8px 8px;font-family:var(--mono);font-size:0.72rem;font-weight:700;color:var(--text);text-transform:uppercase;letter-spacing:.05em">TOTAL</td>
    ${BUDGET_DEPTS.map(d=>`<td style="padding:8px 8px;text-align:right;font-family:var(--mono);font-size:0.78rem;font-weight:700;color:var(--text)" id="edit-deptotal-${d.replace(/[^a-z0-9]/gi,'_')}">
      ${deptGrandTotals[d] > 0 ? '$'+Math.round(deptGrandTotals[d]).toLocaleString() : '—'}
    </td>`).join('')}
    <td style="padding:8px 8px;text-align:right;font-family:var(--mono);font-size:0.78rem;font-weight:700;color:var(--accent)">
      ${grandTotal > 0 ? '$'+Math.round(grandTotal).toLocaleString() : '—'}
    </td>
  </tr>`;

  html += `</tbody></table></div>`;
  el.innerHTML = html;
}

function budgetLineEditCell(input) {
  const acct = input.dataset.acct;
  const dept = input.dataset.dept;
  const yr   = document.getElementById('budget-year-sel')?.value || '2026';
  const raw  = input.value.replace(/[$,\s]/g,'');
  const val  = raw === '' ? 0 : parseFloat(raw);
  if (isNaN(val)) { input.style.borderColor = 'var(--red)'; return; }
  input.style.borderColor = 'var(--border)';
  input.value = val > 0 ? Math.round(val).toLocaleString() : '';
  const data = budgetGetEditDataForYear(yr);
  if (!data[acct]) data[acct] = {};
  data[acct][dept] = val;

  // Update row total (right column)
  const rowTotal = BUDGET_DEPTS.reduce((s,d) => s + (data[acct]?.[d] || 0), 0);
  const totalEl = document.getElementById('edit-rowtotal-'+acct);
  if (totalEl) totalEl.textContent = rowTotal > 0 ? '$'+Math.round(rowTotal).toLocaleString() : '—';

  // Update dept column total (bottom row) — comp + non-comp
  const compData = budgetCalcCompFromTeam();
  const dKey = dept.replace(/[^a-z0-9]/gi,'_');
  const deptEl = document.getElementById('edit-deptotal-'+dKey);
  if (deptEl) {
    let dTotal = 0;
    for (const ak of ['60310','60320','60110','60120']) dTotal += compData[ak]?.[dept] || 0;
    for (const ak of Object.keys(data)) dTotal += data[ak]?.[dept] || 0;
    deptEl.textContent = dTotal > 0 ? '$'+Math.round(dTotal).toLocaleString() : '—';
  }

  // Mark dirty
  const btn = document.getElementById('edit-budget-save-btn');
  if (btn) { btn.style.borderColor = 'var(--orange)'; btn.style.color = 'var(--orange)'; }
}

async function budgetSaveBudgetLines() {
  const btn    = document.getElementById('edit-budget-save-btn');
  const status = document.getElementById('edit-budget-status');
  const yr     = document.getElementById('budget-year-sel')?.value || '2026';
  btn.textContent = 'Saving…'; btn.style.opacity = '.6';
  try {
    const r = await fetch(`${SERVER}/budget/lines`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Auth-Token': getBudgetToken() },
      body: JSON.stringify({ year: yr, lines: _editBudgetData || {} })
    });
    const d = await r.json();
    if (d.ok) {
      budgetApplyLinesToStatic();
      budgetRerender();
      btn.style.borderColor = 'var(--green)'; btn.style.color = 'var(--green)';
      btn.textContent = '✓ Saved';
      status.textContent = `Saved ${yr} budget · ${new Date().toLocaleTimeString()}`;
      setTimeout(() => { btn.textContent = '💾 Save Budget'; btn.style.borderColor = 'var(--accent)'; btn.style.color = 'var(--accent)'; }, 3000);
    } else throw new Error(d.error || 'Failed');
  } catch(e) {
    btn.style.borderColor = 'var(--red)'; btn.style.color = 'var(--red)';
    btn.textContent = '✗ Error'; status.textContent = e.message;
    setTimeout(() => { btn.textContent = '💾 Save Budget'; btn.style.borderColor = 'var(--accent)'; btn.style.color = 'var(--accent)'; }, 4000);
  }
  btn.style.opacity = '1';
}

// Converte _editBudgetData { acctNum: { dept: val } } → STATIC_BUDGET { dept: { key: val } }
function budgetApplyLinesToStatic() {
  const compKeys = new Set(['salary','bonus','commissions','severance']);
  // Reset ALL non-comp keys in STATIC_BUDGET to 0
  for (const d of BUDGET_DEPTS) {
    if (!STATIC_BUDGET[d]) STATIC_BUDGET[d] = {};
    for (const row of CAT_LINES) {
      if (compKeys.has(row.key)) continue;
      STATIC_BUDGET[d][row.key] = 0;
    }
  }
  if (!_editBudgetData) return;
  // Apply from _editBudgetData (acctNum → dept → val) using mapping to get key
  for (const row of budgetMapping) {
    if (compKeys.has(row.key)) continue;
    for (const acct of row.accounts) {
      const acctData = _editBudgetData[String(acct)];
      if (!acctData) continue;
      for (const d of BUDGET_DEPTS) {
        STATIC_BUDGET[d][row.key] = (STATIC_BUDGET[d][row.key] || 0) + (acctData[d] || 0);
      }
    }
  }
}

async function budgetLoadBudgetLines() {
  if (!getBudgetToken()) return;
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  try {
    const r = await fetch(`${SERVER}/budget/lines?year=${yr}`, { headers: { 'X-Auth-Token': getBudgetToken() } });
    if (!r.ok) { 
      _editBudgetData = yr === '2025' ? JSON.parse(JSON.stringify(BUDGET_2025_BY_ACCT)) : {}; 
      window.IMPORTED_BUDGET = window.IMPORTED_BUDGET || {};
      window.IMPORTED_BUDGET[yr] = null;
      budgetApplyLinesToStatic(); 
      return; 
    }
    const d = await r.json();
    if (d.lines && Object.keys(d.lines).length > 0) {
      _editBudgetData = d.lines;
      // Save imported budget for use in budget_getTeamBudget()
      window.IMPORTED_BUDGET = window.IMPORTED_BUDGET || {};
      window.IMPORTED_BUDGET[yr] = d.lines;
      console.log(`[Budget] Loaded imported budget for ${yr}:`, d.lines);
    } else {
      _editBudgetData = yr === '2025' ? JSON.parse(JSON.stringify(BUDGET_2025_BY_ACCT)) : {};
      window.IMPORTED_BUDGET = window.IMPORTED_BUDGET || {};
      window.IMPORTED_BUDGET[yr] = null;
    }
  } catch(e) {
    _editBudgetData = yr === '2025' ? JSON.parse(JSON.stringify(BUDGET_2025_BY_ACCT)) : {};
    window.IMPORTED_BUDGET = window.IMPORTED_BUDGET || {};
    window.IMPORTED_BUDGET[yr] = null;
  }
  budgetApplyLinesToStatic();
}

// ═══════════════════════════════════════════════════════════════════
// ACCESS CONTROL FUNCTIONS
// ═══════════════════════════════════════════════════════════════════

// Toggle department field visibility
function accessToggleDeptField() {
  const role = document.getElementById('access-role-select').value;
  const deptField = document.getElementById('access-dept-field');
  deptField.style.display = role === 'restricted' ? 'block' : 'none';
}

// Load users list
async function accessLoadUsers() {
  const tbody = document.getElementById('access-users-tbody');
  tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--muted);font-family:var(--mono);font-size:0.75rem">⟳ Loading...</td></tr>';
  
  try {
    const token = localStorage.getItem('tidelog_auth_token');
    const res = await fetch(`${SERVER}/api/access/list`, {
      headers: { 'X-Auth-Token': token }
    });
    
    if (!res.ok) {
      throw new Error('Failed to load users');
    }
    
    const data = await res.json();
    
    if (!data.users || data.users.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--muted);font-family:var(--mono);font-size:0.75rem">No users found. Add users above.</td></tr>';
      return;
    }
    
    tbody.innerHTML = data.users.map(u => {
      let roleBadge, roleColor, roleBg;
      if (u.role === 'admin') {
        roleBadge = 'Admin';
        roleColor = 'var(--green)';
        roleBg = 'var(--green-bg)';
      } else if (u.role === 'budget_admin') {
        roleBadge = 'Budget Admin';
        roleColor = '#00A8A8';
        roleBg = 'rgba(0, 168, 168, 0.1)';
      } else {
        roleBadge = 'Restricted';
        roleColor = 'var(--orange)';
        roleBg = 'var(--orange-bg)';
      }
      
      return `
      <tr>
        <td style="font-family:var(--mono);font-size:0.75rem">${u.email}</td>
        <td>
          <span style="display:inline-block;font-family:var(--mono);font-size:0.65rem;padding:3px 8px;border-radius:4px;font-weight:500;background:${roleBg};color:${roleColor}">
            ${roleBadge}
          </span>
        </td>
        <td style="font-family:var(--mono);font-size:0.75rem;color:${u.budget_department ? 'var(--text)' : 'var(--muted)'}">
          ${u.budget_department || '—'}
        </td>
        <td style="text-align:center">
          <button onclick="accessEditUser('${u.email}', '${u.role}', '${u.budget_department || ''}')" style="font-family:var(--mono);font-size:0.68rem;padding:4px 10px;border-radius:4px;border:1px solid var(--border);background:var(--surface2);color:var(--muted);cursor:pointer;margin-right:6px" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'">
            Edit
          </button>
          ${u.email !== 'gustavo@orca.so' ? `
            <button onclick="accessDeleteUser('${u.email}')" style="font-family:var(--mono);font-size:0.68rem;padding:4px 10px;border-radius:4px;border:1px solid var(--border);background:var(--surface2);color:var(--muted);cursor:pointer" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--muted)'">
              Delete
            </button>
          ` : ''}
        </td>
      </tr>
      `;
    }).join('');
    
  } catch (err) {
    console.error('Error loading users:', err);
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--red);font-family:var(--mono);font-size:0.75rem">Error loading users. Please try again.</td></tr>';
  }
}

// Edit user (populate form)
function accessEditUser(email, role, dept) {
  document.getElementById('access-email-input').value = email;
  document.getElementById('access-role-select').value = role;
  accessToggleDeptField();
  if (dept) {
    document.getElementById('access-dept-select').value = dept;
  }
  // Scroll to form
  document.getElementById('access-email-input').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// Save user
async function accessSaveUser() {
  const email = document.getElementById('access-email-input').value.trim();
  const role = document.getElementById('access-role-select').value;
  const dept = document.getElementById('access-dept-select').value;
  const status = document.getElementById('access-save-status');
  
  // Validation
  if (!email || !email.includes('@')) {
    status.style.display = 'block';
    status.style.color = 'var(--red)';
    status.textContent = '✗ Please enter a valid email';
    return;
  }
  
  if (role === 'restricted' && !dept) {
    status.style.display = 'block';
    status.style.color = 'var(--red)';
    status.textContent = '✗ Please select a department for restricted users';
    return;
  }
  
  status.style.display = 'block';
  status.style.color = 'var(--muted)';
  status.textContent = '⟳ Saving...';
  
  try {
    const token = localStorage.getItem('tidelog_auth_token');
    const res = await fetch(`${SERVER}/api/access/user`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Auth-Token': token
      },
      body: JSON.stringify({
        email: email.toLowerCase(),
        role,
        budgetDepartment: role === 'restricted' ? dept : null
      })
    });
    
    if (!res.ok) {
      const err = await res.json();
      throw new Error(err.error || 'Failed to save user');
    }
    
    status.style.color = 'var(--green)';
    status.textContent = '✓ User saved successfully!';
    
    // Clear form
    document.getElementById('access-email-input').value = '';
    document.getElementById('access-role-select').value = 'admin';
    document.getElementById('access-dept-select').value = '';
    accessToggleDeptField();
    
    // Reload list
    setTimeout(() => {
      accessLoadUsers();
      status.style.display = 'none';
    }, 1500);
    
  } catch (err) {
    console.error('Error saving user:', err);
    status.style.color = 'var(--red)';
    status.textContent = `✗ Error: ${err.message}`;
  }
}

// Delete user
async function accessDeleteUser(email) {
  if (!confirm(`Delete user "${email}"?\n\nThey will lose all access restrictions.`)) {
    return;
  }
  
  try {
    const token = localStorage.getItem('tidelog_auth_token');
    const res = await fetch(`${SERVER}/api/access/user/${encodeURIComponent(email)}`, {
      method: 'DELETE',
      headers: { 'X-Auth-Token': token }
    });
    
    if (!res.ok) {
      throw new Error('Failed to delete user');
    }
    
    // Reload list
    accessLoadUsers();
    
  } catch (err) {
    console.error('Error deleting user:', err);
    alert('Error deleting user. Please try again.');
  }
}

// Auto-load users when Access tab opens
const originalSwitchTab = switchTab;
switchTab = function(tabName) {
  originalSwitchTab(tabName);
  if (tabName === 'access') {
    accessLoadUsers();
  }
};

// ── REVENUE TREND CHART ───────────────────────────────────────────────────────
function budgetShowRevenueTrend() {
  // Revenue data (same as Overview)
  const revenueData = {
    2025: {
      5: 912095.04, 6: 961028.99, 7: 991663.86, 8: 1933760.08,
      9: 779485.04, 10: 763582.17, 11: 604374.65, 12: 689910.25
    },
    2026: {
      1: 344482.97, 2: 412176.54
    }
  };
  
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const yearData = revenueData[yr] || {};
  
  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const labels = monthNames; // Always show all 12 months
  const values = [];
  
  // Build chart data - show all 12 months, but only plot where we have data
  for (let m = 1; m <= 12; m++) {
    const revenue = yearData[m];
    if (revenue && revenue > 0) {
      values.push(revenue);
    } else {
      values.push(null); // null will create gaps in the line
    }
  }
  
  // Open modal
  const modal = document.getElementById('pnl-gl-modal') || createGenericModal();
  const title = document.getElementById('pnl-gl-modal-title');
  const body = document.getElementById('pnl-gl-modal-body');
  const tot = document.getElementById('pnl-gl-modal-total');
  
  if (title) title.textContent = `Revenue Trend — ${yr}`;
  if (tot) {
    const ytdTotal = values.reduce((s,v)=>s+v,0);
    tot.textContent = `${yr} Total: ${fmtUSD(ytdTotal,0)}`;
    tot.style.color = '#04a776';
  }
  
  if (body) {
    body.innerHTML = `<canvas id="revenue-trend-chart" style="max-height:400px"></canvas>`;
    
    // Wait for canvas to be in DOM
    setTimeout(() => {
      const ctx = document.getElementById('revenue-trend-chart');
      if (!ctx) return;
      
      // Destroy existing chart if any
      if (window._revenueTrendChart) {
        window._revenueTrendChart.destroy();
      }
      
      // Create line chart with smooth curve
      window._revenueTrendChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Revenue',
            data: values,
            borderColor: '#06D6A0',
            backgroundColor: 'rgba(6, 214, 160, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: '#04a776',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            spanGaps: false
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (context) => 'Revenue: ' + fmtUSD(context.parsed.y, 0)
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: (value) => fmtUSD(value, 0)
              },
              grid: {
                color: 'rgba(0,0,0,0.05)'
              }
            },
            x: {
              grid: {
                display: false
              }
            }
          }
        }
      });
    }, 100);
  }
  
  if (modal) modal.style.display = 'block';
}



</script>

<!-- Budget Import Modal (Budget Admin only) -->
<div id="budget-import-modal">
  <div class="modal-content">
    <h3>📤 Import Budget</h3>
    
    <label for="import-year">Year</label>
    <select id="import-year">
      <option value="2026" selected>2026</option>
    </select>
    
    <label for="import-month">Month</label>
    <select id="import-month">
      <option value="1">January</option>
      <option value="2">February</option>
      <option value="3">March</option>
      <option value="4">April</option>
      <option value="5">May</option>
      <option value="6">June</option>
      <option value="7">July</option>
      <option value="8">August</option>
      <option value="9">September</option>
      <option value="10">October</option>
      <option value="11">November</option>
      <option value="12">December</option>
      <option value="all">All Months (Full Year)</option>
    </select>
    
    <label for="import-dept">Department</label>
    <select id="import-dept">
      <option value="All">All Departments</option>
      <option value="General">General</option>
      <option value="Ops">Ops</option>
      <option value="Finance & Accounting">Finance & Accounting</option>
      <option value="Legal">Legal</option>
      <option value="Product">Product</option>
      <option value="Engineering" selected>Engineering</option>
      <option value="Marketing">Marketing</option>
      <option value="Business Development">Business Development</option>
    </select>
    
    <label for="import-file">Excel File</label>
    <input type="file" id="import-file" accept=".xlsx,.xls" onchange="budgetHandleFileSelect(event)">
    
    <div id="import-preview">
      <div id="import-preview-text"></div>
    </div>
    
    <div style="font-size:0.75rem;color:#666;margin-bottom:20px;">
      <strong>Expected format:</strong> Excel file with columns "line_item" and "budget"
    </div>
    
    <div class="button-group">
      <button id="import-cancel-btn" onclick="budgetCloseImportModal()">Cancel</button>
      <button id="import-submit-btn" onclick="budgetSubmitImport()">Import</button>
    </div>
  </div>
</div>

</body>
</html>

