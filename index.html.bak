5.94], link to transaction: https://app.rippling.com/spend-management/expense/6980ec8620c8dab8096ca762", "amount": 205.94}, {"date": "01/30/2026", "type": "Bill", "num": "", "name": "Rebecca Lara", "memo": "Rebecca Lara, Coinbase, Project Treasure Hunt SOL, Categories: [Utilities: 23.98], link to transaction: https://app.rippling.com/spend-management/expense/6980ec5b35c92603cae08680", "amount": 23.98}]}, "67010": {"Ops": [{"date": "02/22/2026", "type": "Expense", "num": "", "name": "Skyline NY Co Working", "memo": "Feb-26 Coworking space purchased", "amount": 200.0}, {"date": "02/25/2026", "type": "Credit Card Credit", "num": "", "name": "Skyline NY Co Working", "memo": "Feb-26 Coworking space purchased", "amount": -200.0}]}}; // Zagreus GL with class data (from Excel)
let budgetQBActuals = null; // { entity: { acctNum: totalAmount } } — backward compat
let budgetQBActualsByClass = {}; // { entity: { acctNum: { className: amount } } }
let budgetQBActualsYTD = null; // YTD totals
let budgetQBActualsByClassYTD = {}; // YTD class breakdown

// ── Parse QB P&L by Class report → { byAcct: {acctNum: total}, byClass: {acctNum: {class: amount}} }
function budgetParseQBReportByClass(report) {
  const byAcct  = {};
  const byClass = {};

  // The columns header tells us which class each column belongs to
  // ColData[0] = account name, ColData[1..n] = class amounts, last = total
  const cols = report?.Columns?.Column || [];
  // Find class names from columns (skip first "Account" col and last "Total" col)
  const classNames = [];
  for (let i = 1; i < cols.length; i++) {
    const meta = cols[i].MetaData || [];
    const nameMeta = meta.find(m => m.Name === 'ColTitle' || m.Name === 'Value');
    const name = cols[i].ColTitle || nameMeta?.Value || '';
    if (name && name !== 'Total' && name !== '') classNames.push({ idx: i, name });
  }

  function walk(rows) {
    if (!rows) return;
    for (const row of rows) {
      if (row.type === 'Data' && row.ColData) {
        const acctName = row.ColData[0]?.value || '';
        const m = acctName.match(/^(\d{4,6})\s/);
        if (m) {
          const acctNum = parseInt(m[1]);
          // Total = last ColData
          const total = parseFloat(row.ColData[row.ColData.length - 1]?.value || '0') || 0;
          if (total !== 0) byAcct[acctNum] = (byAcct[acctNum] || 0) + total;
          // Per class
          if (!byClass[acctNum]) byClass[acctNum] = {};
          for (const { idx, name } of classNames) {
            const val = parseFloat(row.ColData[idx]?.value || '0') || 0;
            if (val !== 0) byClass[acctNum][name] = (byClass[acctNum][name] || 0) + val;
          }
        }
      }
      if (row.Rows?.Row) walk(row.Rows.Row);
    }
  }
  if (report?.Rows?.Row) walk(report.Rows.Row);
  return { byAcct, byClass };
}

// ── Parse GL report → { className: amount } for one account ──────────────────
// Detects columns from ColData length: 8 cols = has klass, 7 cols = no klass
function budgetParseGLByClass(report) {
  const result = {};
  function walk(rows) {
    if (!rows) return;
    for (const row of rows) {
      if (row.type === 'Data' && row.ColData) {
        const cols = row.ColData;
        // Columns: tx_date,txn_type,doc_num,name,[klass_name,]memo,subt_nat_amount,rbal_nat_amount
        // With klass:    8 cols → klass=4, amt=6
        // Without klass: 7 cols → amt=5
        // QB default GL (no columns param): 0:date,1:type,2:doc,3:name,4:memo,5:split,6:amount,7:balance
        // With klass param (8 cols): 0:date,1:type,2:doc,3:name,4:klass,5:memo,6:amount,7:balance
        const hasKlass = cols.length >= 8 && cols[4]?.value !== undefined && 
                         !['Journal Entry','Invoice','Bill','Check','Expense'].includes(cols[4]?.value);
        const cls = hasKlass ? (cols[4]?.value || '') : '';
        const amt = parseFloat(cols[6]?.value || '0') || 0; // amount always at index 6
        if (amt !== 0) {
          if (cls) result[cls] = (result[cls] || 0) + amt;
        }
      }
      if (row.Rows?.Row) walk(row.Rows.Row);
    }
  }
  if (report?.Rows?.Row) walk(report.Rows.Row);
  return result;
}

// ── Parse QB P&L report (simple) → { accountNum: amount } ────────────────────
function budgetParseQBReport(report) {
  const result = {};
  function walk(rows) {
    if (!rows) return;
    for (const row of rows) {
      if (row.type === 'Data' && row.ColData) {
        const name = row.ColData[0]?.value || '';
        const amount = parseFloat(row.ColData[1]?.value || '0') || 0;
        const m = name.match(/^(\d{4,6})\s/);
        if (m && amount !== 0) result[parseInt(m[1])] = amount;
      }
      if (row.Rows?.Row) walk(row.Rows.Row);
    }
  }
  if (report?.Rows?.Row) walk(report.Rows.Row);
  return result;
}

// ── Get actuals for current entity + line key (optionally filtered by dept/class) ─
function budgetGetActualForKey(key, dept) {
  if (!budgetQBActuals) return null;
  const mapping = budgetMapping.find(m => m.key === key);
  if (!mapping) return 0;
  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];
  
  // Determine current month for reading actuals
  const mode = document.getElementById('budget-mode-sel')?.value || 'month';
  const currentMonth = mode === 'month' ? parseInt(document.getElementById('budget-m')?.value || 0) : null;
  
  let total = 0;
  for (const entity of entities) {
    // Get actuals for current entity (with month support)
    const entityActuals = mode === 'month' && budgetQBActuals[entity]?.[currentMonth] 
      ? budgetQBActuals[entity][currentMonth] 
      : budgetQBActuals[entity] || {};
    
    // Get class data for current month
    const entityClassData = mode === 'month' && budgetQBActualsByClass[entity]?.[currentMonth]
      ? budgetQBActualsByClass[entity][currentMonth]
      : budgetQBActualsByClass[entity] || {};
    
    for (const acct of mapping.accounts) {
      const classData = entityClassData[acct];
      if (dept) {
        if (dept === 'Not specified') {
          // Sum amounts where class is empty/missing
          if (classData !== undefined) {
            const classified = Object.values(classData).reduce((s,v)=>s+v,0);
            const acctTotal = entityActuals[acct] || 0;
            total += Math.max(0, acctTotal - classified);
          }
        } else if (classData !== undefined) {
          // Class data exists — use only matching dept, 0 if not present
          total += classData[dept] || 0;
        } else {
          // No class data fetched — fall back to ratio
          const acctTotal = entityActuals[acct] || 0;
          const deptAnn = ACTUALS[dept]?.[key] || 0;
          const allAnn  = BUDGET_DEPTS.reduce((s,dd) => s + (ACTUALS[dd]?.[key] || 0), 0);
          const ratio   = allAnn > 0 ? deptAnn / allAnn : 0;
          total += acctTotal * ratio;
        }
      } else {
        total += entityActuals[acct] || 0;
      }
    }
  }
  return total;
}

// Helper: Get actual for specific month
function budgetGetActualForMonth(key, month, dept) {
  if (!budgetQBActuals) return 0;
  const mapping = budgetMapping.find(m => m.key === key);
  if (!mapping) return 0;
  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];
  
  let total = 0;
  for (const entity of entities) {
    const entityActuals = budgetQBActuals[entity]?.[month] || {};
    const entityClassData = budgetQBActualsByClass[entity]?.[month] || {};
    
    for (const acct of mapping.accounts) {
      const classData = entityClassData[acct];
      if (dept) {
        if (dept === 'Not specified') {
          if (classData !== undefined) {
            const classified = Object.values(classData).reduce((s,v)=>s+v,0);
            const acctTotal = entityActuals[acct] || 0;
            total += Math.max(0, acctTotal - classified);
          }
        } else if (classData !== undefined) {
          total += classData[dept] || 0;
        } else {
          const acctTotal = entityActuals[acct] || 0;
          const deptAnn = ACTUALS[dept]?.[key] || 0;
          const allAnn  = BUDGET_DEPTS.reduce((s,dd) => s + (ACTUALS[dd]?.[key] || 0), 0);
          const ratio   = allAnn > 0 ? deptAnn / allAnn : 0;
          total += acctTotal * ratio;
        }
      } else {
        total += entityActuals[acct] || 0;
      }
    }
  }
  return total;
}

// ── Get YTD actuals for key ─────────────────────────────────────────────────
function budgetGetActualForKeyYTD(key, dept) {
  const mapping = budgetMapping.find(m => m.key === key);
  if (!mapping) return 0;
  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];
  const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
  
  let total = 0;
  
  // First try: use dedicated YTD fetch data if available AND matches current month
  if (budgetQBActualsYTD && window._budgetYTDMonth === currentMonth) {
    for (const entity of entities) {
      for (const acct of mapping.accounts) {
        const classData = budgetQBActualsByClassYTD?.[entity]?.[acct];
        if (dept) {
          if (dept === 'Not specified') {
            if (classData !== undefined) {
              const classified = Object.values(classData).reduce((s,v)=>s+v,0);
              const acctTotal = (budgetQBActualsYTD[entity] || {})[acct] || 0;
              total += Math.max(0, acctTotal - classified);
            }
          } else if (classData !== undefined) {
            total += classData[dept] || 0;
          } else {
            const acctTotal = (budgetQBActualsYTD[entity] || {})[acct] || 0;
            const deptAnn = ACTUALS[dept]?.[key] || 0;
            const allAnn  = BUDGET_DEPTS.reduce((s,dd) => s + (ACTUALS[dd]?.[key] || 0), 0);
            const ratio   = allAnn > 0 ? deptAnn / allAnn : 0;
            total += acctTotal * ratio;
          }
        } else {
          total += (budgetQBActualsYTD[entity] || {})[acct] || 0;
        }
      }
    }
    return total;
  }
  
  // Fallback: sum individual months (Jan to currentMonth)
  if (budgetQBActuals) {
    for (let m = 0; m <= currentMonth; m++) {
      for (const entity of entities) {
        const monthActuals = budgetQBActuals[entity]?.[m];
        const monthClassData = budgetQBActualsByClass[entity]?.[m] || {};
        if (!monthActuals) continue;
        
        for (const acct of mapping.accounts) {
          const classData = monthClassData[acct];
          
          if (dept) {
            if (dept === 'Not specified') {
              // Sum amounts where class is empty/missing
              if (classData !== undefined) {
                const classified = Object.values(classData).reduce((s,v)=>s+v,0);
                const acctTotal = monthActuals[acct] || 0;
                total += Math.max(0, acctTotal - classified);
              }
            } else if (classData !== undefined) {
              // Class data exists — use only matching dept
              total += classData[dept] || 0;
            } else {
              // No class data — use ratio fallback
              const acctTotal = monthActuals[acct] || 0;
              const deptAnn = ACTUALS[dept]?.[key] || 0;
              const allAnn  = BUDGET_DEPTS.reduce((s,dd) => s + (ACTUALS[dd]?.[key] || 0), 0);
              const ratio   = allAnn > 0 ? deptAnn / allAnn : 0;
              total += acctTotal * ratio;
            }
          } else {
            // No dept filter — just sum the account
            total += monthActuals[acct] || 0;
          }
        }
      }
    }
  }
  
  return total;
}

// ── Get actuals for dept (monthly) — fallback to BUDGET_MONTHLY ──────────────
function budget_periodActual(d, ns) {
  const [f,t] = budget_getRange(ns);
  if (budgetQBActuals) {
    let total = 0;
    for (const row of budgetMapping) {
      const val = budgetGetActualForKey(row.key, d);
      if (val !== null) total += val;
    }
    return total;
  }
  // Fallback: BUDGET_MONTHLY
  let s = 0;
  for (let i = f; i <= t; i++) s += BUDGET_MONTHLY[d]?.[BUDGET_MONTHS[i]] || 0;
  return s;
}

// ── BUDGET FROM TEAM ──────────────────────────────────────────────────────────
function budget_getTeamBudget() {
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
  const monthIndex = currentMonth + 1; // Convert 0-based to 1-based (Jan=1, Feb=2, etc)
  
  const b = {};
  
  // Initialize with imported budget if available
  if (window.IMPORTED_BUDGET && window.IMPORTED_BUDGET[yr]) {
    // Use imported budget from Excel
    BUDGET_DEPTS.forEach(d => {
      if (window.IMPORTED_BUDGET[yr][d] && window.IMPORTED_BUDGET[yr][d][monthIndex]) {
        // Get budget for specific month
        b[d] = {...window.IMPORTED_BUDGET[yr][d][monthIndex]};
      } else {
        b[d] = {}; // Empty if not imported yet for this month
      }
    });
  } else {
    // Fallback to static budget (old hardcoded values)
    BUDGET_DEPTS.forEach(d => b[d] = {...STATIC_BUDGET[d]});
  }
  
  return b;
}
function budget_deptTotalBudget(budget, d) { return Object.values(budget[d]).reduce((s,v)=>s+v,0); }

// ── PERIOD ────────────────────────────────────────────────────────────────────
function budget_getRange(ns) { const p=BUDGET_P; if(p.mode==='ytd')return[0,11]; if(p.mode==='month')return[p.m,p.m]; return[p.from,p.to]; }
function budget_getPLabel(ns) {
  const p=BUDGET_P;
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  if(p.mode==='ytd') return 'YTD '+yr;
  if(p.mode==='month') return BUDGET_MONTHS[p.m]+' '+yr;
  return BUDGET_MONTHS[p.from]+'–'+BUDGET_MONTHS[p.to]+' '+yr;
}
function budget_periodScale(annual, ns) { const [f,t]=budget_getRange(ns); return annual*(t-f+1)/12; }
// budget_periodActual is defined later with QB support

// ── PERIOD HELPERS (unified) ──────────────────────────────────────────────────
// Both 'ov' and 'dp' namespaces now share the same BUDGET_P
function budgetSetPeriod(mode, btn, ns) {
  // Legacy call from any remaining buttons — update unified state
  BUDGET_P.mode = mode;
  document.getElementById('budget-mode-sel').value = mode;
  document.getElementById('budget-picker-month').style.display = mode==='month'?'flex':'none';
  document.getElementById('budget-picker-range').style.display = mode==='range'?'flex':'none';
  budgetRerender();
}
function budgetApplyPeriod(ns) {
  BUDGET_P.m    = parseInt(document.getElementById('budget-m')?.value||0);
  BUDGET_P.from = parseInt(document.getElementById('budget-from')?.value||0);
  BUDGET_P.to   = parseInt(document.getElementById('budget-to')?.value||11);
  budgetRerender();
}

// ── UTILS ─────────────────────────────────────────────────────────────────────
function budgetFmt(n){if(!n&&n!==0||n===0)return'—';const a=Math.abs(n);if(a>=1000000)return'$'+(n/1000000).toFixed(1)+'M';if(a>=1000)return'$'+Math.round(n/1000)+'K';return'$'+Math.round(n).toLocaleString()}
function fmtF(n){
  if(!n||n===0)return'—';
  const a=Math.abs(n);
  if(a>=1000000)return'$'+(n/1000000).toFixed(1)+'M';
  if(a>=1000)return'$'+Math.round(n/1000)+'K';
  if(a<10)return'$'+n.toFixed(3); // Show 3 decimals for small values
  return'$'+Math.round(n).toLocaleString();
}
function budget_vc(b,a){if(b===0&&a===0)return'zero';if(b===0&&a>0)return'over';const p=(a-b)/b;return p>0.15?'over':p>0.05?'warn':'under'}
function budget_vl(b,a){if(b===0&&a===0)return'—';if(b===0)return'+'+budgetFmt(a);const p=(a-b)/b*100;return(p>=0?'+':'')+p.toFixed(1)+'%'}
function budget_bc(pct){return pct>110?'red':pct>92?'orange':'green'}

// ── Get allowed departments based on user permissions ─────────────────────────
function budgetGetAllowedDepts() {
  // If user has department restrictions, return only those
  if (window.BUDGET_RESTRICTED_DEPTS && window.BUDGET_RESTRICTED_DEPTS.length > 0) {
    return window.BUDGET_RESTRICTED_DEPTS;
  }
  // Otherwise return all departments
  return BUDGET_DEPTS;
}

// ── OVERVIEW ──────────────────────────────────────────────────────────────────
async function budgetRenderOverview(){
  const budget=budget_getTeamBudget();
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const ent = document.getElementById('budget-entity-sel')?.value || 'All';
  const entLbl = ent === 'All' ? 'All Entities' : ent;
  const mode = document.getElementById('budget-mode-sel')?.value || 'month';
  const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
  
  // Get allowed departments (filtered by permissions if restricted user)
  const allowedDepts = budgetGetAllowedDepts();
  
  document.getElementById('page-sub').textContent=`${entLbl} · ${yr}`;
  if(document.getElementById('budget-page-title')) document.getElementById('budget-page-title').textContent=`${yr} Budget`;
  
  // Fetch YTD actuals if in Month mode and we have Month actuals
  if (mode === 'month' && budgetQBActuals && currentMonth > 0) {
    if (!budgetQBActualsYTD || !window._lastYTDFetch || window._lastYTDFetch !== `${yr}-${currentMonth}`) {
      // Only fetch if we haven't fetched for this year-month combo yet
      console.log('[Budget Overview] Auto-fetching YTD actuals...');
      await budgetFetchActualsYTD();
      window._lastYTDFetch = `${yr}-${currentMonth}`;
    }
  }
  
  // Month label (Feb, Mar, etc)
  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const monthLabel = monthNames[currentMonth];
  
  // Update table header with 2-level headers + divider
  const table = document.querySelector('#ov-tbody').closest('table');
  const thead = table.querySelector('thead');
  thead.innerHTML = `
    <tr>
      <th rowspan="2" style="width:40px"></th>
      <th rowspan="2" style="text-align:left">Line Item</th>
      <th colspan="3" style="text-align:center;border-bottom:1px solid var(--border)">${monthLabel}</th>
      <th rowspan="2" style="width:1px;padding:0;background:var(--border)"></th>
      <th colspan="3" style="text-align:center;border-bottom:1px solid var(--border)">${monthLabel} YTD</th>
      <th rowspan="2" style="width:1px;padding:0;background:var(--border)"></th>
      <th colspan="3" style="text-align:center;border-bottom:1px solid var(--border)">2026</th>
    </tr>
    <tr>
      <th class="num" style="font-weight:500;color:var(--muted)">Budget</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Actual</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Var</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Budget</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Actual</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Var</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Budget</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Actual</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Var</th>
    </tr>`;
  
  let html='', lastCat='';
  
  // ═══════════════════════════════════════════════════════════════════════════
  // REVENUE LINE (always first, before all expense categories)
  // ═══════════════════════════════════════════════════════════════════════════
  // Only show Actual (from GL account 40110 - Core Product Revenue - Opco only)
  // Budget is always empty for revenue
  
  let revenueMonth = 0, revenueYTD = 0;
  
  // Get revenue from Opco GL account 40110 (with month support)
  const opcoActuals = mode === 'month' && budgetQBActuals?.['Opco']?.[currentMonth]
    ? budgetQBActuals['Opco'][currentMonth]
    : budgetQBActuals?.['Opco'] || {};
  
  if (opcoActuals['40110']) {
    revenueMonth = Math.abs(opcoActuals['40110']); // Revenue is negative in QB, make positive
  }
  
  // YTD Revenue - sum all months from Jan (0) to currentMonth
  if (mode === 'month' && budgetQBActuals?.['Opco']) {
    // Sum individual months (Jan to currentMonth)
    for (let m = 0; m <= currentMonth; m++) {
      const monthData = budgetQBActuals['Opco'][m];
      if (monthData && monthData['40110']) {
        revenueYTD += Math.abs(monthData['40110']);
      }
    }
  } else if (currentMonth === 0) {
    revenueYTD = revenueMonth;
  } else {
    revenueYTD = revenueMonth * (currentMonth + 1);
  }
  
  // Render Revenue row
  html += `<tr class="cat-row" style="background:#e6f9f4;border-top:2px solid #06D6A0">
    <td class="cat-label" colspan="13" style="color:#04a776;font-weight:600">
      Revenue
    </td>
  </tr>`;
  
  const revMonthVal = revenueMonth > 0 ? fmtF(revenueMonth) : '—';
  const revYTDVal = revenueYTD > 0 ? fmtF(revenueYTD) : '—';
  
  // Full Year Revenue (sum all 12 months)
  let revenueFullYear = 0;
  if (budgetQBActuals?.['Opco']) {
    for (let m = 0; m <= 11; m++) {
      const monthData = budgetQBActuals['Opco'][m];
      if (monthData && monthData['40110']) {
        revenueFullYear += Math.abs(monthData['40110']);
      }
    }
  }
  const revFullYearVal = revenueFullYear > 0 ? fmtF(revenueFullYear) : '—';
  
  html += `<tr style="background:#f0fdf7">
    <td></td>
    <td class="label indent">Core Product Revenue</td>
    <td class="num" style="color:var(--muted2)">—</td>
    <td class="num" style="color:#04a776;font-weight:500">${revMonthVal}</td>
    <td class="num">—</td>
    <td style="width:1px;padding:0;background:var(--border)"></td>
    <td class="num" style="color:var(--muted2)">—</td>
    <td class="num" style="color:#04a776;font-weight:500;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;text-decoration-color:#06D6A0" onclick="budgetShowRevenueTrend()">${revYTDVal}</td>
    <td class="num">—</td>
    <td style="width:1px;padding:0;background:var(--border)"></td>
    <td class="num" style="color:var(--muted2)">—</td>
    <td class="num" style="color:#04a776;font-weight:500">${revFullYearVal}</td>
    <td class="num">—</td>
  </tr>`;
  
  // ═══════════════════════════════════════════════════════════════════════════
  // EXPENSE CATEGORIES (existing code continues below)
  // ═══════════════════════════════════════════════════════════════════════════
  
  CAT_LINES.forEach(row=>{
    // Month Budget (current period only)
    let bMonth=0;
    allowedDepts.forEach(d=>{bMonth+=budget_periodScale(budget[d][row.key]||0,'ov');});
    
    // Month Actual (current period only - uses current mode selector)
    const _qbActMonth=budgetGetActualForKey(row.key); 
    const aMonth= _qbActMonth!==null ? _qbActMonth : allowedDepts.reduce((s,d)=>s+budget_periodScale(ACTUALS[d][row.key]||0,'ov'),0);
    
    // YTD Budget (sum of all months Jan to currentMonth, assuming monthly = annual/12)
    let bYTD = 0;
    allowedDepts.forEach(d=>{
      const annualBudget = budget[d][row.key] || 0;
      bYTD += (annualBudget / 12) * (currentMonth + 1);
    });
    
    // YTD Actual - Sum all months from 0 to currentMonth
    let aYTD = 0;
    if (mode === 'month' && budgetQBActuals) {
      // Sum Jan (0) through current month
      for (let m = 0; m <= currentMonth; m++) {
        const monthActual = budgetGetActualForMonth(row.key, m);
        if (monthActual > 0) {
          console.log(`[YTD] ${row.line} month ${m}: ${monthActual}`);
        }
        aYTD += monthActual;
      }
      if (aYTD > 0) console.log(`[YTD] ${row.line} TOTAL: ${aYTD}`);
    } else if (currentMonth === 0) {
      aYTD = aMonth;
    } else {
      aYTD = aMonth * (currentMonth + 1);
    }
    
    // Category header
    if(row.cat!==lastCat){html+=`<tr class="cat-row"><td class="cat-label" colspan="13">${row.cat}</td></tr>`;lastCat=row.cat;}
    
    // Month variance
    const vMonth=budget_vc(bMonth,aMonth), vlabMonth=budget_vl(bMonth,aMonth);
    const bvalMonth=bMonth>0?`<span class="budget-link" onclick="budgetOpenDrill('${row.line}','${row.key}',event)">${fmtF(bMonth)}</span>`:'—';
    const avalMonth=aMonth>0?`<span class="budget-link" style="color:var(--text)" onclick="budgetActualClick('${row.key}',event)">${fmtF(aMonth)}</span>`:'—';
    
    // YTD variance  
    const vYTD=budget_vc(bYTD,aYTD), vlabYTD=budget_vl(bYTD,aYTD);
    const bvalYTD=bYTD>0?fmtF(bYTD):'—';
    const avalYTD=aYTD>0?`<span class="budget-link" style="color:var(--text)" onclick="budgetActualClickYTD('${row.key}',event)">${fmtF(aYTD)}</span>`:'—';
    
    // Full Year 2026 Budget (annual total)
    let bFullYearOv = 0;
    allowedDepts.forEach(d=>{
      bFullYearOv += budget[d][row.key] || 0;
    });
    
    // Full Year 2026 Actual = YTD Actual (what we have so far)
    const aFullYearOv = aYTD;
    
    // Full Year variance
    const vFullYearOv=budget_vc(bFullYearOv,aFullYearOv), vlabFullYearOv=budget_vl(bFullYearOv,aFullYearOv);
    const bvalFullYearOv=bFullYearOv>0?fmtF(bFullYearOv):'—';
    const avalFullYearOv=aFullYearOv>0?fmtF(aFullYearOv):'—';
    
    // DEBUG
    if (row.line === 'Salaries & Wages') {
      console.log('[2026 Col]', {bFullYearOv, aFullYearOv, bvalFullYearOv, avalFullYearOv});
    }
    
    html+=`<tr>
      <td></td>
      <td class="label indent">${row.line}</td>
      <td class="num">${bvalMonth}</td>
      <td class="num">${avalMonth}</td>
      <td class="num"><span class="chip ${vMonth}">${vlabMonth}</span></td>
      <td style="width:1px;padding:0;background:var(--border)"></td>
      <td class="num">${bvalYTD}</td>
      <td class="num">${avalYTD}</td>
      <td class="num"><span class="chip ${vYTD}">${vlabYTD}</span></td>
      <td style="width:1px;padding:0;background:var(--border)"></td>
      <td class="num">${bvalFullYearOv}</td>
      <td class="num">${avalFullYearOv}</td>
      <td class="num"><span class="chip ${vFullYearOv}">${vlabFullYearOv}</span></td>
    </tr>`;
  });
  document.getElementById('ov-tbody').innerHTML=html;
}

// ── DRILL MODAL ───────────────────────────────────────────────────────────────
function budgetOpenDrill(line, key, e, dept){
  e&&e.stopPropagation();
  const budget=budget_getTeamBudget(), lbl=budget_getPLabel('ov');
  document.getElementById('drill-title').textContent=line;
  document.getElementById('drill-sub').textContent=`Budget breakdown by department · ${lbl}`;
  let total=0;
  const depts = dept ? [dept] : BUDGET_DEPTS;
  const rows=depts.map(d=>{const v=budget_periodScale(budget[d][key]||0,'ov');total+=v;return{d,v};}).filter(r=>r.v>0).sort((a,b)=>b.v-a.v);
  document.getElementById('drill-tbody').innerHTML=rows.map(r=>{
    const pct=(total>0?r.v/total*100:0), fw=Math.min(pct,100);
    return`<tr><td class="label">${r.d}</td><td class="num">${fmtF(r.v)}</td><td class="num"><div class="prog-cell"><div class="prog-bar" style="width:80px"><div class="prog-fill" style="width:${fw}%;background:var(--accent)"></div></div><span class="prog-pct">${pct.toFixed(1)}%</span></div></td></tr>`;
  }).join('')||'<tr><td colspan="3" style="text-align:center;padding:20px;color:var(--muted)">No budget allocated</td></tr>';
  document.getElementById('drill-total').textContent=fmtF(total);
  document.getElementById('drill-modal').classList.add('open');
}
function budgetCloseDrill(){document.getElementById('drill-modal').classList.remove('open');}

// ── ACTUAL DRILL MODAL ────────────────────────────────────────────────────────
// State for expanded GL rows
const _adrill_expanded = {};

async function budgetActualClick(key, event, dept) {
  if(event) event.stopPropagation();
  const lineName = CAT_LINES.find(r => r.key === key)?.line || key;
  if(!budgetQBActuals) {
    alert('Fetch Actuals from QB first (↺ button above)');
    return;
  }
  // Read period from DOM
  const mode = document.getElementById('budget-mode-sel')?.value || 'ytd';
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  let startDate, endDate;
  if (mode === 'ytd') {
    startDate = `${yr}-01-01`; endDate = `${yr}-12-31`;
  } else if (mode === 'month') {
    const m = parseInt(document.getElementById('budget-m')?.value || 0);
    const mm = String(m+1).padStart(2,'0');
    startDate = `${yr}-${mm}-01`;
    endDate   = `${yr}-${mm}-${new Date(parseInt(yr), m+1, 0).getDate()}`;
  } else {
    const f = parseInt(document.getElementById('budget-from')?.value || 0);
    const t = parseInt(document.getElementById('budget-to')?.value || 11);
    startDate = `${yr}-${String(f+1).padStart(2,'0')}-01`;
    endDate   = `${yr}-${String(t+1).padStart(2,'0')}-${new Date(parseInt(yr), t+1, 0).getDate()}`;
  }
  // Clear cache for this line's accounts
  const mapping = budgetMapping.find(m => m.key === key);
  if (!mapping) return;
  if(window._pnlGLCache) {
    mapping.accounts.forEach(acct => {
      Object.keys(_pnlGLCache).forEach(k => { if(k.includes(String(acct))) delete _pnlGLCache[k]; });
    });
  }
  if (window.qbLoadTokens) qbLoadTokens();

  const acctIdMap = _budgetAcctIdMap?.[budgetEntity === 'All' ? 'Opco' : budgetEntity] || {};
  const realmId = QB_REALM_IDS[budgetEntity === 'All' ? 'Opco' : budgetEntity];
  const sel = document.getElementById('pnl-entity');
  if(sel) sel.value = budgetEntity === 'All' ? 'Opco' : budgetEntity;

  const modal = document.getElementById('pnl-gl-modal');
  const body  = document.getElementById('pnl-gl-modal-body');
  const badge = document.getElementById('pnl-gl-modal-badge');
  const title = document.getElementById('pnl-gl-modal-title');
  const tot   = document.getElementById('pnl-gl-modal-total');
  if(!modal) return;

  badge.textContent = mapping.accounts.join(', ');
  title.textContent = `${lineName} · ${startDate.slice(0,7)}${startDate.slice(0,7)!==endDate.slice(0,7)?` → ${endDate.slice(0,7)}` : ''}`;
  tot.textContent = '⧐ loading…';
  tot.style.color = 'var(--muted)';
  body.innerHTML = `<div style="padding:32px;text-align:center;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">⧐ fetching from QuickBooks…</div>`;
  modal.style.display = 'block';

  const token = getBudgetToken();
  let allData = { Rows: { Row: [] } };
  const entity = budgetEntity === 'All' ? 'Opco' : budgetEntity;

  // Zagreus: use Excel GL data which has class column (QB API doesn't expose it)
  if (entity === 'Zagreus' && dept && ZAGREUS_GL_2026) {
    const toExcelDate = d => { const [y,m,day] = d.split('-'); return `${m}/${day}/${y}`; };
    const eStart = toExcelDate(startDate), eEnd = toExcelDate(endDate);
    for (const acct of mapping.accounts) {
      const acctRows = ZAGREUS_GL_2026[String(acct)]?.[dept] || [];
      const filtered = acctRows.filter(r => r.date >= eStart && r.date <= eEnd);
      const converted = filtered.map(r => ({ type: 'Data', ColData: [
        { value: r.date },
        { value: r.type },
        { value: r.num },
        { value: r.name },
        { value: dept },
        { value: r.memo },
        { value: String(r.amount) },
        { value: '0' },
      ]}));
      allData.Rows.Row = allData.Rows.Row.concat(converted);
    }
  } else {
    for (const acct of mapping.accounts) {
      const acctId = acctIdMap[String(acct)] || String(acct);
      const cacheKey = `${acctId}::${startDate}::${endDate}::klass`;
      let data;
      if (_pnlGLCache[cacheKey]) {
        data = _pnlGLCache[cacheKey].data;
      } else {
        try {
          const path = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${startDate}&end_date=${endDate}&account=${acctId}&columns=tx_date,txn_type,doc_num,name,klass_name,memo,subt_nat_amount,rbal_nat_amount&accounting_method=Accrual&minorversion=65`;
          const url = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
          const r = await fetch(url, { headers: { 'X-Auth-Token': token } });
          if (!r.ok) continue;
          data = await r.json();
          _pnlGLCache[cacheKey] = { data };
        } catch(e) { continue; }
      }
      allData.Rows.Row = allData.Rows.Row.concat(data?.Rows?.Row || []);
    }
  }

  pnlGLRender(body, tot, allData, lineName, mapping.accounts.join(','), dept || null, true);
}
// ── YTD ACTUAL DRILL (Jan to current month) ──────────────────────────────────
async function budgetActualClickYTD(key, event, dept) {
  if(event) event.stopPropagation();
  const lineName = CAT_LINES.find(r => r.key === key)?.line || key;
  if(!budgetQBActuals) {
    alert('Fetch Actuals from QB first (↺ button above)');
    return;
  }
  // YTD range: Jan 1st to last day of current month
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
  const mm = String(currentMonth+1).padStart(2,'0');
  const startDate = `${yr}-01-01`;
  const endDate = `${yr}-${mm}-${new Date(parseInt(yr), currentMonth+1, 0).getDate()}`;
  
  // Clear cache for this line's accounts
  const mapping = budgetMapping.find(m => m.key === key);
  if (!mapping) return;
  if(window._pnlGLCache) {
    mapping.accounts.forEach(acct => {
      Object.keys(_pnlGLCache).forEach(k => { if(k.includes(String(acct))) delete _pnlGLCache[k]; });
    });
  }
  
  if (window.qbLoadTokens) qbLoadTokens();
  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];

  const modal = document.getElementById('pnl-gl-modal');
  const body  = document.getElementById('pnl-gl-modal-body');
  const badge = document.getElementById('pnl-gl-modal-badge');
  const title = document.getElementById('pnl-gl-modal-title');
  const tot   = document.getElementById('pnl-gl-modal-total');
  if(!modal) return;

  badge.textContent = mapping.accounts.join(', ');
  title.textContent = `${lineName} · YTD ${startDate.slice(0,7)} → ${endDate.slice(0,7)}`;
  tot.textContent = '⧐ loading…';
  tot.style.color = 'var(--muted)';
  body.innerHTML = `<div style="padding:32px;text-align:center;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">⧐ fetching YTD from QuickBooks…</div>`;
  modal.style.display = 'block';

  let allData = { Rows: { Row: [] } };
  for (const entity of entities) {
    const realmId = QB_REALM_IDS[entity];
    if (!realmId) continue;

    // Zagreus: use Excel GL data (Jan to current month, filtered by dept)
    if (entity === 'Zagreus' && dept && ZAGREUS_GL_2026) {
      const toExcelDate = d => { const [y,m,day] = d.split('-'); return `${m}/${day}/${y}`; };
      const eStart = toExcelDate(startDate), eEnd = toExcelDate(endDate);
      for (const acct of mapping.accounts) {
        const acctRows = ZAGREUS_GL_2026[String(acct)]?.[dept] || [];
        const filtered = acctRows.filter(r => r.date >= eStart && r.date <= eEnd);
        const converted = filtered.map(r => ({ type: 'Data', ColData: [
          { value: r.date },
          { value: r.type },
          { value: r.num },
          { value: r.name },
          { value: dept },
          { value: r.memo },
          { value: String(r.amount) },
          { value: '0' },
        ]}));
        allData.Rows.Row = allData.Rows.Row.concat(converted);
      }
      continue;
    }

    const acctIdMap = _budgetAcctIdMap?.[entity] || {};
    try {
      const accessToken = await qbEnsureToken(realmId);
      for (const acct of mapping.accounts) {
        // Look up QB internal account Id by AcctNum
        let acctId = acctIdMap?.[String(acct)];
        if (!acctId) {
          try {
            const qPath = `/v3/company/${realmId}/query?query=select * from Account MAXRESULTS 1000&minorversion=65`;
            const qr = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(qPath)}&realmId=${realmId}`, {
              credentials: 'include', headers: { 'Authorization': `Bearer ${accessToken}` }
            });
            if (qr.ok) {
              const qd = await qr.json();
              if (!window._budgetAcctIdMap) window._budgetAcctIdMap = {};
              if (!window._budgetAcctIdMap[entity]) window._budgetAcctIdMap[entity] = {};
              (qd?.QueryResponse?.Account || []).forEach(a => {
                if (a.AcctNum) window._budgetAcctIdMap[entity][a.AcctNum] = a.Id;
              });
              acctId = window._budgetAcctIdMap[entity][String(acct)];
            }
          } catch(e) {}
        }
        if (!acctId) continue;
        const cacheKey = `${entity}::${acctId}::${startDate}::${endDate}`;
        let data;
        if (_pnlGLCache[cacheKey]) {
          data = _pnlGLCache[cacheKey].data;
        } else {
          try {
            const path = `/v3/company/${realmId}/reports/GeneralLedger?start_date=${startDate}&end_date=${endDate}&account=${acctId}&columns=tx_date,txn_type,doc_num,name,klass_name,memo,subt_nat_amount,rbal_nat_amount&accounting_method=Accrual&minorversion=65`;
            const r = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`, {
              credentials: 'include', headers: { 'Authorization': `Bearer ${accessToken}` }
            });
            if (!r.ok) continue;
            data = await r.json();
            _pnlGLCache[cacheKey] = { data };
          } catch(e) { continue; }
        }
        allData.Rows.Row = allData.Rows.Row.concat(data?.Rows?.Row || []);
      }
    } catch(e) { console.warn('GL YTD fetch failed for', entity, e); }
  }

  pnlGLRender(body, tot, allData, lineName, mapping.accounts.join(','), dept || null, true);
}

function budgetOpenActualDrill(){}
function _budgetRenderActualDrillTable(){}
function budgetCloseActualDrill(){}
function budgetOpenGL(){}
async function budgetToggleGL(){}
function _budgetParseTransactionList(){ return []; }

function budgetRenderDeptPills(id){
  // Use restricted depts if user has restrictions
  const depts = window.BUDGET_RESTRICTED_DEPTS || BUDGET_DEPTS;
  const isRestricted = !!window.BUDGET_RESTRICTED_DEPTS;
  const isBudgetAdmin = document.body.classList.contains('budget-admin-view');
  const isFullAdmin = !isRestricted && !isBudgetAdmin;
  
  const pills = depts.map(d => {
    const isActive = d === activeDept;
    const canDelete = isFullAdmin && BUDGET_DEPTS.length > 1; // only full admin can delete
    return `<div style="display:inline-flex;align-items:center;gap:0;margin:2px">
      <div class="dept-pill${isActive?' active':''}" onclick="budgetSelectDept('${d}')" style="${canDelete ? 'border-radius:20px 0 0 20px;border-right:none;padding-right:6px' : 'border-radius:20px'}">${deptDisplayName(d)}</div>
      ${canDelete ? `<button class="dept-pill-close" onclick="budgetDeleteDept('${d}',event)" title="Delete department" style="font-family:var(--mono);font-size:.6rem;padding:4px 6px;border-radius:0 20px 20px 0;border:1px solid var(--border);background:var(--surface);color:var(--muted);cursor:pointer;line-height:1;transition:all .15s" onmouseenter="this.style.color='var(--red)';this.style.borderColor='var(--red)'" onmouseleave="this.style.color='var(--muted)';this.style.borderColor='var(--border)'">✕</button>` : ''}
    </div>`;
  }).join('');
  
  document.getElementById(id).innerHTML = pills +
    (isFullAdmin ? `<button onclick="budgetAddDeptPrompt()" style="font-family:var(--mono);font-size:.68rem;padding:4px 12px;border-radius:20px;border:1px dashed var(--border2);background:none;color:var(--muted);cursor:pointer;margin:2px" onmouseenter="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'" onmouseleave="this.style.color='var(--muted)';this.style.borderColor='var(--border2)'">+ New Department</button>` : '') +
    (budgetQBActuals && isFullAdmin ? `<div class="dept-pill${activeDept==='Not specified'?' active':''}" onclick="budgetSelectDept('Not specified')" style="margin:2px;border-color:var(--orange);color:${activeDept==='Not specified'?'var(--text)':'var(--orange)'}">⚠ Not specified</div>` : '');
}
function budgetSelectDept(d){activeDept=d;budgetRenderDeptPills('dept-pills');budgetRenderDeptDetail();}
function budgetGoDept(d){activeDept=d;budgetShowTab('departments');}

// Department dropdown functions
function budgetPopulateDeptDropdown() {
  const sel = document.getElementById('budget-dept-sel');
  if (!sel) return;
  
  const depts = window.BUDGET_RESTRICTED_DEPTS || BUDGET_DEPTS;
  const isRestricted = !!window.BUDGET_RESTRICTED_DEPTS;
  const isBudgetAdmin = document.body.classList.contains('budget-admin-view');
  const isFullAdmin = !isRestricted && !isBudgetAdmin;
  
  // Admin: All + departments | Restricted: just their department(s)
  let options = '';
  if (isFullAdmin || isBudgetAdmin) {
    options += '<option value="All">All Departments</option>';
  }
  depts.forEach(d => {
    options += `<option value="${d}">${deptDisplayName(d)}</option>`;
  });
  
  sel.innerHTML = options;
  
  // Set current selection
  if (activeDept && depts.includes(activeDept)) {
    sel.value = activeDept;
  } else if (!isRestricted) {
    sel.value = 'All';
  } else {
    sel.value = depts[0];
    activeDept = depts[0];
  }
}

function budgetDeptChange() {
  const sel = document.getElementById('budget-dept-sel');
  if (!sel) return;
  const val = sel.value;
  
  if (val === 'All') {
    // When All Departments: render combined view for all departments
    // Pills stay hidden - dropdown is the only control now
    budgetRenderDeptDetail(); // Could render a combined/summary view
  } else {
    activeDept = val;
    budgetRenderDeptDetail();
  }
}

function budgetAddDeptPrompt() {
  const name = prompt('New department name:');
  if (!name || !name.trim()) return;
  const trimmed = name.trim();
  if (BUDGET_DEPTS.includes(trimmed)) { alert('Department already exists.'); return; }
  BUDGET_DEPTS.push(trimmed);
  STATIC_BUDGET[trimmed] = {};
  ACTUALS[trimmed] = {};
  CAT_LINES.forEach(r => { STATIC_BUDGET[trimmed][r.key] = 0; ACTUALS[trimmed][r.key] = 0; });
  activeDept = trimmed;
  budgetRenderDeptPills('dept-pills');
  budgetRenderDeptDetail();
}

function budgetDeleteDept(d, event) {
  event.stopPropagation();
  if (!confirm(`Delete department "${d}"? This removes it from all budget views.`)) return;
  const idx = BUDGET_DEPTS.indexOf(d);
  if (idx === -1) return;
  BUDGET_DEPTS.splice(idx, 1);
  if (activeDept === d) activeDept = BUDGET_DEPTS[0] || '';
  budgetRenderDeptPills('dept-pills');
  budgetRenderDeptDetail();
}
async function budgetRenderDeptDetail(){
  const budget=budget_getTeamBudget();
  
  // Handle "All Departments" selection from dropdown
  const deptSel = document.getElementById('budget-dept-sel');
  const selectedDept = deptSel?.value;
  
  if (selectedDept === 'All' || !activeDept) {
    // Show all departments - don't render individual dept detail
    document.getElementById('dept-table-title').textContent = `All Departments`;
    document.getElementById('dept-tbody').innerHTML = '<tr><td colspan="13" style="text-align:center;padding:40px;color:var(--muted)">Select a department to view details</td></tr>';
    return;
  }
  
  const isNotSpec = activeDept === 'Not specified';
  const yr = document.getElementById('budget-year-sel')?.value || '2026';
  const mode = document.getElementById('budget-mode-sel')?.value || 'month';
  const currentMonth = parseInt(document.getElementById('budget-m')?.value || 0);
  
  // Month label
  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const monthLabel = monthNames[currentMonth];
  
  document.getElementById('dept-table-title').textContent=`${deptDisplayName(activeDept)} — ${yr}`;
  
  // Auto-fetch YTD actuals if needed (non-blocking)
  if (mode === 'month' && budgetQBActuals && currentMonth > 0) {
    if (!budgetQBActualsYTD || !window._lastYTDFetch || window._lastYTDFetch !== `${yr}-${currentMonth}`) {
      console.log('[Budget Dept] Auto-fetching YTD actuals (non-blocking)...');
      budgetFetchActualsYTD().then(() => {
        window._lastYTDFetch = `${yr}-${currentMonth}`;
        // Re-render after YTD fetch completes
        budgetRenderDeptDetail();
      });
    }
  }
  
  // Update table header with 2-level headers + divider
  const deptTable = document.querySelector('#dept-tbody').closest('table');
  const deptThead = deptTable.querySelector('thead');
  deptThead.innerHTML = `
    <tr>
      <th rowspan="2" style="width:40px"></th>
      <th rowspan="2" style="text-align:left">Line Item</th>
      <th colspan="3" style="text-align:center;border-bottom:1px solid var(--border)">${monthLabel}</th>
      <th rowspan="2" style="width:1px;padding:0;background:var(--border)"></th>
      <th colspan="3" style="text-align:center;border-bottom:1px solid var(--border)">${monthLabel} YTD</th>
      <th rowspan="2" style="width:1px;padding:0;background:var(--border)"></th>
      <th colspan="3" style="text-align:center;border-bottom:1px solid var(--border)">2026</th>
    </tr>
    <tr>
      <th class="num" style="font-weight:500;color:var(--muted)">Budget</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Actual</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Var</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Budget</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Actual</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Var</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Budget</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Actual</th>
      <th class="num" style="font-weight:500;color:var(--muted)">Var</th>
    </tr>`;
  
  let html='',lastCat='';
  
  // ═══════════════════════════════════════════════════════════════════════════
  // REVENUE LINE (same as Overview - always shown, not department-specific)
  // ═══════════════════════════════════════════════════════════════════════════
  
  let revenueMonth = 0, revenueYTD = 0;
  
  // Get revenue from Opco GL account 40110 (with month support)
  const opcoActuals = mode === 'month' && budgetQBActuals?.['Opco']?.[currentMonth]
    ? budgetQBActuals['Opco'][currentMonth]
    : budgetQBActuals?.['Opco'] || {};
  
  if (opcoActuals['40110']) {
    revenueMonth = Math.abs(opcoActuals['40110']);
  }
  
  // YTD Revenue - must match current month selection
  if (currentMonth === 0) {
    revenueYTD = revenueMonth;
  } else if (mode === 'month' && budgetQBActualsYTD && window._budgetYTDMonth === currentMonth && budgetQBActualsYTD['Opco'] && budgetQBActualsYTD['Opco']['40110']) {
    revenueYTD = Math.abs(budgetQBActualsYTD['Opco']['40110']);
  } else if (mode === 'month' && budgetQBActuals?.['Opco']) {
    // Fallback: sum individual months (Jan to currentMonth)
    for (let m = 0; m <= currentMonth; m++) {
      const monthData = budgetQBActuals['Opco'][m];
      if (monthData && monthData['40110']) {
        revenueYTD += Math.abs(monthData['40110']);
      }
    }
  } else {
    revenueYTD = revenueMonth * (currentMonth + 1);
  }
  
  // Render Revenue row
  html += `<tr class="cat-row" style="background:#e6f9f4;border-top:2px solid #06D6A0">
    <td class="cat-label" colspan="13" style="color:#04a776;font-weight:600">
      Revenue
    </td>
  </tr>`;
  
  const revMonthVal = revenueMonth > 0 ? fmtF(revenueMonth) : '—';
  const revYTDVal = revenueYTD > 0 ? fmtF(revenueYTD) : '—';
  
  // Full Year Revenue (sum all 12 months)
  let revenueFullYear = 0;
  if (budgetQBActuals?.['Opco']) {
    for (let m = 0; m <= 11; m++) {
      const monthData = budgetQBActuals['Opco'][m];
      if (monthData && monthData['40110']) {
        revenueFullYear += Math.abs(monthData['40110']);
      }
    }
  }
  const revFullYearVal = revenueFullYear > 0 ? fmtF(revenueFullYear) : '—';
  
  html += `<tr style="background:#f0fdf7">
    <td></td>
    <td class="label indent">Core Product Revenue</td>
    <td class="num" style="color:var(--muted2)">—</td>
    <td class="num" style="color:#04a776;font-weight:500">${revMonthVal}</td>
    <td class="num">—</td>
    <td style="width:1px;padding:0;background:var(--border)"></td>
    <td class="num" style="color:var(--muted2)">—</td>
    <td class="num" style="color:#04a776;font-weight:500;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;text-decoration-color:#06D6A0" onclick="budgetShowRevenueTrend()">${revYTDVal}</td>
    <td class="num">—</td>
    <td style="width:1px;padding:0;background:var(--border)"></td>
    <td class="num" style="color:var(--muted2)">—</td>
    <td class="num" style="color:#04a776;font-weight:500">${revFullYearVal}</td>
    <td class="num">—</td>
  </tr>`;
  
  // ═══════════════════════════════════════════════════════════════════════════
  // EXPENSE CATEGORIES (existing code continues below)
  // ═══════════════════════════════════════════════════════════════════════════
  
  CAT_LINES.forEach(row=>{
    // Month Budget
    const bMonth = isNotSpec ? 0 : budget_periodScale(budget[activeDept][row.key]||0,'dp');
    
    // Month Actual (with dept filter for class)
    const aMonth = budgetGetActualForKey(row.key, activeDept) || 0;
    
    // YTD Budget
    let bYTD = 0;
    if (!isNotSpec) {
      const annualBudget = budget[activeDept][row.key] || 0;
      bYTD = (annualBudget / 12) * (currentMonth + 1);
    }
    
    // YTD Actual - Sum all months from 0 to currentMonth (with dept filter)
    let aYTD = 0;
    if (mode === 'month' && budgetQBActuals) {
      for (let m = 0; m <= currentMonth; m++) {
        const monthActual = budgetGetActualForMonth(row.key, m, activeDept);
        if (monthActual > 0 && (row.line === 'Travel' || row.line === 'Professional Services')) {
          console.log(`[YTD DEPT] ${row.line} month ${m}: ${monthActual}`);
        }
        aYTD += monthActual;
      }
      if (aYTD > 0 && (row.line === 'Travel' || row.line === 'Professional Services')) {
        console.log(`[YTD DEPT] ${row.line} TOTAL: ${aYTD}`);
      }
    } else if (currentMonth === 0) {
      aYTD = aMonth;
    } else {
      aYTD = aMonth * (currentMonth + 1);
    }
    
    // Category header
    if(row.cat!==lastCat){html+=`<tr class="cat-row"><td class="cat-label" colspan="13">${row.cat}</td></tr>`;lastCat=row.cat;}
    
    // Month variance
    const vMonth=budget_vc(bMonth,aMonth), vlabMonth=budget_vl(bMonth,aMonth);
    const bvalMonth=(!isNotSpec&&bMonth>0)?fmtF(bMonth):'—';
    const avalMonth=aMonth!==0?`<span class="budget-link" style="color:var(--text)" onclick="budgetActualClick('${row.key}',event,'${activeDept}')">${fmtF(aMonth)}</span>`:'—';
    
    // YTD variance
    const vYTD=budget_vc(bYTD,aYTD), vlabYTD=budget_vl(bYTD,aYTD);
    const bvalYTD=bYTD>0?fmtF(bYTD):'—';
    const avalYTD=aYTD!==0?`<span class="budget-link" style="color:var(--text)" onclick="budgetActualClickYTD('${row.key}',event,'${activeDept}')">${fmtF(aYTD)}</span>`:'—';
    
    // Full Year 2026 Budget
    const bFullYearDept = !isNotSpec ? (budget[activeDept][row.key] || 0) : 0;
    
    // Full Year 2026 Actual = YTD Actual (what we have so far)
    const aFullYearDept = aYTD;
    
    const vFullYearDept=budget_vc(bFullYearDept,aFullYearDept), vlabFullYearDept=budget_vl(bFullYearDept,aFullYearDept);
    const bvalFullYearDept=bFullYearDept>0?fmtF(bFullYearDept):'—';
    const avalFullYearDept=aFullYearDept>0?fmtF(aFullYearDept):'—';
    
    html+=`<tr>
      <td></td>
      <td class="label indent">${row.line}</td>
      <td class="num">${bvalMonth}</td>
      <td class="num">${avalMonth}</td>
      <td class="num"><span class="chip ${vMonth}">${vlabMonth}</span></td>
      <td style="width:1px;padding:0;background:var(--border)"></td>
      <td class="num">${bvalYTD}</td>
      <td class="num">${avalYTD}</td>
      <td class="num"><span class="chip ${vYTD}">${vlabYTD}</span></td>
      <td style="width:1px;padding:0;background:var(--border)"></td>
      <td class="num">${bvalFullYearDept}</td>
      <td class="num">${avalFullYearDept}</td>
      <td class="num"><span class="chip ${vFullYearDept}">${vlabFullYearDept}</span></td>
    </tr>`;
  });
  document.getElementById('dept-tbody').innerHTML=html||`<tr><td colspan="13" style="text-align:center;padding:24px;color:var(--muted);font-family:var(--mono);font-size:.78rem">No unclassified transactions for this period.</td></tr>`;
}

// ── BUDGET_MONTHLY ───────────────────────────────────────────────────────────────────
function budget_getActuals(){return BUDGET_MONTHS.map(m=>!activeMDept?BUDGET_DEPTS.reduce((s,d)=>s+(BUDGET_MONTHLY[d]?.[m]||0),0):BUDGET_MONTHLY[activeMDept]?.[m]||0);}
function budget_getBudgetM(){const budget=budget_getTeamBudget();const t=activeMDept?budget_deptTotalBudget(budget,activeMDept):BUDGET_DEPTS.reduce((s,d)=>s+budget_deptTotalBudget(budget,d),0);return BUDGET_MONTHS.map(()=>t/12);}
function budgetRenderMonthlyPills(){document.getElementById('monthly-pills').innerHTML=['All',...BUDGET_DEPTS].map(d=>{const k=d==='All'?null:d;return`<div class="dept-pill${activeMDept===k?' active':''}" onclick="budgetSelectMDept(${k?`'${d}'`:'null'})">${d}</div>`;}).join('');}
function budgetSelectMDept(d){activeMDept=(d===null||d==='All')?null:d;budgetRenderMonthlyPills();budgetRenderMonthly();}
function budgetRenderMonthly(){
  const act=budget_getActuals(),bud=budget_getBudgetM(),maxV=Math.max(...act,...bud)*1.1;
  document.getElementById('monthly-chart-title').textContent='Monthly Spend — '+(activeMDept||'All Departments');
  document.getElementById('monthly-chart').innerHTML=BUDGET_MONTHS.map((m,i)=>{const ah=Math.round(act[i]/maxV*140),bh=Math.round(bud[i]/maxV*140);return`<div class="month-grp"><div class="month-bars"><div class="bar-a" style="height:${ah}px"></div><div class="bar-b" style="height:${bh}px"></div></div><div class="month-lbl">${m}</div></div>`;}).join('');
  let cum=0;
  document.getElementById('monthly-tbody').innerHTML=BUDGET_MONTHS.map((m,i)=>{const a=act[i],b=bud[i];cum+=a;return`<tr><td class="label">${m} 2025</td><td class="num">${fmtF(a)}</td><td class="num">${fmtF(b)}</td><td class="num"><span class="chip ${budget_vc(b,a)}">${budget_vl(b,a)}</span></td><td class="num" style="color:var(--muted)">${fmtF(cum)}</td></tr>`;}).join('');
}

// ── HEADCOUNT ─────────────────────────────────────────────────────────────────
function budgetRenderHeadcount(){
  const budget=budget_getTeamBudget();
  const totSalB=BUDGET_DEPTS.reduce((s,d)=>s+(budget[d].salary||0),0), totSalA=BUDGET_DEPTS.reduce((s,d)=>s+(ACTUALS[d].salary||0),0);
  const totBonB=BUDGET_DEPTS.reduce((s,d)=>s+(budget[d].bonus||0),0);
  const cnt=teamData.filter(p=>p.status!=='Terminated').length;
  document.getElementById('hc-cards').innerHTML=`
    <div class="card"><div class="card-label">Active Headcount</div><div class="card-value blue">${cnt}</div><div class="card-sub">Current + Contract</div></div>
    <div class="card"><div class="card-label">Total Salary Budget</div><div class="card-value">${budgetFmt(totSalB)}</div><div class="card-sub">From Team Tracker</div><div class="card-bar"><div class="card-bar-fill" style="width:${Math.min(totSalA/totSalB*100,100)}%;background:var(--accent)"></div></div></div>
    <div class="card"><div class="card-label">Salary Actuals</div><div class="card-value">${budgetFmt(totSalA)}</div><div class="card-sub">${(totSalA/totSalB*100).toFixed(1)}% of budget</div></div>
    <div class="card"><div class="card-label">Avg Monthly Burn</div><div class="card-value green">$1.04M</div><div class="card-sub">All departments</div></div>
  `;
  document.getElementById('hc-tbody').innerHTML=BUDGET_DEPTS.map(d=>{
    const sb=budget[d].salary||0,sa=ACTUALS[d].salary||0,bb=budget[d].bonus||0,ba=ACTUALS[d].bonus||0;
    const count=teamData.filter(p=>p.dept===d&&p.status!=='Terminated').length;
    const v=budget_vc(sb+bb,sa+ba);
    return`<tr class="hc-row-clickable" onclick="budgetOpenPeopleModal('${d}')"><td class="label" style="font-weight:600">${d}</td><td class="num">${count}</td><td class="num">${fmtF(sb)}</td><td class="num">${fmtF(sa)}</td><td class="num">${fmtF(bb)}</td><td class="num">${ba>0?fmtF(ba):'—'}</td><td class="num"><span class="chip ${v}">${budget_vl(sb+bb,sa+ba)}</span></td></tr>`;
  }).join('');
}

// ── DEPT PEOPLE MODAL ─────────────────────────────────────────────────────────
function budgetOpenPeopleModal(dept){
  const people=teamData.filter(p=>p.dept===dept&&p.status!=='Terminated').sort((a,b)=>a.name.localeCompare(b.name));
  document.getElementById('people-modal-title').textContent=dept;
  document.getElementById('people-modal-sub').textContent=`${people.length} active member${people.length!==1?'s':''}`;
  const totalComp=people.reduce((s,p)=>s+(p.salary||0)+(p.bonus||0),0);
  document.getElementById('people-modal-count').textContent=`${people.length} people`;
  document.getElementById('people-modal-total').textContent='Total: '+fmtF(totalComp);
  document.getElementById('people-modal-tbody').innerHTML=people.map(p=>`
    <tr>
      <td class="label" style="font-weight:500">${p.name}<br><span style="font-size:.65rem;color:var(--muted);font-family:var(--mono)">${p.role}</span></td>
      <td><span class="status-badge ${p.status}" style="font-size:.62rem">${p.status}</span></td>
      <td><span class="status-badge ${p.status}" style="font-size:.62rem;background:var(--surface2);color:var(--muted)">${p.classification||''}</span></td>
      <td class="num">${fmtF(p.salary)}</td>
      <td class="num">${fmtF(p.bonus)}</td>
      <td class="num" style="font-weight:500">${fmtF((p.salary||0)+(p.bonus||0))}</td>
    </tr>`).join('')||'<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--muted)">No active members</td></tr>';
  document.getElementById('people-modal').classList.add('open');
}
function budgetClosePeople(){document.getElementById('people-modal').classList.remove('open');}

// ── TEAM TRACKER ──────────────────────────────────────────────────────────────
let budgetSortState = {col: 'name', dir: 1}; // dir: 1=asc, -1=desc

function budgetSortTeam(col, th) {
  if(budgetSortState.col === col) { budgetSortState.dir *= -1; }
  else { budgetSortState.col = col; budgetSortState.dir = 1; }
  // Update header classes
  document.querySelectorAll('#tab-team th.sortable').forEach(t => {
    t.classList.remove('sort-asc','sort-desc');
  });
  th.classList.add(budgetSortState.dir === 1 ? 'sort-asc' : 'sort-desc');
  budgetRenderTeam();
}

function budgetFilteredTeam(){
  const q=(document.getElementById('tt-q')?.value||'').toLowerCase();
  const df=document.getElementById('tt-dept')?.value||'';
  const sf=document.getElementById('tt-status')?.value;
  const ef=document.getElementById('tt-entity')?.value||'';
  return teamData.filter(p=>{
    if(sf==='active'&&p.status==='Terminated')return false;
    if(sf&&sf!=='active'&&p.status!==sf)return false;
    if(df&&p.dept!==df)return false;
    if(ef&&p.entity!==ef)return false;
    if(q&&!`${p.name} ${p.role} ${p.dept}`.toLowerCase().includes(q))return false;
    return true;
  }).sort((a,b)=>{
    let av, bv;
    if(budgetSortState.col==='total'){ av=(a.salary||0)+(a.bonus||0); bv=(b.salary||0)+(b.bonus||0); }
    else if(budgetSortState.col==='salary'||budgetSortState.col==='bonus'){ av=a[budgetSortState.col]||0; bv=b[budgetSortState.col]||0; }
    else { av=(a[budgetSortState.col]||'').toString().toLowerCase(); bv=(b[budgetSortState.col]||'').toString().toLowerCase(); }
    if(av<bv) return -1*budgetSortState.dir;
    if(av>bv) return 1*budgetSortState.dir;
    return 0;
  });
}
function budgetRenderBsum(){
  const ef=document.getElementById('tt-entity')?.value||'';
  const base=teamData.filter(p=>p.status!=='Terminated'&&(!ef||p.entity===ef));
  const ts=base.reduce((s,p)=>s+(p.salary||0),0), tb=base.reduce((s,p)=>s+(p.bonus||0),0);
  document.getElementById('tt-bsum').innerHTML=`
    <div class="bsum-item"><div class="bsum-label">${ef||'All'}</div><div class="bsum-val">${base.length} people</div></div>
    <div class="bsum-item"><div class="bsum-label">Salary Budget</div><div class="bsum-val">${budgetFmt(ts)}</div></div>
    <div class="bsum-item"><div class="bsum-label">Bonus Budget</div><div class="bsum-val">${budgetFmt(tb)}</div></div>
    <div class="bsum-item"><div class="bsum-label">Total Comp</div><div class="bsum-val">${budgetFmt(ts+tb)}</div></div>
    <div class="bsum-item"><div class="bsum-label">Monthly Payroll Est.</div><div class="bsum-val">${budgetFmt(ts/12)}</div></div>
  `;
}
function budgetRenderTeam(){
  budgetRenderBsum();
  const people=budgetFilteredTeam();
  const TERM_MONTHS = ['—','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const rows = people.map(p=>{
    const isTerm = p.status==='Terminated';
    const termSel = isTerm
      ? `<select style="font-family:var(--mono);font-size:.68rem;padding:2px 5px;border:1px solid var(--border);border-radius:4px;background:var(--surface);color:var(--text)" onchange="budgetSetTermMonth(${p.id},this.value)">${TERM_MONTHS.map((m,i)=>`<option value="${i}" ${(p.terminationMonth||0)==i?'selected':''}>${m}</option>`).join('')}</select>`
      : '<span style="color:var(--muted2);font-size:.68rem;font-family:var(--mono)">—</span>';
    return `<tr style="${isTerm?'opacity:0.55':''}">
      <td class="label" style="font-weight:500">${p.name}<br><span style="font-size:.65rem;color:var(--muted);font-family:var(--mono)">${p.email}</span></td>
      <td class="label" style="color:var(--muted);font-size:.76rem">${p.role}</td>
      <td><span class="dept-badge">${p.dept}</span></td>
      <td class="label" style="color:var(--muted);font-size:.72rem">${p.entity}</td>
      <td class="label" style="color:var(--muted);font-size:.72rem">${p.location}</td>
      <td><span class="status-badge ${p.status}">${p.status}</span></td>
      <td>${termSel}</td>
      <td class="num editable" onclick="budgetEditCell(this,${p.id},'salary')">${fmtF(p.salary)}</td>
      <td class="num editable" onclick="budgetEditCell(this,${p.id},'bonus')">${fmtF(p.bonus)}</td>
      <td class="num">${fmtF((p.salary||0)+(p.bonus||0))}</td>
      <td><button class="tt-action" onclick="budgetOpenEdit(${p.id})">✏️</button><button class="tt-action del" onclick="budgetTerminate(${p.id})">${isTerm?'↩️':'🗑️'}</button></td>
    </tr>`;
  }).join('');
  // Total row
  const totSal = people.reduce((s,p)=>s+(p.salary||0),0);
  const totBon = people.reduce((s,p)=>s+(p.bonus||0),0);
  const totalRow = people.length > 0 ? `<tr style="border-top:2px solid var(--border);font-weight:600;background:var(--surface2)">
    <td colspan="7" style="padding:6px 12px;font-family:var(--mono);font-size:0.72rem;color:var(--muted)">TOTAL (${people.length} shown)</td>
    <td class="num" style="font-family:var(--mono);font-size:0.78rem;color:var(--text)">${fmtF(totSal)}</td>
    <td class="num" style="font-family:var(--mono);font-size:0.78rem;color:var(--text)">${fmtF(totBon)}</td>
    <td class="num" style="font-family:var(--mono);font-size:0.78rem;color:var(--text)">${fmtF(totSal+totBon)}</td>
    <td></td>
  </tr>` : '';
  document.getElementById('tt-tbody').innerHTML = rows
    ? rows + totalRow
    : '<tr><td colspan="11" style="text-align:center;padding:24px;color:var(--muted);font-family:var(--mono);font-size:.78rem">No results</td></tr>';
}
function budgetEditCell(td,id,field){
  if(td.querySelector('input'))return;
  const p=teamData.find(x=>x.id===id);if(!p)return;
  td.innerHTML=`<input type="number" value="${p[field]||0}" onblur="budgetCommitCell(this,${id},'${field}')" onkeydown="if(event.key==='Enter')this.blur();if(event.key==='Escape')this.blur()">`;
  td.querySelector('input').focus();td.querySelector('input').select();
}
function budgetCommitCell(input,id,field){
  const p=teamData.find(x=>x.id===id);if(!p)return;
  p[field]=parseFloat(input.value)||0;
  budgetMarkDirty();budgetRenderTeam();
}
function budgetMarkDirty(){
  // data kept in memory only — use "Save to server" to persist
  const btn=document.getElementById('tt-savebtn');
  btn.style.borderColor='var(--orange)';btn.style.color='var(--orange)';
  document.getElementById('tt-sync').textContent='● Unsaved changes';
}
function budgetTerminate(id){
  const p=teamData.find(x=>x.id===id);if(!p)return;
  if(p.status==='Terminated'){p.status='Current';p.terminationMonth=0;}
  else{if(!confirm(`Mark ${p.name} as Terminated?`))return;p.status='Terminated';}
  budgetMarkDirty();budgetRenderTeam();
}
function budgetSetTermMonth(id, month){
  const p=teamData.find(x=>x.id===id);if(!p)return;
  p.terminationMonth=parseInt(month)||0;
  budgetMarkDirty();
}

// ── PERSON MODAL ──────────────────────────────────────────────────────────────
function budgetOpenAdd(){editingId=null;document.getElementById('pm-title').textContent='Add Team Member';['name','role','loc'].forEach(f=>document.getElementById('pf-'+f).value='');['salary','bonus'].forEach(f=>document.getElementById('pf-'+f).value='');document.getElementById('pf-dept').value='Engineering';document.getElementById('pf-entity').value='Zagreus';document.getElementById('pf-class').value='Employee';document.getElementById('pf-status').value='Current';document.getElementById('pf-ft').value='FT';document.getElementById('person-modal').classList.add('open');}
function budgetOpenEdit(id){
  editingId=id;const p=teamData.find(x=>x.id===id);if(!p)return;
  document.getElementById('pm-title').textContent='Edit Team Member';
  document.getElementById('pf-name').value=p.name||'';document.getElementById('pf-role').value=p.role||'';document.getElementById('pf-loc').value=p.location||'';document.getElementById('pf-salary').value=p.salary||0;document.getElementById('pf-bonus').value=p.bonus||0;document.getElementById('pf-dept').value=p.dept||'Engineering';document.getElementById('pf-entity').value=p.entity||'Zagreus';document.getElementById('pf-class').value=p.classification||'Employee';document.getElementById('pf-status').value=p.status||'Current';document.getElementById('pf-ft').value=p.ft||'FT';
  document.getElementById('person-modal').classList.add('open');
}
function budgetClosePerson(){document.getElementById('person-modal').classList.remove('open');}
function budgetSavePerson(){
  const name=document.getElementById('pf-name').value.trim();if(!name){alert('Name is required');return;}
  const data={name,role:document.getElementById('pf-role').value.trim(),dept:document.getElementById('pf-dept').value,entity:document.getElementById('pf-entity').value,classification:document.getElementById('pf-class').value,location:document.getElementById('pf-loc').value.trim(),salary:parseFloat(document.getElementById('pf-salary').value)||0,bonus:parseFloat(document.getElementById('pf-bonus').value)||0,status:document.getElementById('pf-status').value,ft:document.getElementById('pf-ft').value};
  if(editingId){const idx=teamData.findIndex(x=>x.id===editingId);if(idx>=0)teamData[idx]={...teamData[idx],...data};}
  else{const maxId=teamData.reduce((m,p)=>Math.max(m,p.id||0),0);teamData.push({id:maxId+1,email:'',...data});}
  budgetMarkDirty();budgetClosePerson();budgetRenderTeam();budgetRenderBsum();
}

// ── SAVE TO RAILWAY ───────────────────────────────────────────────────────────
async function budgetSaveTeam(){
  const btn=document.getElementById('tt-savebtn'), sync=document.getElementById('tt-sync');
  btn.textContent='Saving…';btn.style.opacity='.6';
  try{
    const r=await fetch(`${SERVER}/budget/team`,{method:'POST',headers:{'Content-Type':'application/json','X-Auth-Token':getBudgetToken()},body:JSON.stringify({team:teamData})});
    const d=await r.json();
    if(d.ok){btn.style.borderColor='var(--green)';btn.style.color='var(--green)';btn.textContent='✓ Saved';sync.textContent=`Saved · ${d.count} members · ${new Date(d.lastUpdated).toLocaleTimeString()}`;setTimeout(()=>{btn.textContent='Save to server';btn.style.borderColor='var(--accent)';btn.style.color='var(--accent)';},3000);
    // Refresh Edit Budget if open
    if(document.getElementById('bgt-edit')?.classList.contains('active')) budgetRenderEdit();
    }
    else throw new Error(d.error||'Failed');
  }catch(e){btn.style.borderColor='var(--red)';btn.style.color='var(--red)';btn.textContent='✗ Error';sync.textContent=e.message;setTimeout(()=>{btn.textContent='Save to server';btn.style.borderColor='var(--orange)';btn.style.color='var(--orange)';},4000);}
  btn.style.opacity='1';
}
async function budgetLoadTeamFromServer(){
  if(!getBudgetToken())return;
  try{
    const r=await fetch(`${SERVER}/budget/team`,{headers:{'X-Auth-Token':getBudgetToken()}});
    if(!r.ok)return;
    const d=await r.json();
    if(d.team&&d.team.length>0){teamData=d.team;const ts=d.lastUpdated?` · ${new Date(d.lastUpdated).toLocaleDateString()}`:'';document.getElementById('tt-sync').textContent=`Synced from server${ts}`;budgetRenderTeam();budgetRenderBsum();}
  }catch(e){}
}

// ── TAB NAVIGATION ────────────────────────────────────────────────────────────
function budgetShowTab(id){
  const panel = document.getElementById('tab-budget');
  panel.querySelectorAll('.tab-view').forEach(el=>el.classList.remove('active'));
  panel.querySelectorAll('.tab-btn').forEach(el=>el.classList.remove('active'));
  document.getElementById('bgt-'+id).classList.add('active');
  const idx={overview:0,departments:1,headcount:2,team:3,mapping:4,coverage:5};
  panel.querySelectorAll('.tab-btn')[idx[id]].classList.add('active');
  // Show/hide Mode selector
  const showMode = ['overview','departments','coverage'].includes(id);
  const modeWrap = document.getElementById('budget-mode-wrap');
  if(modeWrap) modeWrap.style.display = showMode ? 'flex' : 'none';
  // Show/hide Department selector
  const deptWrap = document.getElementById('budget-dept-wrap');
  if(deptWrap) {
    if(id === 'departments') {
      deptWrap.style.display = 'flex';
      budgetPopulateDeptDropdown();
    } else {
      deptWrap.style.display = 'none';
    }
  }
  if(id==='departments'){budgetRenderDeptPills('dept-pills');budgetRenderDeptDetail();}
  if(id==='coverage'){budgetRenderCoverage();}
  if(id==='headcount')budgetRenderHeadcount();
  if(id==='team'){budgetRenderTeam();budgetRenderBsum();budgetLoadTeamFromServer();}
  if(id==='mapping'){budgetRenderMapping();}
}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){budgetCloseDrill();budgetClosePerson();budgetClosePeople();}});

// ══════════════════════════════════════════════════════════════════
// QB MAPPING
// ══════════════════════════════════════════════════════════════════

// Default mapping from Excel — loaded from server if available
const BUDGET_DEFAULT_MAPPING = [
  {cat:'Compensation & Benefits', line:'Salaries & Wages',        key:'salary',       accounts:[60110,60310]},
  {cat:'Compensation & Benefits', line:'Bonus',                   key:'bonus',        accounts:[60120,60320]},
  {cat:'Compensation & Benefits', line:'Commissions',             key:'commissions',  accounts:[60140,60340]},
  {cat:'Compensation & Benefits', line:'Benefits',                key:'benefits',     accounts:[60130,60330,60510,60520]},
  {cat:'Compensation & Benefits', line:'Payroll Taxes',           key:'payroll',      accounts:[60150]},
  {cat:'Compensation & Benefits', line:'Severance Pay',           key:'severance',    accounts:[60160,60350]},
  {cat:'Software & SaaS',         line:'EPD Tools',               key:'epdTools',     accounts:[61010]},
  {cat:'Software & SaaS',         line:'Business Tools',          key:'bizTools',     accounts:[61020]},
  {cat:'Hosting & Infrastructure',line:'Cloud Hosting & Compute', key:'hosting',      accounts:[61110]},
  {cat:'Hosting & Infrastructure',line:'Blockchain & RPC',        key:'blockchainRpc',accounts:[61120]},
  {cat:'Hosting & Infrastructure',line:'Security & Monitoring',   key:'securityMon',  accounts:[61130]},
  {cat:'HR & Recruiting',         line:'HR Costs',                key:'hrCosts',      accounts:[63020,63030,63040,63050]},
  {cat:'HR & Recruiting',         line:'Third-Party & Referrals', key:'recruiting',   accounts:[63010]},
  {cat:'Marketing Expense',       line:'Events',                  key:'meals',        accounts:[65030]},
  {cat:'Marketing Expense',       line:'Other',                   key:'mktExp',       accounts:[65010,65020,65040,65050,65099]},
  {cat:'Travel & Entertainment',  line:'Travel & Entertainment',  key:'travel',       accounts:[64010,64020,64030,64040,64050,64060,64070]},
  {cat:'Travel & Entertainment',  line:'Company Offsite',         key:'colos',        accounts:[64110,64120,64130,64140,64150,64160,64170]},
  {cat:'Professional Services',   line:'Professional Services',   key:'profSvc',      accounts:[62010,62020,62030,62050,62060,62070]},
  {cat:'Transaction Fees',        line:'Transaction Fees',        key:'bankFees',     accounts:[66010,66020,66040]},
  {cat:'Office',                  line:'Office',                  key:'rent',         accounts:[67010,67020,67030]},
  {cat:'Misc Expenses',           line:'Misc Expenses',           key:'hardware',     accounts:[69010,69020,69040,69099]},
];

let budgetMapping = BUDGET_DEFAULT_MAPPING.map(m => ({...m, accounts:[...m.accounts]}));
let budgetMappingDirty = false;
let budgetEditingAccount = null; // {lineKey, acctIndex} or null

// ── Duplicate checker ──────────────────────────────────────────────────────────
function budgetCheckDuplicates() {
  const seen = {}, dupes = [];
  budgetMapping.forEach(row => {
    row.accounts.forEach(acct => {
      if (seen[acct]) dupes.push({acct, line1: seen[acct], line2: row.line});
      else seen[acct] = row.line;
    });
  });
  const alert = document.getElementById('map-dupe-alert');
  const text  = document.getElementById('map-dupe-text');
  if (dupes.length) {
    text.innerHTML = `<strong>Duplicate accounts detected:</strong> ` +
      dupes.map(d => `<strong>${d.acct}</strong> is in both "${d.line1}" and "${d.line2}"`).join(' · ');
    alert.style.display = 'flex';
    alert.style.background = 'var(--red-bg)';
    alert.style.borderColor = 'rgba(217,48,37,.2)';
  } else {
    alert.style.display = 'none';
  }
  return dupes.length === 0;
}

// ── Render mapping table ───────────────────────────────────────────────────────
function budgetRenderMapping() {
  budgetCheckDuplicates();
  const allAccts = budgetMapping.flatMap(r => r.accounts);
  const dupeSet  = new Set(allAccts.filter((a,i) => allAccts.indexOf(a) !== i));

  let html = '', lastCat = '';
  budgetMapping.forEach((row, rowIdx) => {
    if (row.cat !== lastCat) {
      html += `<tr style="background:var(--surface2)">
        <td colspan="5" style="font-family:var(--sans);font-size:.7rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);padding:10px 12px 6px">${row.cat}</td>
      </tr>`;
      lastCat = row.cat;
    }
    // Account chips
    const chips = row.accounts.map((acct, ai) => {
      const isDupe = dupeSet.has(acct);
      const chipStyle = isDupe
        ? 'background:var(--red-bg);color:var(--red);border:1px solid rgba(217,48,37,.3)'
        : 'background:var(--accent-bg);color:var(--accent);border:1px solid rgba(0,168,168,.2)';
      return `<span style="display:inline-flex;align-items:center;gap:3px;font-family:var(--mono);font-size:.68rem;padding:2px 6px 2px 8px;border-radius:4px;${chipStyle};margin:1px">
        ${isDupe ? '⚠ ' : ''}${acct}
        <button onclick="budgetRemoveAccount(${rowIdx},${ai})" style="background:none;border:none;cursor:pointer;color:inherit;font-size:.75rem;padding:0 2px;line-height:1;opacity:.6" title="Remove">✕</button>
      </span>`;
    }).join('');

    html += `<tr>
      <td class="label" style="color:var(--muted);padding-left:24px;font-size:.75rem"></td>
      <td class="label" style="font-weight:500">${row.line}</td>
      <td style="padding:6px 12px">
        <div style="display:flex;flex-wrap:wrap;gap:2px;align-items:center">
          ${chips}
          <button onclick="budgetOpenAddAccountInline(${rowIdx})" style="font-family:var(--mono);font-size:.65rem;padding:2px 8px;border-radius:4px;border:1px dashed var(--border2);background:none;color:var(--muted);cursor:pointer" title="Add account">+ add</button>
        </div>
      </td>
      <td class="label" style="font-size:.72rem;color:var(--muted2)">${row.accounts.length} account${row.accounts.length!==1?'s':''}</td>
      <td></td>
    </tr>`;
  });

  document.getElementById('map-tbody').innerHTML = html;
}

// ── Add account inline ─────────────────────────────────────────────────────────
function budgetOpenAddAccountInline(rowIdx) {
  // Replace the "+ add" button with an inline input
  const rows = document.querySelectorAll('#map-tbody tr:not([style*="surface2"])');
  // Find the right row — count non-header rows
  const allTrs = document.querySelectorAll('#map-tbody tr');
  let dataRowCount = -1;
  for (let i = 0; i < allTrs.length; i++) {
    const tr = allTrs[i];
    if (tr.style.background || tr.querySelector('td[colspan]')) continue;
    dataRowCount++;
    if (dataRowCount === rowIdx) {
      const addBtn = tr.querySelector('button[title="Add account"]');
      if (!addBtn) return;
      const inp = document.createElement('input');
      inp.type = 'number';
      inp.placeholder = 'e.g. 60110';
      inp.style.cssText = 'font-family:var(--mono);font-size:.68rem;width:80px;padding:2px 6px;border:1px solid var(--accent);border-radius:4px;background:var(--surface);color:var(--text);outline:none';
      inp.onkeydown = (e) => {
        if (e.key === 'Enter') { budgetConfirmAddAccount(rowIdx, parseInt(inp.value)); inp.remove(); addBtn.style.display=''; }
        if (e.key === 'Escape') { inp.remove(); addBtn.style.display=''; }
      };
      inp.onblur = () => { if(inp.value) budgetConfirmAddAccount(rowIdx, parseInt(inp.value)); inp.remove(); addBtn.style.display=''; };
      addBtn.style.display = 'none';
      addBtn.parentNode.insertBefore(inp, addBtn);
      inp.focus();
      return;
    }
  }
}

function budgetConfirmAddAccount(rowIdx, acct) {
  if (!acct || isNaN(acct)) return;
  if (!budgetMapping[rowIdx].accounts.includes(acct)) {
    budgetMapping[rowIdx].accounts.push(acct);
    budgetMappingDirty = true;
  }
  budgetRenderMapping();
}

function budgetRemoveAccount(rowIdx, acctIdx) {
  budgetMapping[rowIdx].accounts.splice(acctIdx, 1);
  budgetMappingDirty = true;
  budgetRenderMapping();
}

// ── Add entirely new line (+ Add account button in toolbar) ───────────────────
function budgetOpenAddAccount() {
  const cats = [...new Set(budgetMapping.map(r => r.cat))];
  const catOptions = cats.map(c => `<option value="${c}">${c}</option>`).join('');
  const modal = document.getElementById('person-modal'); // reuse modal shell
  // Use a simpler inline prompt approach
  const name = prompt('Category (e.g. "Software & SaaS"):');
  if (!name) return;
  const line = prompt('Subcategory / Line item name:');
  if (!line) return;
  const key = line.toLowerCase().replace(/[^a-z0-9]/g,'_').replace(/__+/g,'_');
  const acctsRaw = prompt('QB Account numbers (comma separated, e.g. 61010, 61020):');
  if (!acctsRaw) return;
  const accounts = acctsRaw.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n));
  const existing = budgetMapping.find(r => r.cat === name);
  const cat = existing ? existing.cat : name;
  budgetMapping.push({cat, line, key, accounts});
  budgetMappingDirty = true;
  budgetRenderMapping();
}

// ── Save mapping to server ─────────────────────────────────────────────────────
async function budgetSaveMapping() {
  const btn = document.getElementById('map-savebtn');
  btn.textContent = 'Saving…'; btn.style.opacity = '.6';
  try {
    const r = await fetch(`${SERVER}/budget/mapping`, {
      method: 'POST',
      headers: {'Content-Type':'application/json','X-Auth-Token': getBudgetToken()},
      body: JSON.stringify({mapping: budgetMapping}),
    });
    const d = await r.json();
    if (d.ok) {
      budgetMappingDirty = false;
      btn.style.borderColor = 'var(--green)'; btn.style.color = 'var(--green)';
      btn.textContent = '✓ Saved';
      setTimeout(() => { btn.textContent = 'Save to server'; btn.style.borderColor = 'var(--accent)'; btn.style.color = 'var(--accent)'; }, 3000);
    } else throw new Error(d.error || 'Failed');
  } catch(e) {
    btn.style.borderColor = 'var(--red)'; btn.style.color = 'var(--red)';
    btn.textContent = '✗ ' + e.message;
    setTimeout(() => { btn.textContent = 'Save to server'; btn.style.borderColor = 'var(--accent)'; btn.style.color = 'var(--accent)'; }, 4000);
  }
  btn.style.opacity = '1';
}

// ── Load mapping from server ───────────────────────────────────────────────────
async function budgetLoadMappingFromServer() {
  if (!getBudgetToken()) return;
  try {
    const r = await fetch(`${SERVER}/budget/mapping`, {headers:{'X-Auth-Token': getBudgetToken()}});
    if (!r.ok) return;
    const d = await r.json();
    if (d.mapping && d.mapping.length > 0) {
      budgetMapping = d.mapping;
    }
  } catch(e) { /* use default */ }
}



let _budgetInitialized = false;
// ── BUDGET IMPORT UI (Budget Admin only) ─────────────────────────────────────
function budgetShowImportUI() {
  // Add import button to controls if not already there
  const controlsDiv = document.querySelector('#tab-budget > div:nth-of-type(3)');
  if (!controlsDiv) return;
  
  // Check if import button already exists
  if (document.getElementById('budget-import-btn')) return;
  
  // Create import button
  const importBtn = document.createElement('button');
  importBtn.id = 'budget-import-btn';
  importBtn.className = 'fsel';
  importBtn.style.cssText = 'padding:10px 24px;background:#00A8A8;color:white;border:none;border-radius:10px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:0.05em;font-size:0.85rem;';
  importBtn.textContent = '📤 Import Budget';
  importBtn.onclick = budgetOpenImportModal;
  
  controlsDiv.appendChild(importBtn);
}

function budgetOpenImportModal() {
  const modal = document.getElementById('budget-import-modal');
  if (modal) {
    modal.style.display = 'flex';
    // Reset form with current month
    const now = new Date();
    document.getElementById('import-year').value = '2026';
    document.getElementById('import-month').value = String(now.getMonth() + 1);
    document.getElementById('import-dept').value = 'Engineering';
    document.getElementById('import-file').value = '';
    document.getElementById('import-preview').style.display = 'none';
  }
}

function budgetCloseImportModal() {
  const modal = document.getElementById('budget-import-modal');
  if (modal) modal.style.display = 'none';
}

function budgetHandleFileSelect(event) {
  const file = event.target.files[0];
  if (!file) return;
  
  const preview = document.getElementById('import-preview');
  const previewText = document.getElementById('import-preview-text');
  
  previewText.textContent = `File: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
  preview.style.display = 'block';
}

async function budgetSubmitImport(skipConfirm = false) {
  const year = document.getElementById('import-year').value;
  let month = document.getElementById('import-month').value;
  const dept = document.getElementById('import-dept').value;
  const fileInput = document.getElementById('import-file');
  const file = fileInput.files[0];
  
  if (!file) {
    alert('Please select a file');
    return;
  }
  
  // Auto-detect month from Excel row 6 if file is provided
  try {
    const arrayBuffer = await file.arrayBuffer();
    const workbook = XLSX.read(arrayBuffer, {type: 'array'});
    const sheet = workbook.Sheets[workbook.SheetNames[0]];
    
    // Check row 6 (A6, B6, etc.) for month name
    const row6Cells = ['A6', 'B6', 'C6', 'D6', 'E6', 'F6'];
    for (const cell of row6Cells) {
      const cellValue = sheet[cell]?.v || sheet[cell]?.w || '';
      const cellStr = String(cellValue).toLowerCase();
      
      const monthMap = {
        'january': '1', 'jan': '1',
        'february': '2', 'feb': '2',
        'march': '3', 'mar': '3',
        'april': '4', 'apr': '4',
        'may': '5',
        'june': '6', 'jun': '6',
        'july': '7', 'jul': '7',
        'august': '8', 'aug': '8',
        'september': '9', 'sep': '9',
        'october': '10', 'oct': '10',
        'november': '11', 'nov': '11',
        'december': '12', 'dec': '12'
      };
      
      for (const [name, num] of Object.entries(monthMap)) {
        if (cellStr.includes(name)) {
          month = num;
          console.log(`Auto-detected month: ${name} (${num}) from cell ${cell}`);
          break;
        }
      }
      if (month !== document.getElementById('import-month').value) break;
    }
  } catch (err) {
    console.warn('Could not auto-detect month:', err);
  }
  
  const btn = document.getElementById('import-submit-btn');
  const originalText = btn.textContent;
  btn.textContent = '⏳ Importing...';
  btn.disabled = true;
  
  try {
    const formData = new FormData();
    formData.append('file', file);
    formData.append('year', year);
    formData.append('month', month);
    formData.append('department', dept);
    
    if (skipConfirm) {
      formData.append('confirm', 'true');
    }
    
    const token = localStorage.getItem('tidelog_auth_token');
    const response = await fetch('https://tidelog-server-production.up.railway.app/api/budget/import', {
      method: 'POST',
      headers: {
        'X-Auth-Token': token
      },
      body: formData
    });
    
    const result = await response.json();
    
    // Handle confirmation needed (409)
    if (response.status === 409 && result.needsConfirmation) {
      const confirmMsg = `⚠️ Budget already exists!\n\n${result.message}\n\nDepartments with existing data:\n${result.existingDepartments.join(', ')}\n\nDo you want to OVERWRITE the existing budget?`;
      
      if (confirm(confirmMsg)) {
        // Retry with skipConfirm = true
        btn.textContent = originalText;
        btn.disabled = false;
        budgetSubmitImport(true);
        return;
      } else {
        btn.textContent = originalText;
        btn.disabled = false;
        return;
      }
    }
    
    if (response.ok) {
      let successMsg = `✓ Budget imported successfully!\n\n`;
      successMsg += `Year: ${result.year}\n`;
      successMsg += `Month: ${result.month}\n`;
      successMsg += `Departments processed: ${result.departmentsProcessed.join(', ')}\n`;
      successMsg += `Rows: ${result.totalRows}\n`;
      successMsg += `Budget items: ${result.totalKeys}\n`;
      
      if (result.departmentsMissing && result.departmentsMissing.length > 0) {
        successMsg += `\n⚠️ Missing departments in Excel:\n${result.departmentsMissing.join(', ')}`;
      }
      
      if (result.departmentsOverwritten && result.departmentsOverwritten.length > 0) {
        successMsg += `\n✓ Overwritten: ${result.departmentsOverwritten.join(', ')}`;
      }
      
      alert(successMsg);
      budgetCloseImportModal();
      
      // Reload budget data
      setTimeout(() => {
        window.location.reload();
      }, 500);
    } else {
      alert(`Error: ${result.error || 'Import failed'}\n\n${result.detail || ''}`);
    }
  } catch (err) {
    console.error('Import failed:', err);
    alert(`Import failed: ${err.message}`);
  } finally {
    btn.textContent = originalText;
    btn.disabled = false;
  }
}

// Pre-load QB account ID maps for all entities using OAuth tokens (non-blocking)
async function budgetPreloadAcctMaps() {
  if (!window._budgetAcctIdMap) window._budgetAcctIdMap = {};
  if (!window._budgetAcctNameMap) window._budgetAcctNameMap = {};
  const entities = ['Opco','Zagreus','Juku','Foundation'];
  for (const entity of entities) {
    if (window._budgetAcctIdMap[entity]) continue; // already loaded
    const realmId = QB_REALM_IDS[entity];
    if (!realmId) continue;
    try {
      const tok = await qbEnsureToken(realmId);
      const res = await fetch(`${QB_PROXY_URL}?path=${encodeURIComponent(`/v3/company/${realmId}/query?query=select * from Account MAXRESULTS 1000&minorversion=65`)}&realmId=${realmId}`, {
        credentials: 'include', headers: { 'Authorization': `Bearer ${tok}` }
      });
      if (!res.ok) continue;
      const d = await res.json();
      window._budgetAcctIdMap[entity] = {};
      window._budgetAcctNameMap[entity] = {};
      (d?.QueryResponse?.Account || []).forEach(a => {
        if (a.AcctNum) {
          window._budgetAcctIdMap[entity][a.AcctNum] = a.Id;
          window._budgetAcctNameMap[entity][a.AcctNum] = a.Name;
        }
      });
    } catch(e) {}
  }
}

function budgetInit() {
  // Set activeDept for restricted users if not already set
  if (window.BUDGET_RESTRICTED_DEPTS && window.BUDGET_RESTRICTED_DEPTS.length > 0 && !activeDept) {
    activeDept = window.BUDGET_RESTRICTED_DEPTS[0];
  }
  
  if (!_budgetInitialized) {
    _budgetInitialized = true;
    const sel = document.getElementById('tt-dept');
    if (sel && sel.options.length <= 1) {
      BUDGET_DEPTS.forEach(d => {
        const o = document.createElement('option');
        o.value = d; o.textContent = d;
        sel.appendChild(o);
      });
    }
    budgetRenderOverview();
    budgetLoadTeamFromServer();
    budgetLoadMappingFromServer();
    budgetLoadBudgetLines();
    budgetPreloadAcctMaps(); // non-blocking, loads QB account IDs for all entities
  } else {
    budgetRenderOverview();
  }
}
// ── COVERAGE CHECK ────────────────────────────────────────────────────────────
function budgetFetchBtn() {
  const activeTab = document.querySelector('#tab-budget .tab-view.active')?.id?.replace('bgt-','');
  if (activeTab === 'coverage') budgetFetchCoverage();
  else budgetFetchActuals();
}

async function budgetFetchCoverage() {
  const el = document.getElementById('coverage-body');
  const status = document.getElementById('budget-qb-status');
  if(el) el.innerHTML = `<div style="padding:40px;text-align:center;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">⟳ Fetching P&L…</div>`;

  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];
  const token = getBudgetToken();
  budgetQBActuals = budgetQBActuals || {};

  const mode = document.getElementById('budget-mode-sel')?.value || 'ytd';
  const yr   = document.getElementById('budget-year-sel')?.value || '2026';
  let fetchStart, fetchEnd;
  if (mode === 'ytd') {
    fetchStart = `${yr}-01-01`; fetchEnd = `${yr}-12-31`;
  } else if (mode === 'month') {
    const m = parseInt(document.getElementById('budget-m')?.value || 0);
    const mm = String(m+1).padStart(2,'0');
    fetchStart = `${yr}-${mm}-01`;
    fetchEnd   = `${yr}-${mm}-${new Date(parseInt(yr), m+1, 0).getDate()}`;
  } else {
    const f = parseInt(document.getElementById('budget-from')?.value || 0);
    const t = parseInt(document.getElementById('budget-to')?.value || 11);
    fetchStart = `${yr}-${String(f+1).padStart(2,'0')}-01`;
    fetchEnd   = `${yr}-${String(t+1).padStart(2,'0')}-${new Date(parseInt(yr), t+1, 0).getDate()}`;
  }

  // Also fetch account names for display
  if (!window._budgetAcctIdMap) window._budgetAcctIdMap = {};
  if (!window._budgetAcctNameMap) window._budgetAcctNameMap = {};

  for (const entity of entities) {
    const realmId = QB_REALM_IDS[entity];
    if (!realmId) continue;
    try {
      // P&L only — no GL by class needed for coverage
      const path = `/v3/company/${realmId}/reports/ProfitAndLoss?start_date=${fetchStart}&end_date=${fetchEnd}&accounting_method=Accrual&minorversion=65`;
      const url = `${QB_PROXY_URL}?path=${encodeURIComponent(path)}&realmId=${realmId}`;
      const r = await fetch(url, { headers: { 'X-Auth-Token': token } });
      if (!r.ok) continue;
      const data = await r.json();
      budgetQBActuals[entity] = budgetParseQBReport(data);
      // Account names
      if (!_budgetAcctIdMap[entity]) {
        try {
          const ap = `/v3/company/${realmId}/query?query=select * from Account MAXRESULTS 1000&minorversion=65`;
          const au = `${QB_PROXY_URL}?path=${encodeURIComponent(ap)}&realmId=${realmId}`;
          const ar = await fetch(au, { headers: { 'X-Auth-Token': token } });
          if (ar.ok) {
            const ad = await ar.json();
            _budgetAcctIdMap[entity] = {};
            _budgetAcctNameMap[entity] = {};
            (ad?.QueryResponse?.Account || []).forEach(a => {
              if (a.AcctNum) { _budgetAcctIdMap[entity][a.AcctNum] = a.Id; _budgetAcctNameMap[entity][a.AcctNum] = a.Name; }
            });
          }
        } catch(e) {}
      }
    } catch(e) {}
  }
  if(status) status.textContent = `✓ P&L updated (${new Date().toLocaleTimeString()})`;
  budgetRenderCoverage();
}

function budgetRenderCoverage() {
  const el = document.getElementById('coverage-body');
  if (!el) return;

  if (!budgetQBActuals) {
    el.innerHTML = `<div style="padding:40px;text-align:center;font-family:var(--mono);font-size:0.75rem;color:var(--muted)">
      <div style="margin-bottom:12px">Fetch P&L from QB to see coverage analysis.</div>
      <button onclick="budgetFetchCoverage()" style="font-family:var(--mono);font-size:.72rem;padding:5px 14px;border-radius:5px;border:1px solid var(--accent);background:var(--accent-bg);color:var(--accent);cursor:pointer">↺ Fetch P&L from QB</button>
    </div>`;
    return;
  }

  const entities = budgetEntity === 'All' ? ['Opco','Zagreus','Juku','Foundation'] : [budgetEntity];

  // All QB accounts that have values
  const qbAccounts = {}; // acctNum → total across entities
  for (const ent of entities) {
    for (const [acct, val] of Object.entries(budgetQBActuals[ent] || {})) {
      if (val > 0) qbAccounts[acct] = (qbAccounts[acct] || 0) + val;
    }
  }

  // All accounts in mapping
  const mappedAccounts = new Set();
  for (const m of budgetMapping) {
    for (const a of m.accounts) mappedAccounts.add(String(a));
  }

  // Totals
  let totalQB = 0, totalMapped = 0;
  for (const [acct, val] of Object.entries(qbAccounts)) totalQB += val;
  for (const [acct, val] of Object.entries(qbAccounts)) {
    if (mappedAccounts.has(String(acct))) totalMapped += val;
  }

  const coveragePct = totalQB > 0 ? (totalMapped / totalQB * 100) : 0;
  const gap = totalQB - totalMapped;

  // Unmapped accounts with values
  const unmapped = Object.entries(qbAccounts)
    .filter(([acct]) => !mappedAccounts.has(String(acct)))
    .sort((a, b) => b[1] - a[1]);

  // Mapped accounts for reference
  const mapped = Object.entries(qbAccounts)
    .filter(([acct]) => mappedAccounts.has(String(acct)))
    .sort((a, b) => b[1] - a[1]);

  const pctColor = coveragePct >= 95 ? 'var(--green)' : coveragePct >= 80 ? 'var(--orange)' : 'var(--red)';

  let html = `
    <!-- Summary cards -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px">
      <div class="kpi-card">
        <div class="kpi-label">QB Total Expenses</div>
        <div class="kpi-value">${fmtF(totalQB)}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Mapped to Budget</div>
        <div class="kpi-value" style="color:var(--green)">${fmtF(totalMapped)}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Gap (Unmapped)</div>
        <div class="kpi-value" style="color:${gap > 0 ? 'var(--red)' : 'var(--green)'}">${fmtF(gap)}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Coverage</div>
        <div class="kpi-value" style="color:${pctColor}">${coveragePct.toFixed(1)}%</div>
        <div style="margin-top:6px;height:4px;background:var(--border);border-radius:2px">
          <div style="height:4px;background:${pctColor};border-radius:2px;width:${Math.min(coveragePct,100).toFixed(1)}%"></div>
        </div>
      </div>
    </div>`;

  // Helper: get account name across entities
  const getAcctName = (acct) => {
    for (const ent of entities) {
      const name = window._budgetAcctNameMap?.[ent]?.[acct];
      if (name) return name;
    }
    return '';
  };

  // Unmapped accounts table
  if (unmapped.length > 0) {
    html += `
    <div style="margin-bottom:24px">
      <div style="font-family:var(--mono);font-size:0.72rem;font-weight:600;color:var(--red);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px">
        ⚠ ${unmapped.length} Unmapped Account${unmapped.length!==1?'s':''} — ${fmtF(gap)} not in budget
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Account #</th>
            <th>Name</th>
            <th class="num">Amount</th>
            <th class="num">% of QB Total</th>
            <th></th>
          </tr></thead>
          <tbody>`;
    for (const [acct, val] of unmapped) {
      const pct = totalQB > 0 ? (val / totalQB * 100) : 0;
      const name = getAcctName(acct);
      html += `<tr>
        <td><span style="font-family:var(--mono);font-size:0.78rem">${acct}</span></td>
        <td style="color:var(--muted);font-size:0.82rem">${name}</td>
        <td class="num">${fmtF(val)}</td>
        <td class="num" style="color:var(--muted)">${pct.toFixed(1)}%</td>
        <td><button class="tt-action" onclick="budgetGoMapping('${acct}')">+ Map</button></td>
      </tr>`;
    }
    html += `</tbody></table></div></div>`;
  } else {
    html += `<div style="padding:16px;font-family:var(--mono);font-size:0.78rem;color:var(--green);margin-bottom:24px">✓ All QB accounts are mapped to budget categories.</div>`;
  }

  // Mapped accounts table
  html += `
    <div>
      <div style="font-family:var(--mono);font-size:0.72rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px">
        ✓ ${mapped.length} Mapped Accounts — ${fmtF(totalMapped)}
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Account #</th>
            <th>Name</th>
            <th>Budget Line</th>
            <th class="num">Amount</th>
            <th class="num">% of QB Total</th>
          </tr></thead>
          <tbody>`;
  for (const [acct, val] of mapped) {
    const line = budgetMapping.find(m => m.accounts.includes(Number(acct)) || m.accounts.includes(String(acct)));
    const pct = totalQB > 0 ? (val / totalQB * 100) : 0;
    const name = getAcctName(acct);
    html += `<tr>
      <td><span style="font-family:var(--mono);font-size:0.78rem">${acct}</span></td>
      <td style="color:var(--muted);font-size:0.82rem">${name}</td>
      <td style="color:var(--muted)">${line ? line.line : '—'}</td>
      <td class="num">${fmtF(val)}</td>
      <td class="num" style="color:var(--muted)">${pct.toFixed(1)}%</td>
    </tr>`;
  }
  html += `</tbody></table></div></div>`;

  el.innerHTML = html;
}

function budgetGoMapping(acct) {
  budgetShowTab('mapping');
  // Highlight the add button
  setTimeout(() => {
    const btn = document.querySelector('#bgt-mapping .tt-add-btn');
    if(btn) { btn.style.outline = '2px solid var(--accent)'; setTimeout(()=>btn.style.outline='',2000); }
  }, 100);
}

// ══════════════════════════════════════════════════════════════════
// EDIT BUDGET
// ══════════════════════════════════════════════════════════════════
// Working copy of STATIC_BUDGET — editable by COO
// Contas de comp por entidade
const COMP_ACCT_MAP = {
  Opco:    { salary: '60310', bonus: '60320' },
  Zagreus: { salary: '60110', bonus: '60120' },
};
const COMP_ACCTS = new Set(['60310','60320','60110','60120']);

// Calcula salary e bonus do teamData por dept, somando por entidade → conta correcta
function budgetCalcCompFromTeam() {
  // result: { acctNum: { dept: value } }
  const result = {};
  for (const p of teamData) {
    if (p.status !== 'Current') continue;
    const map = COMP_ACCT_MAP[p.entity];
    if (!map) continue; // Juku/Foundation sem funcionários
    const salAcct = map.salary;
    const bonAcct = map.bonus;
    const dept    = p.dept;
    if (!result[salAcct]) result[salAcct] = {};
    if (!result[bonAcct]) result[bonAcct] = {};
    result[salAcct][dept] = (result[salAcct][dept] || 0) + (p.salary || 0);
    result[bonAcct][dept] = (result[bonAcct][dept] || 0) + (p.bonus  || 0);
  }
  return result;
}

