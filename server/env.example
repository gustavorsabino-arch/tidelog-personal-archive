# ─────────────────────────────────────────────
# Tidelog Server — Environment Variables
# Set these in Railway: Settings → Variables
# NEVER commit this file with real values
# ─────────────────────────────────────────────

# Birdeye API (pricing data)
BIRDEYE_KEY=your_birdeye_key_here

# Helius API (Solana RPC + transactions)
HELIUS_KEY=your_helius_key_here

# QuickBooks OAuth App credentials
# Get from: developer.intuit.com → your app → Keys & OAuth
QB_CLIENT_ID=your_qb_client_id_here
QB_CLIENT_SECRET=your_qb_client_secret_here

# QB OAuth redirect — MUST match exactly what's in Intuit Developer settings
# Format: https://YOUR-RAILWAY-DOMAIN/auth/qb/callback
QB_REDIRECT_URI=https://tidelog-server.railway.app/auth/qb/callback

# Comma-separated list of frontend origins allowed to call this server
# Add your Vercel URL here once deployed
ALLOWED_ORIGINS=https://tidelog.vercel.app,http://localhost

# Port (Railway sets this automatically — don't change)
# PORT=8080
