# tidelog — environment template
# Copy to .env.local and fill in. For LOCAL DEV you only need the "CORE (local)"
# block below; everything else is per-feature and optional until you use it.
# NEVER commit real secrets — .env.local is gitignored; this file is placeholders only.

# ─────────────────────────────────────────────────────────────────────────────
# CORE (local dev) — enough to boot `bun run dev`
# ─────────────────────────────────────────────────────────────────────────────
# Use the local Supabase/Postgres stack (not RDS).
DB_MODE=local
# Supabase CLI default port is 54322. `supabase start` prints the exact URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# drizzle migrations read this (falls back to DATABASE_URL if unset).
MIGRATE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Bypass Cloudflare Access locally and log in as a synthetic admin.
# Values: admin | viewer | none  (prod refuses SKIP_AUTH — dev only)
SKIP_AUTH=admin
DEV_USER_EMAIL=dev@orca.so

# App URLs + which email domains may sign in.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=orca.so

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (production / AWS mode) — NOT needed for local (DB_MODE=local)
# ─────────────────────────────────────────────────────────────────────────────
# DB_MODE=aws
# DB_HOST=your-instance.xxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=tidelog
# DB_USER=tidelog_app
# AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::<acct>:role/<vercel-oidc-role>   # RDS IAM auth via Vercel OIDC

# ─────────────────────────────────────────────────────────────────────────────
# AUTH (production) — not needed with SKIP_AUTH set
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_MODE=cf-access                      # cf-access | better-auth
# CF_ACCESS_AUD=<cloudflare-access-app-aud-tag>
# CF_ACCESS_TEAM_DOMAIN=<slug>.cloudflareaccess.com
# BETTER_AUTH_SECRET=<random-32+-char-secret>   # only for AUTH_MODE=better-auth
# GOOGLE_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# ─────────────────────────────────────────────────────────────────────────────
# ON-CHAIN DATA & PRICING (needed to sync/backfill balances & transactions)
# ─────────────────────────────────────────────────────────────────────────────
# HELIUS_API_KEY=<helius-key>              # Solana RPC + enhanced API
# HELIUS_RPS=10
# HELIUS_ENHANCED_RPS=2
# BIRDEYE_API_KEY=<birdeye-key>            # token pricing
# BIRDEYE_RPS=1
# DUST_THRESHOLD_USD=1

# ─────────────────────────────────────────────────────────────────────────────
# QUICKBOOKS (posting JEs, pulling reports) — optional locally
# ─────────────────────────────────────────────────────────────────────────────
# QB_CLIENT_ID=<intuit-app-client-id>
# QB_CLIENT_SECRET=<intuit-app-client-secret>
# QB_REDIRECT_URI=http://localhost:3000/api/qb/callback
# QB_OAUTH_STATE_SECRET=<random-secret>
# QB_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com   # or production base
# QB_REALM_OPCO=<realm-id>
# QB_REALM_FOUNDATION=<realm-id>
# QB_REALM_JUKU=<realm-id>
# QB_REALM_ZAGREUS=<realm-id>
# QB_HISTORY_START_YEAR=2024

# ─────────────────────────────────────────────────────────────────────────────
# INTEGRATIONS (optional) — invoice extraction, Slack, Google Drive, cron
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=<anthropic-key>        # approvals invoice extraction
# SLACK_BOT_TOKEN=<slack-bot-token>
# SLACK_APPROVALS_CHANNEL=<channel-id>
# GDRIVE_SERVICE_ACCOUNT_KEY=<json-service-account-key>
# GDRIVE_APPROVALS_FOLDER_ID=<drive-folder-id>
# CRON_SECRET=<random-secret>              # protects /api/admin/cron/* endpoints
